@code{

    IDictionary<string, object> attributes = new Dictionary<string, object>();

    private object? minValue { get; set; }

    private object? maxValue { get; set; }

    private object? step { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Column != null && Column.EditorSettings is NumericEditCellParams param && param.Params != null)
        {
            NumericTextBoxModel<object> model = param.Params;
            attributes = new Dictionary<string, object>()
            {
                { nameof(model.CssClass), model.CssClass },
                { nameof(model.Decimals), model.Decimals! },
                { nameof(model.EnableRtl), model.EnableRtl },
                { nameof(model.Format), model.Format },
                { nameof(model.Placeholder), model.Placeholder ?? PlaceHolder },
                { nameof(model.ShowClearButton), model.ShowClearButton },
                { nameof(model.ShowSpinButton), model.ShowSpinButton },
                { nameof(model.ValidateDecimalOnType), model.ValidateDecimalOnType }
            };
            minValue = model.Min;
            maxValue = model.Max;
            step = model.Step;
        }

        if (Column != null && Column.IsPrimaryKey)
        {
            attributes.AddOrUpdateItem("ShowSpinButton", false);
        }
        Value = Parent?.PropHelper?.GetObject(Column?.Field!, RowData!)!;
    }

    internal void ValueChange<T>(ChangeEventArgs<T> args)
    {
        if (args.Value != null)
        {
            Value = args.Value;
            if (Parent != null && Parent.EditModule != null)
            Parent.EditModule.SetValue<T>(args.Value, Column?.Field!);
        }
    }

    internal async Task CreatedHandler(Object args)
    {
        if (Parent != null && Parent.EditSettings!.Mode == EditMode.Batch && Parent.EditModule != null)
        {
            await this.Parent.InvokeMethod("sfBlazor.Grid.focusCell", Parent.DataId,
                    Parent.EditModule.OriginalCell?.Column?.Field, Parent.EditModule.IsAdd);
        }
    }
}