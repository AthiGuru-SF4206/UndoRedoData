    IDictionary<string, object> DataManagerAttributes = new Dictionary<string, object>();
    IEnumerable<object>? DropData = null;
    IEnumerable<TCell>? ParentDropData = null;
    public List<GridColumn> GridColumns => GridUtils.GetColumns(Parent!);
    private bool IsColumnUidRequired { get; set; }
    private string? DuplicateForeignkeyField { get; set; }
    private bool IsCustomDataSource { get; set; }

    protected override void OnInitialized()
    {

        base.OnInitialized();
        var ForeignData = Column!.GetForeignData() ?? Column.ColumnData;
        DropData = Column.IsForeignColumn() && ForeignData != null ? DataUtil.GetDistinct((IEnumerable<object>)ForeignData, Column.ForeignKeyField ?? Column.Field) : (IEnumerable<object>)Parent?.DataSource!;
        if (!Column.IsForeignColumn() && Parent != null && Parent.DataSource != null)
            ParentDropData = DataUtil.GetDistinct(Parent.DataSource, Column.Field);

        if (Column.EditorSettings is DropDownEditCellParams param && param.Params != null)
        {
            DropDownListModel<object, object> model = param.Params;
            IsCustomDataSource = model.DataSource != null ;
            attributes = new Dictionary<string, object>()
            {
                    { nameof(model.Enabled), model.Enabled = Column.AllowEditing ? model.Enabled : false},
                    { nameof(model.CssClass), model.CssClass },
                    { nameof(model.FilterBarPlaceholder), model.FilterBarPlaceholder },
                    { nameof(model.AllowFiltering), model.AllowFiltering },
                    { nameof(model.PopupDisplayMode), model.PopupDisplayMode },
                    //TODO: Change data type into RenderFragment for Templates properties
                    //{ nameof(model.FooterTemplate), model.FooterTemplate },
                    //{ nameof(model.HeaderTemplate), model.HeaderTemplate },
                    { nameof(model.PopupHeight), model.PopupHeight },
                    { nameof(model.PopupWidth), model.PopupWidth },
                    { nameof(model.Readonly), model.Readonly },
                    { nameof(model.ShowClearButton), model.ShowClearButton },
                    //{ nameof(model.ValueTemplate), model.ValueTemplate },
                    //{ nameof(model.ActionFailureTemplate), model.ActionFailureTemplate },
                    { nameof(model.DataSource), model.DataSource ?? DropData },
                    { nameof(model.FilterType), model.FilterType },
                    { nameof(model.IgnoreCase), model.IgnoreCase },
                    //{ nameof(model.IgnoreAccent), model.IgnoreAccent },
                    //{ nameof(model.EnableVirtualization), model.EnableVirtualization },
                    //{ nameof(model.Width), model.Width },
                    { nameof(model.Query), model.Query }
                };
        }

        if ((Parent != null && Parent.DataManager != null && Parent.DataManager.IsDataManager) ||
            (Column.IsForeignColumn() && Column.DataManager != null && Column.DataManager.IsDataManager))
        {
            isDataManager = true; DataManager _dm = Column.IsForeignColumn() ? Column.DataManager! : Parent!.DataManager!;
            if (_dm != null && _dm.AdaptorInstance != null && _dm.DataType != null && _dm.Headers != null && _dm.Json != null && _dm.RequestType != null && _dm.HttpClientInstance != null && _dm.GraphQLAdaptorOptions != null)
            {
                DataManagerAttributes = new Dictionary<string, object>()
            {
                { nameof(DataManager.Accept), _dm.Accept },
                { nameof(DataManager.Adaptor), _dm.Adaptor },
                { nameof(DataManager.AdaptorInstance), _dm.AdaptorInstance},
                { nameof(DataManager.CrossDomain), _dm.CrossDomain },
                { nameof(DataManager.DataType), _dm.DataType },
                { nameof(DataManager.Headers), _dm.Headers },
                { nameof(DataManager.Json), _dm.Json },
                { nameof(DataManager.Offline), _dm.Offline },
                { nameof(DataManager.Url), _dm.Url },
                { nameof(DataManager.RequestType), _dm.RequestType },
                { nameof(DataManager.RequiresFormat), _dm.RequiresFormat },
                { nameof(DataManager.HttpClientInstance), _dm.HttpClientInstance },
                { nameof(DataManager.GraphQLAdaptorOptions), _dm.GraphQLAdaptorOptions }
            };
            }
            
            //If datamanager then no need to send data source as attribute as we have datamanager component.
            if (!IsCustomDataSource)
            {
                attributes.Remove("DataSource");
            }
            isDataManager = IsCustomDataSource ? false : true;
        }

        Value = Parent?.PropHelper!.GetObject(Column?.Field!, RowData!);
        object valueExp = GetValueExpression(Column!)!;
        Model = new EditorDropDownModel(){
            PlaceHolder = PlaceHolder,
            FloatLabelType = FloatLabelType,
            isDataManager = isDataManager,
            Attributes = attributes,
            DataManagerAttributes = DataManagerAttributes,
            Column = Column!,
            Enabled = Enabled,
            DropData = DropData,
            Value = Value,
            ValueExpression = valueExp
        };
        var duplicateForeignKeyColumns = ForeignKey<TCell>.GetForeignKeyColumnsAsync(GridColumns).Where(x => x.Field == Column?.Field).ToList();
        if (duplicateForeignKeyColumns.Count > 1)
        {
            IsColumnUidRequired = true;
            DuplicateForeignkeyField = Column?.Field;

        }
        foreignKeyColumnParameters = new GridForeignKeyColumnParameters()
        {
            IsColumnUidRequired = IsColumnUidRequired,
            DuplicateForeignkeyField = DuplicateForeignkeyField
        };
    }

   
    private object? GetValueExpression(GridColumn column)
    {
        object? valueExp = null;
        if (Column != null && Column.IsForeignColumn())
        {
            valueExp = GetForeignKeyValueExpression(column);
        }
        else if (column?.ValueType == typeof(string))
        {
            valueExp = StringExp;
        }
        else if (column?.ValueType == typeof(int))
        {
            valueExp = IntExp;
        }
        else if (column?.ValueType == typeof(int?))
        {
            valueExp = NullableIntExp;
        }
        else if (column?.ValueType == typeof(double?))
        {
            valueExp = NullableDoubleExp;
        }
        else if (column?.ValueType == typeof(double))
        {
            valueExp = DoubleExp;
        }
        else if (column?.ValueType == typeof(float?))
        {
            valueExp = NullableFloatExp;
        }
        else if (column?.ValueType == typeof(float))
        {
            valueExp = FloatExp;
        }
        else if (column?.ValueType == typeof(long?))
        {
            valueExp = NullableLongExp;
        }
        else if (column?.ValueType == typeof(long))
        {
            valueExp = LongExp;
        }
        else if (column?.ValueType == typeof(ulong?))
        {
            valueExp = NullableUlongExp;
        }
        else if (column?.ValueType == typeof(ulong))
        {
            valueExp = UlongExp;
        }
        else if (column?.ValueType == typeof(short?))
        {
            valueExp = NullableShortExp;
        }
        else if (column?.ValueType == typeof(short))
        {
            valueExp = ShortExp;
        }
        else 
        {
            valueExp = GetChildValueExpression(column!);
        }
        return valueExp;
    }

    private object? GetForeignKeyValueExpression(GridColumn column)
    {
        object? valueExp = null;
        switch (column.ActualType)
        {
            case Type t when t == typeof(int?):
                valueExp = NullableIntExp;
                break;

            case Type t when t == typeof(string):
                valueExp = StringExp;
                break;

            case Type t when t == typeof(double?):
                valueExp = NullableDoubleExp;
                break;

            case Type t when t == typeof(decimal?):
                valueExp = NullableDecimalExp;
                break;

            case Type t when t == typeof(long?):
                valueExp = NullableLongExp;
                break;

            case Type t when t == typeof(Guid?):
                valueExp = NullableGuidExp;
                break;
        }
        return valueExp;
    }

    private object? GetChildValueExpression(GridColumn column)
    {
        object? valueExp = null;
        if (column.ValueType == typeof(ushort?))
        {
            valueExp = NullableUshortExp;
        }
        else if (column.ValueType == typeof(ushort))
        {
            valueExp = UshortExp;
        }
        else if (column.ValueType == typeof(uint?))
        {
            valueExp = NullableUintExp;
        }
        else if (column.ValueType == typeof(uint))
        {
            valueExp = UintExp;
        }        
        else if (column.ValueType == typeof(decimal?))
        {
            valueExp = NullableDecimalExp;
        }
        else if (column.ValueType == typeof(decimal))
        {
            valueExp = DecimalExp;
        }
        else if (column.ValueType == typeof(Guid?))
        {
            valueExp = NullableGuidExp;
        }
        else if (column.ValueType == typeof(Guid))
        {
            valueExp = GuidExp;
        }
        else if (column.ValueType == typeof(DateTime?))
        {
            valueExp = NullableDateExp;
        }
        else if (column.ValueType == typeof(DateTime))
        {
            valueExp = DateExp;
        }
        else if (column.ValueType == typeof(DateTimeOffset?))
        {
            valueExp = NullableOffsetExp;
        }
        else if (column.ValueType == typeof(DateTimeOffset))
        {
            valueExp = OffsetExp;
        }
        else if (column.ValueType == typeof(Object))
        {
            valueExp = ObjectExp;
        }
        return valueExp;
    }

    internal void ValueChange<T, TData>(ChangeEventArgs<T, TData> args)
    {
        Value = args.Value;
        if (Parent != null && Parent.EditModule != null)
        Parent.EditModule.SetValue<T>(args.Value, Column?.Field!);
    }
}


