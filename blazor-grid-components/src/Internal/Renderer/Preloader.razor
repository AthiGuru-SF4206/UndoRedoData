@namespace Syncfusion.Blazor.Grids.Internal
@using Syncfusion.Blazor.Internal 
@using System.Text.Json.Serialization;
@using System.Dynamic;
@typeparam TContent

@ChildContent

@code
{
    #region Parameters & Cascading

    [Parameter]
    public IEnumerable<object>? Data { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [CascadingParameter]
    SfGrid<TContent>? Parent { get; set; }

    [CascadingParameter]
    [JsonIgnore]
    BaseComponent? BaseParent { get; set; }

    #endregion

    #region Private State

    private IEnumerable<object>? _data { get; set; }

    private bool _initialLoadListenersAdded;

    #endregion

    #region Lifecycle

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        bool isAutoGenColumns = await TryAutoGenerateColumnsAsync().ConfigureAwait(true);

        EnsureInitialLoadListeners();

        await TryInitialPrerenderDataProcessAsync(isAutoGenColumns).ConfigureAwait(true);
    }

    #endregion

    #region Auto Generated Columns

    private async Task<bool> TryAutoGenerateColumnsAsync()
    {
        // NOTE: Keeping your original condition and behavior as-is.
        bool isAutoGenColumns = false;

        if (Parent != null && !Parent.HasColumnChanges && Parent.Columns == null)
        {
            isAutoGenColumns = true;

            List<GridColumn> columns = (List<GridColumn>)Parent.Columns!;
            Type type = typeof(TContent);

            bool isDynamicObjectType = type.BaseType == typeof(DynamicObject);
            bool isExpandoObjectType = type == typeof(ExpandoObject);
            bool isDynamic = isDynamicObjectType || isExpandoObjectType;

            GridAnnotation.MapAnnotation(ref columns, typeof(TContent), isDynamic);
            GridAnnotation.MapDynamicAnnotation(ref columns, typeof(TContent), Parent.DataSource!);

            await Parent.UpdateProperties("Columns", columns).ConfigureAwait(true);
            Parent.IsAutoGeneratedColumns = true;
        }

        return isAutoGenColumns;
    }

    #endregion

    #region Event Aggregator Wiring

    private void EnsureInitialLoadListeners()
    {
        if (_initialLoadListenersAdded || Parent?.EventAggregator == null)
        {
            return;
        }

        AddLoadEventListener();
        _initialLoadListenersAdded = true;
    }

    private void AddLoadEventListener()
    {
        Parent!.EventAggregator.Add("InitialLoad", Parent.SortModule!.InitialGroupSort);
        Parent.EventAggregator.Add("InitialLoad", Parent.VirtualScrollModule!.VirtualLoadListener);
        Parent.EventAggregator.Add("InitialLoad", Parent.VirtualScrollModule!.HideAtMediaListener);
    }

    #endregion

    #region Initial Server-Prerender Data Process

    private async Task TryInitialPrerenderDataProcessAsync(bool isAutoGenColumns)
    {
        if (!ShouldRunInitialPrerenderDataProcess())
        {
            return;
        }

        Parent!.IsDataLoaded = true;
        Parent.DataManager!.DataAdaptor?.SetRunSyncOnce(true);
        Parent.EventAggregator?.Trigger("InitialLoad", Parent);

        if (Parent.GridEvents?.OnLoad.HasDelegate == true)
        {
            await Parent.GridEvents.OnLoad.InvokeAsync(null!).ConfigureAwait(true);
        }
        else if (Parent.IsRenderedFromTreeGrid)
        {
            await Parent.EventAggregator!.NotifyAsync("OnLoadMock", null!).ConfigureAwait(true);
        }

        if (Parent.VirtualScrollModule != null && !Parent.VirtualScrollModule.NeedClientAction)
        {
            bool hasDirectParamColumns = Parent.directParamKeys?.Contains(nameof(Parent.Columns)) == true;
            Parent.PreventStateChange = !Parent.ID!.Contains("_sfprint") && !isAutoGenColumns && !hasDirectParamColumns;
            await Parent.DataProcess().ConfigureAwait(true);
        }
    }

    private bool ShouldRunInitialPrerenderDataProcess()
    {
        return Parent != null
            && !Parent.EnablePersistence
            && Data == null
            && Parent.DataSource != null
            && Parent.DataSource.Any()
            && !Parent.IsDataLoaded
            && SfGrid<TContent>.IsColumnsLoaded((List<GridColumn>)Parent.Columns!)
            && !Parent.HasAggregateChanges
            && !Parent.HasSortColumnChanges
            && !Parent.HasFilterColumnChanges
            && !ForeignKey<TContent>.GetForeignKeyColumnsAsync(Parent.Columns!).Any();
    }

    #endregion
}

