                item = (TContent)data;
            }
            CustomFilterItem = item;
            if (FirstAutoComplete != null)
            {
                await FirstAutoComplete.AddItemsAsync(new List<TContent>() { item });
            }
            if (SecondAutoComplete != null)
            {
                await SecondAutoComplete.AddItemsAsync(new List<TContent>() { item });
            }

        }
    }

   

