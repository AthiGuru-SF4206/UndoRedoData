    #region Filter Processing

    /// <summary>
    /// Applies the filter based on the current operator and value selections.
    /// Validates input, builds filter predicates, and updates the FilterSettings.
    /// Handles both single and dual condition filters with AND/OR logic.
    /// </summary>
    /// <remarks>
    /// This method:
    /// 1. Retrieves operator and value for first and second conditions
    /// 2. Determines if custom filter (two conditions) or single condition
    /// 3. For single condition: calls FilterByColumn through FilterModule
    /// 4. For dual conditions: creates GridFilterColumn entries with appropriate operators
    /// 5. Triggers ModelChanged event with FilteringEventArgs
    /// 6. Closes dialogs and updates UI state
    ///
    /// Follows Excel filter behavior with support for:
    /// - Custom filters with AND/OR predicates
    /// - Foreign key columns (uses ForeignKeyValue instead of Field)
    /// - Match case sensitivity based on operator type
    /// - Template-based and type-based value retrieval
    /// </remarks>
    internal async Task FilterBtnClick()
    {
        object value1 = "";
        object value2 = "";
        var filterOperator1 = "";
        var filterOperator2 = "";
        isDialogClosed = true;
        isSubMenuItemSelected = false;
        if (Parent?.FilterModule != null)
            Parent.FilterModule.IsSubMenuClick = false;
        if (Column?.FilterTemplate != null)
        {
            filterOperator1 = GetFirstColumnFilterOperator();
            filterOperator2 = GetSecondColumnFilterOperator();
            value1 = filterOperator1 == null ? null! : ModelInstance1?.GetType().GetProperty("Value")?.GetValue(ModelInstance1)!;
            value2 = filterOperator2 == null ? null! : ModelInstance2?.GetType().GetProperty("Value")?.GetValue(ModelInstance2)!;
        }
        else if (Column?.ValueType != null)
        {
            filterOperator1 = GetFirstColumnFilterOperator();
            filterOperator2 = GetSecondColumnFilterOperator();
            value1 = GetFirstColumnFilterValue()!;
            value2 = GetSecondColumnFilterValue()!;
        }
#pragma warning disable BL0005
        if (Parent?.FilterSettings?.Columns == null)
        {
            Parent!.FilterSettings!.Columns = new List<GridFilterColumn>();
        }

        List<PredicateModel<object>> predicateModels = new List<PredicateModel<object>>();
#pragma warning restore BL0005
        bool isCustomFilter = filterOperator1 != null && filterOperator2 != null;
        if (((value2 == null && value1 != null) || (value1 == null && value2 != null) || (value1 == null && value2 == null) || (value1 != null && value2 != null && filterOperator1 != null && filterOperator2 == null)) && (!isCustomFilter || (Parent.IsRenderedFromTreeGrid && value1 == null && value2 == null)))
        {
            object? value = (value1 == null && AndRadioButton == "or" && filterOperator2 != null) ? value2 : value1;
            string? filterOperator = (value == value1) ? filterOperator1 : filterOperator2;
            Parent.FilterModule!.FilterIconIsClicked = false;
            Parent.FilterModule.ExcelDialog = true;
            FirstAutoComplete?.Dispose();
            Parent.EventAggregator.Trigger("CloseAdaptiveDialog", null!);
            Parent.EventAggregator.Trigger("CloseColumnMenuAdaptiveDialog", null!);
            await Parent.FilterModule.FilterDialogInstance?.HideAsync()!;
            await Parent.FilterSettings.UpdateProperties("Columns", Parent.FilterSettings.Columns);
            await Parent.FilterModule.FilterByColumn(this.Column?.Field!, Filter<TContent>.GetOperator(filterOperator!), value!, null, MatchCaseCheckBox?.Checked, Parent.FilterSettings.IgnoreAccent, null, null, Column?.Uid);
        }
        else
        {
            var removeFilterColumns = Parent.FilterSettings.Columns?.Where(col => col.Field == this.Column?.Field).ToList();
            foreach (var col in removeFilterColumns!)
            {
                Parent.FilterSettings.Columns?.Remove(col);
            }
            for (var i = 0; i < 2; i++)
            {
                var filterColumn = new GridFilterColumn()
                {
#pragma warning disable BL0005
                    Field = this.Column?.IsForeignColumn() == true ? this.Column.ForeignKeyValue! : this.Column?.Field!,
                    Operator = i == 0 ? Filter<TContent>.GetEnumOperator(filterOperator1!) : Filter<TContent>.GetEnumOperator(filterOperator2!),
                    Value = i == 0 ? value1! : value2!,
                    MatchCase = MatchCaseCheckBox != null ? MatchCaseCheckBox.Checked ? MatchCaseCheckBox.Checked : Parent.FilterSettings.EnableCaseSensitivity : false,
                    IgnoreAccent = Parent.FilterSettings.IgnoreAccent,
                    Uid = this.Column?.Uid!,
                    Predicate = AndRadioButton,
                    ColumnType = Filter<TContent>.GetColumnType(this.Column?.Type)!,
#pragma warning restore BL0005
                };

                var predicateModel = new PredicateModel<object>()
                {
#pragma warning disable BL0005
                    Field = this.Column?.IsForeignColumn() == true ? this.Column.ForeignKeyValue! : this.Column?.Field!,
                    Operator = i == 0 ? Filter<TContent>.GetEnumOperator(filterOperator1!) : Filter<TContent>.GetEnumOperator(filterOperator2!),
                    Value = i == 0 ? value1! : value2!,
                    MatchCase = MatchCaseCheckBox != null ? MatchCaseCheckBox.Checked ? MatchCaseCheckBox.Checked : Parent.FilterSettings.EnableCaseSensitivity : false,
                    IgnoreAccent = Parent.FilterSettings.IgnoreAccent,
                    Uid = this.Column?.Uid!,
                    Predicate = AndRadioButton,
#pragma warning restore BL0005
                };
                Parent.FilterSettings.Columns?.Add(filterColumn);
                predicateModels.Add(predicateModel);
            }
            if (Parent.FilterModule != null)
                Parent.FilterModule.FilterIconIsClicked = false;
            SecondAutoComplete?.Dispose();
            Parent.EventAggregator.Trigger("CloseAdaptiveDialog", null!);
            Parent.EventAggregator.Trigger("CloseColumnMenuAdaptiveDialog", null!);
            await Parent.FilterModule!.FilterDialogInstance?.HideAsync()!;
            await Parent.FilterSettings.UpdateProperties("Columns", Parent.FilterSettings.Columns!);
            var filteringArgs = new Syncfusion.Blazor.Grids.FilteringEventArgs()
            {
                ColumnName = this.Column?.Field!,
                FilterPredicates = predicateModels,
            };
            await Parent.ModelChanged(new ActionEventArgs<TContent>() { Columns = predicateModels, CurrentFilteringColumn = this.Column?.Field!, RequestType = Grids.Action.Filtering }, eventArgs: filteringArgs, requestType: "Filtering");
            isDialogClosed = true;
            Parent.FilterModule.ExcelDialog = false;
        }
        Parent.EventAggregator.Trigger("CloseAdaptiveDialog", null!);
        Parent.EventAggregator.Trigger("CloseColumnMenuAdaptiveDialog", null!);
        await Parent.FilterModule.FilterDialogInstance?.HideAsync()!;
        Parent.FilterModule.FilterIconIsClicked = false;
        Parent.EventAggregator.Trigger("FilterComponentUpdate", null!);
        Parent.FilterModule.ExcelDialog = false;
    }

