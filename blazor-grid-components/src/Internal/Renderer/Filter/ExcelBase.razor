    /// <summary>
    /// Handles menu item selection event in the custom filter context menu.
    /// Manages operator selection, dialog transitions, and submenu navigation.
    /// </summary>
    /// <param name="Args">The menu event arguments containing the selected menu item.</param>
    /// <remarks>
    /// This method:
    /// 1. Extracts selected menu item text and sub-items
    /// 2. Closes parent dialogs (adaptive UI context menus)
    /// 3. Determines if selected item is a filter type (TextFilter, NumberFilter, etc.)
    /// 4. For operator items: sets SelectedFoperator and transitions to custom filter dialog
    /// 5. For ClearFilter item: removes filter predicates via FilterModule
    /// 6. Handles adaptive UI mode with different dialog behavior
    /// 7. Manages context menu and column menu visibility
    ///
    /// Supports both desktop and adaptive (mobile) UI modes with appropriate transitions.
    /// </remarks>
    internal async Task ItemSelected(MenuEventArgs<MenuItem> Args)
    {
        IsSubMenuDialog = true;
        SubMenuItems = Args.Item?.Items!;
        SelectedText = Args.Item?.Text!;
        if ((Parent?.EnableAdaptiveUI == true) && SubMenuItems != null)
        {
            this.contextMenu?.Close();
            Parent.Notify("CloseAdaptiveCheckBoxDialog", null!);
        }
        if (Parent!.ColumnMenuInstance != null)
        {
#pragma warning disable BL0005
            Parent.ColumnMenuInstance.CssClass = $"e-hide-menu e-{Parent.ID}-column-menu e-grid-column-menu e-grid-menu";
#pragma warning restore BL0005
            Parent.ColumnMenuClass = $"e-hide-menu e-{Parent.ID}-column-menu e-grid-column-menu e-grid-menu";
            Parent.IsColumnMenuFilter = false;
            Parent.ColumnMenuInstance?.Close();
        }
        if (Args.Item?.Text != Localizer!.GetText(GridLocaleKeys.ClearFilter) &&
            Args.Item?.Text != Localizer.GetText(GridLocaleKeys.TextFilter) &&
            Args.Item?.Text != Localizer.GetText(GridLocaleKeys.NumberFilter) &&
            Args.Item?.Text != Localizer.GetText(GridLocaleKeys.DateFilter) &&
            Args.Item?.Text != Localizer.GetText(GridLocaleKeys.DateTimeFilter) &&
            Args.Item?.Text != Localizer.GetText(GridLocaleKeys.TimeFilter))
        {
            isSubMenuItemSelected = true;
            Parent.FilterModule!.IsSubMenuClick = true;
            if (Args.Item != null && !string.IsNullOrEmpty(Args.Item.Id))
            {
                SelectedFoperator = Args.Item.Id;
            }
            if (!Parent.EnableAdaptiveUI)
            {
                await Parent.FilterModule.FilterDialogInstance?.HideAsync()!;
                this.contextMenu?.Close();
            }
            else
            {
                IsSubMenuDialog = false;
                isDialogClosed = true;
                this.SubMenuRef?.Close();
                Parent.EventAggregator.Trigger("CloseAdaptiveDialog", null!);
                await Parent.FilterModule.FilterDialogInstance?.HideAsync()!;
            }
        }
        else if (Args.Item?.Text == Localizer.GetText(GridLocaleKeys.ClearFilter))
        {
            isDialogClosed = true;
            Parent.FilterModule!.FilterIconIsClicked = false;
            Parent.EventAggregator.Trigger("FilterComponentUpdate", null!);
            await Parent.FilterModule.RemoveFilterColumnByField(this.Column?.Field!, this.Column?.Uid!);
        }
    }

