    /// <summary>
    /// Represents a filter operator with localized display text and internal value.
    /// Used to populate the operator dropdown lists in custom filter dialogs.
    /// </summary>
    /// <remarks>
    /// This class models the key-value pair structure for dropdown items:
    /// - Value: The internal operator identifier (e.g., "equal", "contains", "between")
    ///   Used in filter predicate building and GridFilterColumn.Operator assignment
    /// - Text: The localized display text shown in the UI dropdown
    ///   Retrieved from ISyncfusionStringLocalizer (e.g., "Equals", "Contains", "Between")
    ///
    /// Instances are collected in NumberSubMenuItems and StringSubMenuItems lists
    /// and bound to SfDropDownList/SfAutoComplete components for operator selection.
    /// </remarks>
    internal class Operator
    {
        public string? Value { get; set; }
        public string? Text { get; set; }
    }

