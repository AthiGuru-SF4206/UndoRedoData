@using Syncfusion.Blazor.Data
@using System.Globalization;
@using Microsoft.AspNetCore.Components.Web;
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Inputs
@using System.Dynamic

@namespace Syncfusion.Blazor.Grids.Internal
@typeparam TContent

@{
    if (Parent!.FilterSettings?.Columns != null && Parent.FilterSettings.Columns.Count != 0)
    {
        var CurrentFilterColumns = Parent.FilterSettings.Columns.Where(e => e.Uid == Column?.Uid);
        Fcount = CurrentFilterColumns.Count();
        isFiltered = Fcount != 0 ? true : false;
        @if (Fcount == 1 || Fcount == 2)
        {
            var count = 0;
            foreach (var Fcol in CurrentFilterColumns)
            {
                count++;
                if (count == 1)
                {
                    var firstFilterOperator = Fcol.Operator.ToString().ToLower(CultureInfo.InvariantCulture);
                    FirstFoperator = SelectedFoperator == "customfilter" || (SelectedFoperator == "between" && Fcount != 1) || SelectedFoperator == null ? firstFilterOperator : SelectedFoperator;
                    var firstFilterValue = (SelectedFoperator != null && firstFilterOperator != SelectedFoperator) ? null : Fcol.Value?.GetType().Name == "JsonElement" ? SfBaseUtils.ChangeType(Fcol.Value, Column?.ValueType) : Fcol.Value;
                    FirstValue = SelectedFoperator == "customfilter" || (SelectedFoperator == "between" && Fcount != 1) ? Fcol.Value! : firstFilterValue!;
                    Fpredicate = Fcol.Predicate!;
                    FmatchCase = Fcol.MatchCase;
                    if (Column?.FilterTemplate != null)
                        Filter<TContent>.UpdateFilterModel(ModelInstance1!, Fcol, FirstValue, Column.ValueType);
                }
                else
                {
                    var secondFilterOperator = Fcol.Operator.ToString().ToLower(CultureInfo.InvariantCulture);
                    SecondFoperator = SelectedFoperator == "customfilter" || (SelectedFoperator == "between") || SelectedFoperator == null ? secondFilterOperator : null;
                    SecondValue = SecondFoperator == null ? null! : (Fcol.Value?.GetType().Name == "JsonElement" ? SfBaseUtils.ChangeType(Fcol.Value, Column?.ValueType)! : Fcol.Value!);
                    if (Column?.FilterTemplate != null)
                        Filter<TContent>.UpdateFilterModel(ModelInstance2!, Fcol, SecondValue, Column.ValueType);
                }
            }
        }

    }

}
@if (IsSubMenuDialog && Parent.EnableAdaptiveUI)
{
    <SfDialog ID="@(($"{Column?.Field}_customfilter_submenu"))" AllowPrerender="true" MinHeight="100%" HtmlAttributes="@Border" CssClass="e-filter-popup e-resfilterdiv e-responsive-dialog e-bigger e-resfilter e-row-responsive-filter e-dlg-fullscreen e-excelfilter" Height="100%" @bind-Visible="IsSubMenuDialog" Target="@(($"#{Parent.ID}"))">
        <DialogEvents Created="RenderedSubmenu"></DialogEvents>
        <DialogTemplates>
            <Header>
                <SfButton IconCss="e-btn-icon e-icon-dlg-close e-icons" CssClass="e-dlg-closeicon-btn" @onclick="@CloseHandler" HtmlAttributes="@title"></SfButton>
                <div class="e-dlg-header">
                    <div class="e-res-custom-element">
                        <div class="e-dlg-custom-header" id="@(($"{Parent.ID}_excel_submenu_wrapper"))">@SelectedText</div>
                    </div>
                </div>
            </Header>
            <Content>
                <SfContextMenu @ref="SubMenuRef" Items="@SubMenuItems">
                    <MenuEvents TValue="MenuItem" Created="OnSubMenuCreated" ItemSelected="ItemSelected" OnClose="OnCloseMenu"></MenuEvents>
                </SfContextMenu>
            </Content>
        </DialogTemplates>
    </SfDialog>
}
@if (!isDialogClosed)
{
    @if (Parent.EnableAdaptiveUI)
    {
        <SfContextMenu @ref="contextMenu" TValue="MenuItem" CssClass="e-contextmenu-wrapper e-grid-filter-menu" ShowItemOnClick="true" EnableRtl="@Parent.EnableRtl">
            <MenuItems>
                @foreach (MenuItem item in BuildDefaultItems())
                {
                    <MenuItem IconCss="@item.IconCss" Text="@item.Text" Items="@item.Items" Separator="@item.Separator"></MenuItem>
                }
            </MenuItems>
            <MenuEvents TValue="MenuItem" Created="OnMenuCreated" ItemSelected="ItemSelected" OnClose="OnCloseMenu"></MenuEvents>
        </SfContextMenu>
    }
    else
    {
        <SfContextMenu @ref="contextMenu" CssClass="e-grid-filter-menu" EnableRtl="@Parent.EnableRtl" Items="BuildDefaultItems()">
            <MenuEvents TValue="MenuItem" Opened="OnSubMenuOpened" Created="OnMenuCreated" ItemSelected="ItemSelected" OnClose="OnCloseMenu"></MenuEvents>
        </SfContextMenu>
    }
}
@if (isSubMenuItemSelected && !Parent.EnableAdaptiveUI)
{
    <SfDialog @ref="CustomFilterDialog" ID="@(($"{Column?.Field}-xlflmenu"))" AllowPrerender="true" Width="430" HtmlAttributes="@gridClass" Target="body" Visible="true" IsModal="true" CloseOnEscape="true" ShowCloseIcon="true" EnableRtl="Parent.EnableRtl">
        <DialogEvents OnClose="Closed"></DialogEvents>
        <DialogTemplates>
            <Header>

                @Localizer!.GetText(GridLocaleKeys.CustomFilter)

            </Header>
            <Content>

                <div class="e-xlfl-maindiv" id="@(($"{Column!.Field}-xlflmenu"))">
                    <div class="e-xlfl-dlgfields">
                        @Localizer!.GetText(GridLocaleKeys.ShowRowsWhere)
                    </div>
                    <div class="e-xlfl-fieldset">@Column.HeaderText</div>
                    <table class="e-xlfl-table">
                        <colgroup>
                            <col>
                            <col>
                        </colgroup>
                        <tr class="e-xlfl-fields">
                            <td class="e-xlfl-optr">
                                <div class="e-xlfl-optrdiv">
                                    @switch (Column.Type)
                                    {
                                        case ColumnType.Date:
                                        case ColumnType.DateOnly:
                                        case ColumnType.TimeOnly:
                                        case ColumnType.DateTime:
                                        case ColumnType.Integer:
                                        case ColumnType.Double:
                                        case ColumnType.Long:
                                        case ColumnType.Decimal:

                                            var NumberIndex = firstDropdownChangedIndex != -1 ? firstDropdownChangedIndex : (!string.IsNullOrEmpty(FirstFoperator) && (FirstFoperator != "between")) ? NumberDropDown?.FindIndex(e => e.Value == FirstFoperator) : (SelectedFoperator == "between" ? NumberDropDown?.FindIndex(e => e.Value == "greaterthanorequal") : NumberDropDown?.FindIndex(e => e.Value == SelectedFoperator));
                                            if (NumberIndex < 0 && SelectedFoperator == "customfilter")
                                            {
                                                NumberIndex = 0;
                                            }
                                            <SfDropDownList aria-label="@(Localizer.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column.Field}-xlfl-frstoptr"))" @ref="FirstNumberOperatorDropDown" @key="@(($"{Column.Uid}-frstoptr"))" Index="@NumberIndex" TValue="string" TItem="Operator" DataSource=@NumberDropDown>
                                                <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                                <DropDownListEvents ValueChange="FirstNumberDropdownChangeHandler" TValue="string" TItem="Operator"></DropDownListEvents>
                                            </SfDropDownList>
                                            break;
                                        default:
                                            var StringIndex = firstDropdownChangedIndex != -1 ? firstDropdownChangedIndex : !string.IsNullOrEmpty(FirstFoperator) ? StringDropDown?.FindIndex(e => e.Value == FirstFoperator) : StringDropDown?.FindIndex(e => e.Value == SelectedFoperator);
                                            if (StringIndex < 0 && SelectedFoperator == "customfilter")
                                            {
                                                StringIndex = 0;
                                            }
                                            
                                            <SfDropDownList aria-label="@(Localizer.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column.Field}-xlfl-frstoptr"))" @key="@(($"{Column.Uid}-frstoptr"))" Index="@StringIndex" @ref="FirstStringOperatorDropDown" TValue="string" TItem="Operator" DataSource=@StringDropDown>
                                                <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                                <DropDownListEvents ValueChange="FirstDropdownChangeHandler" TValue="string" TItem="Operator"></DropDownListEvents>
                                            </SfDropDownList>
                                            break;

                                    }
                                </div>
                            </td>
                            <td class="e-xlfl-value">
                                <div class="e-xlfl-valuediv">
                                    @if (Column.FilterTemplate != null)
                                    {
                                        ModelInstance1!.GetType()?.GetProperty("Uid")?.SetValue(ModelInstance1, Column.Uid);
                                        string? filterOperator = GetFirstColumnFilterOperator();
                                        ModelInstance1.GetType()?.GetProperty("Operator")?.SetValue(ModelInstance1, Filter<TContent>.GetFilterOperator(filterOperator!));
                                        @Column.FilterTemplate(ModelInstance1)
                                        ;
                                    }
                                    else if (Column.ValueType != null)
                                    {
                                        var NumberIndex = firstDropdownChangedIndex != -1 ? firstDropdownChangedIndex : (!string.IsNullOrEmpty(FirstFoperator) && (FirstFoperator != "between")) ? NumberDropDown?.FindIndex(e => e.Value == FirstFoperator) : (SelectedFoperator == "between" ? NumberDropDown?.FindIndex(e => e.Value == "greaterthanorequal") : NumberDropDown?.FindIndex(e => e.Value == SelectedFoperator));
                                        FirstValue = FirstAutoComplete != null ? FirstAutoComplete.Value! : FirstValue?.GetType().Name == "JsonElement" ? SfBaseUtils.ChangeType(FirstValue, Column.ValueType)! : FirstValue!;
                                        _isInteger = (Parent.FilterModule != null && Parent.FilterModule.IntConvertedList.ContainsKey(Column.ValueType));
                                        _isLong = (Parent.FilterModule != null && Parent.FilterModule.LongConvertedList.ContainsKey(Column.ValueType));
                                        @if ((Column.Type == ColumnType.Integer || Column.Type == ColumnType.Double || Column.Type == ColumnType.Long || Column.Type == ColumnType.Decimal))
                                        {
                                            
                                            var ConvertedValue = Filter<TContent>.TryParseNullable(FirstValue?.ToString()!, Parent.FilterModule!.IntConvertedList.ContainsKey(Column.ValueType), Parent.FilterModule.LongConvertedList.ContainsKey(Column.ValueType));
                                            @if (_isInteger)
                                            {
                                                <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstNumericValueasInt" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column.Uid}"))" Value="@((int?)ConvertedValue)" TValue="int?" Step="@(step != null ? (int?)step : 1)" Min="minValue != null ? (int)minValue : int.MinValue" Max="maxValue != null ? (int)maxValue : int.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                            }
                                            else if (_isLong)
                                            {
                                                <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstNumericValueasLong" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui -{Column.Uid}"))" Value="@((long?)ConvertedValue)" TValue="long?" Step="@(step != null ? (long?)Convert.ToInt64(step) : 1)" Min="minValue != null ? (long?)Convert.ToInt64(minValue) : long.MinValue" Max="maxValue != null ? (long?)Convert.ToInt64(maxValue) : long.MaxValue" @attributes=numericTextBoxAttributes></SfNumericTextBox>
                                            }
                                            else
                                            {
                                                <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstNumericValueasDouble" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column.Uid}"))" Value="@((double?)ConvertedValue)" TValue="double?" Step="@(step != null ? (double?)Convert.ToDouble(step) : 1)" Min="minValue != null ? (double?)Convert.ToDouble(minValue) : double.MinValue" Max="maxValue != null ? (double?)Convert.ToDouble(maxValue) : double.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                            }
                                        }
                                        @if (Column.Type == ColumnType.Date)
                                        {
                                            @if (FirstValue != null && FirstValue is DateTimeOffset)
                                            {
                                                isDateTimeOffsetType = true;
                                                <SfDatePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstDatePickerOffsetType" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" ID="@(($"{Column.Field}-xlfl-frstvalue"))" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterDatePlaceHolder))" TValue="DateTimeOffset?" Value=(DateTimeOffset?)FirstValue @attributes=datePickerAttributes></SfDatePicker>
                                                //TODO Ensured Globalization
                                            }
                                            else
                                            {
                                                isDateTimeOffsetType = false;
                                                <SfDatePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstDatePicker" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" ID="@(($"{Column.Field}-xlfl-frstvalue"))" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterDatePlaceHolder))" TValue="DateTime?" Value=(DateTime?)FirstValue @attributes=datePickerAttributes></SfDatePicker>
                                                // TODO Ensured Globalization
                                            }
                                        }
                                        @if (Column.Type == ColumnType.DateOnly)
                                        {
                                            <SfDatePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstDateOnlyPicker" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" ID="@(($"{Column.Field}-xlfl-frstvalue"))" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterDatePlaceHolder))" TValue="DateOnly?" Value=(DateOnly?)FirstValue @attributes=datePickerAttributes></SfDatePicker>
                                        }
                                        @if (Column.Type == ColumnType.TimeOnly)
                                        {
                                            <SfTimePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstTimeOnlyPicker" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" ID="@(($"{Column.Field}-xlfl-frstvalue"))" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.ChooseTime))" TValue="TimeOnly?" Value=(TimeOnly?)FirstValue @attributes=timePickerAttributes></SfTimePicker>
                                        }
                                        @if (Column.Type == ColumnType.DateTime)
                                        {
                                            <SfDateTimePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" ID="@(($"{Column.Field}-xlfl-frstvalue"))" @ref="FirstDateTimePicker" Enabled="@GetNumberClass(NumberIndex, NumberDropDown!)" Format="@Column.Format" @key="Column.Uid" Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterDatePlaceHolder))" TValue="DateTime?" Value=(DateTime?)FirstValue @attributes=dateTimePickerAttributes></SfDateTimePicker>
                                        }

                                        @if (Column.Type == ColumnType.String)
                                        {
                                            DataManager filterDataManager = (Column.IsForeignColumn() ? Column.DataManager : Parent.DataManager) ?? new DataManager();
                                            IEnumerable<object>? Json = filterDataManager?.Json != null ? Column.IsForeignColumn() ? DataUtil.GetDistinct(filterDataManager.Json, Column.ForeignKeyValue ?? "") : (IEnumerable<object>)DataUtil.GetDistinct<TContent>(filterDataManager.Json.Cast<TContent>(), Column.Field) : null!;

                                            if (Column.IsForeignColumn() && Column.IsGridForeignColumn)
                                            {
                                                filterModel1 = new FilterAutoCompleteModel()
                                                {
                                                    DataManager = Column.DataManager,
                                                    Column = Column,
                                                    FilterValue = FirstValue?.ToString()!,
                                                    Json = Json,
                                                    Id = Column.Field + "-xlfl-firstvalue",
                                                    FilterOperator = Filter<TContent>.GetFilterType(FirstStringOperatorDropDown?.Value!),
                                                    PlaceHolder = Localizer.GetText(GridLocaleKeys.EnterValue)
                                                };
                                                @Column.GetAutoComplete()!(filterModel1)
                                                ;
                                            }
                                            else if (Column.Field.Contains('.') && Parent.IsRenderedFromTreeGrid)
                                            {
                                                var StringIndex = firstDropdownChangedIndex != -1 ? firstDropdownChangedIndex : !string.IsNullOrEmpty(FirstFoperator) ? StringDropDown?.FindIndex(e => e.Value == FirstFoperator) : StringDropDown?.FindIndex(e => e.Value == SelectedFoperator);
                                                <SfAutoComplete aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstAutoComplete" @key="@(($"{Column.Field}-xlfl-frstvalue"))" Enabled="@GetClass(StringIndex, StringDropDown!)" ID="@(($"{Column.Field}-xlfl-frstvalue"))" Query="@Parent.Query" Autofill=enableAutoFill Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterPlaceHolder))" TItem="TContent" TValue="string" Value=@(FirstValue?.ToString()) @attributes=autoCompleteAttributes>
                                                    <SfDataManager Headers=@filterDataManager?.Headers GraphQLAdaptorOptions="@filterDataManager!.GraphQLAdaptorOptions" HttpClientInstance="@filterDataManager.HttpClientInstance" Url=@filterDataManager.Url Json="@Json" AdaptorInstance="@filterDataManager.AdaptorInstance" Adaptor="@filterDataManager.Adaptor" Offline="@filterDataManager.Offline">
                                                        @filterDataManager.ChildContent
                                                    </SfDataManager>
                                                    <AutoCompleteFieldSettings Value="@(Column.IsForeignColumn() ? Column.ForeignKeyValue : Column.Field)"></AutoCompleteFieldSettings>
                                                    <AutoCompleteEvents TItem="TContent" TValue="string" CustomValueSpecifier="CustomValueHandler" Created="@CreatedHandler" Filtering="FirstCustomFilterQuery"></AutoCompleteEvents>
                                                </SfAutoComplete>
                                            }
                                            else
                                            {
                                                var StringIndex = firstDropdownChangedIndex != -1 ? firstDropdownChangedIndex : !string.IsNullOrEmpty(FirstFoperator) ? StringDropDown?.FindIndex(e => e.Value == FirstFoperator) : StringDropDown?.FindIndex(e => e.Value == SelectedFoperator);
                                                <SfAutoComplete aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="FirstAutoComplete" @key="@(($"{Column.Field}-xlfl-frstvalue"))" Enabled="@GetClass(StringIndex, StringDropDown!)" ID="@(($"{Column.Field}-xlfl-frstvalue"))" Query="@Parent.Query" Autofill=enableAutoFill Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterPlaceHolder))" TItem="TContent" TValue="string" Value=@(FirstValue?.ToString()) @attributes=autoCompleteAttributes>
                                                    <SfDataManager Headers=@filterDataManager?.Headers GraphQLAdaptorOptions="@filterDataManager!.GraphQLAdaptorOptions" HttpClientInstance="@filterDataManager.HttpClientInstance" Url=@filterDataManager.Url Json="@Json" AdaptorInstance="@filterDataManager.AdaptorInstance" Adaptor="@filterDataManager.Adaptor" Offline="@filterDataManager.Offline">
                                                        @filterDataManager.ChildContent
                                                    </SfDataManager>
                                                    <AutoCompleteFieldSettings Value="@(Column.IsForeignColumn() ? Column.ForeignKeyValue : Column.Field)"></AutoCompleteFieldSettings>
                                                    <AutoCompleteEvents TItem="TContent" TValue="string" Filtering="FirstCustomFilterQuery"></AutoCompleteEvents>
                                                </SfAutoComplete>
                                            }
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr class="e-xlfl-predicate">
                            <td class="e-xlfl-radio" colspan="2">
                                <div class="e-xlfl-radiodiv">
                                    @{
                                        AndRadioButton = AndRadioButton == null ? ((Fpredicate == null || Fpredicate == "and") ? "and" : "or") : AndRadioButton;

                                        <SfRadioButton Label="@(Localizer.GetText(GridLocaleKeys.AND))" @onclick="@(e => RadioButtonClickHandler("and"))" Name="options" Checked="@AndRadioButton" Value="and"></SfRadioButton>
                                        <SfRadioButton Label="@(Localizer.GetText(GridLocaleKeys.OR))" @onclick="@(e => RadioButtonClickHandler("or"))" Name="options" Checked="@AndRadioButton" Value="or"></SfRadioButton>
                                    }

                                </div>
                                @if (Column.Type == ColumnType.String)
                                {
                                    <div class="e-xlfl-matchcasediv">
                                        <SfCheckBox @ref="MatchCaseCheckBox" Checked=@FmatchCase ID="@(($"{Column.Field}-xlfl-predicate"))" Label="@Localizer.GetText(GridLocaleKeys.MatchCase)"></SfCheckBox>
                                    </div>
                                }
                            </td>
                        </tr>
                        <tr class="e-xlfl-fields">
                            <td class="e-xlfl-optr">
                                <div class="e-xlfl-optrdiv">
                                    @switch (Column.Type)
                                    {
                                        case ColumnType.Date:
                                        case ColumnType.DateOnly:
                                        case ColumnType.TimeOnly:
                                        case ColumnType.DateTime:
                                        case ColumnType.Integer:
                                        case ColumnType.Double:
                                        case ColumnType.Long:
                                        case ColumnType.Decimal:
                                            var SecondNumIndex = secondDropdownChangedIndex != -1 ? secondDropdownChangedIndex : !string.IsNullOrEmpty(SecondFoperator) ? (int?)NumberDropDown?.FindIndex(e => e.Value == SecondFoperator) : (SelectedFoperator == "between" ? (int?)NumberDropDown?.FindIndex(e => e.Value == "lessthanorequal") : null);
                                            if (Column.FilterTemplate != null && SecondNumIndex == null && !string.IsNullOrEmpty(SecondNumberOperatorDropDown?.Value))
                                            {
                                                SecondNumIndex = (int?)NumberDropDown?.FindIndex(e => e.Value == SecondNumberOperatorDropDown.Value);
                                            }
                                            <SfDropDownList aria-label="@(Localizer.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column.Field}-xlfl-secndoptr"))" @ref="SecondNumberOperatorDropDown" @key="@(($"{Column.Uid}-secndoptr"))" Index="@SecondNumIndex" TValue="string" TItem="Operator" DataSource=@NumberDropDown>
                                                <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                                <DropDownListEvents ValueChange="SecondNumberDropdownChangeHandler" TValue="string" TItem="Operator"></DropDownListEvents>
                                            </SfDropDownList>
                                            break;
                                        default:
                                            var SecondStringIndex = secondDropdownChangedIndex != -1 ? secondDropdownChangedIndex : !string.IsNullOrEmpty(SecondFoperator) ? (int?)StringDropDown?.FindIndex(e => e.Value == SecondFoperator) : null;
                                            <SfDropDownList aria-label="@(Localizer.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column.Field}-xlfl-secndoptr"))" @key="@(($"{Column.Uid}-secndoptr"))" Index="@SecondStringIndex" @ref="SecondStringOperatorDropDown" TValue="string" TItem="Operator" DataSource=@StringDropDown>
                                                <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                                <DropDownListEvents ValueChange="SecondDropdownChangeHandler" TValue="string" TItem="Operator"></DropDownListEvents>
                                            </SfDropDownList>
                                            break;

                                    }
                                </div>
                            </td>
                            <td class="e-xlfl-value">
                                <div class="e-xlfl-valuediv">
                                    @if (Column.FilterTemplate != null)
                                    {
                                        ModelInstance2!.GetType()?.GetProperty("Uid")?.SetValue(ModelInstance2, Column.Uid);
                                        string? filterOperator = GetSecondColumnFilterOperator();
                                        ModelInstance2.GetType()?.GetProperty("Operator")?.SetValue(ModelInstance2, Filter<TContent>.GetFilterOperator(filterOperator!));
                                        @Column.FilterTemplate(ModelInstance2)
                                    }
                                    else if (Column.ValueType != null)
                                    {
                                        var SecondNumIndex = secondDropdownChangedIndex != -1 ? secondDropdownChangedIndex : !string.IsNullOrEmpty(SecondFoperator) ? (int?)NumberDropDown?.FindIndex(e => e.Value == SecondFoperator) : (SelectedFoperator == "between" ? (int?)NumberDropDown?.FindIndex(e => e.Value == "lessthanorequal") : null);
                                        SecondValue = SecondAutoComplete != null ? SecondAutoComplete.Value! : SecondValue?.GetType().Name == "JsonElement" ? SfBaseUtils.ChangeType(FirstValue, Column.ValueType)! : SecondValue!;

                                        @if (Column.Type == ColumnType.Integer || Column.Type == ColumnType.Double || Column.Type == ColumnType.Long || Column.Type == ColumnType.Decimal)
                                        {
                                            
                                            var ConvertedValue = Filter<TContent>.TryParseNullable(SecondValue?.ToString()!, (Parent.FilterModule != null && Parent.FilterModule.IntConvertedList.ContainsKey(Column.ValueType)), Parent.FilterModule!.LongConvertedList.ContainsKey(Column.ValueType));
                                            @if (_isInteger)
                                            {
                                                <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="SecondNumericValueasInt" Enabled="@GetNumberClass(SecondNumIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column.Uid}"))" Value="@((int?)ConvertedValue)" TValue="int?" Step="@(step != null ? (int?)step : 1)" Min="minValue != null ? (int)minValue : int.MinValue" Max="maxValue != null ? (int)maxValue : int.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                            }
                                            else if (_isLong)
                                            {
                                                <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="SecondNumericValueasLong" Enabled="@GetNumberClass(SecondNumIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column.Uid}"))" Value="@((long?)ConvertedValue)" TValue="long?" Step="@(step != null ? (long?)Convert.ToInt64(step) : 1)" Min="minValue != null ? (long?)Convert.ToInt64(minValue) : long.MinValue" Max="maxValue != null ? (long?)Convert.ToInt64(maxValue) : long.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                            }
                                            else
                                            {
                                                <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="SecondNumericValueasDouble" Enabled="@GetNumberClass(SecondNumIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column.Uid}"))" Value="@((double?)ConvertedValue)" TValue="double?" Step="@(step != null ? (double?)Convert.ToDouble(step) : 1)" Min="minValue != null ? (double?)Convert.ToDouble(minValue) : double.MinValue" Max="maxValue != null ? (double?)Convert.ToDouble(maxValue) : double.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                            }
                                        }

                                        @if (Column.Type == ColumnType.Date)
                                        {
                                            if (SecondValue != null && SecondValue is DateTimeOffset)
                                            {
                                                isDateTimeOffsetType = true;
                                                <SfDatePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="SecondDatePickerOffsetType" ID="@(($"{Column.Field}-xlfl-secondvalue"))" Enabled="@GetNumberClass(SecondNumIndex, NumberDropDown!)" Format="@Column.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.CustomFilterDatePlaceHolder))" TValue="DateTimeOffset?" Value=(DateTimeOffset?)SecondValue @attributes=datePickerAttributes></SfDatePicker>
                                                //TODO Ensured Globalization
                                            }
                                            else
                                            {
