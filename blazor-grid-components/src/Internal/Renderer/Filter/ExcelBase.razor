    /// <summary>
    /// Handles the clear button click event in the custom filter dialog.
    /// Resets dialog state and triggers filter component update.
    /// </summary>
    /// <remarks>
    /// This method:
    /// 1. Marks the dialog as closed
    /// 2. Resets filter module state (IsSubMenuClick, FilterIconIsClicked)
    /// 3. Sets ExcelDialog flag to false
    /// 4. Triggers FilterComponentUpdate event for UI refresh
    ///
    /// Used when user clicks "Clear" button to reset custom filter conditions without applying.
    /// </remarks>
    internal async void ClearBtnClick()
    {
        isDialogClosed = true;
        if (Parent?.FilterModule != null)
        {
            Parent.FilterModule.IsSubMenuClick = false;
            Parent.FilterModule.FilterIconIsClicked = false;
            Parent.EventAggregator.Trigger("FilterComponentUpdate", null!);
            Parent.FilterModule.ExcelDialog = false;
        }
    }

    /// <summary>
    /// Handles the dialog close event before the dialog is actually closed.
    /// Disposes of dropdown components and resets filter module state.
    /// </summary>
    /// <param name="args">The dialog close event arguments, used to control close behavior.</param>
    /// <remarks>
    /// This method:
    /// 1. Cancels the close operation if dialog was not previously closed (prevents immediate closure)
    /// 2. Disposes all dropdown list components (string, number, and boolean)
    /// 3. Resets filter module state flags
    /// 4. Triggers UI update event
    ///
    /// Ensures proper resource cleanup before dialog closure.
    /// </remarks>
    internal async void Closed(BeforeCloseEventArgs args)
    {
        if (!isDialogClosed && Parent?.FilterModule != null)
        {
            args.Cancel = true;
            isDialogClosed = true;
            Parent.FilterModule!.FilterIconIsClicked = false;
            FirstStringOperatorDropDown?.Dispose();
            SecondStringOperatorDropDown?.Dispose();
            FirstNumberOperatorDropDown?.Dispose();
            SecondNumberOperatorDropDown?.Dispose();
            FirstBoolDropDown?.Dispose();
            SecondBoolDropDown?.Dispose();
            Parent.EventAggregator.Trigger("FilterComponentUpdate", null!);
            Parent.FilterModule.ExcelDialog = false;
        }
    }

    /// <summary>
    /// Retrieves the first filter operator from the appropriate dropdown based on column type.
    /// </summary>
    /// <returns>The operator string (e.g., "equal", "startswith") or null if not set.</returns>
    /// <remarks>
    /// Handles type-specific operator retrieval:
    /// - Numeric/Date/Time types: Uses FirstNumberOperatorDropDown
    /// - String/Other types: Uses FirstStringOperatorDropDown
    ///
    /// The operator value is used to determine the filter comparison method.
    /// </remarks>
    internal string? GetFirstColumnFilterOperator()
    {

        switch (Column?.Type)
        {
            case ColumnType.Integer:
            case ColumnType.Double:
            case ColumnType.Long:
            case ColumnType.Decimal:
            case ColumnType.Date:
            case ColumnType.DateOnly:
            case ColumnType.TimeOnly:
            case ColumnType.DateTime:
                return FirstNumberOperatorDropDown?.Value?.ToString();
            default:
                return FirstStringOperatorDropDown?.Value?.ToString();
        }
    }

    /// <summary>
    /// Retrieves the first filter condition value from the appropriate editor component based on column type.
    /// </summary>
    /// <returns>The filter value for the first condition, or null if not set.</returns>
    /// <remarks>
    /// Handles type-specific value retrieval:
    /// - Numeric types: Returns value from appropriate NumericTextBox (Int, Long, or Double)
    /// - Date/Time types: Returns value from DatePicker, DateTimePicker, or TimePicker (with offset support)
    /// - String/Other types: Returns value from AutoComplete, considering foreign key filtering
    /// </remarks>
    internal object? GetFirstColumnFilterValue()
    {
        switch (Column?.Type)
        {
            case ColumnType.Integer:
            case ColumnType.Double:
            case ColumnType.Long:
            case ColumnType.Decimal:
                return _isInteger ? FirstNumericValueasInt?.Value : _isLong ? FirstNumericValueasLong?.Value : FirstNumericValueasDouble?.Value;
            case ColumnType.Date:
                if (isDateTimeOffsetType)
                {
                    return FirstDatePickerOffsetType?.Value;
                }
                else
                {
                    return FirstDatePicker?.Value;
                }
            case ColumnType.DateOnly:
                return FirstDateOnlyPicker?.Value;
            case ColumnType.TimeOnly:
                return FirstTimeOnlyPicker?.Value;
            case ColumnType.DateTime:
                return FirstDateTimePicker?.Value;
            default:
                return Column?.IsForeignColumn() == true && filterModel1 != null ? filterModel1.FilterValue ?? FirstAutoComplete?.Value : FirstAutoComplete?.Value;
        }
    }

