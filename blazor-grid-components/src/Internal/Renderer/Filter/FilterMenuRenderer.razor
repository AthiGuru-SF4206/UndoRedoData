                                </SfDropDownList>
                                break;
                            case ColumnType.Boolean:
                                _booleanIndex = (!string.IsNullOrEmpty(Foperator) && _booleanIndex == null) ? Filter<TContent>.GetOperatorIndex(BooleanDropDown!, Foperator) : (_booleanIndex != null ? _booleanIndex : 0);
                                    <SfDropDownList aria-label="@(Localizer!.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column?.Uid}-floptr"))" @key="Column?.Uid" @ref="BoolOperatorDropDown" @bind-Index="@_booleanIndex" TValue="string" TItem="object" DataSource=@BooleanDropDown EnableRtl="@Parent.EnableRtl">
                                    <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                </SfDropDownList>
                                break;
                            default:
                                _stringIndex = (!string.IsNullOrEmpty(Foperator) && _stringIndex == null) ? Filter<TContent>
                                    .GetOperatorIndex(StringDropDown!, Foperator) : (_stringIndex != null ? _stringIndex : 0);
                                    <SfDropDownList aria-label="@(Localizer!.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column?.Uid}-floptr"))" @key="Column?.Uid" @ref="StringOperatorDropDown" @bind-Index="@_stringIndex" TValue="string" TItem="object" DataSource=@StringDropDown  EnableRtl="@Parent.EnableRtl">
                                    <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                </SfDropDownList>
                                break;
                        }
                    </div>
                    <div class="e-flmenu-valuediv">
                            @if (Parent.FilterModule != null && !Parent.FilterModule.ShouldTemplateDispose)
                            {
                                @if (Column?.FilterTemplate != null && ModelInstance != null)
                                {
                                    if (GFilterColumn != null)
                                    {
                                        Filter<TContent>.UpdateFilterModel(ModelInstance, GFilterColumn, Fvalue, Column?.ValueType, Parent.EnablePersistence);
                                    }
                                    else
                                        ModelInstance?.GetType()?.GetProperty("Uid")?.SetValue(ModelInstance, Column?.Uid);
                                        string? filterOperator = GetColumnFilterOperator();
                                    ModelInstance?.GetType()?.GetProperty("Operator")?.SetValue(ModelInstance, Filter<TContent>.GetFilterOperator(filterOperator!));
                                    @Column?.FilterTemplate(ModelInstance!)
                                    ;
                                }
                                else if (Column?.ValueType != null && !Parent.FilterModule.ShouldTemplateDispose)
