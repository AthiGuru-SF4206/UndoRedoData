                                        <SfAutoComplete aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="AutoComplete" @key="Column?.Uid" Enabled="@GetClass(_stringIndex, StringDropDown!)" ID="@(($"strui-{Column?.Uid}"))" Query="@Parent.Query" Autofill=enableAutoFill  Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" TItem="TContent" TValue="string" Value=@((string)Fvalue!)  @attributes=autoCompleteAttributes>
                                            <SfDataManager Headers=@filterDataManager?.Headers Url=@filterDataManager?.Url Json="@Json" HttpClientInstance="@filterDataManager?.HttpClientInstance" AdaptorInstance="@filterDataManager?.AdaptorInstance" Adaptor="@filterDataManager!.Adaptor" Offline="@filterDataManager.Offline">
                                                @filterDataManager?.ChildContent
                                            </SfDataManager>
                                            <AutoCompleteFieldSettings Value="@((Column?.IsForeignColumn() == true) ? Column?.ForeignKeyValue : Column?.Field)"></AutoCompleteFieldSettings>
                                            <AutoCompleteEvents TItem="TContent" TValue="string" OnActionBegin="@BeginHandler" Filtering="@CustomFilterQuery"></AutoCompleteEvents>
                                        </SfAutoComplete>
                                    }
                                }
                            }

                        </div>
                    </div>
                </div>
            </Content>
        </DialogTemplates>
    </SfDialog>
}
</div>
