                                    Fvalue = IsNullOrEmptyOperator(GetColumnFilterOperator()!) ? null! : (Fvalue?.GetType().Name == "JsonElement" ? SfBaseUtils.ChangeType(Fvalue, Column?.ValueType) : Fvalue)!;
                                    _isInteger = Parent.FilterModule.IntConvertedList.ContainsKey(Column?.ValueType!);
                                    _isLong = Parent.FilterModule.LongConvertedList.ContainsKey(Column?.ValueType!);
                                    @if (Column?.Type == ColumnType.Integer || Column?.Type == ColumnType.Double || Column?.Type == ColumnType.Long || Column?.Type == ColumnType.Decimal)
                                    {                                        
                                        var ConvertedValue = Filter<TContent>.TryParseNullable(Fvalue?.ToString()!, Parent.FilterModule.IntConvertedList.ContainsKey(Column.ValueType), Parent.FilterModule.LongConvertedList.ContainsKey(Column.ValueType));
                                        @if (_isInteger)
                                        {
                                            <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="NumericValueasInt" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column?.Uid}"))" Value="@((int?)ConvertedValue)" TValue="int?" Step="@(step != null ? (int?)step : 1)" Min="minValue != null ? (int)minValue : int.MinValue" Max="maxValue != null ? (int)maxValue : int.MaxValue" @attributes=numericTextBoxAttributes></SfNumericTextBox>
                                        }
                                        else if(_isLong)
                                        {
                                            <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref = "NumericValueasLong" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui -{ Column?.Uid}"))" Value="@((long?)ConvertedValue)" TValue="long?" Step="@(step != null ? (long?)Convert.ToInt64(step) : 1)" Min="minValue != null ? (long?)Convert.ToInt64(minValue) : long.MinValue" Max="maxValue != null ? (long?)Convert.ToInt64(maxValue) : long.MaxValue"  @attributes=numericTextBoxAttributes></SfNumericTextBox>
                                        }
                                        else
                                        {
                                            <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="NumericValueasDouble" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column?.Uid}"))" Value="@((double?)ConvertedValue)" TValue="double?" Step="@(step != null ? (double?)Convert.ToDouble(step) : 1)" Min="minValue != null ? (double?)Convert.ToDouble(minValue) : double.MinValue" Max="maxValue != null ? (double?)Convert.ToDouble(maxValue) : double.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                        }
                                    }
