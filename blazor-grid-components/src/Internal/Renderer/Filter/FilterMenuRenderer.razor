                                            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    }
                                    @if (Column?.Type == ColumnType.Date)
                                    {
                                        <SfDatePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="DatePicker" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.ChooseDate))" TValue="DateTime?" Value=(DateTime?)Fvalue @attributes=datePickerAttributes></SfDatePicker>
