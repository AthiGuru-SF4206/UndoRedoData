    <SfDialog @ref="@MenuAdaptiveDialog" ID="@(($"{Parent.ID}custommenufilter"))" HtmlAttributes="@MaxHeight" AllowPrerender="true" Height="100%" MinHeight="350px" Width="100%" Target="@(($"#{Parent.ID}"))" CssClass="e-resfilterdiv e-responsive-dialog e-bigger e-resfilter e-row-responsive-filter e-dlg-fullscreen">
        <DialogEvents Created="AdaptiveRendered"></DialogEvents>
        <DialogTemplates>
            <Header>
                <SfButton IconCss="e-btn-icon e-icon-dlg-close e-icons" CssClass="e-dlg-closeicon-btn" @onclick="@CloseHandler" HtmlAttributes="@title"></SfButton>
                <div class="e-dlg-header">
                    <div class="e-res-custom-element">
                        <div class="e-dlg-custom-header" id="@(($"{Parent.ID}_filter_dialog_wrapper"))">@Column?.HeaderText!</div>
                        <SfButton IconCss="e-btn-icon e-icon-filter-clear e-icons" CssClass="e-primary e-flat e-res-filter-clear-btn" @onclick="@ClearBtnClick"></SfButton>
