                                    string filterOperator = GetColumnFilterOperator()!;
                                    ModelInstance?.GetType()?.GetProperty("Operator")?.SetValue(ModelInstance, Filter<TContent>.GetFilterOperator(filterOperator));
                                    @Column?.FilterTemplate(ModelInstance!);
                            }
                            else
                            {
                                Fvalue = Fvalue?.GetType().Name == "JsonElement" ? SfBaseUtils.ChangeType(Fvalue, Column?.ValueType) : Fvalue!;
                                _isInteger = Parent.FilterModule!.IntConvertedList.ContainsKey(Column!.ValueType!);
                                _isLong = Parent.FilterModule.LongConvertedList.ContainsKey(Column.ValueType!);
                                @if (Column?.Type == ColumnType.Integer || Column?.Type == ColumnType.Double || Column?.Type == ColumnType.Long || Column?.Type == ColumnType.Decimal)
                                {
                                    var ConvertedValue = Filter<TContent>.TryParseNullable(Fvalue?.ToString()!, Parent.FilterModule.IntConvertedList.ContainsKey(Column?.ValueType!), Parent.FilterModule.LongConvertedList.ContainsKey(Column?.ValueType!));
                                    @if (_isInteger)
                                    {
                                        <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="NumericValueasInt" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column?.Uid}"))" Value="@((int?)ConvertedValue)" TValue="int?" Step="@(step != null ? (int?)step : 1)" Min="minValue != null ? (int)minValue : int.MinValue" Max="maxValue != null ? (int)maxValue : int.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                    }
                                    else if (_isLong)
