                                                Json = Json!,
                                                Id = "strui" + Column?.Uid,
                                                FilterValue = Fvalue?.ToString()!,
                                                FilterOperator = Filter<TContent>.GetFilterType(StringOperatorDropDown?.Value!),
                                                PlaceHolder = Localizer.GetText(GridLocaleKeys.EnterValue)
                                            };
                                            @Column?.GetAutoComplete()!(model)
                                            ;
                                        }
                                        else if ((Column?.Field?.Contains('.') == true))
                                        {
                                            <SfAutoComplete aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="AutoComplete" @key="Column?.Uid" Enabled="@GetClass(_stringIndex, StringDropDown!)" ID="@(($"strui-{Column?.Uid}"))" Query="@Parent.Query" Autofill=enableAutoFill  Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" TItem="TContent" TValue="string" Value=@((string)Fvalue?.ToString()!) @attributes=autoCompleteAttributes>
                                                <SfDataManager Headers=@filterDataManager?.Headers GraphQLAdaptorOptions=@filterDataManager?.GraphQLAdaptorOptions HttpClientInstance="@filterDataManager?.HttpClientInstance" Url=@filterDataManager?.Url Json="@Json" AdaptorInstance="@filterDataManager?.AdaptorInstance" Adaptor="@filterDataManager!.Adaptor" Offline="@filterDataManager.Offline">
                                                    @filterDataManager?.ChildContent
                                                </SfDataManager>
                                                <AutoCompleteFieldSettings Value="@((Column?.IsForeignColumn() == true) ? Column?.ForeignKeyValue : Column?.Field)"></AutoCompleteFieldSettings>
                                                <AutoCompleteEvents TItem="TContent" TValue="string" OnActionBegin="@BeginHandler" CustomValueSpecifier="CustomValueHandler" Created="@CreatedHandler" Filtering="CustomFilterQuery" DataBound="AutoCompleteDataBound"></AutoCompleteEvents>
                                            </SfAutoComplete>
                                        }
                                        else
                                        {
                                            <SfAutoComplete aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="AutoComplete" @key="Column?.Uid" Enabled="@GetClass(_stringIndex, StringDropDown!)" ID="@(($"strui-{Column?.Uid}"))" Query="@Parent.Query" Autofill=enableAutoFill Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" TItem="TContent" TValue="string" Value=@((string)Fvalue?.ToString()!) @attributes=autoCompleteAttributes>
                                                <SfDataManager Headers=@filterDataManager?.Headers GraphQLAdaptorOptions=@filterDataManager?.GraphQLAdaptorOptions HttpClientInstance="@filterDataManager?.HttpClientInstance" Url=@filterDataManager?.Url Json="@Json" AdaptorInstance="@filterDataManager?.AdaptorInstance" Adaptor="@filterDataManager!.Adaptor" Offline="@filterDataManager.Offline">
                                                    @filterDataManager?.ChildContent
                                                </SfDataManager>
                                                <AutoCompleteFieldSettings Value="@((Column?.IsForeignColumn() == true) ? Column?.ForeignKeyValue : Column?.Field)"></AutoCompleteFieldSettings>
                                                <AutoCompleteEvents TItem="TContent" TValue="string" OnActionBegin="@BeginHandler" Created="@CreatedHandler" Filtering="@CustomFilterQuery"></AutoCompleteEvents>
                                            </SfAutoComplete>
                                        }
                                    }
                                }
                            }
                    </div>
                </div>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton OnClick="@FilterBtnClick" Content=@(Localizer!.GetText(GridLocaleKeys.FilterButton)) IsPrimary="true" CssClass="e-flmenu-okbtn e-primary e-flat">
            </DialogButton>
            <DialogButton OnClick="@ClearBtnClick" Content=@(Localizer.GetText(GridLocaleKeys.ClearButton)) CssClass="e-flmenu-cancelbtn e-flat">
