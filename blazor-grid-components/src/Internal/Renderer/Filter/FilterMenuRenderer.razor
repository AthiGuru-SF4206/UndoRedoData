                                    }
                                    else
                                    {
                                        <SfNumericTextBox aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="NumericValueasDouble" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.EnterValue))" ID="@(($"numberui-{Column?.Uid}"))" Value="@((double?)ConvertedValue)" TValue="double?" Step="@(step != null ? (double?)Convert.ToDouble(step) : 1)" Min="minValue != null ? (double?)Convert.ToDouble(minValue) : double.MinValue" Max="maxValue != null ? (double?)Convert.ToDouble(maxValue) : double.MaxValue" @attributes=numericTextBoxAttributes> </SfNumericTextBox>
                                    } 
