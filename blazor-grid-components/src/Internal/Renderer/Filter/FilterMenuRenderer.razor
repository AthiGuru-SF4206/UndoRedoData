                                    <SfDropDownList aria-label="@(Localizer!.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column?.Uid}-floptr"))" @ref="NumberOperatorDropDown" @key="Column?.Uid" @bind-Index="@_numberIndex" TValue="string" TItem="object" DataSource=@NumberDropDown>
                                        <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                    break;
                                case ColumnType.Boolean:
                                    _booleanIndex = (!string.IsNullOrEmpty(Foperator) && _booleanIndex == null) ? Filter<TContent>.GetOperatorIndex(BooleanDropDown!, Foperator) : (_booleanIndex != null ? _booleanIndex : 0);
                                    <SfDropDownList aria-label="@(Localizer!.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column?.Uid}-floptr"))" @key="Column?.Uid" @ref="BoolOperatorDropDown" @bind-Index="@_booleanIndex" TValue="string" TItem="object" DataSource=@BooleanDropDown>
                                        <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                    break;
                                default:
                                    _stringIndex = (!string.IsNullOrEmpty(Foperator) && _stringIndex == null) ? Filter<TContent>.GetOperatorIndex(StringDropDown!, Foperator) : (_stringIndex != null ? _stringIndex : 0);

                                    <SfDropDownList aria-label="@(Localizer!.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column?.Uid}-floptr"))" @key="Column?.Uid" @ref="StringOperatorDropDown" @bind-Index="@_stringIndex" TValue="string" TItem="object" DataSource=@StringDropDown>
                                        <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                                    </SfDropDownList>
                                    break;
                            }
