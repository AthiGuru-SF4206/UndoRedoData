                                    }
                                    @if (Column?.Type == ColumnType.DateOnly)
                                    {
                                        <SfDatePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="DateOnlyPicker" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.ChooseDate))" TValue="DateOnly?" Value=(DateOnly?)Fvalue @attributes=datePickerAttributes></SfDatePicker>
                                        //TODO Ensured Globalization
                                    }
                                    @if (Column?.Type == ColumnType.TimeOnly)
                                    {
                                        <SfTimePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="TimeOnlyPicker" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" Placeholder="@(Localizer.GetText(GridLocaleKeys.ChooseTime))" TValue="TimeOnly?" Value=(TimeOnly?)Fvalue @attributes=timePickerAttributes></SfTimePicker>
                                    }
                                    @if (Column?.Type == ColumnType.DateTime)
                                    {
                                        <SfDateTimePicker aria-label="@(Localizer.GetText(GridLocaleKeys.FilterValue))" @ref="DateTimePicker" Enabled="@GetNumberClass(_numberIndex, NumberDropDown!)" Format="@Column?.Format" @key="Column?.Uid" Placeholder="@(Localizer.GetText(GridLocaleKeys.ChooseDate))" TValue="DateTime?" Value=(DateTime?)Fvalue @attributes=dateTimePickerAttributes></SfDateTimePicker>
