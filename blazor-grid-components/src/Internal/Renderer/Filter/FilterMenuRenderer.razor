@using Microsoft.AspNetCore.Components.Web;
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Internal;
@using System.Text.RegularExpressions
@using Syncfusion.Blazor.DropDowns
@using System.Globalization;
@using Syncfusion.Blazor.Grids;
@using System.Dynamic;

@typeparam TContent


@namespace Syncfusion.Blazor.Grids.Internal
<div id="RefDialog" class="e-dlg-grid-element e-hide">
@if (!Parent!.EnableAdaptiveUI || (Parent.EnableAdaptiveUI && !Parent.SyncfusionService.IsDeviceMode && Parent.AdaptiveUIMode.Equals(AdaptiveMode.Mobile)) || (Parent.EnableAdaptiveUI && Parent.AdaptiveUIMode.Equals(AdaptiveMode.Desktop) && Parent.SyncfusionService.IsDeviceMode))
{
    var dialogAttributes = new Dictionary<string, object>() { { "relateTo", Column!.Uid } };
    <SfDialog @ref="MenuDialog" @key="Column.Uid" ID="@(($"{Column.Uid}-flmdlg"))" AllowPrerender="true" HtmlAttributes="dialogAttributes" Width="250" Target="@(($"#{Parent.ID}"))" Visible="false" CssClass="e-filter-popup" CloseOnEscape="true" ShowCloseIcon="false" EnableRtl="Parent.EnableRtl">
        <DialogPositionData X=@Xvalue Y="@Yvalue"></DialogPositionData>
        <DialogEvents Created="Rendered" Closed="Closed"></DialogEvents>
        <DialogAnimationSettings Effect="@Effects"></DialogAnimationSettings>
        <DialogTemplates>
            <Content>
                    @{
                        Foperator = Filter<TContent>.GetColumnOperator(this.Column)!;
                        object Fvalue = null!;
                    }
                    @if (Parent.FilterSettings != null && Parent.FilterSettings.Columns != null && Parent.FilterSettings.Columns.Count != 0)
                    {

                        GFilterColumn = Parent.FilterSettings.Columns.Where(e => e.Uid == Column?.Uid).FirstOrDefault();
                        @if (GFilterColumn != null)
                        {
                            bool isJsonElement = GFilterColumn.Value?.GetType().Name == "JsonElement";
                            Fvalue = isJsonElement ? SfBaseUtils.ChangeType(GFilterColumn.Value, Column?.ValueType)! : GFilterColumn.Value!;
                            Foperator = GFilterColumn.Operator.ToString().ToLower(CultureInfo.InvariantCulture);   
                        }
                    }
                    
                 <div class="e-flmenu-maindiv" id="@(($"{Column?.Uid}-flmenu"))">
                    <div class="e-flm_optrdiv">
                        @switch (Column?.Type)
                        {
                            case ColumnType.Date:
                            case ColumnType.DateOnly:
                            case ColumnType.TimeOnly:
                            case ColumnType.DateTime:
                            case ColumnType.Integer:
                            case ColumnType.Double:
                            case ColumnType.Long:
                            case ColumnType.Decimal:
                                _numberIndex = (!string.IsNullOrEmpty(Foperator) && _numberIndex == null) ? Filter<TContent>.GetOperatorIndex(NumberDropDown!, Foperator) : (_numberIndex != null ? _numberIndex : 0);
                                    <SfDropDownList aria-label="@(Localizer!.GetText(GridLocaleKeys.FilterOperator))" ID="@(($"{Column?.Uid}-floptr"))" @ref="NumberOperatorDropDown" @key="Column?.Uid" @bind-Index="@_numberIndex" TValue="string" TItem="object" DataSource=@NumberDropDown EnableRtl="@Parent.EnableRtl">
