                            @if (Column?.FilterTemplate != null && ModelInstance != null)
                            {
                                if (GFilterColumn != null)
                                {
                                    Filter<TContent>.UpdateFilterModel(ModelInstance, GFilterColumn,Fvalue,Column?.ValueType, Parent.EnablePersistence);
                                }
                                else
