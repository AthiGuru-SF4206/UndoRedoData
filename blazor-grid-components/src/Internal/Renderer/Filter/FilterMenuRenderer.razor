                    </div>
                </div>
            </Header>
            <Content>
                <div class="e-mainfilterdiv e-default-filter">
                    @{
                        Foperator = Filter<TContent>.GetColumnOperator(this.Column!)!;
                        object Fvalue = null!;
                    }
                    @if (Parent.FilterSettings != null && Parent.FilterSettings.Columns != null && Parent.FilterSettings.Columns.Count != 0)
                    {
                        GFilterColumn = Parent.FilterSettings.Columns.Where(e => e.Uid == Column?.Uid).FirstOrDefault();
                            @if (GFilterColumn != null)
                            {
                                bool isJsonElement = GFilterColumn.Value?.GetType().Name == "JsonElement";
                                Fvalue = isJsonElement ? SfBaseUtils.ChangeType(GFilterColumn.Value, Column?.ValueType) : GFilterColumn.Value!;
                                Foperator = GFilterColumn.Operator.ToString().ToLower(CultureInfo.InvariantCulture);
                            }
                        }

                    <div class="e-flmenu-maindiv" id="@(($"{Column?.Uid}-flmenu"))">
                        <div class="e-flm_optrdiv">


