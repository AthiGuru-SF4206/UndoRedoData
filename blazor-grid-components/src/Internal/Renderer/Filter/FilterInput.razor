@using Microsoft.AspNetCore.Components.Web;
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using System.Timers;
@using System.Text.RegularExpressions
@using System.Globalization
@using Syncfusion.Blazor.Internal;
@using Syncfusion.Blazor.Data;
@using Syncfusion.Blazor.Grids.Internal;

@namespace Syncfusion.Blazor.Grids.Internal
@typeparam TContent

<td class="@GetClass(FilterInputParameters!.Column!)" data-sf-style="@GetStyles(FilterInputParameters.Column!)" e-mappinguid="@FilterInputParameters.Column?.Uid" role="gridcell">
    <div class="@GetDivClass()">
        @if (FilterInputParameters.Column != null && FilterInputParameters.Column.FilterTemplate != null && FilterInputParameters.Column.Visible)
        {
            var FilterObject = new PredicateModel() { Field = FilterInputParameters.FieldName!, Value = FilterInputParameters.FilterValue!, ActualValue = FilterInputParameters.ActualValue!, Uid = FilterInputParameters.Column.Uid, Predicate = FilterInputParameters.Predicate!, IgnoreAccent = FilterInputParameters.IgnoreAccent, MatchCase = FilterInputParameters.MatchCase };
            @FilterInputParameters.Column.FilterTemplate(FilterObject);
        }
        else if (FilterInputParameters.CellType?.Equals("indent") != true && FilterInputParameters.CellType?.Equals("detailindent") != true && FilterInputParameters.CellType?.Equals("rowdrag") != true && !FilterInputParameters.IsCheckbox && FilterInputParameters.Column?.Visible == true)
        {
            @if (ShouldShowOperatorDropdown())
            {
  
                <div class="e-enhanced-filter-input">
                    @switch (FilterInputParameters.Column?.Type)
                    {
                        case ColumnType.String:
                            
                            <SfTextBox @ref="StringTextBoxComponent"
                                       type="InputType.Search"
                                       Width="100%"
                                       id="@($"{FilterInputParameters.Column?.Field}_value")"
                                       Value="@StringInputValue"
                                       placeholder="@GetPlaceholder()"
                                       @oninput="@((ChangeEventArgs e) => OnStringInputChanged(e))"
                                       @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                       Enabled="@(GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type))"
                                       aria-disabled="@(!GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type))"
                                       role="searchbox"
                                       aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                            </SfTextBox>
                            break;

                        case ColumnType.Integer:
                        case ColumnType.Double:
                        case ColumnType.Long:
                        case ColumnType.Decimal:
                            @if (Filter<TContent>.IsNumericInteger(FilterInputParameters.Column))
                            {
                                <SfNumericTextBox TValue="int?" @ref="NumericValueAsInt"
                                                  ShowSpinButton="@(!_isDeviceMode)"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_numeric_int")"
                                                  Value="@(FilterValue as int?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnNumericIntInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Placeholder="@GetPlaceholder()"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Step="1"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <NumericTextBoxEvents TValue="int?" ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<int?> e) => OnNumericValueChanged(e.Value))"></NumericTextBoxEvents>
                                </SfNumericTextBox>
                            }
                            else if (Filter<TContent>.IsNumericLong(FilterInputParameters.Column))
                            {
                                <SfNumericTextBox TValue="long?" @ref="NumericValueAsLong"
                                                  ShowSpinButton="@(!_isDeviceMode)"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_numeric_long")"
                                                  Value="@(FilterValue as long?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnNumericLongInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Placeholder="@GetPlaceholder()"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Step="1"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <NumericTextBoxEvents TValue="long?" ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<long?> e) => OnNumericValueChangedLong(e.Value))"></NumericTextBoxEvents>
                                </SfNumericTextBox>
                            }
                            else if (Filter<TContent>.IsNumericDecimal(FilterInputParameters.Column))
                            {
                                <SfNumericTextBox TValue="decimal?" @ref="NumericValueAsDecimal"
                                                  ShowSpinButton="@(!_isDeviceMode)"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_numeric_decimal")"
                                                  Value="@(FilterValue as decimal?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnNumericDecimalInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Placeholder="@GetPlaceholder()"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Step="@(0.01m)"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <NumericTextBoxEvents TValue="decimal?" ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<decimal?> e) => OnNumericValueChangedDecimal(e.Value))"></NumericTextBoxEvents>
                                </SfNumericTextBox>
                            }
                            else
                            {
                                <SfNumericTextBox TValue="double?" @ref="NumericValueAsDouble"
                                                  ShowSpinButton="@(!_isDeviceMode)"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_numeric_double")"
                                                  Value="@(FilterValue as double?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnNumericDoubleInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Placeholder="@GetPlaceholder()"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Step="0.01"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <NumericTextBoxEvents TValue="double?" ValueChange="@((Syncfusion.Blazor.Inputs.ChangeEventArgs<double?> e) => OnNumericValueChangedDouble(e.Value))"></NumericTextBoxEvents>
                                </SfNumericTextBox>
                            }
                            break;

                        case ColumnType.Date:
                        case ColumnType.DateOnly:
                            @if (Filter<TContent>.IsDateOnlyColumn(FilterInputParameters.Column))
                            {
                                <SfDatePicker TValue="DateTime?" @ref="DatePickerComponent"
                                              Width="100%"
                                              @key="@($"{FilterInputParameters.Column?.Uid}_date_{_invalidInputCalendarRefreshKey}")"
                                              Value="@(FilterValue as DateTime?)"
                                              Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                              @oninput="@((ChangeEventArgs e) => OnDateInput(e))"
                                              @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                              Format="@FilterInputParameters.Column?.Format"
                                              Placeholder="@GetPlaceholder()"
                                              ShowClearButton="false"
                                              ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                              aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <DatePickerEvents TValue="DateTime?" ValueChange="@OnDateValueChanged"></DatePickerEvents>
                                </SfDatePicker>
                            }
                            else
                            {
                                <SfDatePicker TValue="DateTime?" @ref="DatePickerComponent"
                                              Width="100%"
                                              @key="@($"{FilterInputParameters.Column?.Uid}_date_{_invalidInputCalendarRefreshKey}")"
                                              Value="@(FilterValue as DateTime?)"
                                              Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                              @oninput="@((ChangeEventArgs e) => OnDateInput(e))"
                                              @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                              Format="@FilterInputParameters.Column?.Format"
                                              Placeholder="@GetPlaceholder()"
                                              ShowClearButton="false"
                                              ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                              aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <DatePickerEvents TValue="DateTime?" ValueChange="@OnDateValueChanged"></DatePickerEvents>
                                </SfDatePicker>
                            }
                            break;

                        case ColumnType.DateTime:
                            @if (Filter<TContent>.IsDateTimeColumn(FilterInputParameters.Column))
                            {
                                <SfDateTimePicker TValue="DateTime?" @ref="DateTimePickerComponent"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_datetime_{_invalidInputCalendarRefreshKey}")"
                                                  Value="@(FilterValue as DateTime?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnDateTimeInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Placeholder="@GetPlaceholder()"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <DateTimePickerEvents TValue="DateTime?" ValueChange="@OnDateTimeValueChanged"></DateTimePickerEvents>
                                </SfDateTimePicker>
                            }
                            else
                            {
                                <SfDateTimePicker TValue="DateTime?" @ref="DateTimePickerComponent"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_datetime_{_invalidInputCalendarRefreshKey}")"
                                                  Value="@(FilterValue as DateTime?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnDateTimeInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Placeholder="@GetPlaceholder()"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <DateTimePickerEvents TValue="DateTime?" ValueChange="@OnDateTimeValueChanged"></DateTimePickerEvents>
                                </SfDateTimePicker>
                            }
                            break;

                        case ColumnType.TimeOnly:
                            @if (Filter<TContent>.IsTimeOnlyColumn(FilterInputParameters.Column))
                            {
                                <SfTimePicker TValue="TimeOnly?" @ref="TimePickerComponent"
                                              Width="100%"
                                              @key="@($"{FilterInputParameters.Column?.Uid}_time_{_invalidInputCalendarRefreshKey}")"
                                              Value="@(FilterValue as TimeOnly?)"
                                              Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                              @oninput="@((ChangeEventArgs e) => OnTimeInput(e))"
                                              @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                              Format="@FilterInputParameters.Column?.Format"
                                              Placeholder="@GetPlaceholder()"
                                              ShowClearButton="false"
                                              ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                              aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <TimePickerEvents TValue="TimeOnly?" ValueChange="@OnTimeValueChanged"></TimePickerEvents>
                                </SfTimePicker>
                            }
                            else
                            {
                                <SfTimePicker TValue="TimeOnly?" @ref="TimePickerComponent"
                                              Width="100%"
                                              @key="@($"{FilterInputParameters.Column?.Uid}_time_{_invalidInputCalendarRefreshKey}")"
                                              Value="@(FilterValue as TimeOnly?)"
                                              Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                              @oninput="@((ChangeEventArgs e) => OnTimeInput(e))"
                                              @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                              Format="@FilterInputParameters.Column?.Format"
                                              Placeholder="@GetPlaceholder()"
                                              ShowClearButton="false"
                                              ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                              aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <TimePickerEvents TValue="TimeOnly?" ValueChange="@OnTimeValueChanged"></TimePickerEvents>
                                </SfTimePicker>
                            }
                            break;

                        case ColumnType.Boolean:
                            <SfDropDownList @ref="BooleanDropDown"
                                            Width="100%"
                                            @key="@($"{FilterInputParameters.Column?.Uid}_boolean")"
                                            TValue="bool?"
                                            TItem="BooleanOption"
                                            DataSource="@BooleanOptions"
                                            Value="@(FilterValue as bool?)"
                                            ValueChanged="@OnBooleanValueChanged"
                                            @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                            ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                            Placeholder="@GetPlaceholder()"
                                            ShowClearButton="false"
                                            aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                            </SfDropDownList>
                            break;

                        default:
                            @if (Filter<TContent>.IsDateColumn(FilterInputParameters.Column))
                            {
                                <SfDatePicker TValue="DateTime?" @ref="DatePickerComponent"
                                              Width="100%"
                                              @key="@($"{FilterInputParameters.Column?.Uid}_date_fallback_{_invalidInputCalendarRefreshKey}")"
                                              Value="@(FilterValue as DateTime?)"
                                              Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                              @oninput="@((ChangeEventArgs e) => OnDateInput(e))"
                                              @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                              Format="@FilterInputParameters.Column?.Format"
                                              Placeholder="@GetPlaceholder()"
                                              ShowClearButton="false"
                                              ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                              aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <DatePickerEvents TValue="DateTime?" ValueChange="@OnDateValueChanged"></DatePickerEvents>
                                </SfDatePicker>
                            }
                            else if (Filter<TContent>.IsDateTimeColumn(FilterInputParameters.Column))
                            {
                                <SfDateTimePicker TValue="DateTime?" @ref="DateTimePickerComponent"
                                                  Width="100%"
                                                  @key="@($"{FilterInputParameters.Column?.Uid}_datetime_fallback_{_invalidInputCalendarRefreshKey}")"
                                                  Value="@(FilterValue as DateTime?)"
                                                  Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                                  @oninput="@((ChangeEventArgs e) => OnDateTimeInput(e))"
                                                  @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                                  Format="@FilterInputParameters.Column?.Format"
                                                  Placeholder="@GetPlaceholder()"
                                                  ShowClearButton="false"
                                                  ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                                  aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <DateTimePickerEvents TValue="DateTime?" ValueChange="@OnDateTimeValueChanged"></DateTimePickerEvents>
                                </SfDateTimePicker>
                            }
                            else if (Filter<TContent>.IsTimeOnlyColumn(FilterInputParameters.Column))
                            {
                                <SfTimePicker TValue="TimeOnly?" @ref="TimePickerComponent"
                                              Width="100%"
                                              @key="@($"{FilterInputParameters.Column?.Uid}_time_fallback_{_invalidInputCalendarRefreshKey}")"
                                              Value="@(FilterValue as TimeOnly?)"
                                              Enabled="@GetInputEnabledState(CurrentOperator, FilterInputParameters.Column?.Type)"
                                              @oninput="@((ChangeEventArgs e) => OnTimeInput(e))"
                                              @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                              Format="@FilterInputParameters.Column?.Format"
                                              Placeholder="@GetPlaceholder()"
                                              ShowClearButton="false"
                                              ID="@($"{FilterInputParameters.Column?.Field}_value")"
                                              aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")">
                                    <TimePickerEvents TValue="TimeOnly?" ValueChange="@OnTimeValueChanged"></TimePickerEvents>
                                </SfTimePicker>
                            }
                            else
                            {
                                <SfTextBox type="InputType.Text"
                                           class="e-control e-textbox e-lib e-input"
                                           value="@FilteredValue"
                                           @oninput="@((ChangeEventArgs e) => OnStringInputChanged(e))"
                                           @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))"
                                           placeholder="@GetPlaceholder()"
                                           id="@($"{FilterInputParameters.Column?.Field}_value")"
                                           aria-label="@($"Filter value for {FilterInputParameters.Column?.Field}")"></SfTextBox>
                            }
                            break;
                    }
                </div>
                <div class="e-filter-icons-wrapper">
                   
                    <div class="@GetOperatorIconClass()"
                         id="@($"filter_icon_{FilterInputParameters.Column?.Uid}")"
                         @onmousedown="@OnIconMouseDown"
                         @onclick="@OpenOperatorDropdown"
                         @onclick:stopPropagation="true"
                         @onkeydown="@((KeyboardEventArgs args) => OnIconKeyDown(args))"
                         title="@(Parent?.Localizer?.GetText(GridLocaleKeys.FilterOperator) ?? "Filter Operator")"
                         role="button"
                         tabindex="0"
                         aria-label="@GetOperatorIconAriaLabel()"></div>
                    
                    <span class="@GetClearIconClass()" 
                          @onclick="@((MouseEventArgs e) => HasActiveFilter() ? OnClearIconClick(e, FilterInputParameters.Column!) : Task.CompletedTask)"
                          @onkeydown="@((KeyboardEventArgs args) => HasActiveFilter() ? OnClearIconKeyDown(args, FilterInputParameters.Column!) : Task.CompletedTask)"
                          title="@(Parent?.Localizer?.GetText(GridLocaleKeys.ClearFilter) ?? "Clear Filter")" 
                          role="button"
                          tabindex="@(HasActiveFilter() ? "0" : "-1")"
                          aria-label="@($"Clear filter for {FilterInputParameters.Column?.Field}")"
                          aria-disabled="@(!HasActiveFilter())"></span>
                </div>
                
                <SfDropDownList @ref="OperatorDropDown"
                                @key="@($"{FilterInputParameters.Column?.Uid}_operator")"
                                TValue="string"
                                TItem="OperatorItem"
                                DataSource="@AvailableOperators"
                                @bind-Value="@CurrentOperator"
                                ID="@($"{FilterInputParameters.Column?.Field}_operator")"
                                Placeholder=""
                                CssClass="e-enhanced-operator-dropdown"
                                PopupHeight="300px"
                                PopupWidth="160px"
                                TabIndex="@OperatorDropdownTabIndex">
                    <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                    <DropDownListEvents TValue="string" TItem="OperatorItem" ValueChange="@((Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, OperatorItem> e) => OnOperatorChanged(e))" Closed="@((Syncfusion.Blazor.DropDowns.ClosedEventArgs args) => OnOperatorDropdownClosed(args))"></DropDownListEvents>
                </SfDropDownList>
            }
            else
            {
                if (FilterInputParameters.FilterValue != null && !string.IsNullOrEmpty(FilterInputParameters.FilterValue.ToString()) && (FilterInputParameters.Column?.Type == ColumnType.Date || FilterInputParameters.Column?.Type == ColumnType.DateTime) && FilterInputParameters.Column?.Format != null)
                {
                    if (FilterInputParameters.Column?.ValueType == typeof(DateTimeOffset?) || FilterInputParameters.Column?.ValueType == typeof(DateTimeOffset))
                    {
                        FilterInputParameters.FilterValue = FilterInputParameters.FilterValue is string ? FilterInputParameters.FilterValue : ((DateTimeOffset)FilterInputParameters.FilterValue).ToString(FilterInputParameters.Column.Format, System.Globalization.CultureInfo.CurrentCulture);
                    }
                    else if (FilterInputParameters.FilterValue?.GetType() == typeof(DateTime))
                    {
                        FilterInputParameters.FilterValue = ((DateTime)FilterInputParameters.FilterValue).ToString(FilterInputParameters.Column?.Format, System.Globalization.CultureInfo.CurrentCulture);
                    }
                }
                if (FilterInputParameters.FilterValue != null && !string.IsNullOrEmpty(FilterInputParameters.FilterValue.ToString()) && FilterInputParameters.FilterValue.GetType().IsEnum)
                {
                    if (FilterInputParameters.FilterValue is Enum enumValue)
                    {
                        FilterInputParameters.FilterValue = MetadataExtension.GetDisplayName(enumValue);
                    }
                }
                string? Val = FilterInputParameters.FilterValue == null || string.IsNullOrEmpty(FilterInputParameters.FilterValue.ToString()) ? null : FilterInputParameters.Column?.Format != null && (FilterInputParameters.Column?.Type == ColumnType.DateOnly) ? Filter<TContent>.ConvertToDesiredDateFormat(FilterInputParameters.FilterValue.ToString()!, FilterInputParameters.Column?.Format!, FilterInputParameters.Column!.Type, false) : FilterInputParameters.FilterValue.ToString();
                <span class="e-input-group e-control-container e-control-wrapper @InputFocus">
                    <input id="@($"{FilterInputParameters.Column?.Field}_filterBarcell")" @attributes="GetHtmlAttributes(Title!, FilterInputParameters.Column!)" autocomplete="on" type="search" class="e-control e-textbox e-lib e-input" @key="FilterInputParameters.Column?.Uid" value="@Val" @oninput="@((e) => UpdateValue(e))" @onkeydown="@((KeyboardEventArgs args) => KeyDownHandler(args, FilterInputParameters.Column!))" @onblur="@OnBlur" @onfocus="@OnFocus" name="@($"{FilterInputParameters.Column?.Field}_filterBarcell")" role="searchbox" aria-disabled=false tabindex=0 aria-label="@($"{FilterInputParameters.Column?.Field}_{Parent?.Localizer?.GetText(GridLocaleKeys.FilterBar)}")">
                    @if (FilterInputParameters.Column?.FilterClearIcon == "e-clear-icon")
                    {
                        <span class="@FilterInputParameters.Column.FilterClearIcon" @onclick="@((e) => CancelIconClick(e, FilterInputParameters.Column))"
                        title="@Parent?.Localizer?.GetText(GridLocaleKeys.ClearButton)" role="button"></span>
                    }
                    else
                    {
                        <span class="e-clear-icon e-clear-icon-hide" title="@Parent?.Localizer?.GetText(GridLocaleKeys.ClearButton)" role="button" />
                    }
                </span>
            }
        }
    </div>
    @if (FilterInputParameters.Column != null && FilterInputParameters.Column.EnableFrozenLineCursor)
    {
        string cursorClass = string.Empty;
        if (FilterInputParameters.Column.EnableLeftFrozenLineCursor)
        {
            cursorClass = "e-frozen-cursor e-frozen-right-cursor e-frozen-default-cursor";
        }
        else if (FilterInputParameters.Column.EnableRightFrozenLineCursor)
        {
            cursorClass = "e-frozen-cursor e-frozen-left-cursor e-frozen-default-cursor";
        }
        if (FilterInputParameters.IsFrozen.HasValue && FilterInputParameters.IsFrozen == true)
        {
            cursorClass = FilterInputParameters.IsFrozenRight == true ? "e-frozen-cursor e-frozen-right-cursor" : "e-frozen-cursor e-frozen-left-cursor";
        }
        if (Parent != null && Parent.AllowResizing && FilterInputParameters.Column?.AllowResizing == true)
        {
            cursorClass = string.Concat(cursorClass, " e-frozen-resize-cursor");
        }
        <div class="@(cursorClass)"></div>
    }
</td>


@code {
    [Parameter]
    public FilterInputParameters? FilterInputParameters { get; set; }

    [CascadingParameter]
    SfGrid<TContent>? Parent { get; set; }

    private System.Timers.Timer? aTimer;

    public string FilteredValue { get; set; } = string.Empty;

    private GridColumn? FilteredColumn { get; set; }
    public string? FilterOperator { get; set; }
    public bool IsInputEventTriggered { get; set; }
    private string? InputFocus { get; set; }
    private string? Title { get; set; }
    private object? FilterValue { get; set; }
    private Syncfusion.Blazor.DropDowns.SfDropDownList<string, OperatorItem>? OperatorDropDown { get; set; }
    private List<OperatorItem> AvailableOperators { get; set; } = new List<OperatorItem>();
    private string CurrentOperator { get; set; } = string.Empty;
    private bool IsOperatorDropdownOpen { get; set; } = false;
    private bool _wasOpenOnMouseDown = false;
    private int OperatorDropdownTabIndex { get; set; } = -1;

    private Syncfusion.Blazor.Inputs.SfTextBox? StringTextBoxComponent { get; set; }
    private Syncfusion.Blazor.Inputs.SfNumericTextBox<int?>? NumericValueAsInt { get; set; }
    private Syncfusion.Blazor.Inputs.SfNumericTextBox<long?>? NumericValueAsLong { get; set; }
    private Syncfusion.Blazor.Inputs.SfNumericTextBox<double?>? NumericValueAsDouble { get; set; }
    private Syncfusion.Blazor.Inputs.SfNumericTextBox<decimal?>? NumericValueAsDecimal { get; set; }
    private Syncfusion.Blazor.Calendars.SfDatePicker<DateTime?>? DatePickerComponent { get; set; }
    private Syncfusion.Blazor.Calendars.SfDateTimePicker<DateTime?>? DateTimePickerComponent { get; set; }
    private Syncfusion.Blazor.Calendars.SfTimePicker<TimeOnly?>? TimePickerComponent { get; set; }
    private Syncfusion.Blazor.DropDowns.SfDropDownList<bool?, BooleanOption>? BooleanDropDown { get; set; }

    private string StringInputValue { get; set; } = string.Empty;
    private List<BooleanOption> BooleanOptions { get; set; } = new();
    private bool _userInitiatedClear = false;
    private bool _isDeviceMode = false;
    private int _invalidInputCalendarRefreshKey = 0;


    private bool ShouldShowOperatorDropdown()
    {
        if (Parent?.FilterSettings?.ShowFilterBarOperator != true)
        {
            return false;
        }

        return FilterInputParameters?.Column?.FilterSettings?.ShowFilterBarOperator ?? true;
    }

    private string GetDivClass()
    {
        bool isFiltertemplate = (FilterInputParameters != null && FilterInputParameters.Column != null && FilterInputParameters.Column.FilterTemplate != null && FilterInputParameters.Column.Visible);
        return ShouldShowOperatorDropdown() && !isFiltertemplate
            ? "e-filterdiv e-enhancement-filterbar" 
            : "e-filterdiv e-fltrinputdiv";
    }

    private string GetOperatorIconClass()
    {
        return "e-icons e-filter";
    }
    private bool HasActiveFilter()
    {
        if (Filter<TContent>.IsNullOrEmptyOperator(CurrentOperator))
        {
            return true;
        }

        bool hasFilterValue = FilterValue != null;
        bool hasFilteredValue = !string.IsNullOrEmpty(FilteredValue);

        return hasFilterValue || hasFilteredValue;
    }
    private string GetOperatorIconAriaLabel()
    {
        if (HasActiveFilter())
        {
            return $"Filter operator for {FilterInputParameters?.Column?.Field}, currently filtered";
        }
        else
        {
            return $"Filter operator for {FilterInputParameters?.Column?.Field}";
