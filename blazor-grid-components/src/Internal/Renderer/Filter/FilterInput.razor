    private void StopTimer()
    {
        if (aTimer != null)
        {
            aTimer.Stop();
            aTimer.Dispose();
        }
    }

    private void StartTimer(KeyboardEventArgs Args, GridColumn Column)
    {
        this.FilterInputParameters!.Column = Column;
        aTimer = new System.Timers.Timer();
        aTimer.Elapsed += new System.Timers.ElapsedEventHandler(DisplayTimeEvent!);
        aTimer.Interval = Args.Key == "Enter" ? 1 : Parent!.FilterSettings!.ImmediateModeDelay;
        aTimer.Start();
    }

    private void TriggerImmediateFilterIfNeeded()
    {
        if (Parent?.FilterSettings?.Mode == FilterBarMode.Immediate)
        {
            StopTimer();
            StartTimer(new KeyboardEventArgs() { }, this.FilterInputParameters!.Column!);
        }
    }

    private async Task KeyDownHandler(KeyboardEventArgs args, GridColumn column)
    {
        this.FilterInputParameters!.Column = column;
        var keyCombination = args?.GetKeyCombination();
        HashSet<string> navigationKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Tab",
            "ShiftTab",
        };
        if (args?.Key == "Enter")
        {
            StopTimer();
            StartTimer(args, this.FilterInputParameters.Column);
        }
        if (args?.Key == "Tab" || args?.Key == "Enter")
        {
            this.FilterInputParameters.Column.FilterClearIcon = !string.IsNullOrEmpty(this.FilterInputParameters.Column?.FilterClearIcon) ? string.Empty : this.FilterInputParameters.Column?.FilterClearIcon!;
        }
        if (args?.Key == "Escape")
        {
            this.FilterInputParameters.Column!.FilterClearIcon = string.Empty;
            if (Parent?.FilterSettings?.ShowFilterBarOperator == true)
            {
                FilteredValue = string.Empty;
                FilterValue = null;
                StringInputValue = string.Empty;
                FilterInputParameters.FilterValue = string.Empty;
                FilteredColumn = null!;
                if (Parent?.FilteredColumns != null && Parent.FilteredColumns.Count > 0)
                {
                    Parent.FilteredColumns.Clear();
                }

                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            }
            else
            {
                Parent!.FilterModule!.FilteredValue = string.Empty;
                FilterInputParameters.FilterValue = string.Empty;
                FilteredColumn = null!;
                if (Parent?.FilteredColumns != null && Parent.FilteredColumns.Count > 0)
                {
                    TriggerImmediateFilterIfNeeded();
                    Parent.FilteredColumns.Clear();
                }
            }
        }
        else if (keyCombination != null && navigationKeys.Contains(keyCombination))
        {
            await Parent!.InvokeMethod("sfBlazor.Grid.focusFilterBar", new object[] { Parent.DataId, keyCombination! });
        }
    }

    private async Task ProcessFilter(GridColumn column)
    {
        object? value = null;
        if (FilteredColumn != null && !(FilteredColumn.Equals(column)))
        {
            Parent!.FilterModule!.FilteredValue = string.Empty;
        }
        await InvokeAsync(async () =>
        {
            IsInputEventTriggered = false;
            if (!string.IsNullOrEmpty(Parent?.FilterModule?.FilteredValue))
            {
                string formattedFilterValue = column?.Format != null && (column?.Type == ColumnType.Date || column?.Type == ColumnType.DateTime || column?.Type == ColumnType.DateOnly) ? Filter<TContent>.ConvertToDesiredDateFormat(Parent.FilterModule.FilteredValue, column.Format, column.Type) : Parent.FilterModule.FilteredValue;
                value = Parent.FilterModule!.GetActualFilterValue(column!, formattedFilterValue);
                string operatorStr = !string.IsNullOrEmpty(Parent.FilterModule.FilterOperatorProperty) ? Parent.FilterModule.FilterOperatorProperty : FilterOperator!;
                await Parent?.FilterModule?.FilterByColumn(column?.Field!, Filter<TContent>.GetOperator(operatorStr), value!, null!, Parent.FilterSettings!.EnableCaseSensitivity, Parent.FilterSettings.IgnoreAccent, null, null, column?.Uid, Parent.FilterModule.RawInputValue)!;
                if (Parent.FilteredColumns != null && Parent.FilteredColumns.Count > 1 && Parent.FilterSettings?.Mode != FilterBarMode.Immediate)
                {
                    List<string>? filteredFiledName = Parent.FilteredColumns?.Select(item => item?.Field)?.ToList()!;
                    List<string> filteredActualValues = await Parent.FilterModule.GetPreviousFilteredValues();
                    await Parent.InvokeMethod("sfBlazor.Grid.updateFilterBarCell", new object[] { Parent.DataId, filteredFiledName, filteredActualValues });
                }
            }
            else
                await Parent?.FilterModule?.RemoveFilterColumnByField(column?.Field!, column?.Uid!)!;
        });
    }

