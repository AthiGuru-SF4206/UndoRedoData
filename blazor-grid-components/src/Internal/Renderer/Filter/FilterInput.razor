    private void HandleNumericInput(ChangeEventArgs e, Func<string, (bool, object?)> parseFunc)
    {
        string stringValue = e?.Value?.ToString() ?? string.Empty;

        IsInputEventTriggered = true;
        FilteredValue = stringValue;

        var (parsed, numericValue) = parseFunc(stringValue);
        if (parsed)
        {
            FilterValue = numericValue;
        }
        else if (string.IsNullOrEmpty(stringValue))
        {
            FilterValue = null;
        }

        FilteredColumn = FilterInputParameters!.Column!;
        FilterInputParameters.Column!.FilterClearIcon = string.IsNullOrEmpty(FilteredValue) ? FilteredValue : "e-clear-icon";

        TriggerImmediateFilterIfNeeded();
    }

