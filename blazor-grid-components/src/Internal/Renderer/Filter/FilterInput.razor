    private async Task ProcessFilter_Enhanced(GridColumn column)
    {
        object? value = null;
        if (FilteredColumn != null && !(FilteredColumn.Equals(column)))
        {
            FilteredValue = string.Empty;
        }

        bool isNullEmptyOp = Filter<TContent>.IsNullOrEmptyOperator(CurrentOperator);

        bool isNumericOrTyped = column?.Type == ColumnType.Integer
                             || column?.Type == ColumnType.Double
                             || column?.Type == ColumnType.Long
                             || column?.Type == ColumnType.Decimal
                             || column?.Type == ColumnType.Date
                             || column?.Type == ColumnType.DateTime
                             || column?.Type == ColumnType.DateOnly
                             || column?.Type == ColumnType.TimeOnly
                             || column?.Type == ColumnType.Boolean;

        bool hasValue = isNullEmptyOp
                     || !string.IsNullOrEmpty(FilteredValue)
                     || (isNumericOrTyped && FilterValue != null);

        await InvokeAsync(async () =>
        {
            if (hasValue)
            {
                if (!string.IsNullOrEmpty(CurrentOperator))
                    FilterOperator = CurrentOperator;

                if (isNullEmptyOp)
                {
                    value = null;
                }
                else if (isNumericOrTyped && FilterValue != null)
                {
                    value = FilterValue;
                }
                else
                {
                    string formattedFilterValue = column?.Format != null && (column?.Type == ColumnType.Date || column?.Type == ColumnType.DateTime || column?.Type == ColumnType.DateOnly) ? Filter<TContent>.ConvertToDesiredDateFormat(FilteredValue, column.Format, column.Type)! : FilteredValue;
                    value = Parent!.FilterModule!.GetActualFilterValue(column!, formattedFilterValue);
                }

                if (!string.IsNullOrEmpty(CurrentOperator))
                    FilterOperator = CurrentOperator;

                await Parent?.FilterModule?.FilterByColumn(column?.Field!, Filter<TContent>.GetOperator(FilterOperator!), value!, null!, Parent.FilterSettings!.EnableCaseSensitivity, Parent.FilterSettings.IgnoreAccent, null, null, column?.Uid, Parent.FilterModule.RawInputValue)!;
                if (Parent.FilteredColumns != null && Parent.FilteredColumns.Count > 1 && Parent.FilterSettings?.Mode != FilterBarMode.Immediate)
                {
                    List<string>? filteredFieldName = Parent.FilteredColumns?.Select(item => item?.Field)?.ToList()!;
                    List<string> filteredActualValues = await Parent.FilterModule.GetPreviousFilteredValues();
                    await Parent.InvokeMethod("sfBlazor.Grid.updateFilterBarCell", new object[] { Parent.DataId, filteredFieldName, filteredActualValues });
                }
            }
            else
                await Parent?.FilterModule?.RemoveFilterColumnByField(column?.Field!, column?.Uid!)!;
        });
    }

    private async Task ClearFilter()
    {
        _userInitiatedClear = true;

        FilteredValue = string.Empty;
        FilterValue = null;
        StringInputValue = string.Empty;
        CurrentOperator = Filter<TContent>.GetDefaultOperator(FilterInputParameters?.Column?.Type);
        StopTimer();

        if (FilterInputParameters?.Column == null || Parent?.FilterModule == null)
            return;

        try
        {
            await InvokeAsync(async () =>
            {
                var clearTask = Parent.FilterModule.RemoveFilterColumnByField(
                    FilterInputParameters.Column.Field ?? string.Empty,
                    FilterInputParameters.Column.Uid ?? string.Empty
                );

                if (clearTask != null)
                {
                    await clearTask.ConfigureAwait(true);
                }

                if (Parent?.FilterSettings?.Columns != null)
                {
                    var existingFilter = Parent.FilterSettings.Columns
                        .FirstOrDefault(c => c.Uid == FilterInputParameters.Column.Uid);

                    if (existingFilter != null)
                    {
                        existingFilter.ActualValue = null;
                        existingFilter.Value = null;
                    }
                }

                await InvokeAsync(StateHasChanged).ConfigureAwait(true);
            }).ConfigureAwait(true);
        }
        catch { /* silently fail */ }
    }

    



    private Dictionary<string, object> GetHtmlAttributes(string Value, GridColumn Column)
    {
        Dictionary<string, object> Attributes = new Dictionary<string, object>();
        Attributes.Add("title", Value);
        if (!Column.AllowFiltering)
            Attributes.Add("disabled", "disabled");
        return Attributes;
    }

    private bool GetInputEnabledState(string? operatorValue, ColumnType? columnType)
    {
        if (Filter<TContent>.IsNullOrEmptyOperator(operatorValue))
        {
            return false;
        }
        return true;
    }

    private string GetPlaceholder()
    {
        return FilterInputParameters?.Column?.Type switch
        {
            ColumnType.Date or ColumnType.DateTime or ColumnType.DateOnly => Parent?.Localizer?.GetText(GridLocaleKeys.ChooseDate) ?? string.Empty,
            ColumnType.TimeOnly => Parent?.Localizer?.GetText(GridLocaleKeys.ChooseTime) ?? string.Empty,
            ColumnType.Integer or ColumnType.Double or ColumnType.Long or ColumnType.Decimal => Parent?.Localizer?.GetText(GridLocaleKeys.EnterValue) ?? string.Empty,
            ColumnType.Boolean => Parent?.Localizer?.GetText(GridLocaleKeys.EnterValue) ?? string.Empty,
            _ => Parent?.Localizer?.GetText(GridLocaleKeys.EnterValue) ?? string.Empty
        };
    }
}
