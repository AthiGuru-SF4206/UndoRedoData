    private bool IsTemporalColumn(GridColumn? column)
    {
        if (column == null) return false;
        return column.Type == ColumnType.Date 
            || column.Type == ColumnType.DateTime 
            || column.Type == ColumnType.DateOnly 
            || column.Type == ColumnType.TimeOnly;
    }
    private bool HasInvalidTemporalInput(GridColumn column, string input)
    {
        if (string.IsNullOrEmpty(input))
            return false;

        return column.Type switch
        {
            ColumnType.Date => !DateTime.TryParse(input, CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out _),
            ColumnType.DateTime => !DateTime.TryParse(input, CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out _),
            ColumnType.DateOnly => !DateOnly.TryParse(input, CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out _),
            ColumnType.TimeOnly => !TimeOnly.TryParse(input, CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out _),
            _ => false
        };
    }

    private async Task OnClearIconClick(MouseEventArgs e, GridColumn column)
    {
        if (column == null) return;

        if (IsTemporalColumn(column) && HasInvalidTemporalInput(column, FilteredValue))
        {
            _invalidInputCalendarRefreshKey++;
        }

        FilteredValue = string.Empty;
        FilterValue = null;
        StringInputValue = string.Empty;
        CurrentOperator = Filter<TContent>.GetDefaultOperator(column.Type);
        column.FilterClearIcon = string.Empty;
        StopTimer();   

        if (Parent?.FilterModule != null)
        {
            Parent.FilterModule.FilteredValue = string.Empty;
            await Parent.FilterModule.RemoveFilterColumnByField(column?.Field!, column?.Uid!);
        }
        await Parent!.InvokeMethod("sfBlazor.Grid.searchClear", new object[]
        {
            Parent.DataId, $"{column?.Field}_filterBarcell"
        });
        await InvokeAsync(StateHasChanged).ConfigureAwait(true);
    }


    private async Task OnClearIconKeyDown(KeyboardEventArgs args, GridColumn column)
    {
        if (column == null) return;

        if (args?.Key == "Enter" || args?.Key == " ")
        {

            await OnClearIconClick(new MouseEventArgs(), column);
        }
    }

    private async void DisplayTimeEvent(object source, ElapsedEventArgs s)
    {
        aTimer!.Stop();
        aTimer.Enabled = false;
        StopTimer();

        if (ShouldShowOperatorDropdown())
            await ProcessFilter_Enhanced(this.FilterInputParameters!.Column!).ConfigureAwait(true);

        else
            await ProcessFilter(this.FilterInputParameters!.Column!);
    }

