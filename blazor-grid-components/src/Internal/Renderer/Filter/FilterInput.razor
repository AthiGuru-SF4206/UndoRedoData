    private string GetClass(GridColumn column)
    {
        string className = "e-filterbarcell";
        if (string.IsNullOrEmpty(column?.Field)) { return className; }
        GridGroupSettings? _settings = Parent!.GroupSettings!;
        if (_settings != null && Parent.AllowGrouping && !_settings.ShowGroupedColumn && _settings.Columns != null && _settings.Columns.Any(x => x == column?.Field))
        {
            className += " e-hide";
        }
        if (column?.EnableFrozenLineCursor == true)
        {
            className += " e-freezeline";
        }
        var classFrozenName = Parent.FreezeModule!.ApplyFrozenColumnsClass(column!);
        className = string.Concat(className, classFrozenName);
        return className;
    }

    private string GetStyles(GridColumn column)
    {
        if (column == null)
            return string.Empty;
        String StylesName = Parent!.FreezeModule!.ApplyFrozenColumnsStyles(column);
        return StylesName;
    }

    private void LoadOperators()
    {
        if (FilterInputParameters?.Column == null) return;

        var operators = Parent?.FilterModule?.GetOperatorsByColumnType(FilterInputParameters.Column.Type) ?? new List<OperatorItem>();

        AvailableOperators = operators;
        CurrentOperator = Filter<TContent>.GetDefaultOperator(FilterInputParameters.Column.Type);

        var existingFilter = Parent?.FilterSettings?.Columns?
            .FirstOrDefault(c => c.Uid == FilterInputParameters.Column.Uid);
        if (existingFilter != null)
        {
            CurrentOperator = existingFilter.Operator.ToString().ToLower();
        }
    }

    private void LoadFilterValue()
    {
        if (FilterInputParameters?.Column == null) return;

        if (_userInitiatedClear)
            return;

        var existingFilter = Parent?.FilterSettings?.Columns?
            .FirstOrDefault(c => c.Uid == FilterInputParameters.Column.Uid);

        if (existingFilter != null)
        {
            var rawValue = existingFilter.ActualValue ?? existingFilter.Value;

            if (rawValue != null && FilterInputParameters.Column.ValueType != null)
            {
                try { FilterValue = SfBaseUtils.ChangeType(rawValue, FilterInputParameters.Column.ValueType); }
                catch { FilterValue = rawValue; }
            }
            else
            {
                FilterValue = rawValue;
            }

            FilteredValue = FilterValue?.ToString() ?? string.Empty;

            if (FilterInputParameters.Column.Type == ColumnType.String && FilterValue != null)
            {
                StringInputValue = FilterValue.ToString() ?? string.Empty;
                FilteredValue = StringInputValue;
            }
        }
    }

    private void InitializeBooleanOptions()
    {
        BooleanOptions = new List<BooleanOption>
        {
            new BooleanOption { Value = true, Text = Parent?.Localizer?.GetText(GridLocaleKeys.True) ?? "True" },
            new BooleanOption { Value = false, Text = Parent?.Localizer?.GetText(GridLocaleKeys.False) ?? "False" }
        };
    }

    private void OnIconMouseDown(MouseEventArgs args)
    {
        _wasOpenOnMouseDown = IsOperatorDropdownOpen;
        // Stop any pending timer to prevent filter from being applied after the click
        StopTimer();
    }

    private async Task OpenOperatorDropdown()
    {
        if (OperatorDropDown == null) return;

        // Stop any pending timer to prevent filter from being applied
        StopTimer();

        if (_wasOpenOnMouseDown)
        {
            _wasOpenOnMouseDown = false;
            await OperatorDropDown.HidePopupAsync().ConfigureAwait(true);
        }
        else
        {
            _wasOpenOnMouseDown = false;
            IsOperatorDropdownOpen = true;
            await OperatorDropDown.ShowPopupAsync().ConfigureAwait(true);
            await OperatorDropDown.FocusAsync().ConfigureAwait(true);

        }
    }

    private async Task OnIconKeyDown(KeyboardEventArgs args)
    {
        // Stop any pending timer to prevent filter from being applied after the interaction
        StopTimer();

        if (args?.Key == "Escape" && IsOperatorDropdownOpen && OperatorDropDown != null)
        {
            await OperatorDropDown.HidePopupAsync().ConfigureAwait(true);
            await FocusValueInput().ConfigureAwait(true);
        }

        // Handle Alt+Down Arrow to toggle dropdown when filter icon has focus
        if (args?.Key == "ArrowDown" && args.AltKey && OperatorDropDown != null)
        {
            if (IsOperatorDropdownOpen)
            {
                await OperatorDropDown.HidePopupAsync().ConfigureAwait(true);
                await FocusValueInput().ConfigureAwait(true);
                IsOperatorDropdownOpen = false;
                OperatorDropdownTabIndex = -1;
            }
            else
            {
                IsOperatorDropdownOpen = true;
                OperatorDropdownTabIndex = 0;
                await OperatorDropDown.ShowPopupAsync().ConfigureAwait(true);
                // Transfer focus from icon to dropdown so arrow keys navigate list items
                await OperatorDropDown.FocusAsync().ConfigureAwait(true);
            }
        }
    }

    private async Task OnOperatorChanged(ChangeEventArgs<string, OperatorItem> e)
    {
        if (e.IsInteracted)
        {
            if (string.IsNullOrEmpty(CurrentOperator)) return;

            CurrentOperator = CurrentOperator.ToLower();

            IsOperatorDropdownOpen = false;
            if (OperatorDropDown != null)
            {
                await OperatorDropDown.HidePopupAsync().ConfigureAwait(true);
            }

            _userInitiatedClear = false;

            FilterValue = null;
            FilteredValue = string.Empty;
            StringInputValue = string.Empty;
            FilterOperator = CurrentOperator;

            
            if (Parent?.FilterModule != null)
            {
                Parent.FilterModule.FilteredValue = string.Empty;

            }

            if (Filter<TContent>.IsNullOrEmptyOperator(CurrentOperator))
            {
                await ProcessFilter_Enhanced(FilterInputParameters!.Column!).ConfigureAwait(true);
            }
            await FocusValueInput().ConfigureAwait(true);
            UpdateFilterDisplayState();
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);
        }
    }

    private async Task FocusValueInput()
    {
        try
        {
            if (Filter<TContent>.IsNullOrEmptyOperator(CurrentOperator))
                return;

            switch (FilterInputParameters?.Column?.Type)
            {
                case ColumnType.String:
                    if (StringTextBoxComponent != null)
                        await StringTextBoxComponent.FocusAsync().ConfigureAwait(true);
                    break;

                case ColumnType.Integer:
                case ColumnType.Double:
                case ColumnType.Long:
                case ColumnType.Decimal:
                    if (Filter<TContent>.IsNumericInteger(FilterInputParameters.Column) && NumericValueAsInt != null)
                        await NumericValueAsInt.FocusAsync().ConfigureAwait(true);
                    else if (Filter<TContent>.IsNumericLong(FilterInputParameters.Column) && NumericValueAsLong != null)
                        await NumericValueAsLong.FocusAsync().ConfigureAwait(true);
                    else if (NumericValueAsDouble != null)
                        await NumericValueAsDouble.FocusAsync().ConfigureAwait(true);
                    break;

                case ColumnType.Date:
                case ColumnType.DateOnly:
                    if (DatePickerComponent != null)
                        await DatePickerComponent.FocusAsync().ConfigureAwait(true);
                    break;

                case ColumnType.DateTime:
                    if (DateTimePickerComponent != null)
                        await DateTimePickerComponent.FocusAsync().ConfigureAwait(true);
                    break;

                case ColumnType.TimeOnly:
                    if (TimePickerComponent != null)
                        await TimePickerComponent.FocusAsync().ConfigureAwait(true);
                    break;

                case ColumnType.Boolean:
                    if (BooleanDropDown != null)
                        await BooleanDropDown.FocusAsync().ConfigureAwait(true);
                    break;
            }
        }
        catch { /* silently fail */ }
    }

