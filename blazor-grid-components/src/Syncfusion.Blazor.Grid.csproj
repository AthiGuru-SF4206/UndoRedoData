<Project Sdk="Microsoft.NET.Sdk.Razor">

 <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <Nullable>enable</Nullable>
	  <AssemblyOriginatorKeyFile>..\sf.snk</AssemblyOriginatorKeyFile>
    <TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <BlazorLinkOnBuild>false</BlazorLinkOnBuild>
    <LangVersion Condition="'$(TargetFramework)'=='net8.0'">12</LangVersion>
    <LangVersion Condition="'$(TargetFramework)'=='net9.0'">13</LangVersion>
    <LangVersion Condition="'$(TargetFramework)'=='net10.0'">14</LangVersion>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Version>33.1.44</Version>
    <FileVersion>33.1.44</FileVersion>
    <PackageId>Syncfusion.Blazor.Grid</PackageId>
    <Title>Syncfusion Blazor Grid Component</Title>
    <Company>Syncfusion Inc.</Company>
    <Authors>Syncfusion Inc.</Authors>
    <Product>Syncfusion Blazor Grid Component</Product>
    <Copyright>Copyright 2001 - 2026 Syncfusion® Inc.</Copyright>
    <AssemblyName>Syncfusion.Blazor.Grids</AssemblyName>
    <RootNamespace>Syncfusion.Blazor.Grids</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://www.syncfusion.com/blazor-components/?utm_source=nuget&amp;utm_medium=listing</PackageProjectUrl>
    <PackageIcon>syncfusion_logo.png</PackageIcon>
    <PackageDescription>Syncfusion® Blazor DataGrid component for rendering high-performance, feature-rich tabular UI in .NET Blazor applications. Includes virtualization, paging, sorting, filtering, grouping, editing, templates, and export (Excel/PDF).</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://blazor.syncfusion.com/documentation/release-notes/32.1.19?type=all&amp;utm_source=nuget&amp;utm_medium=listing</PackageReleaseNotes>
    <PackageTags>syncfusion blazor datagrid grid datagrid-component virtualization paging sorting filtering grouping editing templates export accessibility dotnet</PackageTags>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
	<ItemGroup>
		<None Include="syncfusion_logo.png" Pack="true" PackagePath="\"/>
	</ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
	<None Include="LICENSE.txt" Pack="true" PackagePath="\"/>
   </ItemGroup>

  <ItemGroup>
    <Content Update="*.razor">
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="Syncfusion.Blazor.Core" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Buttons" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Calendars" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Data" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Inputs" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Navigations" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Popups" Version="34.2.3" />
      <PackageReference Include="Syncfusion.Blazor.Spinner" Version="34.2.3" />
      <PackageReference Include="Syncfusion.PdfExport.Net.Core" Version="*" />
      <PackageReference Include="Syncfusion.ExcelExport.Net.Core" Version="*" />
      <PackageReference Include="Syncfusion.Telemetry" Version="34.2.3" />
  </ItemGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>TRACE;DEBUG;$(SyncfusionLicensing);Release</DefineConstants>
	</PropertyGroup>
</Project>