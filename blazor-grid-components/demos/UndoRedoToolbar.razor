@page "/undoredo-toolbar"

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons

<div style="margin-bottom: 20px;">
    <h2>Grid with Undo/Redo Toolbar Buttons</h2>
    <p>Click the Undo and Redo buttons in the toolbar to undo/redo batch editing operations.</p>
</div>

<SfGrid @ref="GridRef" DataSource="@orderData" AllowPaging="true" Toolbar="@ToolbarItems">
    <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Batch"></GridEditSettings>
    <GridPageSettings PageSize="12"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(OrderDetails.OrderID)" HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="100"></GridColumn>
        <GridColumn Field="@nameof(OrderDetails.CustomerID)" HeaderText="Customer ID" Width="100"></GridColumn>
        <GridColumn Field="@nameof(OrderDetails.ShipCity)" HeaderText="Ship City" Width="100"></GridColumn>
        <GridColumn Field="@nameof(OrderDetails.ShipName)" HeaderText="Ship Name" Width="120"></GridColumn>
        <GridColumn Field="@nameof(OrderDetails.Freight)" HeaderText="Freight" TextAlign="TextAlign.Right" Width="100"></GridColumn>
    </GridColumns>
</SfGrid>

<div style="margin-top: 20px;">
    <h3>Instructions:</h3>
    <ul>
        <li>Click <strong>Add</strong> to add a new row</li>
        <li>Click on cells to edit them directly (Batch mode)</li>
        <li>Click <strong>Undo</strong> button to undo the last operation</li>
        <li>Click <strong>Redo</strong> button to redo the undone operation</li>
        <li>Use keyboard shortcuts: <strong>Ctrl+Z</strong> for Undo, <strong>Ctrl+Y</strong> for Redo</li>
    </ul>
</div>

@code {
    private SfGrid<OrderDetails>? GridRef;
    private List<OrderDetails> orderData = new();
    private List<object> ToolbarItems = new List<object>() { "Add", "Edit", "Delete", "Update", "Cancel", "Undo", "Redo" };

    protected override void OnInitialized()
    {
        orderData = OrderDetails.GetAllRecords();
    }

    public class OrderDetails
    {
        public int OrderID { get; set; }
        public string? CustomerID { get; set; }
        public string? ShipCity { get; set; }
        public string? ShipName { get; set; }
        public double Freight { get; set; }

        public OrderDetails() { }

        public OrderDetails(int orderID, string customerID, string shipCity, string shipName, double freight)
        {
            OrderID = orderID;
