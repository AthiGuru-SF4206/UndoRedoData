@inherits GridTestBase

<SfFixture @ref="fixture15" TestAsync="GridBasicRendering15" Description="Filtering using buttons">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateRows()" AllowFiltering="true">
            <GridEditSettings AllowAdding AllowDeleting AllowEditing></GridEditSettings>
            <GridColumns>
                <GridColumn Field="TaskId" Visible=false IsPrimaryKey="true"></GridColumn>
                <GridColumn Field="TaskName" HeaderText="Task Name"></GridColumn>
                <GridColumn Field="StartDate" HeaderText="Start Date" Type="ColumnType.Date"></GridColumn>
                <GridColumn Field="EndDate" HeaderText="End Date" Type="ColumnType.Date"></GridColumn>
                <GridColumn Field="Progress"></GridColumn>
            </GridColumns>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
{
    SfFixture fixture15 { get; set; }
    public static List<TaskData> Task { get; set; }
    public async Task GridBasicRendering15(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<TaskData>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");

        Assert.True(cut.Instance.AllowFiltering == true);
        Assert.True(cut.Instance.CurrentViewData.Count() == 15, "Before filtering count");
        await cut.Instance.FilterByColumnAsync("EndDate", "notequal", "4/5/2022", "or", true, false);
        Assert.True(cut.Instance.CurrentViewData.Count() == 13, "After filtering count");
        await cut.Instance.FilterByColumnAsync("EndDate", "equal", "4/8/2022", "or", true, false);
        Assert.True(cut.Instance.CurrentViewData.Count() == 4, "After filtering count");
        await cut.Instance.FilterByColumnAsync("StartDate", "greaterthan", "4/1/2022", "or", true, false);
        Assert.True(cut.Instance.CurrentViewData.Count() == 0, "After filtering count");
    }

