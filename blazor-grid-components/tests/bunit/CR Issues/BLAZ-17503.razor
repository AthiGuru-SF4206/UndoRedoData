@inherits GridTestBase

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="All the records gets selected when clearing the filtering with one already selected record">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" Height="600" EnableVirtualization="true" AllowFiltering="true" >
            <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Both" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" PersistSelection=false></GridSelectionSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.EmployeeID) HeaderText="Employee ID" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> GridData { get; set; }

    public async void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Grid.FilterByColumnAsync("EmployeeID", "equal", "1").GetAwaiter();
        var count = Grid.SelectedRecords.Count;
        Grid.SelectRowAsync(0).GetAwaiter();
        Assert.True(Grid.SelectedRecords.Count == 1);
        Grid.FilterModule.RemoveFilterColumnByField("EmployeeID").GetAwaiter();
        Assert.True(Grid.SelectedRecords.Count == 0);
    }

     public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 50).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            EmployeeID = x,
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public int? EmployeeID { get; set; }
        public double? Freight { get; set; }
        public DateTime? OrderDate { get; set; }
    }
}