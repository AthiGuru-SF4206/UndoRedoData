@inherits GridTestBase
<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="NullReferenceException is thrown when an invalid column name is passed to the ShowColumnsAsync() method">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" Height="315">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Center" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150" TextAlign="TextAlign.Center"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Visible="false" Type="ColumnType.Date" TextAlign="TextAlign.Center" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" Visible="false" TextAlign="TextAlign.Center" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> GridData { get; set; }

    public string[] ColumnItems = new string[] { "Order Date", "Freight1" };

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;
        await Grid.ShowColumnsAsync(ColumnItems);
        Assert.True(Grid.GetVisibleColumnsAsync().Result.Count() == 3, "Columns are rendered properly.");
    }

