                IsDelivered = false
            });
        orders.Add(new Order
            {
                OrderID = 1003,
                OrderInvoiceNumber = 2003,
                CustomerID = "Philip",
                Freight = 4.1,
                OrderDate = DateTime.Now,
                DeliveryDate = DateTime.Now.AddDays(3),
                IsDelivered = false
            });
        orders.Add(new Order
            {
                OrderID = 1004,
                OrderInvoiceNumber = 2004,
                CustomerID = "David",
                Freight = 4.1,
                OrderDate = DateTime.Now,
                DeliveryDate = DateTime.Now.AddDays(3),
                IsDelivered = false
            });
        orders.Add(new Order
            {
                OrderID = 1005,
                OrderInvoiceNumber = 2005,
                CustomerID = "Jack",
                Freight = 4.1,
                OrderDate = DateTime.Now,
                DeliveryDate = DateTime.Now.AddDays(3),
                IsDelivered = false
            });
        orders.Add(new Order
            {
                OrderID = 1006,
