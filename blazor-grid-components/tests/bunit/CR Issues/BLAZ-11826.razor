<h3>BLAZ_11826</h3>

@inherits GridTestBase
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel.DataAnnotations.Schema
@using Newtonsoft.Json;
@using System.Dynamic
@using Syncfusion.Blazor.Grids;
@using Syncfusion.Blazor;
@using Syncfusion.Blazor.Data;

<SfFixture @ref="fixture" Test="EditingComplexExpandoData" Description="Predicate generate with different ForeignKey field and column field name">
    <ComponentUnderTest>
        <SfGrid TValue="BlogTheme" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Search", "ColumnChooser" })"
                AllowSelection="true" AllowSorting="true" AllowFiltering="true" AllowPaging="true" AllowMultiSorting="true" AllowReordering="true" AllowResizing="true"
                AllowTextWrap="true" EnableAutoFill="true" AllowExcelExport="true"
                ShowColumnChooser="true"
                ContextMenuItems="@(new List<object>() { "AutoFit", "AutoFitAll", "SortAscending", "SortDescending", "Copy", "Edit", "Delete",
                                        "Save", "Cancel", "ExcelExport", "CsvExport", "FirstPage", "PrevPage", "LastPage", "NextPage"})"
                AllowGrouping="false" AllowPdfExport="false">
            <GridPageSettings PageSizes="true" />
            <GridTextWrapSettings WrapMode="Syncfusion.Blazor.Grids.WrapMode.Content" />
            <SfDataManager AdaptorInstance="@typeof(CustomAdaptor)" Adaptor="Adaptors.CustomAdaptor"></SfDataManager>
            <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
            <GridColumns>
                <GridColumn Field=@nameof(BlogTheme.Id) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(BlogTheme.Name) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(BlogTheme.Key) HeaderText=" Order Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>

                @foreach (Culture culture in Cul)
                {
                    <GridColumn Field="@($"Names.{culture.Id}")" HeaderText="@culture.Name" Type="ColumnType.String"></GridColumn>
                }
                <GridColumn Width="26px" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" ShowInColumnChooser="false">
                    <GridCommandColumns>
                        <GridCommandColumn ButtonOption="@(new CommandButtonOptions() { IconCss = "icon-new-tab", CssClass = "e-icon-button" })" Title="@("Show Theme Blog")" />
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
            <GridSearchSettings IgnoreAccent="true" IgnoreCase="true" Operator="Operator.Contains" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" ShowFilterBarStatus="true" EnableCaseSensitivity="false" IgnoreAccent="true" Mode="FilterBarMode.Immediate" />
            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="@nameof(BlogTheme.Key)" Direction="SortDirection.Ascending" />
                </GridSortColumns>
            </GridSortSettings>
            <GridEditSettings Mode="Syncfusion.Blazor.Grids.EditMode.Normal" AllowAdding="true" AllowDeleting="true" AllowEditing="true"
                              AllowNextRowEdit="true" AllowEditOnDblClick="true" ShowDeleteConfirmDialog="true" />
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }
    public static List<BlogTheme> orders { get; set; }
    List<BlogThemeCulture> BT { get; set; }
    List<Culture> Cul { get; set; }

    public async void EditingComplexExpandoData(Fixture fixture)
    {
        Cul = Enumerable.Range(1, 5).Select(x => new Culture()
        {
            Id = x,
            Name = (new string[] { "en", "pt", "gb", "nl", "fr" })[x - 1],
        }).ToList();

        BT = Enumerable.Range(1, 5).Select(x => new BlogThemeCulture()
        {
            Id = 1000 + x,
            CultureId = x,
            Name = (new string[] { "en", "pt", "gb", "nl", "fr" })[x - 1],
        }).ToList();

        orders = Enumerable.Range(1, 75).Select(x => new BlogTheme()
        {
            Id = 1000 + x,
            Name = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Key = (2.1 * x).ToString(),
        }).ToList();

        foreach (BlogTheme item in orders)
        {
            item.Names = new ExpandoObject();
            foreach (Culture culture in Cul)
            {
                ((IDictionary<string, object>)item.Names)[culture.Id.ToString()] = item.BlogThemeCultures.Where(r => r.CultureId == culture.Id).FirstOrDefault()?.Name;
            }
        }

        var cut = fixture.GetComponentUnderTest<SfGrid<BlogTheme>>();
        await cut.Instance.SelectRowAsync(1);
        await cut.Instance.StartEditAsync();
        Assert.True(cut.Instance.IsEdit == true, "Edit form renders properly with complex Expando Data");
        await cut.Instance.CloseEditAsync();
        Assert.True(cut.Instance.IsEdit == false, "Edit form close properly with complex Expando Data");
    }

    public void OnInitialized()
    {

    }

    // Implementing custom adaptor by extending the DataAdaptor class
    public class CustomAdaptor : DataAdaptor
    {
        // Performs data Read operation
        public override object Read(DataManagerRequest dm, string key = null)
        {
            IEnumerable<BlogTheme> DataSource = orders;
            if (dm.Search != null && dm.Search.Count > 0)
            {
                // Searching
                DataSource = DataOperations.PerformSearching(DataSource, dm.Search);
            }
            if (dm.Sorted != null && dm.Sorted.Count > 0)
            {
                // Sorting
                DataSource = DataOperations.PerformSorting(DataSource, dm.Sorted);
            }
            if (dm.Where != null && dm.Where.Count > 0)
            {
                // Filtering
                DataSource = DataOperations.PerformFiltering(DataSource, dm.Where, dm.Where[0].Operator);
            }
            int count = DataSource.Cast<BlogTheme>().Count();
            if (dm.Skip != 0)
            {
                //Paging
                DataSource = DataOperations.PerformSkip(DataSource, dm.Skip);
            }
            if (dm.Take != 0)
            {
                DataSource = DataOperations.PerformTake(DataSource, dm.Take);
            }
            return dm.RequiresCounts ? new DataResult() { Result = DataSource, Count = count } : (object)DataSource;
        }

        // Performs Insert operation
        public override object Insert(DataManager dm, object value, string key)
        {
            orders.Insert(0, value as BlogTheme);
            return value;
        }

        // Performs Remove operation
        public override object Remove(DataManager dm, object value, string keyField, string key)
        {
            orders.Remove(orders.Where(or => or.Id == int.Parse(value.ToString())).FirstOrDefault());
            return value;
        }

        // Performs Update operation
        public override object Update(DataManager dm, object value, string keyField, string key)
        {
            var data = orders.Where(or => or.Id == (value as BlogTheme).Id).FirstOrDefault();
            if (data != null)
            {
                data.Id = (value as BlogTheme).Id;
                data.Name = (value as BlogTheme).Name;
                data.Key = (value as BlogTheme).Key;
                data.Names = (value as BlogTheme).Names;
            }
            return value;
        }
    }

    public class BlogTheme
    {
        [Key]
        public int Id { get; set; }
        [Required]
        public string Key { get; set; }

        public string Name { get; set; }
        public List<BlogThemeCulture> BlogThemeCultures { get; } = Enumerable.Range(1, 5).Select(x => new BlogThemeCulture()
        {
            Id = 1000 + x,
            CultureId = x,
            Name = (new string[] { "en", "pt", "gb", "nl", "fr" })[x - 1],
        }).ToList();
        [NotMapped]
        public ExpandoObject Names { get; set; }
    }

    public class BlogThemeCulture
    {
        [Required]
        public int Id { get; set; }
        public BlogTheme BlogTheme { get; set; }
        [Required]
        [MaxLength(2)]
        public int CultureId { get; set; }
        public Culture Culture { get; set; }
        public string Name { get; set; }
    }
    public class Culture
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }
}
