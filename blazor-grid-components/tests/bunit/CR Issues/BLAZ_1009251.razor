@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Inputs

<SfFixture @ref="fixture" TestAsync="GridSearchNestedProperties" Description="Search functionality with nested complex object properties">
    <ComponentUnderTest>
        <SfGrid @ref="EmployeeGrid" DataSource="@GetAllRecords()" AllowFiltering="true" Height="315" Toolbar="@(new List<string> { "Search" })">
            <GridSearchSettings Operator="Operator.Contains"></GridSearchSettings>
            <GridColumns>
                <GridColumn Field="@nameof(EmployeeData.EmployeeID)" HeaderText="EmployeeID" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="Name.FirstName" HeaderText="First Name" Width="150"></GridColumn>
                <GridColumn Field="Name.LastName" HeaderText="Last Name" Width="130"></GridColumn>
                <GridColumn Field="@nameof(EmployeeData.Title)" HeaderText="Title" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="Details.Position.Title" HeaderText="Position Title" Width="150"></GridColumn>
                <GridColumn Field="Details.Position.EmployeeRole.RoleTitle" HeaderText="Role Title" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    private SfGrid<EmployeeData> EmployeeGrid;
    public static List<EmployeeData> Employees { get; set; }
    bool _canAssert = false;
    public static List<EmployeeData> GetAllRecords()
    {
        Employees = new List<EmployeeData>
        {
            new EmployeeData()
            {
                EmployeeID = 1,
                Name = new EmployeeName()
                {
                    FirstName = "Nancy",
                    LastName = "Davolio"
                },
                Title = "Sales Representative",
                Details = null
            },
            new EmployeeData()
            {
                EmployeeID = 2,
                Name = new EmployeeName()
                {
                    FirstName = "Andrew",
                    LastName = "Fuller"
                },
                Title = "Vice President, Sales",
                Details = null
            },
            new EmployeeData()
            {
                EmployeeID = 3,
                Name = new EmployeeName()
                {
                    FirstName = "Janet",
                    LastName = "Leverling"
                },
                Title = "Sales Manager",
                Details = null
            },
            new EmployeeData()
            {
                EmployeeID = 4,
                Name = new EmployeeName()
                {
                    FirstName = "Margaret",
                    LastName = "Peacock"
                },
                Title = "Sales Representative",
                Details = null
            },
            new EmployeeData()
            {
                EmployeeID = 5,
                Name = new EmployeeName()
                {
                    FirstName = "Steven",
                    LastName = "Buchanan"
                },
                Title = "Sales Manager",
                Details = null
            }
        };
        return Employees;
    }

    async Task GridSearchNestedProperties(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeData>>();
        _canAssert = true;

        // Verify initial state - all 5 rows should be visible
        Assert.True(5 == cut.Instance.CurrentViewData.Count(), "Initial data loaded properly with 5 employees");
        await cut.Instance.SearchAsync("Janet");

        await Task.Delay(100); // Small delay for search to process

        Assert.True(1 == cut.Instance.CurrentViewData.Count(), "Search for 'Janet' returns 1 matching record");

        // Verify the filtered data contains Janet
        var filteredData = cut.Instance.CurrentViewData.Cast<EmployeeData>().FirstOrDefault();
        Assert.True(filteredData != null && filteredData.Name.FirstName == "Janet", "Filtered data contains correct employee 'Janet'");

        // Verify DOM elements - check if the row contains Janet
        var rows = cut.FindAll(".e-row");
        Assert.True(rows.Count >= 1, "At least one row is visible after search");

        // Verify the row content by checking for "Janet" text in DOM
        var rowContent = string.Join(" ", rows.Select(r => r.InnerHtml ?? ""));
        Assert.True(rowContent.Contains("Janet"), "DOM contains 'Janet' text in filtered row");

        // Verify other details of the filtered record
        Assert.True(filteredData.EmployeeID == 3, "Search result has correct EmployeeID");
        Assert.True(filteredData.Title == "Sales Manager", "Search result has correct Title");
    }
    

   

    public class EmployeeData
    {
        public int? EmployeeID { get; set; }
        public EmployeeName Name { get; set; }
        public string Title { get; set; }
        public EmployeeDetails Details { get; set; }
    }

    public class EmployeeName
    {
        public string FirstName { get; set; }
        public string LastName { get; set; }
    }

    public class EmployeeDetails
    {
        public EmployeePosition Position { get; set; }
    }

    public class EmployeePosition
    {
        public string Title { get; set; }

        public Role EmployeeRole { get; set; }
    }

    public class Role
    {
        public string RoleTitle { get; set; }
    }

}
