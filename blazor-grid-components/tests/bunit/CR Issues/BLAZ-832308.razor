        data.Add(new Order() { OrderID = 100011, CustomerID = "ALFKI", OrderDate = new DateTime(1991, 05, 14), Freight = 30.7 * 2, ShipCountry = "Switzerland", ShippedDate = new DateTime(2005, 04, 04) });
        data.Add(new Order() { OrderID = 100012, CustomerID = "ANANTR", OrderDate = new DateTime(1991, 07, 10), Freight = 31.7 * 2, ShipCountry = "Austria", ShippedDate = new DateTime(2006, 05, 05) });
