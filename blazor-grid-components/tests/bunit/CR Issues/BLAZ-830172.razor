@inherits GridTestBase

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Selection should maintain after delete operation">
    <ComponentUnderTest>
            <SfGrid @ref="grid" DataSource="GenerateRows()" AllowPaging="true">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true"></GridEditSettings>
            <GridSelectionSettings EnableToggle="false" Type="Syncfusion.Blazor.Grids.SelectionType.Single">
                </GridSelectionSettings>
                <GridColumns>
                    <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" IsPrimaryKey="true" Width="120"></GridColumn>
                    <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                    <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                    <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                </GridColumns>
            </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    public static List<Order> Orders { get; set; }
    SfGrid<Order> grid;

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        await grid.SelectRowAsync(0);
        var selectedRowCount = cut.Instance.SelectedRowIndexes.Count();
        Assert.True(1 == selectedRowCount, "First row is selected");

        // delete rows
        await grid.DeleteRecordAsync();
        var selectedRow = cut.Instance.SelectedRowIndexes.Count();
        Assert.True(1 == selectedRowCount, "Single-type selection is working properly");
    }


    public List<Order> GenerateRows()
    {
        List<Order> data = new List<Order>();
        data.Add(new Order() { OrderID = 10001, CustomerID = "ALFKI", OrderDate = new DateTime(1991, 05, 15), Freight = 25.7 * 2 });
        data.Add(new Order() { OrderID = 10002, CustomerID = "ANANTR", OrderDate = new DateTime(1991, 07, 11), Freight = 26.7 * 2 });
        data.Add(new Order() { OrderID = 10003, CustomerID = "BLONP", OrderDate = new DateTime(1991, 05, 12), Freight = 27.7 * 2 });
        data.Add(new Order() { OrderID = 10004, CustomerID = "ANTON", OrderDate = new DateTime(1991, 12, 30), Freight = 28.7 * 2 });
        data.Add(new Order() { OrderID = 10005, CustomerID = "BOLID", OrderDate = new DateTime(1991, 05, 13), Freight = 29.7 * 2 });
        data.Add(new Order() { OrderID = 10006, CustomerID = "ALFKI", OrderDate = new DateTime(1991, 05, 14), Freight = 30.7 * 2 });
        data.Add(new Order() { OrderID = 10007, CustomerID = "ANANTR", OrderDate = new DateTime(1991, 07, 10), Freight = 31.7 * 2 });
        data.Add(new Order() { OrderID = 10008, CustomerID = "BLONP", OrderDate = new DateTime(1991, 05, 9), Freight = 32.7 * 2 });
        data.Add(new Order() { OrderID = 10009, CustomerID = "ANTON", OrderDate = new DateTime(1991, 12, 29), Freight = 33.7 * 2 });
        data.Add(new Order() { OrderID = 100010, CustomerID = "BOLID", OrderDate = new DateTime(1991, 05, 28), Freight = 34.7 * 2 });
        return Orders = data;
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}