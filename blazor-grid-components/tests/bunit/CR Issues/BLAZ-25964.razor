@inherits GridTestBase

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Pager External Message not updated">
    <ComponentUnderTest>
        <SfGrid DataSource="@Orders" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings>
                <GridFilterColumns>
                    <GridFilterColumn Field="CustomerID" MatchCase=false Operator="Syncfusion.Blazor.Operator.StartsWith" Predicate="and" Value="@val"></GridFilterColumn>
                </GridFilterColumns>
            </GridFilterSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    public List<Order> GridData { get; set; }
    public string val = "ANANTR";


    public void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var externalMessage = GridReflection.GetNestedPropertyValue<string>(cut.Instance, "PagerRef.ExternalMessage");
        Assert.True(externalMessage == "Customer Name: ANANTR", "External Message updated");
    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 10).Select(x => new Order()
            {
                OrderID = 1000 + x,
                CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
                Freight = 2.1 * x,
                OrderDate = DateTime.Now.AddDays(-x),
            }).ToList();
    }
}