@inherits GridTestBase

@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Problem with removing checkbox selection on clear filtering when persist selection is enabled.">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" AllowFiltering="true" AllowPaging="true">
            <GridPageSettings PageSize="5"></GridPageSettings>
            <GridSelectionSettings PersistSelection="true" CheckboxOnly="true"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="50px" />
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code 
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> Orders { get; set; }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.TotalItemCount == 10);
        await Grid.FilterByColumnAsync("CustomerID", "equal", "ALFKI");
        cut.WaitForState(() => cut.Instance.TotalItemCount < 10);
        cut.FindAll(".e-checkselectall")[0].Click();
        await Grid.FilterModule.RemoveFilterColumnByField("CustomerID");
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.Intermediate), "CheckBox State Updated Properly");
        Assert.True(cut.Instance.SelectedRecords.Count > 0, "Selection has not been cleared");
    }

    public List<Order> GenerateRows()
    {
        return Orders = Enumerable.Range(1, 10).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON" })[new Random().Next(3)],
            Freight = 2.1 * x,
            OrderDate = (new DateTime[] { new DateTime(2010, 5, 1), new DateTime(2010, 5, 2), new DateTime(2010, 5, 3), })[new Random().Next(3)]
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}


<SfFixture @ref="fixture2" TestAsync="GridBasicRendering2" Description="CheckBox Header not getting updated while adding and cancelling in batch mode when persist selection is disabled.">
    <ComponentUnderTest>
        <SfGrid @ref="Grid2" DataSource="GenerateRows()" AllowFiltering="true" AllowPaging="true">
            <GridPageSettings PageSize="5"></GridPageSettings>
            <GridSelectionSettings PersistSelection="false" CheckboxOnly="true"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="50px" />
                <GridColumn Field=@nameof(Order.OrderID) IsPrimaryKey="true" HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture2 { get; set; }
    private SfGrid<Order> Grid2;

    public async Task GridBasicRendering2(Fixture fixture2)
    {
        var cut = fixture2.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.TotalItemCount == 10);
        await Grid2.FilterByColumnAsync("CustomerID", "equal", "ALFKI");
        cut.WaitForState(() => cut.Instance.TotalItemCount < 10);
        cut.FindAll(".e-checkselectall")[0].Click();
        await Grid2.FilterModule.RemoveFilterColumnByField("CustomerID");
        cut.WaitForState(() => cut.Instance.CheckBoxState.Equals(CheckState.UnCheck));
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.UnCheck), "CheckBox State Updated Properly");
        Assert.True(cut.Instance.SelectedRecords.Count == 0, "Selection has been cleared");
    }

}
