@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Tests

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Flat grid with filter checkbox type">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateCheckBoxData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings EnableCaseSensitivity="false"></GridFilterSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code{
    SfFixture fixture { get; set; }
    public List<Order> OrdersData { get; set; }

    async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;
        await Grid.FilterByColumnAsync("CustomerID", "equal", "datagrid");
        Assert.True(Grid.FilterSettings.Columns.Count() == 1, "Filter method working properly");
        cut.FindAll(".e-filtermenudiv")[1].Click();
        var value = "datagrid";
        var CheckBoxRenderer = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterCheckBoxRenderer<Order>>();
        var result = CheckBoxRenderer.Instance.UpdateResult(value);
        value = "DataGrid";
        var result1 = CheckBoxRenderer.Instance.UpdateResult(value);
        Assert.True(result1 == result, "Checkbox Filter type choice list works fine ");
    }

    public List<Order> GenerateCheckBoxData()
    {
        return OrdersData = Enumerable.Range(1, 75).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "datagrid", "Datagrid", "pgAdmin 4", "pgadmin 4" })[new Random().Next(4)],
            Freight = 2.1 * x,
            OrderDate = (new DateTime[] { new DateTime(2010, 5, 1), new DateTime(2010, 5, 2), new DateTime(2010, 5, 3), })[new Random().Next(3)],
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}
