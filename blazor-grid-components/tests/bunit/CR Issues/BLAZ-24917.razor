@inherits GridTestBase

@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Multiple cells not selected in same row">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateRecords()" AllowSelection="true" EnableHover="false" AllowPaging="true">
            <GridSelectionSettings EnableToggle="true" PersistSelection=true AllowDragSelection="true" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Cell" CellSelectionMode="Syncfusion.Blazor.Grids.CellSelectionMode.Box"></GridSelectionSettings>
                    <GridColumns>
                        <GridColumn HeaderText="test 2" TextAlign="TextAlign.Right" IsPrimaryKey="true" Width="120" IsFrozen="true"></GridColumn>
                        <GridColumn HeaderText="Test"><GridColumns>
                        <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer ID" Width="150"></GridColumn>
                        <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                        <GridColumn Field=@nameof(Order.Freight) Format="C2" TextAlign="TextAlign.Right" Width="150"></GridColumn>
                        </GridColumns>
                        </GridColumn>
                    </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> Orders { get; set; }

    protected List<Order> GenerateRecords()
    {
        return Orders = Enumerable.Range(1, 75).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }

    public void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows[2].Cells[1].IsSelected == false);
        var a = cut.Instance.SelectCellsAsync(new ValueTuple<int, int> [] { (2, 1), (2, 2), (2, 3) });
        Assert.True(cut.Instance.Rows[2].Cells[1].IsSelected == true);
        Assert.True(cut.Instance.Rows[2].Cells[2].IsSelected == true);
        Assert.True(cut.Instance.Rows[2].Cells[3].IsSelected == true);    
    }

    public class Order {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}
