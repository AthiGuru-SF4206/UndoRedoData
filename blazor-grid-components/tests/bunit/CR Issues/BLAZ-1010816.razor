@using System.Collections.ObjectModel
@using Syncfusion.Blazor.Grids
@using System.ComponentModel
@using System.Runtime.CompilerServices
@inherits GridTestBase

<SfFixture @ref="fixture" Test="HighPrioritySorting" Description="Grid rows not rendered after sorting, when using abstract TValue with polymorphic data source in Grid">
    <ComponentUnderTest>
        <SfGrid TValue="CarViewModel" DataSource="@GetCarsData()" AllowSorting="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="@nameof(CarViewModel.Year)" Direction="SortDirection.Descending"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>
            <GridColumns>
                <GridColumn Field="@nameof(CarViewModel.Make)" HeaderText="Make" Width="120"></GridColumn>
                <GridColumn Field="@nameof(CarViewModel.Model)" HeaderText="Model" Width="120"></GridColumn>
                <GridColumn Field="@nameof(CarViewModel.Year)" HeaderText="Year" TextAlign="TextAlign.Right" Width="120" Type="ColumnType.Integer"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private static List<CarViewModel> Cars = new List<CarViewModel>();

    public List<CarViewModel> GetCarsData()
    {
        if (Cars.Count == 0)
        {
            Cars = new List<CarViewModel>
            {
                new AudiViewModel { Model = "A4", Year = 2020 },
                new BmwViewModel { Model = "3 Series", Year = 2019 },
                new AudiViewModel { Model = "A6", Year = 2021 },
                new BmwViewModel { Model = "5 Series", Year = 2018 },
            };
        }
        return Cars;
    }

    void HighPrioritySorting(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<CarViewModel>>();
        
        // Wait for grid to render with data
        cut.WaitForState(() => cut.FindAll("tr.e-row").Count > 0);
        
        // Verify initial data is rendered
        var initialRows = cut.FindAll("tr.e-row");
        Assert.True(initialRows.Count == 4, "Grid rows rendered initially");
        
        // Verify sort icon renders properly
        var sortHeader = cut.FindAll("th.e-headercell").Where(th => th.TextContent.Contains("Year")).FirstOrDefault();
        Assert.True(sortHeader != null, "Year header column found");
        
        var sortIcon = sortHeader?.QuerySelector(".e-sortfilterdiv");
        Assert.True(sortIcon != null, "Sort icon renders properly");
        
        // Verify data is sorted by Year in descending order (2021, 2020, 2019, 2018)
        var cells = cut.FindAll("tr.e-row td");
        var yearCells = cells.Where((cell, index) => (index + 1) % 3 == 0).Take(4).ToList();
        
        Assert.True(yearCells.Count == 4, "Year cells found");
        Assert.True(int.Parse(yearCells[0].TextContent.Trim()) == 2021, "First year is 2021 (highest)");
        Assert.True(int.Parse(yearCells[1].TextContent.Trim()) == 2020, "Second year is 2020");
        Assert.True(int.Parse(yearCells[2].TextContent.Trim()) == 2019, "Third year is 2019");
        Assert.True(int.Parse(yearCells[3].TextContent.Trim()) == 2018, "Fourth year is 2018 (lowest)");
    }

    public abstract class CarViewModel : BaseViewModel
    {
        private string _make;
        public string Make
        {
            get => _make;
            set => SetField(ref _make, value);
        }

        private string _model;
        public string Model
        {
            get => _model;
            set => SetField(ref _model, value);
        }

        private int _year;
        public int Year
        {
            get => _year;
            set => SetField(ref _year, value);
        }
    }

    public abstract class BaseViewModel : INotifyPropertyChanged
    {
        public event PropertyChangedEventHandler PropertyChanged;

        protected virtual void OnPropertyChanged([CallerMemberName] string propertyName = null)
        {
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
        }

        protected bool SetField<T>(ref T field, T value, [CallerMemberName] string propertyName = null)
        {
            if (EqualityComparer<T>.Default.Equals(field, value)) return false;
            field = value;
            OnPropertyChanged(propertyName);
            return true;
        }
    }

    public class AudiViewModel : CarViewModel
    {
        private string _audiCustomProperty;

        public string AudiCustomProperty
        {
            get => _audiCustomProperty;
            set => SetField(ref _audiCustomProperty, value);
        }

        public AudiViewModel()
        {
            Make = "Audi";
        }
    }

    public class BmwViewModel : CarViewModel
    {
        private string _bmwCustomProperty;

        public string BmwCustomProperty
        {
            get => _bmwCustomProperty;
            set => SetField(ref _bmwCustomProperty, value);
        }

        public BmwViewModel()
        {
            Make = "BMW";
        }
    }

}
