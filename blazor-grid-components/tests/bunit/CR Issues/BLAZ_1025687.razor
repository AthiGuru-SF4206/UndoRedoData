@inherits GridTestBase
@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="EnableSanitization and DisableHtmlEncode">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateRecords()">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="120" DisableHtmlEncode="false" EnableSanitization="true"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name 2" Width="120" DisableHtmlEncode="false" EnableSanitization="false"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=ShipCountry HeaderText="ShipCountry" Format="C2" Width="100"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> Orders { get; set; }
    private string _currentRequestType = "";
    public bool EnableSanitization { get; set; } = true;
    public List<Order> GenerateRecords()
    {
        Orders = Enumerable.Range(1, 9).Select((x) =>
        {
            Order d = new Order();
            d.OrderID = 1000 + x;
            d.CustomerID = x % 2 == 0 ? "ALFKI1" : x % 5 == 0 ? "ANANTR2" : x % 11 == 0 ? "ANTON3" : "BOLID4";
            d.Freight = Math.Round((2.3 * x), 2);
            d.OrderDate = x % 2 == 0 ? new DateTime(2010, 11, 5) : x % 5 == 0 ? new DateTime(2018, 10, 3) : x % 11 == 0 ? new DateTime(1995, 9, 9) : new DateTime(2012, 8, 2);
            return d;
        }).Cast<Order>().ToList<Order>();
        Orders.Add(new Order
        {
            OrderID = 50001,
            CustomerID = "<button id=\"htmlbtn\" onclick=\"badFunc()\" class=\"custombtn\">Submit</button>",
            Freight = 123.45,
            OrderDate = DateTime.Now,
        });
        return Orders;
    }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var htmlBtn1 = cut.FindAll(".custombtn")[0];
        Assert.True(htmlBtn1 != null, "HTML content should be rendered in the grid");
        Assert.True(htmlBtn1.GetAttribute("onclick") == null, "Onclick attribute must be null when sanitization is enabled");
        var htmlBtn2 = cut.FindAll(".custombtn")[1];
        Assert.True(htmlBtn2 != null, "HTML content should be rendered in the grid");
        Assert.True(htmlBtn2.GetAttribute("onclick") == "badFunc()", "Onclick attribute must be present when sanitization is disabled");

    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }

}
