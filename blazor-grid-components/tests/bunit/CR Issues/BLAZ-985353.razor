@inherits GridTestBase

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="ClearRowSelection Not works well after selectAll using checkbox">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" AllowPaging="true">
            <GridPageSettings PageSize="5"></GridPageSettings>
            <GridSelectionSettings PersistSelection="true" CheckboxOnly="true"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Type="ColumnType.CheckBox" Width="50px" />
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> Orders { get; set; }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.TotalItemCount == 10);
        cut.FindAll(".e-checkselectall")[0].Click();
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.Check), "CheckBox State Updated Check - SelectAll");
        await cut.Instance.ClearRowSelectionAsync();
        cut.Render();
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.UnCheck), "CheckBox State Updated UnCheck - ClearRowSelectionAsync");
        cut.FindAll(".e-checkselect")[0].Click();
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.Intermediate), "CheckBox State Updated Intermediate - Selected one row");
        await cut.InvokeAsync(() => cut.Instance.GoToPageAsync(2));
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.Intermediate), "CheckBox State Updated Intermediate - Selected one row");
        cut.FindAll(".e-checkselect")[0].Click();
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.Intermediate), "CheckBox State Updated Intermediate - Selected one row in second page");
        //In above code, CR issue's scenario is covered, below code to just ensure selectall works fine after.
        cut.FindAll(".e-checkselectall")[0].Click();
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.UnCheck), "CheckBox State Updated UnCheck - UnSelectAll");
        cut.FindAll(".e-checkselectall")[0].Click();
        Assert.True(cut.Instance.CheckBoxState.Equals(CheckState.Check), "CheckBox State Updated UnCheck - SelectAll");
    }

    public List<Order> GenerateRows()
    {
        return Orders = Enumerable.Range(1, 10).Select(x => new Order()
            {
                OrderID = 1000 + x,
                CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON" })[new Random().Next(3)],
                Freight = 2.1 * x,
                OrderDate = (new DateTime[] { new DateTime(2010, 5, 1), new DateTime(2010, 5, 2), new DateTime(2010, 5, 3), })[new Random().Next(3)]
            }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}
