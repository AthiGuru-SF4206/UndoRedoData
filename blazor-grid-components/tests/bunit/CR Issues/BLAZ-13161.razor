@inherits GridTestBase

<SfFixture Test="GridBasicRendering" Setup="Initialize" Description="Checkbox selection state getting persisted when changing the DataSource dynamically">
   <ComponentUnderTest>
    <SfGrid DataSource="@Orderss" Height="315" AllowGrouping="true" AllowFiltering="true">
        <GridSelectionSettings PersistSelection="true" />
        <GridColumns>
            <GridColumn Type="ColumnType.CheckBox" Width="80"/>
            <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            <GridColumn Field=@nameof(Order.EmployeeID) HeaderText="Employee Name" Width="150" AllowFiltering="true"></GridColumn>
            <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
            <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
        </GridColumns>
        <GridEvents TValue="Order" DataBound="Bound"></GridEvents>
    </SfGrid>
   </ComponentUnderTest>
</SfFixture>

@code{
    public List<Order> Orderss { get; set; }
    bool _canAssert = false;
    bool _canData = false;
    private IRenderedComponent<SfGrid<Order>> grid;
    
    public void Initialize(Fixture fixture)
    {
      Orderss = Enumerable.Range(1, 75).Select(x => new Order()
        {
            OrderID = 1000 + x,
            EmployeeID = (x % 5 == 0) ? null : x,
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();

    }
    public async void GridBasicRendering(Fixture fixture)
    {
        grid = fixture.GetComponentUnderTest<SfGrid<Order>>();
        await grid.Instance.SelectRowAsync(0);
        Assert.True(grid.Instance.SelectedRecords.Count == 1, "Selected count is 1");    
    }

    private void Bound(object a)
    {
        

        if (_canAssert)
        {
            Assert.True(grid.Instance.SelectedRecords.Count == 0, "Selection cleared after data change");    
        }
        if (_canData)
        {
            _canAssert = true;
            _canData = false;
            Orderss = Enumerable.Range(1, 2).Select(x => new Order()
        {
            OrderID = 1000 + x,
            EmployeeID = (x % 5 == 0) ? null : x,
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
        
        }
    }   

    public class Order
    {
        public int? OrderID { get; set; }
        public int? EmployeeID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }

    
}

