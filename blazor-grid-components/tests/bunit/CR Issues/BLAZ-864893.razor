@inherits GridTestBase

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Exception is thrown when defining the Frozen Grid width property with percentage value">
    <ComponentUnderTest>
        <SfGrid @ref="grid" DataSource="GenerateRows()" FrozenColumns="3" Height="100%" Width="650" >
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsIdentity="true" TextAlign="TextAlign.Right" Width="140"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="50%"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerNumber) HeaderText="Customer Number" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" EditType="EditType.DatePickerEdit" Format="d" TextAlign="TextAlign.Right" Width="140" Type="ColumnType.Date"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    public List<Order> Orders { get; set; }
    SfGrid<Order> grid;


    public void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Columns.Count > 0, "Exception is not thrown");
    }

    public List<Order> GenerateRows()
    {
        return Orders = GetAllRecords();
    }

    public List<Order> GetAllRecords()
    {
        List<Order> data = new List<Order>();
        int count = 1000;
        int custnum = 1;

        for (int i = 1; i <= 15; i++)
        {
            data.Add(new Order() { OrderID = count + 1, CustomerNumber = custnum, CustomerID = "ALFKI", OrderDate = new DateTime(1995, 05, 15), Freight = 1 * i });
            data.Add(new Order() { OrderID = count + 2, CustomerNumber = custnum, CustomerID = "ANANTR", OrderDate = new DateTime(1994, 04, 04), Freight = 2 * i });
            data.Add(new Order() { OrderID = count + 3, CustomerNumber = custnum, CustomerID = "BLONP", OrderDate = new DateTime(1993, 03, 10), Freight = 3 * i });
            data.Add(new Order() { OrderID = count + 4, CustomerNumber = custnum, CustomerID = "ANTON", OrderDate = new DateTime(1992, 02, 14), Freight = 4 * i });
            data.Add(new Order() { OrderID = count + 5, CustomerNumber = custnum, CustomerID = "BOLID", OrderDate = new DateTime(1991, 01, 18), Freight = 5 * i });
            count += 5;
            custnum += 5;
        }
        return data;

    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime OrderDate { get; set; }
        public int? CustomerNumber { get; set; }
        public double? Freight { get; set; }
    }
}
