@inherits GridTestBase

@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Focus issue while using selectionCell related methods">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateRows()" @ref="Grid" AllowSelection="true" AllowGrouping=true AllowPaging="true" Toolbar="@(new List<string>{"Add", "Edit"})">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="@selectionMode"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) IsPrimaryKey="true" HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    public SfGrid<Order> Grid { get; set; }
    public List<Order> Orders { get; set; }
    private SelectionMode selectionMode { get; set; } = SelectionMode.Cell;


    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => Grid.Rows.Count > 0);
        await Grid.SelectCellAsync((3, 3));
        Assert.True(Grid.Rows[3].Cells[3].IsFocused, "SelectCell method works as expected.");
        await Grid.ClearCellSelectionAsync();
        await Grid.SelectCellsAsync(new ValueTuple<int, int>[] { (2, 1), (2, 2), (2, 3), (3, 1), (4, 1), (5, 1) });
        Assert.True(Grid.Rows[5].Cells[1].IsFocused, "SelectCells method works as expected.");
        await Grid.ClearCellSelectionAsync();
        await Grid.SelectCellsByRangeAsync((5, 2), (3, 1));
        Assert.True(Grid.Rows[5].Cells[2].IsFocused, "SelectCellsByRange method works as expected");
        await Grid.ClearCellSelectionAsync();
        selectionMode = SelectionMode.Row;
        await Grid.SelectRowsByRangeAsync(2, 5);
        Assert.True(Grid.Rows[5].Cells.Where(e => e.IsFocused).Any(), "SelectRowsByRange method works as expected");
    }

    public List<Order> GenerateRows()
    {
        return Orders = Enumerable.Range(1, 75).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
            Verified = (new bool[] { true, false })[new Random().Next(2)],
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
        public bool Verified { get; set; }
    }
}
