@inherits GridTestBase


@{
    var Initial = (new string[] { "OrderID" });
}

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Group with filter in stacked header">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateRows()" AllowGrouping= "true" AllowFiltering="true" AllowSelection="true" AllowRowDragAndDrop ="true" ClipMode="ClipMode.EllipsisWithTooltip">
            <GridGroupSettings Columns="@Initial"></GridGroupSettings>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn HeaderText="Order Details" TextAlign="TextAlign.Center">
            <GridColumns>
                <GridColumn Field="OrderDate" Width="130" HeaderText="Order Date" Format="d" TextAlign="TextAlign.Right" MinWidth="10"></GridColumn>
                <GridColumn Field="Freight" Width="135" Format="C2" TextAlign="TextAlign.Right" MinWidth="10">
                </GridColumn>
            </GridColumns>
        </GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    public List<Order> GridData { get; set; }

    public void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var tr = cut.FindAll(".e-filterbarcell");        
        Assert.True(tr.Count() == 4, "filterbar cell element check");
    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 10).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }
}