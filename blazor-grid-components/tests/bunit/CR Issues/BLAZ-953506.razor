@inherits GridTestBase

<SfFixture @ref="fixture" TestAsync="EnumColumnAdd" Description="Need to check the enum column editing">
    <Fragment>
        <SfButton OnClick="AddRow" Content="AddRow" />
    </Fragment>
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GetAllRecords()" AllowPaging="true" Toolbar="@(new List<string>() {"Add", "Edit", "Delete", "Update","Cancel" })">
            <GridPageSettings PageSize="5"></GridPageSettings>
            <GridEditSettings AllowEditing="true" AllowAdding="true" AllowDeleting="true" Mode="Syncfusion.Blazor.Grids.EditMode.Batch"> </GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="Syncfusion.Blazor.Grids.ColumnType.DateOnly" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderTime) HeaderText="Order Time" Type="Syncfusion.Blazor.Grids.ColumnType.TimeOnly" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="color.Mode" HeaderText="Shipping Color" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    public List<Order> Orders { get; set; }
    SfGrid<Order> Grid;
    SfFixture fixture { get; set; }

    public async Task EnumColumnAdd(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var btn = fixture.GetFragment<SfButton>();
        btn.FindAll(".e-btn").ElementAt(0).Click();
        var content = cut.FindAll(".e-gridcontent")[0].QuerySelectorAll("tr");
        Assert.True(content[0].QuerySelectorAll("td")[4].TextContent == "Red");
    }
    private Task AddRow()
    {
        var order = new Order
            {
                Freight = 123,
                OrderID = 100,
                color = new ShippingDetails
                {
                    Mode = FavouriteColour.Red,
                }

            };
        return Grid.AddRecordAsync(order);
    }

    public List<Order> GetAllRecords()
    {
        var modes = Enum.GetValues<FavouriteColour>();

        Orders = Enumerable.Range(1, 10).Select(x => new Order()
            {
                OrderID = 1000 + x,
                Freight = 2.1 * x,
                OrderDate = new DateOnly(2023, 2, x),
                OrderTime = new TimeOnly(x, 00),
                color = new ShippingDetails
                {
                    Mode = x % 2 == 0 ? FavouriteColour.Blue : FavouriteColour.Green,
                }
            }).ToList();
        return Orders;
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public DateOnly? OrderDate { get; set; }
        public TimeOnly? OrderTime { get; set; }
        public double? Freight { get; set; }
        public ShippingDetails color { get; set; }
    }

    public class ShippingDetails
    {
        public FavouriteColour Mode { get; set; }
    }

    public enum FavouriteColour : byte
    {
        Blue = (byte)'B',
        Green = (byte)'G',
        Red = (byte)'R',
        Yellow = (byte)'Y',
    }
}
