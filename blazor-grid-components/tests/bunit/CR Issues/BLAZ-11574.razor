@inherits GridTestBase

<SfFixture @ref="fixture" Test="ComplexForeignRendering" Description="Predicate generate with different ForeignKey field and column field name">
    <ComponentUnderTest>
        <SfGrid TValue="EmployeeData"
                @ref="Grid"
                AllowSorting="true"
                AllowResizing="true"
                AllowReordering="true"
                AllowPaging="true"
                AllowGrouping="true"
                AllowFiltering="true"
                AllowSelection="true"
                EnablePersistence="false"
                Toolbar="@Toolbar" DataSource="@GenerateOrdersData()">
            <GridPageSettings PageSize="3" />
            <GridColumns>
                <GridColumn Field="Id" HeaderText="Id" IsPrimaryKey="true" IsIdentity="true" Visible="false" ShowInColumnChooser="false" />

                <GridForeignColumn Field="Name.FirstName"
                                   ForeignKeyField="Id" ForeignKeyValue="Nam" TValue="Emp" ForeignDataSource="@GenerateEmpData()">
                </GridForeignColumn>

                <GridColumn Field="Name.Text" Type="ColumnType.String" />
            </GridColumns>
        </SfGrid>

    </ComponentUnderTest>
</SfFixture>


@code
  {
    SfFixture fixture { get; set; }
    SfGrid<EmployeeData> Grid { get; set; }
    public object Toolbar { get; set; } = new List<object>() { "Add", "Edit", "Delete", "Cancel", "Update" };

    public static List<EmployeeData> order = new List<EmployeeData>();
    public static List<Emp> empData = new List<Emp>();

    public void ComplexForeignRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeData>>();
        cut.WaitForState(() => Grid.Rows.Count > 0);
        Assert.True(Grid.CurrentViewData.Count() == 3, "Grid rendered properly");
        
    }

    public List<EmployeeData> GenerateOrdersData()
    {
        if (order.Count == 0)
        {
            order = Enumerable.Range(1, 9).Select(x => new EmployeeData()
            {
                Id = x,
                Name = new EmployeeName()
                {
                    FirstName = x,
                    Text = (new string[] { "ALFKI", "VINET", "BLONP", "BOLID", "WELLI" })[new Random().Next(5)],
                },
                Title = (new string[] { "Sales Representative", "Vice President, Sales", "Sales Manager",
                                          "Inside Sales Coordinator" })[new Random().Next(4)],
            }).ToList();
        }
        return order;
    }

    public List<Emp> GenerateEmpData()
    {
        if (empData.Count == 0)
        {
            empData = Enumerable.Range(1, 9).Select(x => new Emp()
            {
                Id = x,
                Nam = (new string[] { "Nancy", "Andrew", "Janet", "Margaret", "Steven" })[new Random().Next(5)],
            }).ToList();
        }
        return empData;
    }

    public class EmployeeData
    {
        public int? Id { get; set; }
        public EmployeeName Name { get; set; }
        public string Title { get; set; }
    }

    public class EmployeeName
    {
        public int FirstName { get; set; }
        public Emp LastName { get; set; }
        public string Text { get; set; }
    }

    public class Emp
    {
        public int Id { get; set; }
        public string Nam { get; set; }
    }
}
