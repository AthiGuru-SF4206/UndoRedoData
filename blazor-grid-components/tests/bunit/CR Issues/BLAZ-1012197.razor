@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Inputs

<SfFixture @ref="fixture" TestAsync="GridSearchWithPartialNullValues" Description="Search functionality with nested complex object properties containing partial null values">
    <ComponentUnderTest>
        <SfGrid @ref="EmployeeGrid" DataSource="@GetAllRecords()" AllowFiltering="true" Height="315" Toolbar="@(new List<string> { "Search" })">
            <GridSearchSettings Operator="Operator.Contains"></GridSearchSettings>
            <GridColumns>
                <GridColumn Field="@nameof(EmployeeData.EmployeeID)" HeaderText="EmployeeID" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="Name.FirstName" HeaderText="First Name" Width="150"></GridColumn>
                <GridColumn Field="Name.LastName" HeaderText="Last Name" Width="130"></GridColumn>
                <GridColumn Field="@nameof(EmployeeData.Title)" HeaderText="Title" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="Details.Position" HeaderText="Position" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    private SfGrid<EmployeeData> EmployeeGrid;
    public static List<EmployeeData> Employees { get; set; }
    bool _canAssert = false;

    public static List<EmployeeData> GetAllRecords()
    {
        Random rand = new Random();
        Employees = Enumerable.Range(1, 100).Select(x => new EmployeeData()
        {
            EmployeeID = x,
            Name = new EmployeeName()
            {
                FirstName = (new string[] { "Nancy", "Andrew", "Janet", "Margaret", "Steven" })[rand.Next(5)],
                LastName = (new string[] { "Davolio", "Fuller", "Leverling", "Peacock", "Buchanan" })[rand.Next(5)]
            },
            Title = (new string[] { "Sales Representative", "Vice President, Sales", "Sales Manager", "Inside Sales Coordinator" })[rand.Next(4)],
            Details = rand.Next(2) == 0 ? null : new EmployeeDetails() 
            { 
                Position = rand.Next(2) == 0 ? null : new EmployeePosition() 
                { 
                    Title = "Test",
                    EmployeeRole = new Role() { RoleTitle = "TestRole" }
                } 
            }
        }).ToList();
        return Employees;
    }

    async Task GridSearchWithPartialNullValues(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeData>>();
        _canAssert = true;

        // Verify initial state - all 100 rows should be visible
        Assert.True(100 == cut.Instance.CurrentViewData.Count(), "Initial data loaded properly with 100 employees");

        // Test 1: Search by FirstName - should work even with null Details
        await cut.Instance.SearchAsync("Nancy");
        await Task.Delay(100); // Small delay for search to process

        var nancyCount = cut.Instance.CurrentViewData.Count();
        Assert.True(nancyCount > 0, "Search for 'Nancy' returns matching records even with partial null values in Details");

        // Verify all filtered data contains "Nancy" in FirstName
        var nancyRecords = cut.Instance.CurrentViewData.Cast<EmployeeData>().ToList();
        Assert.True(nancyRecords.All(r => r.Name.FirstName == "Nancy"), "All filtered records have 'Nancy' as FirstName");

        // Test 2: Search by LastName - should work with null Details
        await cut.Instance.SearchAsync("Fuller");
        await Task.Delay(100);

        var fullerCount = cut.Instance.CurrentViewData.Count();
        Assert.True(fullerCount > 0, "Search for 'Fuller' returns matching records");

        var fullerRecords = cut.Instance.CurrentViewData.Cast<EmployeeData>().ToList();
        Assert.True(fullerRecords.All(r => r.Name.LastName == "Fuller"), "All filtered records have 'Fuller' as LastName");

        // Test 3: Search by Title - should work with null Details
        await cut.Instance.SearchAsync("Sales Manager");
        await Task.Delay(100);

        var salesManagerCount = cut.Instance.CurrentViewData.Count();
        Assert.True(salesManagerCount > 0, "Search for 'Sales Manager' returns matching records");

        var salesRecords = cut.Instance.CurrentViewData.Cast<EmployeeData>().ToList();
        Assert.True(salesRecords.All(r => r.Title == "Sales Manager"), "All filtered records have 'Sales Manager' as Title");

        // Test 4: Verify DOM elements are rendered correctly after search
        var rows = cut.FindAll(".e-row");
        Assert.True(rows.Count >= salesManagerCount, "Correct number of rows rendered in DOM");

        // Test 5: Clear search - should show all records again
        await cut.Instance.SearchAsync("");
        await Task.Delay(100);

        Assert.True(100 == cut.Instance.CurrentViewData.Count(), "After clearing search, all 100 records are visible again");

        // Test 6: Search with multiple null values in Details
        var recordsWithNullDetails = Employees.Where(e => e.Details == null).Count();
        Assert.True(recordsWithNullDetails > 0, "Test data contains records with null Details");

        var recordsWithNullPosition = Employees.Where(e => e.Details != null && e.Details.Position == null).Count();
        Assert.True(recordsWithNullPosition >= 0, "Test data correctly handles null Position values");

        // Test 7: Search by Position.Title for records that have non-null Details
        await cut.Instance.SearchAsync("Test");
        await Task.Delay(100);

        var testPositionCount = cut.Instance.CurrentViewData.Count();
        // Should return records with Position.Title = "Test" or Title = "Inside Sales Coordinator" or "Sales Representative" etc
        Assert.True(testPositionCount >= 0, "Search handles records with partial null values in complex properties");
    }

    public class EmployeeData
    {
        public int? EmployeeID { get; set; }
        public EmployeeName Name { get; set; }
        public string Title { get; set; }
        public EmployeeDetails Details { get; set; }
    }

    public class EmployeeName
    {
        public string FirstName { get; set; }
        public string LastName { get; set; }
    }

    public class EmployeeDetails
    {
        public EmployeePosition Position { get; set; }
    }

    public class EmployeePosition
    {
        public string Title { get; set; }
        public Role EmployeeRole { get; set; }

        public override string ToString()
        {
            return Title;
        }
    }

    public class Role
    {
        public string RoleTitle { get; set; }
    }
}
