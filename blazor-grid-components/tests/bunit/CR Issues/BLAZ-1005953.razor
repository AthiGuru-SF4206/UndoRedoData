@inherits GridTestBase

@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" Test="GridBasicRendering6" Description="Virtualization Column Reordering then row drag and drop">
    <ComponentUnderTest>
        <SfGrid DataSource="@GetVirtualData()" ID="DestGrid" RowHeight="38" Height="410" OverscanCount="5" Width="700" EnableHover="false" EnableVirtualization="true"
                EnableVirtualMaskRow="true" EnableColumnVirtualization="true"
                AllowGrouping AllowSorting AllowFiltering AllowReordering AllowRowDragAndDrop AllowResizing ShowColumnChooser
                Toolbar="@(new List<string>() { "Add", "Delete", "Update", "Cancel", "Search", "Indent", "Outdent", "ColumnChooser" })">
            <GridPageSettings PageSize="40"></GridPageSettings>
            <GridSelectionSettings PersistSelection Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridEditSettings AllowAdding AllowDeleting AllowEditing NewRowPosition="NewRowPosition.Bottom" Mode="Syncfusion.Blazor.Grids.EditMode.Normal"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(TaskDetails.TaskID) HeaderText="TaskID" Uid="Task1" IsPrimaryKey TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Engineer) HeaderText="Engineer" Uid="Task2" Width="150"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Designation) HeaderText="Designation" Uid="Task3" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
