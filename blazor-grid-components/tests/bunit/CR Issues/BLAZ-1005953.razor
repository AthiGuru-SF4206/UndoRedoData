                <GridColumn Field=@nameof(TaskDetails.Status4) HeaderText="Status4" Width="150"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Status5) HeaderText="Status5" Width="150"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Status6) HeaderText="Status6" Width="150"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Status7) HeaderText="Status7" Width="150"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Status8) HeaderText="Status8" Width="150"></GridColumn>
                <GridColumn Field=@nameof(TaskDetails.Status9) HeaderText="Status9" Width="150"></GridColumn>
