@inherits GridTestBase
@using System.Diagnostics
@using Syncfusion.Blazor.Grids
@using System.Dynamic;

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="SortComparer must not take more than 2000ms for 10k records">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateRecords()" AllowFiltering="true" AllowSorting="true" EnableVirtualization="true" AllowGrouping="true">
            <GridEvents OnActionComplete="OnActionCompleteHandler" OnActionBegin="OnActionBeginHandler" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=CustomerID SortComparer="new CustomExpandoComparer()" HeaderText="Customer Name" Width="120">
                    <Template>
                        @{
                            dynamic? value = context as Order;
                        }
                        <span>Customer Id: @value?.CustomerID</span>
                    </Template>
                </GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=ShipCountry HeaderText="ShipCountry" Format="C2" Width="100"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> Orders { get; set; }
    private Stopwatch _actionStopwatch = new();
    private List<ActionLogEntry> ActionLog { get; set; } = new();
    private string _currentRequestType = "";
    public void OnActionBeginHandler(ActionEventArgs<Order> args)
    {
        _currentRequestType = args.RequestType.ToString();
        _actionStopwatch.Restart();
    }

    public void OnActionCompleteHandler(ActionEventArgs<Order> args)
    {
        _actionStopwatch.Stop();
        ActionLog.Add(new ActionLogEntry
        {
            Index = ActionLog.Count + 1,
            RequestType = args.RequestType.ToString(),
            DurationMs = _actionStopwatch.Elapsed.TotalMilliseconds
        });
    }

    public List<Order> GenerateRecords()
    {
        Orders = Enumerable.Range(1, 10000).Select((x) =>
        {
            Order d = new Order();
            d.OrderID = 1000 + x;
            d.CustomerID = x % 2 == 0 ? "ALFKI1" : x % 5 == 0 ? "ANANTR2" : x % 11 == 0 ? "ANTON3" : "BOLID4";
            d.Freight = Math.Round((2.3 * x), 2);
            d.OrderDate = x % 2 == 0 ? new DateTime(2010, 11, 5) : x % 5 == 0 ? new DateTime(2018, 10, 3) : x % 11 == 0 ? new DateTime(1995, 9, 9) : new DateTime(2012, 8, 2);
            return d;
        }).Cast<Order>().ToList<Order>();
        return Orders;
    }

    public void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.Instance.SortColumnAsync("CustomerID", SortDirection.Descending, true).GetAwaiter();
        Assert.True(cut.Instance.SortSettings.Columns.Count() == 1);
        if(_currentRequestType == "Sorting" && ActionLog.Count > 0)
        {
            Assert.True(ActionLog[0].DurationMs < 2000, "Time not exceeds 150ms for sorting 10k records");
        }
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
    
    private record ActionLogEntry
    {
        public int Index { get; init; }
        public string RequestType { get; init; }
        public double DurationMs { get; init; }
    }
    public class CustomExpandoComparer : IComparer<Object>
    {
        public int Compare(object XRowDataToCompare, object YRowDataToCompare)
        {
            dynamic? XRowData = XRowDataToCompare as Order;
            dynamic? YRowData = YRowDataToCompare as Order;

            if (XRowData is null || YRowData is null)
            {
                return 0;
            }

            string XRowDataCN = (string)XRowData!.CustomerID;
            string YRowDataCN = (string)YRowData!.CustomerID;

            var xDigit = Int16.Parse("" + XRowDataCN.Last());
            var yDigit = Int16.Parse("" + YRowDataCN.Last());

            if (xDigit < yDigit)
            {
                return -1;
            }
            else if (xDigit > yDigit)
            {
                return 1;
            }
            else
            {
                return 0;
            }
        }
    }
}
