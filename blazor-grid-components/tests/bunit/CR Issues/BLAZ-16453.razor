@inherits GridTestBase

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Need to prevent column validating when Required property is defined as false">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateRows()" Height="315" AllowPaging="true" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules { Required = true })" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="120" ValidationRules="@(new ValidationRules { Required = false })"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" EditType="EditType.DatePickerEdit" Format="d" TextAlign="TextAlign.Right" Width="130" Type="ColumnType.Date"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" ValidationRules="@(new ValidationRules { Min = 10, Max = 100 })" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> GridData { get; set; }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.TotalItemCount > 0);
        Order addRecord = new Order()
        {
            OrderID = 1100,
            Freight = 25.7,
            OrderDate = new DateTime(2010, 5, 1)
        };
        await cut.Instance.AddRecordAsync(addRecord);
        await cut.Instance.EndEditAsync();
        Assert.True(cut.Instance.TotalItemCount > 75);
    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 75).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }
}