                order.Add(new OrderDetails(10255, "Genève", 9, 2, 48.33));
                order.Add(new OrderDetails(10256, "Resende", 3, 3, 13.97));
                order.Add(new OrderDetails(10257, "San Cristóbal", 4, 1, 81.91));
                order.Add(new OrderDetails(10258, "Graz", 1, 2, 40.51));
                order.Add(new OrderDetails(10259, "México D.F.", 4, 3, 3.25));
                order.Add(new OrderDetails(10260, "Köln", 4, 1, 55.09));
                order.Add(new OrderDetails(10261, "Rio de Janeiro", 4, 2, 3.05));
                order.Add(new OrderDetails(10262, "Albuquerque", 8, 3, 48.29));
            }
            return order;
        }

        public int OrderID { get; set; }
        public string ShipCity { get; set; }
        public int EmployeeID { get; set; }
        public int CustomerID { get; set; }
        public double Freight { get; set; }
    }

