                order.Add(new OrderDetails(10250, "Rio de Janeiro", 4, 3, 65.83));
                order.Add(new OrderDetails(10251, "Lyon", 3, 1, 41.34));
                order.Add(new OrderDetails(10252, "Charleroi", 4, 2, 51.3));
