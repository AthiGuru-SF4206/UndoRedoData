@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using System.Collections.Generic
@using System.Linq
@inherits GridTestBase

<!-- Test Case 1: SearchQuery with Foreign Key Column (Int) -->
<SfFixture @ref="fixture1" TestAsync="ForeignKeySearchQueryTest" Description="SearchQuery with Foreign Key Column Test">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="@Orders" Height="315" AllowSearching="true">
            <GridSearchSettings Fields="@SearchFields" Key="@SearchKey" IgnoreCase="true"></GridSearchSettings>
            <GridColumns>
                <GridColumn Field=@nameof(OrderDetails.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120" AllowSearching="true"></GridColumn>
                <GridForeignColumn Field=@nameof(OrderDetails.EmployeeID) HeaderText="Employee Name" ForeignKeyValue="FirstName" ForeignDataSource="@Employees" Width="150" AllowSearching="true"></GridForeignColumn>
                <GridColumn Field=@nameof(OrderDetails.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderDetails.ShipCity) HeaderText="Ship City" TextAlign="TextAlign.Right" Width="120" AllowSearching="true"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

<!-- Test Case 2: SearchQuery with Foreign Key Column (UInt) -->
<SfFixture @ref="fixture2" TestAsync="ForeignKeySearchQueryUIntTest" Description="SearchQuery with Foreign Key Column UInt Test">
    <ComponentUnderTest>
        <SfGrid @ref="Grid2" DataSource="@UIntOrders" Height="315" AllowSearching="true">
            <GridSearchSettings Fields="@SearchFields" Key="@SearchKey" IgnoreCase="true"></GridSearchSettings>
            <GridColumns>
                <GridColumn Field=@nameof(UIntOrderDetails.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120" AllowSearching="true"></GridColumn>
                <GridForeignColumn Field=@nameof(UIntOrderDetails.EmployeeID) HeaderText="Employee ID" ForeignKeyValue="EmployeeID" ForeignDataSource="@UIntEmployees" Width="150" AllowSearching="true"></GridForeignColumn>
                <GridColumn Field=@nameof(UIntOrderDetails.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(UIntOrderDetails.ShipCity) HeaderText="Ship City" TextAlign="TextAlign.Right" Width="120" AllowSearching="true"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

<!-- Test Case 3: SearchQuery with Foreign Key Column (Double) -->
<SfFixture @ref="fixture3" TestAsync="ForeignKeySearchQueryDoubleTest" Description="SearchQuery with Foreign Key Column Double Test">
    <ComponentUnderTest>
        <SfGrid @ref="Grid3" DataSource="@DoubleOrders" Height="315" AllowSearching="true">
            <GridSearchSettings Fields="@SearchFields" Key="@SearchKey" IgnoreCase="true"></GridSearchSettings>
            <GridColumns>
                <GridColumn Field=@nameof(DoubleOrderDetails.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120" AllowSearching="true"></GridColumn>
                <GridForeignColumn Field=@nameof(DoubleOrderDetails.ProductPrice) HeaderText="Product Price" ForeignKeyValue="ProductPrice" ForeignDataSource="@DoubleProducts" Width="150" AllowSearching="true"></GridForeignColumn>
                <GridColumn Field=@nameof(DoubleOrderDetails.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(DoubleOrderDetails.ShipCity) HeaderText="Ship City" TextAlign="TextAlign.Right" Width="120" AllowSearching="true"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture1 { get; set; }
    SfFixture fixture2 { get; set; }
    SfFixture fixture3 { get; set; }

    private SfGrid<OrderDetails> Grid { get; set; }
    private SfGrid<UIntOrderDetails> Grid2 { get; set; }
    private SfGrid<DoubleOrderDetails> Grid3 { get; set; }

    private List<OrderDetails> Orders { get; set; } = new();
    private List<EmployeeDetails> Employees { get; set; } = new();
    private List<UIntOrderDetails> UIntOrders { get; set; } = new();
    private List<UIntEmployeeDetails> UIntEmployees { get; set; } = new();
    private List<DoubleOrderDetails> DoubleOrders { get; set; } = new();
    private List<DoubleProductDetails> DoubleProducts { get; set; } = new();

    private string SearchKey { get; set; } = "Nancy";
    private string[] SearchFields { get; set; } = new[] { "OrderID", "EmployeeID", "ShipCity" };

    // Test Method 1: Int Foreign Key
    async Task ForeignKeySearchQueryTest(Fixture fixture)
    {
        if (Orders.Count == 0)
            Orders = OrderDetails.GetAllRecords();
        if (Employees.Count == 0)
            Employees = EmployeeDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();
        Assert.NotNull(cut);
        Assert.NotNull(Grid);

        // Call SearchQuery with Query object and set ODataV4Adaptor
        var query = new Query();
        Grid.SearchSettings.Key = "5";
        Grid.DataManager.Adaptor = Adaptors.ODataV4Adaptor;
        Grid.DataModule.SearchQuery(query);
        Grid.ColumnQueryMode = ColumnQueryModeType.ExcludeHidden;
        Grid.DataModule.GenerateQuery();
        Assert.NotNull(Grid);
    }

    // Test Method 2: UInt Foreign Key
    async Task ForeignKeySearchQueryUIntTest(Fixture fixture)
    {
        if (UIntOrders.Count == 0)
            UIntOrders = UIntOrderDetails.GetAllRecords();
        if (UIntEmployees.Count == 0)
            UIntEmployees = UIntEmployeeDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<UIntOrderDetails>>();
        Assert.NotNull(cut);
        Assert.NotNull(Grid2);

        // Call SearchQuery with Query object - uint type and set ODataV4Adaptor
        var query = new Query();
        Grid2.SearchSettings.Key = "3";
        Grid2.DataManager.Adaptor = Adaptors.ODataV4Adaptor;
        Grid2.DataModule.SearchQuery(query);
        Grid2.ColumnQueryMode = ColumnQueryModeType.Schema;
        Grid2.DataModule.GenerateQuery();
        Assert.NotNull(Grid2);
    }

    // Test Method 3: Double Foreign Key
    async Task ForeignKeySearchQueryDoubleTest(Fixture fixture)
    {
        if (DoubleOrders.Count == 0)
            DoubleOrders = DoubleOrderDetails.GetAllRecords();
        if (DoubleProducts.Count == 0)
            DoubleProducts = DoubleProductDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<DoubleOrderDetails>>();
        Assert.NotNull(cut);
        Assert.NotNull(Grid3);

        // Call SearchQuery with Query object - double type and set ODataV4Adaptor
        var query = new Query();
        Grid3.SearchSettings.Key = "29.95";
        Grid3.DataManager.Adaptor = Adaptors.ODataV4Adaptor;
        Grid3.DataModule.SearchQuery(query);
        Assert.NotNull(Grid3);
    }

