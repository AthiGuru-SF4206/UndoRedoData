        if (Employees.Count == 0)
            Employees = EmployeeDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();
        await Grid5.ExportToPdfAsync();
        Assert.NotNull(Grid5);
    }

    async Task ForeignKeyColumnAllExportsSequentialTest(Fixture fixture)
    {        if (Orders.Count == 0)
            Orders = OrderDetails.GetAllRecords();
        if (Employees.Count == 0)
            Employees = EmployeeDetails.GetAllRecords();
        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();
        await Grid6.ExportToExcelAsync();
        await Grid6.ExportToCsvAsync();
        await Grid6.ExportToPdfAsync();
        Assert.NotNull(Grid6);
