    // Test Methods
    void ForeignKeyColumnGridInitializationTest(Fixture fixture)
    {
        if (Orders.Count == 0)
            Orders = OrderDetails.GetAllRecords();
        if (Employees.Count == 0)
            Employees = EmployeeDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();
        Assert.NotNull(cut);
        Assert.NotNull(Grid);
    }

    void ForeignKeyColumnDataBindingTest(Fixture fixture)
    {
        if (Orders.Count == 0)
            Orders = OrderDetails.GetAllRecords();
        if (Employees.Count == 0)
            Employees = EmployeeDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();
        Assert.NotEmpty(Orders);
        Assert.Equal(15, Orders.Count);
        Assert.NotEmpty(Employees);
        Assert.Equal(9, Employees.Count);
    }

    async Task ForeignKeyColumnExcelExportTest(Fixture fixture)
    {
        if (Orders.Count == 0)
            Orders = OrderDetails.GetAllRecords();
        if (Employees.Count == 0)
            Employees = EmployeeDetails.GetAllRecords();

        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();
        await Grid3.ExportToExcelAsync();
        Assert.NotNull(Grid3);
    }

    async Task ForeignKeyColumnCsvExportTest(Fixture fixture)
