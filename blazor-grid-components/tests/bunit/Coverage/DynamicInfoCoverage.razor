<!-- Test 1: CanWrite Property -->
<SfFixture @ref="fixtureCanWrite" Test="DynamicInfo_CanWrite" Description="DynamicInfo - CanWrite property override">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" Height="315">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer ID" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureCanWrite { get; set; }

    public void DynamicInfo_CanWrite(Fixture fixture)
    {
        var result = DynamicInfoFixture.TestCanWrite();
        Assert.True(result, "CanWrite property should return true");
    }
}

