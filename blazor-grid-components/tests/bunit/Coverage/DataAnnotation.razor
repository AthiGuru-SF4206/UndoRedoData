<SfFixture @ref="fixture17" Test="ExpandoObjectExclusionFromComplexIdentifier" Description="Test ExpandoObject exclusion from complex field identifier logic">
    <ComponentUnderTest>
        <SfGrid DataSource="@ExpandoExclusionData" Height="315" AllowSorting="true" @ref="Grid17"
                Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Dialog"></GridEditSettings>
            <GridColumns>
                <GridColumn Field="ID" HeaderText="ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="Name" HeaderText="Name" Width="150"></GridColumn>
                <GridColumn Field="Metadata.CreatedBy" HeaderText="Created By" Width="150"></GridColumn>
                <GridColumn Field="Metadata.CreatedDate" HeaderText="Created Date" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture17 { get; set; }
    SfGrid<ExpandoObject> Grid17;
    List<ExpandoObject> ExpandoExclusionData { get; set; }

    public async void ExpandoObjectExclusionFromComplexIdentifier(Fixture fixture)
    {

        ExpandoExclusionData = new List<ExpandoObject>();
        
        for (int i = 1; i <= 2; i++)
        {
            dynamic record = new ExpandoObject();
            record.ID = i;
            record.Name = $"Record {i}";
            
            dynamic metadata = new ExpandoObject();
            metadata.CreatedBy = $"User{i}";
            metadata.CreatedDate = DateTime.Now.AddDays(-i).ToString("yyyy-MM-dd");
            
            record.Metadata = metadata;
            ExpandoExclusionData.Add(record);
        }
        
        var cut = fixture.GetComponentUnderTest<SfGrid<ExpandoObject>>();

        await cut.Instance.SelectRowAsync(0);
        await cut.Instance.StartEditAsync();
        cut.WaitForState(() => cut.Instance.IsEdit, TimeSpan.FromSeconds(2));

        Assert.True(cut.Instance.IsEdit, "Grid should be in edit mode");

        await cut.Instance.EndEditAsync();
        
        Assert.True(true, "ExpandoObject correctly excluded from complex field identifier logic");
    }
}

