@* Common codes *@
@code
{
    private async Task TriggerContextMenuOnHeader(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(async () =>
        {
            var headerCell = cut.FindAll(".e-headercell").FirstOrDefault();
            if (headerCell != null)
            {
                var cellUid = headerCell.GetAttribute("data-uid");
                
                cut.Instance._jsAdaptor.MouseDownHandler("Header", cellUid, null, null);
                await Task.Delay(100);
                
                var contextMenuComponent = cut.FindComponent<SfContextMenu<MenuItem>>();
                if (contextMenuComponent != null)
                {
                    await contextMenuComponent.Instance.OpenAsync(50, 50);
                }
            }
        });
    }

    private async Task TriggerContextMenuOnContent(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(async () =>
        {
            await cut.Instance.SelectRowAsync(0);
            await Task.Delay(50);
            var contentCell = cut.FindAll(".e-rowcell").FirstOrDefault();
            if (contentCell != null)
            {
                var cellUid = contentCell.GetAttribute("data-uid");
                cut.Instance._jsAdaptor.MouseDownHandler("Content", cellUid, null, null);
                await Task.Delay(100);
                var contextMenuComponent = cut.FindComponent<SfContextMenu<MenuItem>>();
                if (contextMenuComponent != null)
                {
                    await contextMenuComponent.Instance.OpenAsync(50, 50);
                }
            }
        });
    }
    
    private async Task TriggerContextMenuOnPager(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(async () =>
        {
            var pagerElement = cut.FindAll(".e-pager").FirstOrDefault();
            if (pagerElement != null)
            {
                cut.Instance._jsAdaptor.MouseDownHandler("Pager", null, null, null);
                await Task.Delay(100);
                
                var contextMenuComponent = cut.FindComponent<SfContextMenu<MenuItem>>();
                if (contextMenuComponent != null)
                {
                    await contextMenuComponent.Instance.OpenAsync(50, 50);
                }
            }
        });
    }

    private async Task CloseContextMenu(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(async () =>
        {
            var contextMenuComponent = cut.FindComponent<SfContextMenu<MenuItem>>();
            if (contextMenuComponent != null)
            {
                await contextMenuComponent.Instance.CloseMenuAsync();
            }
        });
    }
}
