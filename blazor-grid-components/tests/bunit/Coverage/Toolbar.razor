@inherits GridTestBase
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons


<!-- FIXTURE 1: ToolbarItem type - Executes dictionary creation, key generation, and ClickHandler path -->
<SfFixture @ref="fixtureToolbar1"
           Test="GridToolbar_ToolbarItemType"
           Description="GridToolbar_ToolbarItem for mobile">
    <ComponentUnderTest>
        <SfGrid @ref="toolbarGrid1" DataSource="GenerateOrderData()" 
                Toolbar="@toolbarItemsWithDelegate"
                EnableAdaptiveUI="true" AdaptiveUIMode="AdaptiveMode.Both" RowRenderingMode="RowDirection.Vertical" AllowSorting="true" AllowFiltering="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureToolbar1 { get; set; }
    private SfGrid<Order> toolbarGrid1;
    
    private List<object> toolbarItemsWithDelegate => new List<object>
    {
        new ToolbarItem 
        { 
            Id = "custom_toolbar_delegate",
            Text = "Custom Action",
            PrefixIcon = "e-icons e-edit",
            TooltipText = "Custom Tooltip",
            CssClass = "custom-class",
            Disabled = false,
            SuffixIcon = "e-icons e-arrow",
            Type = ItemType.Button,
            Visible = true,
            Width = "100px",
            Overflow = OverflowOption.Show,
            ShowAlwaysInPopup = false,
            TabIndex = 0
        }
    };

    public void GridToolbar_ToolbarItemType(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.NotNull(grid);
        Assert.NotNull(grid.Toolbar);
        Assert.True(cut.FindAll(".e-row").Count > 0, "Data rows must be rendered");
        
        // Verify grid structure - indicates else block code execution
        Assert.True(grid.EnableAdaptiveUI, "EnableAdaptiveUI must be true (indicates else if block entered)");
        Assert.Equal(AdaptiveMode.Both, grid.AdaptiveUIMode);
    }
}

