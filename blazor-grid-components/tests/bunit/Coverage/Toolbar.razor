<!-- FIXTURE 4: ToolbarItem type - Executes dictionary creation, key generation, and ClickHandler path -->
<SfFixture @ref="fixtureToolbar4"
           Test="GridToolbar_KeyDownHandler"
           Description="GridToolbar_KeyDownHandler">
    <ComponentUnderTest>
        <SfGrid @ref="toolbarGrid4" DataSource="GenerateOrderData()"
                Toolbar="@(new List<string>() { "Search" })" EnableAdaptiveUI="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureToolbar4 { get; set; }
    private SfGrid<Order> toolbarGrid4;

    public void GridToolbar_KeyDownHandler(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.NotNull(grid);
        Assert.NotNull(grid.Toolbar);
        Assert.True(cut.FindAll(".e-row").Count > 0, "Data rows must be rendered");
        var searchInput = cut.FindAll(".e-searchinput")[0];
        searchInput.Input("");
        searchInput.KeyDown(new KeyboardEventArgs() { Key = "Escape" });
        searchInput.Input("1001");
        searchInput.KeyDown(new KeyboardEventArgs() { Key = "Enter" });
        var clearIcon = cut.FindAll(".e-clear-icon")[0];
        clearIcon.KeyDown(new KeyboardEventArgs() { Key = "Enter" });
        searchInput.Input("1001");
        cut.FindAll(".e-searchclear")[0].Click();
        searchInput.Focus();
        searchInput.Blur();
    }
}

