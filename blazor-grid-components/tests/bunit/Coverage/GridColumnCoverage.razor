    /// </summary>
    public async Task GridParent_InternalProperty_CanBeSetAndRetrieved(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        // Technique 1: Direct component property access
        if (refColumn != null)
        {
            // Access GridParent property via reflection (since it's internal)
            var gridParentProperty = refColumn.GetType().GetProperty("GridParent",
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);

            if (gridParentProperty != null)
            {
                // Set a test parent object
                var testParent = new object();
                gridParentProperty.SetValue(refColumn, testParent);

                // Get the value back
                var retrievedParent = gridParentProperty.GetValue(refColumn);

                // Assert: Retrieved value should match set value
                Assert.NotNull(retrievedParent);
                Assert.Same(testParent, retrievedParent);
            }
        }
    }

