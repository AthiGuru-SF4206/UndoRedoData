        return new List<GroupingOrderData>
        {
            new GroupingOrderData(10248, "VINET", 32.38, "Reims", "Vins et alcools Chevalier", "France"),
            new GroupingOrderData(10249, "TOMSP", 11.61, "Münster", "Toms Spezialitäten", "Germany"),
            new GroupingOrderData(10250, "HANAR", 65.83, "Rio de Janeiro", "Hanari Carnes", "Brazil"),
            new GroupingOrderData(10251, "VICTE", 41.34, "Lyon", "Victuailles en stock", "France"),
            new GroupingOrderData(10252, "SUPRD", 51.3, "Charleroi", "Suprêmes délices", "Belgium"),
            new GroupingOrderData(10253, "HANAR", 58.17, "Rio de Janeiro", "Hanari Carnes", "Brazil"),
            new GroupingOrderData(10254, "CHOPS", 22.98, "Bern", "Chop-suey Chinese", "Switzerland"),
            new GroupingOrderData(10255, "RICSU", 148.33, "Genève", "Richter Supermarkt", "Switzerland"),
            new GroupingOrderData(10256, "WELLI", 13.97, "Resende", "Wellington Import Export", "Brazil"),
            new GroupingOrderData(10257, "HILAA", 81.91, "San Cristóbal", "Hila Alimentos", "Venezuela"),
            new GroupingOrderData(10258, "ERNSH", 140.51, "Graz", "Ernst Handel", "Austria"),
            new GroupingOrderData(10259, "CENTC", 3.25, "México D.F.", "Centro comercial", "Mexico"),
            new GroupingOrderData(10260, "OTTIK", 55.09, "Köln", "Ottilies Käseladen", "Germany"),
            new GroupingOrderData(10261, "QUEDE", 3.05, "Rio de Janeiro", "Que delícia", "Brazil"),
            new GroupingOrderData(10262, "RATTC", 48.29, "Albuquerque", "Rattlesnake Canyon Grocery", "USA")
        };
    }

    // ==================== MODEL CLASS ====================
    
    /// <summary>
    /// Order data model for grouping export testing
    /// </summary>
    public class GroupingOrderData
    {
        public int OrderID { get; set; }
        public string CustomerID { get; set; }
        public double Freight { get; set; }
        public string ShipCity { get; set; }
        public string ShipName { get; set; }
        public string ShipCountry { get; set; }

        public GroupingOrderData()
        {
        }

        public GroupingOrderData(int orderID, string customerID, double freight, string shipCity, string shipName, string shipCountry)
        {
            this.OrderID = orderID;
            this.CustomerID = customerID;
            this.Freight = freight;
            this.ShipCity = shipCity;
            this.ShipName = shipName;
            this.ShipCountry = shipCountry;
        }
    }
}
