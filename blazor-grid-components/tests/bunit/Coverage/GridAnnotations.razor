        var data = new List<ExpandoObject>();
        data.Add(CreateExpandoObject("Name", "John", "Age", 25, "Department", "IT"));
        data.Add(CreateExpandoObject("Name", "Jane", "Age", 30, "Department", "HR"));
        return data;
    }

