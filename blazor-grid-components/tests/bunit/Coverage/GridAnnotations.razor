    // ============ MODEL CLASSES ============

    /// <summary>
    /// Simple model class (not ExpandoObject or DynamicObject)
    /// </summary>
    public class SimpleData
    {
        public string Name { get; set; }
        public int Age { get; set; }
    }

    /// <summary>
    /// Custom DynamicObject for testing
    /// Inherits from DynamicObject to trigger isDynamicObjectType == true condition
    /// </summary>
    public class DynamicTestObject : DynamicObject
    {
        private Dictionary<string, object> _properties = new Dictionary<string, object>();

        public string FirstName
        {
            get => _properties.ContainsKey("FirstName") ? _properties["FirstName"].ToString() : null;
            set => _properties["FirstName"] = value;
        }

        public string LastName
        {
            get => _properties.ContainsKey("LastName") ? _properties["LastName"].ToString() : null;
            set => _properties["LastName"] = value;
        }

        public int Age
        {
            get => _properties.ContainsKey("Age") ? (int)_properties["Age"] : 0;
            set => _properties["Age"] = value;
        }

        public override IEnumerable<string> GetDynamicMemberNames()
        {
            return _properties.Keys;
        }

        public override bool TryGetMember(GetMemberBinder binder, out object result)
        {
            return _properties.TryGetValue(binder.Name, out result);
        }

        public override bool TrySetMember(SetMemberBinder binder, object value)
        {
            _properties[binder.Name] = value;
            return true;
        }
    }

    /// <summary>
    /// Model class with comprehensive annotations for MapAnnotation foreach branch testing
    /// Covers all branches inside the foreach loop in MapAnnotation method
    /// </summary>
    public class AnnotatedData
    {
        /// <summary>
        /// PRIMARY KEY - tests: if (meta.IsPrimaryKey) branch
        /// Also tests: if (meta.Validations != null) branch with Required attribute
        /// </summary>
        [Key]
        [Required(ErrorMessage = "Id is required")]
        public int Id { get; set; }

        /// <summary>
        /// IDENTITY COLUMN - tests: if (meta.IsIdentity) branch
        /// </summary>
        [DatabaseGenerated(DatabaseGeneratedOption.Identity)]
        public int EmployeeId { get; set; }

        /// <summary>
        /// READONLY FIELD - tests AllowEditing negation in foreach
        /// </summary>
        [ReadOnly(true)]
        public string ReadOnlyField { get; set; }

        /// <summary>
        /// HIDDEN COLUMN - tests: if (!meta.Visible) branch
        /// </summary>
        [Display(Name = "Hidden Info", AutoGenerateField = false, Order = 10)]
        public string HiddenColumn { get; set; }

        /// <summary>
        /// FORMAT STRING - tests: if (!string.IsNullOrEmpty(meta.FormatString)) branch
        /// </summary>
        [DataType(DataType.Currency)]
        [Display(Name = "Salary", Order = 5)]
        public decimal Salary { get; set; }

        /// <summary>
        /// AUTO GENERATE FALSE - tests: if (meta?.AutoGenerateField != true) continue; branch
        /// This property should be SKIPPED and not added to columns
        /// </summary>
        [Display(AutoGenerateField = false)]
        public string SkipThisField { get; set; }

        /// <summary>
        /// REQUIRED WITH MESSAGE - tests: if (meta.Validations.TryGetValue("messages", out object? messages)) branch
        /// </summary>
        [Required(ErrorMessage = "Name is mandatory")]
        [StringLength(100, ErrorMessage = "Name cannot exceed 100 characters")]
        [Display(Name = "Employee Name", Order = 1)]
        public string Name { get; set; }

        /// <summary>
        /// VALIDATION RULES - tests: if (meta.Validations != null && meta.Validations.Count != 0) branch
        /// </summary>
        [EmailAddress(ErrorMessage = "Invalid email address")]
        [Display(Name = "Email Address", Order = 2)]
        public string Email { get; set; }

        /// <summary>
        /// RANGE VALIDATION - tests multiple validations on single property
        /// </summary>
        [Range(18, 70, ErrorMessage = "Age must be between 18 and 70")]
        [Required(ErrorMessage = "Age is required")]
        [Display(Name = "Employee Age", Order = 3)]
        public int Age { get; set; }

        /// <summary>
        /// REGULAR FIELD - tests basic PropertyChanges method behavior
        /// </summary>
        [Display(Name = "Department", Order = 4)]
        public string Department { get; set; }

        /// <summary>
        /// INTERNAL/HIDDEN FIELD - tests: if (!meta.Visible) branch
        /// Explicitly marked as not visible but auto-generated (to bypass the continue statement)
        /// </summary>
        [Display(Name = "Internal Code", Order = 6)]
        public string InternalCode { get; set; }

        /// <summary>
        /// DATE FIELD WITH FORMAT - tests: if (!string.IsNullOrEmpty(meta.FormatString)) branch
        /// Uses DataType to potentially set FormatString in metadata
        /// </summary>
        [DataType(DataType.Date)]
        [Display(Name = "Hire Date", Order = 7, Description = "yyyy-MM-dd")]
        [DisplayFormat(DataFormatString = "{0:dd/MM/yyyy}")]
        public DateTime HireDate { get; set; }

        /// <summary>
        /// PHONE FIELD - tests additional FormatString scenarios
        /// </summary>
        [Phone(ErrorMessage = "Invalid phone number")]
        [Display(Name = "Phone Number", Order = 8)]
        public string PhoneNumber { get; set; }
    }
