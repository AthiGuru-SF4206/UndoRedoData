    /// <summary>
    /// Helper: Create ExpandoObject with dynamic properties
    /// </summary>
    private ExpandoObject CreateExpandoObject(params object[] keyValuePairs)
    {
        dynamic expando = new ExpandoObject();
        var dictionary = (IDictionary<string, object>)expando;

        for (int i = 0; i < keyValuePairs.Length; i += 2)
        {
            dictionary[keyValuePairs[i].ToString()] = keyValuePairs[i + 1];
        }

        return expando;
    }

