<SfFixture @ref="fixture4" TestAsync="GridBasicRendering4" Description="ColumnMenu with Custom ColumnMenuItemModel">
    <ComponentUnderTest>
        <SfGrid @ref="Grid4" DataSource="GenerateRows()" AllowSorting="true" AllowGrouping=true AllowPaging=true ShowColumnMenu=true ColumnMenuItems=@MenuItems4>
            <GridGroupSettings ShowGroupedColumn=true></GridGroupSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
            <GridEvents OnColumnMenuOpen="ColumnMenuOpenHandler4" ColumnMenuItemClicked="ColumnMenuClickHandler4" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
