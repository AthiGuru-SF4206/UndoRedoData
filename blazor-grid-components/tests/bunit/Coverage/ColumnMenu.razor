@code
{
    SfFixture fixture2 { get; set; }
    private SfGrid<Order> Grid2;
    private string[] MenuItems2 = new string[] { "SortAscending", "SortDescending", "AutoFit", "AutoFitAll", "ColumnChooser", "Filter", "Group", "Ungroup" };
    private bool preventColumnMenuRendering2 { get; set; }

    public async Task GridBasicRendering2(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");

        preventColumnMenuRendering2 = false;
        await ClickAllItemsOfColumnMenu2(cut);
        await ColumnChooserItemCheckbox2(cut);
        preventColumnMenuRendering2 = true;
        await ClickSecondColumnMenu2(cut);
    }

    private async Task ClickSecondColumnMenu2(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(() =>
        {
            cut.FindAll(".e-columnmenu")[1].Click(new MouseEventArgs());
        });
        // Wait for dialog to open instead of context menu
        cut.WaitForState(() => cut.FindAll(".e-dialog").Count > 0);
    }

    private async Task ColumnChooserItemCheckbox2(IRenderedComponent<SfGrid<Order>> cut)
    {
        await ClickSecondColumnMenu2(cut);
        
        // Find and click the ColumnChooser (Columns) item in the dialog
        var columnChooserItem = cut.FindAll(".e-responsivecoldiv")
            .FirstOrDefault(div => div.TextContent.Contains("Columns"));
        
        Assert.True(columnChooserItem != null, "Columns menu item found in dialog");
        
        await cut.InvokeAsync(() =>
        {
            columnChooserItem?.Click(new MouseEventArgs());
        });
        
        // Wait for the "Choose Column" dialog to appear with checkboxes
        cut.WaitForState(() => cut.FindAll(".e-checkbox-wrapper").Count > 0, TimeSpan.FromSeconds(2));
        
        var checkboxWrappers = cut.FindAll(".e-checkbox-wrapper");
        var orderDateCheckboxWrapper = checkboxWrappers
            .FirstOrDefault(cb => cb.TextContent.Contains("Order Date"));
        
        Assert.True(orderDateCheckboxWrapper != null, "Order Date checkbox found");
        
        await cut.InvokeAsync(() =>
        {
            var checkboxInput = orderDateCheckboxWrapper?.QuerySelector("input[type='checkbox']") as IElement;
            checkboxInput?.Click(new MouseEventArgs());
            var okButton = cut.FindAll(".e-btn").FirstOrDefault(cb => cb.TextContent.Contains("OK"));
            okButton?.Click(new MouseEventArgs());
        });
        
        cut.WaitForState(() => cut.Instance.Columns?.Any(c => c.Field == "OrderDate" && !c.Visible) == true, TimeSpan.FromSeconds(2));
    }

    private async Task ClickAllItemsOfColumnMenu2(IRenderedComponent<SfGrid<Order>> cut)
    {
        // Map of menu item text to corresponding responsive div class pattern
        string[] MenuItemsAdaptive = new string[] { "Ascending", "Descending", "Autofit this column", "Autofit all columns", "Columns", "Filter", "Group", "Ungroup" };
        
        for (int i = 0; i < MenuItemsAdaptive.Length; i++)
        {
            await ClickSecondColumnMenu2(cut);
            
            // Verify dialog items are rendered
            var dialogItems = cut.FindAll(".e-responsivecoldiv");
            Assert.True(dialogItems.Count > 0, "Dialog menu items are rendered properly.");
            
            // Find the item by text content instead of index
            var menuItem = dialogItems.FirstOrDefault(item => item.TextContent.Contains(MenuItemsAdaptive[i]));
            Assert.True(menuItem != null, $"{MenuItemsAdaptive[i]} menu item found");
            
            await cut.InvokeAsync(() =>
            {
                menuItem?.Click(new MouseEventArgs());
            });
            
            if (i == 0)
            {
                cut.WaitForState(() => cut.FindAll(".e-rowcell")[0].TextContent.Contains("1005"));
                Assert.True((cut.Instance.CurrentViewData.ToList()[0] as Order).OrderID == 1005, "Ascending Order sorting works Properly");
            }
            else if (i == 1)
            {
                cut.WaitForState(() => cut.FindAll(".e-rowcell")[0].TextContent.Contains("1004"));
                Assert.True((cut.Instance.CurrentViewData.ToList()[0] as Order).OrderID == 1004, "Descending Order sorting works Properly");
            }
            else if (i == 6)
            {
                cut.WaitForState(() => cut.FindAll(".e-groupheadercell").Count > 0);
                Assert.True(cut.FindAll(".e-groupheadercell").Count == 1, "Grouping done");
            }
            else if (i == 7)
            {
                cut.WaitForState(() => cut.FindAll(".e-groupheadercell").Count == 0);
                Assert.True(cut.FindAll(".e-groupheadercell").Count == 0, "Ungrouping done");
            }
        }
    }

    public void ColumnMenuOpenHandler2(ColumnMenuOpenEventArgs args)
    {
        if (preventColumnMenuRendering2)
        {
            args.Cancel = true;
            return;
        }
        Assert.True(args.Column.Field == "CustomerID");
    }

    public void ColumnMenuClickHandler2(ColumnMenuClickEventArgs args)
    {
        Assert.True(args.Column.Field == "CustomerID");
    }

}



