</SfFixture>

@code
{
    SfFixture fixture4 { get; set; }
    private SfGrid<Order> Grid4;
    private List<ColumnMenuItemModel> MenuItems4 = new List<ColumnMenuItemModel>()
    {
        new ColumnMenuItemModel { Text = "Clear Sorting", Id = "sort", IconCss = "e-icons e-sort" },
        new ColumnMenuItemModel { Text = "Clear Grouping", Id = "group", IconCss = "e-icons e-group" },
        new ColumnMenuItemModel
        {
            Text = "Hide Grouping",
            Id = "hide-grouping",
            IconCss = "e-icons e-group e-hide",
            Hide = true,
            Separator = false,
            Url = string.Empty,
            Items = null
        }
    };
    private bool preventColumnMenuRendering4 { get; set; }
    private bool clearSortingClicked { get; set; }
    private bool clearGroupingClicked { get; set; }

    public async Task GridBasicRendering4(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");

        preventColumnMenuRendering4 = false;
        await ClickSecondColumnMenu4(cut);
        await ClickCustomMenuItem4(cut, "Clear Sorting");
        Assert.True(clearSortingClicked, "Clear Sorting menu item was clicked");
        
        preventColumnMenuRendering4 = false;
        await ClickSecondColumnMenu4(cut);
        await ClickCustomMenuItem4(cut, "Clear Grouping");
        Assert.True(clearGroupingClicked, "Clear Grouping menu item was clicked");
    }

    private async Task ClickSecondColumnMenu4(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(() =>
        {
            cut.FindAll(".e-columnmenu")[1].Click(new MouseEventArgs());
        });
        cut.WaitForState(() => cut.FindAll(".e-contextmenu").Count == 1);
    }

    private async Task ClickCustomMenuItem4(IRenderedComponent<SfGrid<Order>> cut, string menuItemText)
    {
        
        await cut.InvokeAsync(() =>
        {
            var customMenuItem = cut.FindAll(".e-menu-item")
                .FirstOrDefault(item => item.TextContent.Contains(menuItemText));
        
            Assert.True(customMenuItem != null, $"{menuItemText} custom menu item found");
            customMenuItem?.Click(new MouseEventArgs());
        });
        
        cut.WaitForState(() => true, TimeSpan.FromMilliseconds(500));
    }

    public void ColumnMenuOpenHandler4(ColumnMenuOpenEventArgs args)
    {
        if (preventColumnMenuRendering4)
        {
            args.Cancel = true;
            return;
        }
        Assert.True(args.Column.Field == "CustomerID");
    }

    public void ColumnMenuClickHandler4(ColumnMenuClickEventArgs args)
    {
        Assert.True(args.Column.Field == "CustomerID");
        
        // Handle custom menu item clicks
        if (args.Item.Id == "sort")
        {
            clearSortingClicked = true;
            Grid4.ClearSortingAsync();
        }
        else if (args.Item.Id == "group")
        {
            clearGroupingClicked = true;
            Grid4.ClearGroupingAsync();
        }
    }
}

@code{    
    public List<Order> GridData { get; set; }
    public List<Order> GenerateRows()
    {
        string[] customers = new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" };
        return GridData = Enumerable.Range(1, 30).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = customers[x % customers.Length],
            Freight = 2.1 * x,
            OrderDate = new DateTime(2026,01,01).AddDays(-x),
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}
