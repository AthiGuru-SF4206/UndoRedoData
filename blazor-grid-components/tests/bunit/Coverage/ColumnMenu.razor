@inherits GridTestBase

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="ColumnMenu code coverage">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" AllowSorting="true" AllowGrouping=true AllowPaging=true ShowColumnMenu=true ColumnMenuItems=@MenuItems>
            <GridGroupSettings ShowGroupedColumn=true></GridGroupSettings>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
            <GridEvents OnColumnMenuOpen="ColumnMenuOpenHandler" ColumnMenuItemClicked="ColumnMenuClickHandler" ColumnVisibilityChanged="ColumnVisibilityChangedHandler" 
                        OnActionComplete="ActionCompletedHandler" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    private string[] MenuItems = new string[] { "SortAscending", "SortDescending", "AutoFit", "AutoFitAll", "ColumnChooser", "Filter", "Group", "Ungroup" };


    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");
        await ClickAllItemsOfColumnMenu(cut);

        await ColumnChooserItemCheckbox(cut);

        await ClickSecondColumnMenu(cut);
        await ClickSecondColumnMenu(cut);
        await ColumnChooserItemCheckbox(cut, true);
    }


    private async Task ClickAllItemsOfColumnMenu(IRenderedComponent<SfGrid<Order>> cut)
    {
        for (int i = 0; i < MenuItems.Length; i++)
        {
            await ClickSecondColumnMenu(cut);
            Assert.True(cut.FindAll(".e-menu-item").Count == 8, "Column menu items are rendered properly.");
            await cut.InvokeAsync(() =>
            {
                cut.FindAll(".e-menu-item")[i].Click(new MouseEventArgs());
            });
            if (i == 0)
            {
                cut.WaitForState(() => cut.FindAll(".e-rowcell")[0].TextContent.Contains("1005"));
                Assert.True((cut.Instance.CurrentViewData.ToList()[0] as Order).OrderID == 1005, "Ascending Order sorting works Properly");
            }
            else if (i == 1)
            {
                cut.WaitForState(() => cut.FindAll(".e-rowcell")[0].TextContent.Contains("1004"));
                Assert.True((cut.Instance.CurrentViewData.ToList()[0] as Order).OrderID == 1004, "Descending Order sorting works Properly");
            }
            else if (i == 6)
            {
                cut.WaitForState(() => cut.FindAll(".e-groupheadercell").Count > 0);
                Assert.True(cut.FindAll(".e-groupheadercell").Count == 1, "Grouping done");
            }
            else if (i == 7)
            {
                cut.WaitForState(() => cut.FindAll(".e-groupheadercell").Count == 0);
                Assert.True(cut.FindAll(".e-groupheadercell").Count == 0, "Ungrouping done");
            }
        }
    }

    private async Task ClickSecondColumnMenu(IRenderedComponent<SfGrid<Order>> cut)
    {
        await cut.InvokeAsync(() =>
        {
            cut.FindAll(".e-columnmenu")[1].Click(new MouseEventArgs());
        });
        cut.WaitForState(() => cut.FindAll(".e-contextmenu").Count == 1);
    }

    private async Task ColumnChooserItemCheckbox(IRenderedComponent<SfGrid<Order>> cut, bool show = false)
    {
        await ClickSecondColumnMenu(cut);
        await cut.InvokeAsync(() =>
        {
            var columnChooserMenuItem = cut.FindAll(".e-menu-item")[4];
            var mouseoverArgs = new MouseEventArgs
            {
                Type = "mouseover",
                Buttons = 0
            };
            columnChooserMenuItem?.TriggerEvent("onmouseover", mouseoverArgs);
        });

        // Wait for submenu to appear with checkboxes
        cut.WaitForState(() => cut.FindAll(".e-checkbox-wrapper").Count > 0);

        var checkboxWrappers = cut.FindAll(".e-checkbox-wrapper");
        var orderDateCheckboxWrapper = checkboxWrappers
            .FirstOrDefault(cb => cb.TextContent.Contains("Order Date"));

        Assert.True(orderDateCheckboxWrapper != null, "Order Date checkbox found");

        await cut.InvokeAsync(() =>
        {
            var checkboxInput = orderDateCheckboxWrapper?.QuerySelector("input[type='checkbox']") as IElement;
            checkboxInput?.Click(new MouseEventArgs());
        });
        if (show)
        {
            cut.WaitForState(() => cut.Instance.Columns?.Any(c => c.Field == "OrderDate" && c.Visible) == true, TimeSpan.FromSeconds(2));
        }
        else
        {
            cut.WaitForState(() => cut.Instance.Columns?.Any(c => c.Field == "OrderDate" && !c.Visible) == true, TimeSpan.FromSeconds(2));
        }
    }

    public void ColumnMenuOpenHandler(ColumnMenuOpenEventArgs args)
    {
        Assert.True(args.Column.Field == "CustomerID");
    }

    public void ColumnMenuClickHandler(ColumnMenuClickEventArgs args)
    {
        Assert.True(args.Column.Field == "CustomerID");
    }

    public void ColumnVisibilityChangedHandler(ColumnVisibilityChangedEventArgs args)
    {}
    public void ActionCompletedHandler(ActionEventArgs<Order> args)
    {}
}




