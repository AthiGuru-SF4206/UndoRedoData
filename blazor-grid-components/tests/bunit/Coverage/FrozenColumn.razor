<SfFixture @ref="fixture88"
           Test="SetStackedFixed_AllMovable_LastChildSavedCorrectly"
           Description="SetStackedFixed_AllMovable_Branch3_LastChild_Coverage">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowPaging="true" FrozenColumns="1">
            <GridColumns>
                <GridColumn HeaderText="Info">
                    <GridColumns>
                        <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                        <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="C2"></GridColumn>
                        <GridColumn Field="@nameof(Order.ShipCity)" Width="150"></GridColumn>
                    </GridColumns>
                </GridColumn>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture88 { get; set; }

    public async void SetStackedFixed_AllMovable_LastChildSavedCorrectly(Fixture fixture)
    {
        var cut = fixture88.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.True(grid.IsStackedHeader, "IsStackedHeader should be true");

        var fixedFreezeHeaders = cut.FindAll("th.e-fixedfreeze");
        Assert.True(fixedFreezeHeaders.Count == 0,
            "No Fixed-frozen columns → no e-fixedfreeze class should appear (pure Movable branch path)");

        var headerRows = cut.FindAll("thead tr");
        Assert.True(headerRows.Count >= 2, "Stacked header must produce at least 2 header rows");

        Assert.True(cut.FindAll(".e-row").Count > 0, "Data rows must be present");

        await Task.CompletedTask;
    }
}