@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Tests
@using System.Threading.Tasks

<SfFixture @ref="fixture82"
           Test="FrozenRight_WithGroup_ShowGroupedColumnFalse_ShouldApplyFreezeRightBorder"
           Description="RightFreeze_Group_ShowGroupedColumnFalse_FreezeRightBorder">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowGrouping="true" AllowPaging="true">
            <GridGroupSettings Columns="@(new string[] { "CustomerID" })" ShowGroupedColumn="false"></GridGroupSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="C2"></GridColumn>
                <GridColumn Field="@nameof(Order.ShipCity)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150" IsFrozen="true" Freeze="FreezeDirection.Right"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture82 { get; set; }

    public async void FrozenRight_WithGroup_ShowGroupedColumnFalse_ShouldApplyFreezeRightBorder(Fixture fixture)
    {
        var cut = fixture82.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.True(grid.GroupSettings.Columns.Length == 1, "One column should be grouped");
        Assert.False(grid.GroupSettings.ShowGroupedColumn, "ShowGroupedColumn should be false");

        var frozenRightCols = grid.Columns
            .Where(c => c.IsFrozen && c.Freeze == FreezeDirection.Right && c.Visible)
            .ToList();
        Assert.True(frozenRightCols.Count == 1, "One right-frozen column should exist");
        Assert.Equal("OrderID", frozenRightCols[0].Field);

        var frozenRightHeaders = cut.FindAll("th.e-rightfreeze");
        Assert.True(frozenRightHeaders.Count > 0, "At least one header cell should have e-rightfreeze class");

        var firstRightFreezeHeader = frozenRightHeaders[0];
        Assert.True(
            firstRightFreezeHeader.ClassList.Contains("e-freezerightborder"),
            "First right-frozen header must have e-freezerightborder when grouped column (CustomerID) != frozen column (OrderID) and ShowGroupedColumn=false");

        await Task.CompletedTask;
    }
}

