<SfFixture @ref="fixture84"
           Test="FrozenRight_WithoutGrouping_ShouldApplyCorrectClasses"
           Description="RightFreeze_NoGrouping_CorrectClasses">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="C2"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150" IsFrozen="true" Freeze="FreezeDirection.Right"></GridColumn>
                <GridColumn Field="@nameof(Order.ShipCity)" Width="150" IsFrozen="true" Freeze="FreezeDirection.Right"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture84 { get; set; }

    public async void FrozenRight_WithoutGrouping_ShouldApplyCorrectClasses(Fixture fixture)
    {
        var cut = fixture84.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.True(grid.GroupSettings.Columns == null || grid.GroupSettings.Columns.Length == 0,
            "No grouping should be active");

        var frozenRightCols = grid.Columns
            .Where(c => c.IsFrozen && c.Freeze == FreezeDirection.Right && c.Visible)
            .ToList();
        Assert.True(frozenRightCols.Count == 2, "Two right-frozen columns should exist");

        var frozenRightHeaders = cut.FindAll("th.e-rightfreeze");
        Assert.True(frozenRightHeaders.Count >= 2, "Both right-frozen header cells should have e-rightfreeze");

        Assert.True(
            frozenRightHeaders[0].ClassList.Contains("e-freezerightborder"),
            "First right-frozen header must have e-freezerightborder (no-grouping path)");
        Assert.False(
            frozenRightHeaders[1].ClassList.Contains("e-freezerightborder"),
            "Non-first right-frozen header must NOT have e-freezerightborder when there is no grouping");

        await Task.CompletedTask;
    }
}

