@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Grids.Internal
@using Syncfusion.Blazor.Tests
@using System.Threading.Tasks

<SfFixture @ref="fixtureAutoFit1"
           TestAsync="AutoFitColumnsAsync_NoParam_SetsIsAutoFitEnabled"
           Description="AutoFitColumnsAsync_NoParam_SetsAutoFitFlag">
    <ComponentUnderTest>
        <SfGrid @ref="autoFitGrid1" DataSource="GenerateOrderData()">
            <EventRegisterAsync Name="DummyEvent" Handler="DummyHandler" T="Order"></EventRegisterAsync>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)"    Width="150" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150" HeaderText="Customer ID"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)"    Width="150" HeaderText="Freight" Format="C2"></GridColumn>
                <GridColumn Field="@nameof(Order.ShipCity)"   Width="150" HeaderText="Ship City"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureAutoFit1 { get; set; }
    private SfGrid<Order> autoFitGrid1;
    async Task DummyHandler(Task incomingTask, object args)
    {
        
    }
    public async Task AutoFitColumnsAsync_NoParam_SetsIsAutoFitEnabled(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.False(grid.IsAutoFitEnabled, "IsAutoFitEnabled should be false before calling AutoFitColumnsAsync()");

        await grid.AutoFitColumnsAsync();

        Assert.True(grid.IsAutoFitEnabled, "IsAutoFitEnabled must be set to true after AutoFitColumnsAsync()");

        Assert.True(cut.FindAll(".e-row").Count > 0, "Data rows must still be present after AutoFitColumnsAsync()");

        var cols = await grid.GetColumnsAsync();
        Assert.True(cols.Count == 4, "All 4 columns must still be present after AutoFitColumnsAsync()");
    }
}

<SfFixture @ref="fixtureAutoFit2"
           TestAsync="AutoFitColumnsAsync_WithFields_NoPersistence_SetsAutoFitFlagOnly"
           Description="AutoFitColumnsAsync_Fields_NoPersistence_Branch">
    <ComponentUnderTest>
        <SfGrid @ref="autoFitGrid2" DataSource="GenerateOrderData()">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)"    Width="150" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150" HeaderText="Customer ID"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)"    Width="150" HeaderText="Freight" Format="C2"></GridColumn>
                <GridColumn Field="@nameof(Order.ShipCity)"   Width="150" HeaderText="Ship City"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureAutoFit2 { get; set; }
    private SfGrid<Order> autoFitGrid2;

    public async Task AutoFitColumnsAsync_WithFields_NoPersistence_SetsAutoFitFlagOnly(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        Assert.False(grid.EnablePersistence, "EnablePersistence should be false by default");

        string[] fieldsToFit = { nameof(Order.OrderID), nameof(Order.CustomerID) };

        await grid.AutoFitColumnsAsync(fieldsToFit);

        Assert.True(grid.IsAutoFitEnabled,
            "IsAutoFitEnabled must be true after AutoFitColumnsAsync(string[]) without persistence");

        var cols = await grid.GetColumnsAsync();
        Assert.True(cols.All(c => !c.IsPersistAutoFit),
            "IsPersistAutoFit must remain false on all columns when EnablePersistence=false (Branch NP)");

        Assert.True(cut.FindAll(".e-row").Count > 0, "Data rows must still be rendered after AutoFitColumnsAsync()");
    }
}

