@inherits GridTestBase

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Grids
@using System.IO

<SfFixture @ref="fixture" TestAsync="GridGroupingWithExportAutoSpan1" Description="Grid with 6 columns, grouping 4 columns using GroupColumnAsync, autospan horizontal and vertical, Excel and PDF export">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" ID="Grid" DataSource="ProductData.GetAllRecords()" Toolbar="@(new List<string>() { "ExcelExport", "PdfExport" })" AllowExcelExport="true" AllowPdfExport="true" AllowGrouping="true" Height="450px" AutoSpan="AutoSpanMode.HorizontalAndVertical">
            <GridGroupSettings>
                <GridGroupSettingsColumns>
                    <GridGroupSettingsColumn Field="Category"></GridGroupSettingsColumn>
                    <GridGroupSettingsColumn Field="Status"></GridGroupSettingsColumn>
                    <GridGroupSettingsColumn Field="Offers"></GridGroupSettingsColumn>
                    <GridGroupSettingsColumn Field="Available"></GridGroupSettingsColumn>
                </GridGroupSettingsColumns>
            </GridGroupSettings>
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field=@nameof(ProductData.Cost) Type="AggregateType.Sum">
                            <GroupCaptionTemplate>
                                @{
                                    var aggregate = (context as AggregateTemplateContext);
                                    <div style="font-weight: bold; color: #0a76ff;">
                                        <p>Total Cost: @aggregate.Sum</p>
                                    </div>
                                }
                            </GroupCaptionTemplate>
                        </GridAggregateColumn>
                        <GridAggregateColumn Field=@nameof(ProductData.Available) Type="AggregateType.Max">
                            <GroupCaptionTemplate>
                                @{
                                    var aggregate = (context as AggregateTemplateContext);
                                    <div style="font-weight: bold; color: #FF6600;">
                                        <p>Max Available: @aggregate.Max</p>
                                    </div>
                                }
                            </GroupCaptionTemplate>
                        </GridAggregateColumn>
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
            <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="ProductData"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(ProductData.Category) HeaderText="Category" Width="120"></GridColumn>
                <GridColumn Field=@nameof(ProductData.ProductID) HeaderText="Product ID" Width="130"></GridColumn>
                <GridColumn Field=@nameof(ProductData.Status) HeaderText="Status" Width="110"></GridColumn>
                <GridColumn Field=@nameof(ProductData.Offers) HeaderText="Offers" Width="100"></GridColumn>
                <GridColumn Field=@nameof(ProductData.Available) HeaderText="Available" Width="100"></GridColumn>
                <GridColumn Field=@nameof(ProductData.Cost) HeaderText="Cost" Width="100"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    private SfFixture fixture;
    private SfGrid<ProductData> Grid;

    public async Task GridGroupingWithExportAutoSpan1(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<ProductData>>();
        Assert.True(cut.Instance.TotalItemCount == 20, "All the records are rendered.");

        // Group 4 columns using GroupColumnAsync method
        await cut.Instance.GroupColumnAsync("Category");
        await cut.Instance.GroupColumnAsync("Status");
        await cut.Instance.GroupColumnAsync("Offers");
        await cut.Instance.GroupColumnAsync("Available");

        // Export to Excel with grouping
        ExcelExportProperties excelExportProperties = new ExcelExportProperties();

        await cut.Instance.ExportToExcelAsync(excelExportProperties);

        // Export to PDF with grouping
        PdfExportProperties pdfExportProperties = new PdfExportProperties();
     
        await cut.Instance.ExportToPdfAsync(pdfExportProperties);

        Assert.True(true, "Grid exported successfully with grouping, autospan horizontal and vertical mode");
    }

    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (args.Item.Id == "Grid_excelexport")
        {
            // Conditional logic: Check if grid has data before export
           
                ExcelExportProperties excelExportProperties = new ExcelExportProperties();
             
                await Grid.ExportToExcelAsync(excelExportProperties);
            
        }
        if (args.Item.Id == "Grid_pdfexport")
        {
         
                PdfExportProperties pdfExportProperties = new PdfExportProperties();
               
                await Grid.ExportToPdfAsync(pdfExportProperties);
            
        }
    }

