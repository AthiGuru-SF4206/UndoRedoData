@inherits GridTestBase

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Grids
@using Syncfusion.ExcelExport
@using Syncfusion.Blazor.Grids.Internal

<SfFixture @ref="fixture" TestAsync="PdfTextStyleFontCoverage" Description="PdfTextStyle Property Coverage - Font Property">
    <ComponentUnderTest>
        <SfGrid ID="Grid1" @ref="Grid1" DataSource="GenerateRows()" AllowSelection="true" Toolbar="@(new List<string>() { "PdfExport" })" AllowPdfExport="true">
            <GridEvents OnPdfExport="PdfExportHandler" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid1;
    public List<Order> GridData { get; set; }

    public async Task PdfTextStyleFontCoverage(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");

        // Test Case 1: PdfTextStyle with Font property
        PdfTextStyle textStyle1 = new PdfTextStyle();
        
        // Configure Font property of PdfTextStyle
        textStyle1.Font = new PdfGridFont() 
        { 
            FontFamily = "Arial", 
            FontSize = 14, 
            FontStyle = PdfExport.PdfFontStyle.Bold, 
            IsTrueType = true
        };

        // Assert Font property
        Assert.True(textStyle1.Font != null, "PdfTextStyle.Font should be assigned");
        Assert.True(textStyle1.Font.FontFamily == "Arial", "Font Family should be Arial");
        Assert.True(textStyle1.Font.FontSize == 14, "Font Size should be 14");
        Assert.True(textStyle1.Font.FontStyle == PdfExport.PdfFontStyle.Bold, "Font Style should be Bold");
        Assert.True(textStyle1.Font.IsTrueType == true, "IsTrueType should be true");

        // Test Case 2: Multiple PdfTextStyle instances with different fonts
        PdfTextStyle textStyle2 = new PdfTextStyle();
        textStyle2.Font = new PdfGridFont() 
        { 
            FontFamily = "Times New Roman", 
            FontSize = 12, 
            FontStyle = PdfExport.PdfFontStyle.Regular, 
            IsTrueType = false
        };

        Assert.True(textStyle2.Font.FontFamily == "Times New Roman", "Second style Font Family should be Times New Roman");
        Assert.True(textStyle2.Font.FontSize == 12, "Second style Font Size should be 12");

        // Test Case 3: PdfTextStyle with Italic font
        PdfTextStyle textStyle3 = new PdfTextStyle();
        textStyle3.Font = new PdfGridFont() 
        { 
            FontFamily = "Calibri", 
            FontSize = 13, 
            FontStyle = PdfExport.PdfFontStyle.Italic, 
            IsTrueType = true
        };

        Assert.True(textStyle3.Font.FontFamily == "Calibri", "Third style Font Family should be Calibri");
        Assert.True(textStyle3.Font.FontStyle == PdfExport.PdfFontStyle.Italic, "Font Style should be Italic");

        // Test Case 4: Export without theme to avoid base64 errors
        PdfExportProperties PdfProperties = new PdfExportProperties();
        PdfProperties.FileName = "PdfTextStyleFont.pdf";
        PdfProperties.PageOrientation = Syncfusion.Blazor.Grids.PageOrientation.Portrait;
        PdfProperties.PageSize = PdfPageSize.A4;
        PdfProperties.IncludeHeaderRow = true;
        PdfProperties.ExportType = ExportType.CurrentPage;
        PdfProperties.DataSource = GenerateRows();

        await cut.Instance.ExportToPdfAsync(PdfProperties);
        
        Assert.True(PdfProperties.FileName == "PdfTextStyleFont.pdf", "Export file name should be set correctly");
    }

    public void PdfExportHandler(object args)
    {
        Assert.True(true, "PDF Exported Successfully");
    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 30).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}

