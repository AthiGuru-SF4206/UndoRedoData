@inherits GridTestBase

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Grids
@using System.IO

<SfFixture @ref="fixture" TestAsync="GridGroupingWithCaptionExport" Description="Grid with 6 columns, grouping 4 columns, GroupCaptionTemplate with aggregates, autospan horizontal and vertical, Excel and PDF export with conditional logic">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" ID="Grid" DataSource="OrderData.GetAllRecords()" Toolbar="@(new List<string>() { "ExcelExport", "PdfExport" })" AllowExcelExport="true" AllowPdfExport="true" AllowGrouping="true" Height="450px" AutoSpan="AutoSpanMode.HorizontalAndVertical">
        
            <GridAggregates>
                <GridAggregate>
                    <GridAggregateColumns>
                        <GridAggregateColumn Field=@nameof(OrderData.Freight) Type="AggregateType.Sum">
                            <GroupCaptionTemplate>
                                @{
                                    var aggregate = (context as AggregateTemplateContext);
                                    <div style="font-weight: bold; color: #0a76ff;">
                                        <p>Total Freight: @aggregate.Sum</p>
                                    </div>
                                }
                            </GroupCaptionTemplate>
                        </GridAggregateColumn>
                        
                    </GridAggregateColumns>
                </GridAggregate>
            </GridAggregates>
            <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="OrderData"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(OrderData.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderData.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderData.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.DateOnly" TextAlign="TextAlign.Right" Width="130"></GridColumn>
              
                <GridColumn Field=@nameof(OrderData.ShipCountry) HeaderText="Ship Country" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderData.Status) HeaderText="Status" Width="100"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    private SfFixture fixture;
    private SfGrid<OrderData> Grid;
    private bool isExporting = false;

    public async Task GridGroupingWithCaptionExport(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<OrderData>>();
        Assert.True(cut.Instance.TotalItemCount == 20, "All the records are rendered.");

        // Group 4 columns using GroupColumnAsync method
        await cut.Instance.GroupColumnAsync("ShipCountry");
        await cut.Instance.GroupColumnAsync("CustomerID");
        await cut.Instance.GroupColumnAsync("OrderDate");
        // await cut.Instance.GroupColumnAsync("Freight");

        // Set export flag to enable conditional formatting
        isExporting = true;

        // Export to Excel with grouping and aggregates
       
            ExcelExportProperties excelExportProperties = new ExcelExportProperties();
          
            await cut.Instance.ExportToExcelAsync(excelExportProperties);
       

        // Export to PDF with grouping and aggregates
      
            PdfExportProperties pdfExportProperties = new PdfExportProperties();
          
            await cut.Instance.ExportToPdfAsync(pdfExportProperties);
       

       
        Assert.True(true, "Grid exported successfully with grouping, GroupCaptionTemplate aggregates, and autospan horizontal and vertical mode");
    }

    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        // Conditional logic: Validate data before export
        if (args.Item.Id == "Grid_excelexport")
        {
         
                isExporting = true;
                ExcelExportProperties excelExportProperties = new ExcelExportProperties();
                await Grid.ExportToExcelAsync(excelExportProperties);
                isExporting = false;
            }
      

        if (args.Item.Id == "Grid_pdfexport")
        {
          
                isExporting = true;
                PdfExportProperties pdfExportProperties = new PdfExportProperties();
               
                await Grid.ExportToPdfAsync(pdfExportProperties);
                isExporting = false;
           
        }
    }

