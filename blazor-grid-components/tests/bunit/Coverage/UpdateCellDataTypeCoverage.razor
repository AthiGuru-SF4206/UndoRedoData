@code {
    SfFixture fixture { get; set; }
    private SfGrid<TestDataModel> GridRef;

    public async Task UpdateCellDataTypeCoverageTest(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<TestDataModel>>();

        await cut.Instance.ExportToCsvAsync();

        await cut.Instance.ExportToExcelAsync();

        await cut.Instance.ExportToPdfAsync();
        // ==================== STRING TYPE ====================
        await cut.Instance._jsAdaptor.UpdateCell(0, "StringField", "UpdatedString");

        // ==================== BOOLEAN TYPES ====================
        // Non-nullable bool: true
        await cut.Instance._jsAdaptor.UpdateCell(0, "BoolField", "true");

        // Non-nullable bool: false
        await cut.Instance._jsAdaptor.UpdateCell(0, "BoolField", "false");

        // Nullable bool: true
        await cut.Instance._jsAdaptor.UpdateCell(0, "NullableBoolField", "true");

        // Nullable bool: false
        await cut.Instance._jsAdaptor.UpdateCell(0, "NullableBoolField", "false");

        // ==================== INTEGER TYPES ====================
        // Non-nullable int
        await cut.Instance._jsAdaptor.UpdateCell(1, "IntField", "42");

        // Nullable int
        await cut.Instance._jsAdaptor.UpdateCell(1, "NullableIntField", "100");

        // ==================== LONG TYPES ====================
        // Non-nullable long
        await cut.Instance._jsAdaptor.UpdateCell(2, "LongField", "9223372036854775");

        // Nullable long
        await cut.Instance._jsAdaptor.UpdateCell(2, "NullableLongField", "1234567890");

        // ==================== DOUBLE TYPE ====================
        await cut.Instance._jsAdaptor.UpdateCell(0, "DoubleField", "150.50");

        // ==================== DATETIME TYPES ====================
        // Non-nullable DateTime with format
        var dateTimeString = DateTime.Now.AddDays(5).ToString("G");
        await cut.Instance._jsAdaptor.UpdateCell(3, "DateTimeField", dateTimeString);

        // Nullable DateTime
        var nullableDateTimeString = DateTime.Now.AddDays(10).ToString("G");
        await cut.Instance._jsAdaptor.UpdateCell(3, "NullableDateTimeField", nullableDateTimeString);

        // ==================== DATETIMEOFFSET TYPES ====================
        // Non-nullable DateTimeOffset
        var dateTimeOffsetString = DateTimeOffset.Now.AddDays(2).ToString("G");
        await cut.Instance._jsAdaptor.UpdateCell(4, "DateTimeOffsetField", dateTimeOffsetString);

        // Nullable DateTimeOffset
        var nullableDateTimeOffsetString = DateTimeOffset.Now.AddDays(3).ToString("G");
        await cut.Instance._jsAdaptor.UpdateCell(4, "NullableDateTimeOffsetField", nullableDateTimeOffsetString);

        // ==================== DATEONLY TYPES ====================
        // Non-nullable DateOnly
        var dateOnlyString = DateOnly.FromDateTime(DateTime.Now.AddDays(7));
        await cut.Instance._jsAdaptor.UpdateCell(5, "DateOnlyField", dateOnlyString.ToString("d"));

        // Nullable DateOnly
        var nullableDateOnlyString = DateOnly.FromDateTime(DateTime.Now.AddDays(8));
        await cut.Instance._jsAdaptor.UpdateCell(5, "NullableDateOnlyField", nullableDateOnlyString.ToString("d"));

        // ==================== TIMEONLY TYPES ====================
        // Non-nullable TimeOnly
        var timeOnlyString = TimeOnly.FromDateTime(DateTime.Now.AddHours(2));
        await cut.Instance._jsAdaptor.UpdateCell(0, "TimeOnlyField", timeOnlyString.ToString("HH:mm:ss"));

        // Nullable TimeOnly
        var nullableTimeOnlyString = TimeOnly.FromDateTime(DateTime.Now.AddHours(3));
        await cut.Instance._jsAdaptor.UpdateCell(0, "NullableTimeOnlyField", nullableTimeOnlyString.ToString("HH:mm:ss"));

        // ==================== GUID TYPES ====================
        var testGuid = Guid.NewGuid();
        await cut.Instance._jsAdaptor.UpdateCell(1, "GuidField", testGuid.ToString());

        // Nullable Guid
        var testNullableGuid = Guid.NewGuid();
        await cut.Instance._jsAdaptor.UpdateCell(1, "NullableGuidField", testNullableGuid.ToString());

        // ==================== CHARACTER TYPE ====================
        await cut.Instance._jsAdaptor.UpdateCell(2, "CharField", "X");

        // ==================== ENUM TYPE ====================
        // Enum: Active
        await cut.Instance._jsAdaptor.UpdateCell(3, "EnumField", "Active");

        // Enum: Inactive
        await cut.Instance._jsAdaptor.UpdateCell(3, "EnumField", "Inactive");

        // Enum: Pending
        await cut.Instance._jsAdaptor.UpdateCell(3, "EnumField", "Pending");

        // ==================== EDGE CASES ====================
        // Test invalid conversions are handled gracefully
        await cut.Instance._jsAdaptor.UpdateCell(1, "IntField", "notanumber");
        
        // Test empty/null values
        await cut.Instance._jsAdaptor.UpdateCell(0, "NullableIntField", "");
    }

