@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Grids.Internal
@using System.ComponentModel.DataAnnotations


<SfFixture @ref="fixture2" Test="Test_BatchSaveLostChanges_CancelButton_ClosesDialog"
           Description="Verify that clicking Cancel button with BatchSaveLostChanges alert closes dialog without performing batch actions">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" @ref="grid2" Toolbar="@(new List<string>() { "Add", "Delete", "Update", "Cancel" })" AllowPaging="true">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" ShowConfirmDialog="true" Mode="EditMode.Batch"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture2 { get; set; }
    public SfGrid<Order> grid2 { get; set; }
    
    public async void Test_BatchSaveLostChanges_CancelButton_ClosesDialog(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        cut.WaitForState(() => cut.Instance.Rows.Count > 0, TimeSpan.FromMilliseconds(2000));
        
        await cut.Instance.EditModule.UpdateCopyCell(0, nameof(Order.Freight), "50.5");
        
        cut.Instance.EditModule.AlertMessage = "BatchSaveLostChanges";
        cut.Render();
        
        cut.WaitForState(() => cut.FindAll(".e-dlg-modal").Count > 0, TimeSpan.FromMilliseconds(1000));
        

        var cancelButtons = cut.FindAll(".e-btn.e-lib.e-flat").Where(b => !b.ClassList.Contains("e-primary")).ToList();
        Assert.True(cancelButtons.Count > 0, "Cancel button should be present");

        cancelButtons[0].Click();

        cut.WaitForState(() => string.IsNullOrEmpty(cut.Instance.EditModule.AlertMessage), TimeSpan.FromMilliseconds(1000));
        
        Assert.True(string.IsNullOrEmpty(cut.Instance.EditModule.AlertMessage), "AlertMessage should be cleared after Cancel click");
    }
}

