<SfFixture @ref="fixtureGetColorReflection"
           Test="GetColor_ViaReflection_ReturnsExpectedColor"
           Description="GetColor – private method invoked via reflection returns correct Color">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" @ref="gridGetColorReflection">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer ID" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureGetColorReflection { get; set; }
    SfGrid<Order> gridGetColorReflection { get; set; }

    public void GetColor_ViaReflection_ReturnsExpectedColor(Fixture fixture)
    {
        // Arrange – resolve the private static method via reflection
        var methodInfo = typeof(ExportHelper<Order>)
            .GetMethod("GetColor", BindingFlags.NonPublic | BindingFlags.Static);

        Assert.NotNull(methodInfo);

        // Act
        var resultRed   = (Color)methodInfo.Invoke(null, new object[] { "Red" });
        var resultBlue  = (Color)methodInfo.Invoke(null, new object[] { "Blue" });
        var resultEmpty = (Color)methodInfo.Invoke(null, new object[] { "UnknownColor" });

        // Assert
        Assert.Equal(Color.FromName("Red"),          resultRed);
        Assert.Equal(Color.FromName("Blue"),         resultBlue);
        Assert.Equal(Color.FromName("UnknownColor"), resultEmpty);   // unknown names return Color.Empty
        Assert.False(resultEmpty.IsKnownColor);
    }
}


