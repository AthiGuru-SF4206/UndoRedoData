<SfFixture @ref="fixtureGetHexValueElseBranch"
           Test="GetHexValueFromColor_WithColorName_ReturnsHexFromArgb"
           Description="GetHexValueFromColor else branch – colour name is converted to its ARGB hex string">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" @ref="gridGetHexValueElseBranch">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer ID" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureGetHexValueElseBranch { get; set; }
    SfGrid<Order> gridGetHexValueElseBranch { get; set; }

    public void GetHexValueFromColor_WithColorName_ReturnsHexFromArgb(Fixture fixture)
    {
        // ── helper: replicates the else-branch logic exactly ──────────
        static string ExpectedHex(string name)
        {
            int argb = Color.FromName(name).ToArgb();
            return string.Format(CultureInfo.InvariantCulture, "{0:x6}", argb);
        }

        // Act – all inputs are plain names, so the else branch is always taken
        string resultRed = ExportHelper<Order>.GetHexValueFromColor("Red");
        string resultBlue = ExportHelper<Order>.GetHexValueFromColor("Blue");
        string resultGreen = ExportHelper<Order>.GetHexValueFromColor("Green");
        string resultBlack = ExportHelper<Order>.GetHexValueFromColor("Black");
        string resultWhite = ExportHelper<Order>.GetHexValueFromColor("White");

        // Assert – returned string must match the ARGB-formatted hex
        Assert.Equal(ExpectedHex("Red"), resultRed);
        Assert.Equal(ExpectedHex("Blue"), resultBlue);
        Assert.Equal(ExpectedHex("Green"), resultGreen);
        Assert.Equal(ExpectedHex("Black"), resultBlack);
        Assert.Equal(ExpectedHex("White"), resultWhite);

        // Additional structural checks
        Assert.NotEmpty(resultRed);
        Assert.NotNull(resultBlue);
    }
}


