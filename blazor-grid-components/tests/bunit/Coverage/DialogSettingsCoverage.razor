@inherits GridTestBase
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Popups

<SfFixture @ref="fixtureDialogHeight" Test="DialogSettings_Height" Description="DialogSettings - Height property">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" @ref="gridDialogHeight" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })" Height="315">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Dialog="@DialogParamsHeight" Mode="EditMode.Dialog"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules { Required = true })" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer ID" ValidationRules="@(new ValidationRules { Required = true })" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCountry) HeaderText="Ship Country" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixtureDialogHeight { get; set; }
    public SfGrid<Order> gridDialogHeight { get; set; }
    public DialogSettings DialogParamsHeight { get; set; } = new DialogSettings { Height = "400px" };

    public async void DialogSettings_Height(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        
        await cut.Instance.SelectRowAsync(0);
        await cut.Instance.StartEditAsync();
        
        cut.WaitForState(() => cut.FindAll(".e-dialog").Count > 0, TimeSpan.FromMilliseconds(1000));
        var dialog = cut.Find(".e-dialog");
        
        Assert.NotNull(dialog);
        Assert.Contains("400px", cut.Instance.EditSettings.Dialog.Height);
    }
}

