@code {
    SfFixture fixtureDialogAllProperties { get; set; }
    public SfGrid<Order> gridDialogAllProperties { get; set; }
    public DialogSettings DialogParamsAllProperties { get; set; } = new DialogSettings 
    { 
        Height = "450px",
        Width = "550px",
        MinHeight = "300px",
        AllowDragging = true,
        ShowCloseIcon = true,
        CloseOnEscape = true,
        EnableResize = true,
        CssClass = "e-custom-dialog",
        Target = null,
        XValue = "50px",
        YValue = "75px",
        AnimationDelay = 100,
        AnimationDuration = 500,
        ZIndex = 1200,
        AnimationEffect = DialogEffect.Fade
    };

    public async void DialogSettings_AllProperties_Combined(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var dialog = cut.Instance.EditSettings.Dialog;
        
        Assert.Equal("450px", dialog.Height);
        Assert.Equal("550px", dialog.Width);
