@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Grids.Internal

<SfFixture @ref="fixture1" TestAsync="GridFilterOperatorComprehensiveTesting" Description="FilterBarParameters with frozen columns">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true" FrozenColumns="2" AllowFreezeLineMoving="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" Format="d" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture1 { get; set; }

    public async Task GridFilterOperatorComprehensiveTesting(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var filterBarMethod = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterBarRenderer<Order>>();
        filterBarMethod.Instance.FilterBarParameters.IsFrozen = true;
        filterBarMethod.Instance.UpdateFilterBarColumns();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.FrozenColumns > 0, "Grid has frozen columns");
    }
}

