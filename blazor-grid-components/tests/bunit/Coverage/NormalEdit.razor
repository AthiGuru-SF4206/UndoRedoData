<SfFixture @ref="fixture3" Test="CommandClickHandler" Description="Record Click event in Command Column">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" @ref="gridRef3" Toolbar="@(new List<string>() { "Edit", "Delete", "Update", "Cancel" })" AllowPaging="true">
            <GridEvents CommandClicked="OnCancelTestCommandClicked2" TValue="Order" OnRecordClick="OnRecordClicked"></GridEvents>
