            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules { Required = true })" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="CustomerID" ValidationRules="@(new ValidationRules { Required = true })" Width="100"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" Width="120"></GridColumn>
                <GridColumn HeaderText="Manage Records">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Cancel" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-close", CssClass = "e-flat" })"></GridCommandColumn>
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture3 { get; set; }
    public SfGrid<Order> gridRef3 { get; set; }

    private async Task OnRecordClicked(RecordClickEventArgs<Order> args)
    {
        await Task.CompletedTask;
    }

    public async void CommandClickHandler(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        // Arrange
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        var editing = new Syncfusion.Blazor.Grids.Internal.NormalEdit<Order>();
        var commandColumn = new GridCommandColumn() { Type = CommandButtonType.Edit };
        var cell = new Cell<object>();
        editing.Parent = cut.Instance;
        Row<object> rowObj = cut.Instance.Rows[0];
        await editing.CommandClickHandler(commandColumn, rowObj, cell);
        var gridForm = cut.Find(".e-gridform");
        Assert.True(gridForm != null, "Grid form should be present after command click");
        var commandColumn2 = new GridCommandColumn() { Type = CommandButtonType.Delete };
        await editing.CommandClickHandler(commandColumn2, rowObj, cell);
        Assert.True(cut.FindAll(".e-gridform").Count() == 0, "Grid form should be removed after delete command click");
    }
}

