        // Custom formatting logic for caption template in Excel export
        // This can be extended based on business requirements
    }

    public async Task OnExportClick()
    {
        if (Grid != null)
        {
            await Grid.ExportToExcelAsync();
            await Grid.ExportToPdfAsync();
        }
    }

