@inherits GridTestBase

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons

<SfFixture @ref="fixture" TestAsync="GroupingCaptionTemplateExportTest" Description="Grid Grouping with Caption Template Export - PDF and Excel with Foreign Key columns and custom caption formatting">
    <ComponentUnderTest>
        <SfButton OnClick="OnExportClick"></SfButton>
        <SfGrid ID="GroupingCaptionTemplateGrid" @ref="Grid" DataSource="@OrderDetails.GetAllRecords()" Height="315" AllowFiltering="true" AllowGrouping="true" AllowExcelExport="true" AllowPdfExport="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridEvents TValue="OrderDetails" ExcelGroupCaptionTemplateInfo="ExcelGroupTemplateHandler"></GridEvents>
            <GridGroupSettings ShowDropArea="false" Columns="@GroupingColumns">
                <CaptionTemplate>
                    @{
                        var data = (context as CaptionTemplateContext);
                        <span>@data.HeaderText - @data.Key : @data.Count Items</span>
                    }
                </CaptionTemplate>
            </GridGroupSettings>
            <GridColumns>
                <GridColumn Field=@nameof(OrderDetails.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120" IsPrimaryKey="true"></GridColumn>
                <GridForeignColumn Field=@nameof(OrderDetails.EmployeeID) HeaderText="Employee Name" ForeignKeyValue="FirstName" ForeignDataSource="@EmployeeDetails.GetAllRecords()" Width="150"></GridForeignColumn>
                <GridColumn Field=@nameof(OrderDetails.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderDetails.ShipCity) HeaderText="Ship City" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture { get; set; }
    private SfGrid<OrderDetails> Grid;
    public string[] GroupingColumns = new string[] { "EmployeeID", "Freight" };

    public async Task GroupingCaptionTemplateExportTest(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<OrderDetails>>();

        // ==================== VERIFY GROUPING SETUP WITH CAPTION TEMPLATE ====================
        Assert.NotNull(cut.Instance.GroupSettings);
        Assert.Equal(2, cut.Instance.GroupSettings.Columns.Length);
        Assert.Contains("EmployeeID", cut.Instance.GroupSettings.Columns);
        Assert.Contains("Freight", cut.Instance.GroupSettings.Columns);

        // ==================== VERIFY DATA SOURCE ====================
        var testOrders = OrderDetails.GetAllRecords();
        Assert.NotEmpty(testOrders);
        Assert.Equal(15, testOrders.Count);

        // ==================== VERIFY GRID PROPERTIES ====================
        Assert.True(cut.Instance.AllowGrouping, "Grouping should be enabled");
        Assert.True(cut.Instance.AllowExcelExport, "Excel export should be enabled");
        Assert.True(cut.Instance.AllowPdfExport, "PDF export should be enabled");
        Assert.True(cut.Instance.AllowFiltering, "Filtering should be enabled");

        // ==================== VERIFY FOREIGN KEY COLUMN ====================
       
      

        // ==================== EXCEL EXPORT WITH CAPTION TEMPLATE ====================
        ExcelExportProperties excelProperties = new ExcelExportProperties();
        ExcelTheme excelTheme = new ExcelTheme();
        ExcelStyle headerStyle = new ExcelStyle()
        {
            FontName = "Segoe UI",
            FontColor = "#000080",
            FontSize = 11,
            BackColor = "#D3D3D3",
            VAlign = ExcelVerticalAlign.Center,
            HAlign = ExcelHorizontalAlign.Center,
            Borders = new Border
            {
                Color = "#5A5A5A",
                LineStyle = Syncfusion.ExcelExport.LineStyle.Medium
            }
        };
        ExcelStyle captionStyle = new ExcelStyle()
        {
            FontName = "Segoe UI",
            FontColor = "#0B6623",
            FontSize = 10,
            BackColor = "#E8F5E9",
            Bold = true,
            VAlign = ExcelVerticalAlign.Center,
            HAlign = ExcelHorizontalAlign.Left,
            Borders = new Border
            {
                Color = "#5A5A5A",
                LineStyle = Syncfusion.ExcelExport.LineStyle.Thin
            }
        };
        excelTheme.Header = headerStyle;
        excelTheme.Caption = captionStyle;
        excelProperties.Theme = excelTheme;

        await cut.Instance.ExportToExcelAsync(excelProperties);

        // ==================== PDF EXPORT WITH CAPTION TEMPLATE ====================
        PdfExportProperties pdfExportProps = new PdfExportProperties
        {
            Theme = new PdfTheme
            {
                Header = new PdfThemeStyle
                {
                    Font = new PdfGridFont { FontFamily = "TimesRoman", FontSize = 11 },
                    FontColor = "#000080",
                    Bold = true,
                    Border = new PdfBorder { Color = "#5A5A5A", DashStyle = PdfDashStyle.Solid }
                },
                Caption = new PdfThemeStyle
                {
                    Font = new PdfGridFont { FontFamily = "TimesRoman", FontSize = 9 },
                    FontColor = "#0B6623",
                    Bold = true,
                    Border = new PdfBorder { Color = "#5A5A5A", DashStyle = PdfDashStyle.Solid }
                },
                Record = new PdfThemeStyle
                {
                    Font = new PdfGridFont { FontFamily = "TimesRoman", FontSize = 10 },
                    FontColor = "#333333",
                    Bold = false,
                    Border = new PdfBorder { Color = "#5A5A5A", DashStyle = PdfDashStyle.Solid }
                }
            }
        };

        await cut.Instance.ExportToPdfAsync(pdfExportProps);

        // ==================== VERIFY GROUPED DATA STRUCTURE ====================
        // Verify that data can be grouped by EmployeeID
        var groupedByEmployee = testOrders.GroupBy(x => x.EmployeeID).ToList();
        Assert.NotEmpty(groupedByEmployee);

        // Verify that each group has freight data
        var groupedByFreight = testOrders.GroupBy(x => x.Freight).ToList();
        Assert.NotEmpty(groupedByFreight);

        // ==================== VERIFY CAPTION TEMPLATE RENDERING ====================
        // Verify caption template context would have required data
        var employees = EmployeeDetails.GetAllRecords();
        foreach (var employeeGroup in groupedByEmployee)
        {
            var employeeName = employees.FirstOrDefault(e => e.EmployeeID == employeeGroup.Key)?.FirstName;
            Assert.NotNull(employeeName);
            // Caption should display: "Employee Name - {EmployeeID} : {Count} Items"
        }

        // ==================== VERIFY EXPORT CONFIGURATIONS ====================
        Assert.True(cut.Instance.AllowExcelExport, "Excel export should be enabled");
        Assert.True(cut.Instance.AllowPdfExport, "PDF export should be enabled");
        Assert.True(cut.Instance.AllowGrouping, "Grouping should be enabled");
    }

