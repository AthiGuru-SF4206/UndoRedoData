<SfFixture @ref="fixture1"
           Test="VirtualMaskRow_EnableVirtualization_FrozenRows_ShouldRenderCorrectly"
           Description="VirtualizationMaskRow_EnableVirtualization_FrozenRows">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" Height="400" RowHeight="38" EnableVirtualMaskRow="true" EnableVirtualization="true" EnableColumnVirtualization="true" FrozenColumns="2" FrozenRows="2">
            <GridPageSettings PageSize="32"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(OrderDetails.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.CustomerID)" HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.EmployeeID)" HeaderText="Employee ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.OrderDate)" HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.Freight)" HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.ShipCountry)" HeaderText="Ship Country" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.ShipCity)" HeaderText="Ship City" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.ShipAddress)" HeaderText="Ship Address" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.ShippedDate)" HeaderText="Shipped Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="150"></GridColumn>
                <GridColumn Field="@nameof(OrderDetails.Verified)" HeaderText="Verified" Type="ColumnType.Boolean" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture1 { get; set; }

    public async void VirtualMaskRow_EnableVirtualization_FrozenRows_ShouldRenderCorrectly(Fixture fixture)
    {

        var cut = fixture1.GetComponentUnderTest<SfGrid<OrderDetails>>();
        var grid = cut.Instance;
        // Verify virtualization settings
        Assert.True(grid.EnableVirtualization, "EnableVirtualization should be true");
        Assert.True(grid.EnableVirtualMaskRow, "EnableVirtualMaskRow should be true");
        Assert.True(grid.EnableColumnVirtualization, "EnableColumnVirtualization should be true");

        // Verify frozen rows and columns
        Assert.Equal(2, grid.FrozenColumns);
        Assert.Equal(2, grid.FrozenRows);

        // Verify grid dimensions
        Assert.Equal("400", grid.Height);
        Assert.Equal(38, grid.RowHeight);

        // Verify page settings
        Assert.NotNull(grid.PageSettings);
        Assert.Equal(32, grid.PageSettings.PageSize);

        // Verify columns count
        Assert.Equal(10, grid.Columns.Count);

        // Verify specific column properties
        var orderIdColumn = grid.Columns.FirstOrDefault(c => c.Field == nameof(OrderDetails.OrderID));
        Assert.NotNull(orderIdColumn);
        Assert.Equal("Order ID", orderIdColumn.HeaderText);
        Assert.Equal("150", orderIdColumn.Width);

        var dateColumn = grid.Columns.FirstOrDefault(c => c.Field == nameof(OrderDetails.OrderDate));
        Assert.NotNull(dateColumn);
        Assert.Equal(ColumnType.Date, dateColumn.Type);
        Assert.Equal("d", dateColumn.Format);
        Assert.Equal(TextAlign.Right, dateColumn.TextAlign);

        var verifiedColumn = grid.Columns.FirstOrDefault(c => c.Field == nameof(OrderDetails.Verified));
        Assert.NotNull(verifiedColumn);
        Assert.Equal(ColumnType.Boolean, verifiedColumn.Type);

        // // Verify data is loaded
        // cut.Instance.CancelBegin();
        await Task.CompletedTask;
    }
}

