@code {
    private List<OrderDetails> GenerateOrderData()
    {
        List<OrderDetails> orders = new List<OrderDetails>();
        int code = 10247;
        
        for (int i = 1; i < 100; i++)
        {
            orders.Add(new OrderDetails(
                code + i,
                "VINET",
                i,
                new DateTime(1991, 05, 15),
                32.38,
                "Denmark",
                "Berlin",
                "Kirchgasse 6",
                new DateTime(1996, 7, 16),
                i % 2 == 0
            ));

            orders.Add(new OrderDetails(
                code + i + 1,
                "HANAR",
                i + 2,
                new DateTime(1990, 04, 04),
                58.17,
                "Brazil",
                "Madrid",
                "Avda. Azteca 123",
                new DateTime(1996, 9, 11),
                true
            ));
        }
        
        return orders;
    }
}
    <!-- Test RefreshIndentWidth - RowReorder and Grouping enabled, isRowDragCell = true -->
    <SfFixture @ref="fixture11"
               Test="RefreshIndentWidth_WithRowDragCell_ShouldUpdateRowReorderIndentWidth"
               Description="RefreshIndentWidth_RowDragCell_True">
        <ComponentUnderTest>
            <SfGrid DataSource="GenerateOrderData()" AllowRowDragAndDrop="true" AllowGrouping="true" Height="400">
                <GridGroupSettings Columns="@(new string[] { nameof(OrderDetails.CustomerID) })"></GridGroupSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(OrderDetails.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                    <GridColumn Field="@nameof(OrderDetails.CustomerID)" HeaderText="Customer Name" Width="150"></GridColumn>
                    <GridColumn Field="@nameof(OrderDetails.Freight)" HeaderText="Freight" Width="150"></GridColumn>
                </GridColumns>
            </SfGrid>
        </ComponentUnderTest>
    </SfFixture>

    @code {
        SfFixture fixture11 { get; set; }

        public async void RefreshIndentWidth_WithRowDragCell_ShouldUpdateRowReorderIndentWidth(Fixture fixture)
        {
            var cut = fixture11.GetComponentUnderTest<SfGrid<OrderDetails>>();
            var grid = cut.Instance;

            // Verify initial state
            Assert.True(grid.AllowRowDragAndDrop, "AllowRowDragAndDrop should be true");
            Assert.NotNull(grid.GroupSettings);
            Assert.NotNull(grid.RowReorderModule);
            Assert.NotNull(grid.GroupModule);

            // Call RefreshIndentWidth with isRowDragCell = true
            string indentWidth = "20";
            await cut.InvokeAsync(async () => await grid.RefreshIndentWidth(indentWidth, isRowDragCell: true));

            // Verify RowReorderModule indent width was updated
            Assert.NotNull(grid.RowReorderModule);
            Assert.Equal(indentWidth, grid.RowReorderModule.RowReorderIndentWidth);

            // Verify GroupModule indent width was also updated
            Assert.NotNull(grid.GroupModule);
            Assert.Equal(indentWidth, grid.GroupModule.IndentWidth);

            await Task.CompletedTask;
        }
    }

