@code {
    SfFixture fixture6;
    SfGrid<Order> Grid6;
    
    async Task ReorderColumns_MultipleSourceColumns(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        // 009: Test ReorderColumns(string[] fromNames, string toName) method
        // This method moves multiple columns (fromNames) to position of toName column
        var initialCount = cut.Instance.Columns.Count();
        Assert.Equal(5, initialCount);
        
        var columns = (List<GridColumn>)cut.Instance.Columns;
        
        // Get initial positions - we'll move columns 0 and 1 to position of column 3
        var col0Uid = columns[0].Uid;  // OrderID
        var col1Uid = columns[1].Uid;  // CustomerID
        var toColUid = columns[3].Uid; // ShipCity (target position)
        
        // Simulate ReorderColumns behavior: move fromNames columns to toName position
        var fromIndices = new[] { 0, 1 };
        var toIndex = 3;
        
        // Sequential reorder: move column at index 0 to position 3
        var col = columns[0];
        columns.RemoveAt(0);
        columns.Insert(toIndex, col);
        
        // Adjust index for next iteration (after first removal, indices shift)
        toIndex = toIndex > 0 ? toIndex - 1 : toIndex;
        
        // Move second column
        col = columns[0];
        columns.RemoveAt(0);
        columns.Insert(toIndex, col);
        
        // Verify all columns still present
        Assert.Equal(5, cut.Instance.Columns.Count());
        Assert.NotNull(cut.Instance.Columns.FirstOrDefault(c => c.Uid == col0Uid));
        Assert.NotNull(cut.Instance.Columns.FirstOrDefault(c => c.Uid == col1Uid));
