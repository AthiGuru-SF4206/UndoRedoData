@*002: PerformReorder with IsMultipleReorder=false (single reorder)*@
<SfFixture @ref="fixture2" TestAsync="PerformReorder_SingleReorder" Description="PerformReorder with single column reorder">
    <ComponentUnderTest>
        <SfGrid @ref="Grid2" DataSource="GenerateOrderData()" AllowReordering="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150"></GridColumn>
            </GridColumns>
            <GridEvents TValue="Order" OnActionComplete="ActionComplete2"></GridEvents>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture2;
    SfGrid<Order> Grid2;
    
    async Task PerformReorder_SingleReorder(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        // 002: Single column reorder - move column from index 0 to index 2 using Grid's ReorderColumnByIndexAsync
        var initialOrder = cut.Instance.Columns.Select(c => c.Field).ToList();
        Assert.Equal(3, initialOrder.Count);
        Assert.Equal("OrderID", initialOrder[0]);
        
        // Get original row data before reorder
        var recordsBeforeReorder = await cut.Instance.GetColumnsAsync();
        Assert.NotNull(recordsBeforeReorder);
        
        // Call actual Grid reorder method - move column from index 0 to index 2
        cut.Instance.ReorderModule.ReorderColumn(0, 2);
        
        // Get records after reorder to verify operation completed
        var recordsAfterReorder = await cut.Instance.GetColumnsAsync();
        
        // Verify column reorder completed by checking grid structure
        Assert.NotNull(cut.Instance.Columns);
        Assert.Equal(3, cut.Instance.Columns.Count());
        
        // Verify data integrity after column reorder
        Assert.NotNull(recordsAfterReorder);
        Assert.Equal(recordsBeforeReorder.Count, recordsAfterReorder.Count);
        
        // Verify column index changed - column at index 0 should not be OrderID anymore
        var columnAtIndex0 = cut.Instance.Columns.ElementAt(0).Field;
        var columnAtIndex2 = cut.Instance.Columns.ElementAt(2).Field;
        Assert.NotEqual("OrderID", columnAtIndex0);
        Assert.Equal("OrderID", columnAtIndex2);
    }

    void ActionComplete2()
    {
        // Single reorder should preserve column count
        Assert.Equal(3, Grid2.Columns.Count());
    }
}

