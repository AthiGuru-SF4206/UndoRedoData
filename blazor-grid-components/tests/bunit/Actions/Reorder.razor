        toTmp.SetFreeze(columns[1].Freeze);
        toTmp.SetIsFrozen(columns[1].IsFrozen);
        columns.RemoveAt(0);
        columns.Insert(1, toTmp);
        
        // After swap, first position should have freeze settings
        Assert.True(columns[1].IsFrozen);
        Assert.Equal(FreezeDirection.Left, columns[1].Freeze);
    }

    void ActionComplete28()
    {
        // Frozen status should be properly handled
        var frozen = Grid28.Columns.Where(c => c.IsFrozen);
        Assert.NotEmpty(frozen);
    }
