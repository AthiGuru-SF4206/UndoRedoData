<!-- Test 1.4: Grouping Expand/Collapse - Scrollbar Updates -->
<SfFixture @ref="fixture4" Test="GroupingExpandCollapseScrollbarUpdates" Description="Grouping expand/collapse should update scrollbar visibility">
    <ComponentUnderTest>
        <SfGrid ID="GroupingGrid4" @ref="GroupingGrid4" DataSource="GenerateGroupingData()" AllowGrouping="true" Height="400" Width="100%">
            <GridGroupSettings Columns="@(new string[] { "CustomerID" })"></GridGroupSettings>
            <GridColumns>
                <GridColumn Field=@nameof(OrderGrouping.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderGrouping.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderGrouping.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(OrderGrouping.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture4 { get; set; }
    private SfGrid<OrderGrouping> GroupingGrid4;

    public void GroupingExpandCollapseScrollbarUpdates(Fixture fixture4)
    {
        var cut = fixture4.GetComponentUnderTest<SfGrid<OrderGrouping>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.AllowGrouping, "Grouping enabled");
        
        // Initially grouped: 100 records grouped by CustomerID (10 groups)
        var initialRows = cut.Instance.Rows.Count;
        Assert.True(initialRows > 0, "Groups rendered successfully");
        
        // Find first caption row and collapse it
        var captionRow = cut.Instance.Rows.FirstOrDefault(r => r.IsCaptionRow);
        if (captionRow != null)
        {
            cut.InvokeAsync(() => cut.Instance.GroupModule.ExpandCollapse(captionRow));
            cut.WaitForState(() => cut.Instance.Rows.Count != initialRows);
            
            // After collapse, row count should decrease
            var afterCollapseRows = cut.Instance.Rows.Count;
            Assert.True(afterCollapseRows < initialRows, "Rows decreased after group collapse");
            
            // If all collapsed to fit in 400px, scrollbar might disappear
            // Re-expand and verify it reappears
            cut.InvokeAsync(() => cut.Instance.GroupModule.ExpandCollapse(captionRow));
            cut.WaitForState(() => cut.Instance.Rows.Count >= initialRows);
            
            var afterExpandRows = cut.Instance.Rows.Count;
            Assert.True(afterExpandRows >= initialRows, "Rows increased after group re-expand");
        }
    }

    public List<OrderGrouping> GenerateGroupingData()
    {
        var data = new List<OrderGrouping>();
        var customers = new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID", "BSBEV", "CACTU", "CHOPS", "COMMI", "CONSH" };
        
        for (int i = 0; i < 100; i++)
        {
            data.Add(new OrderGrouping()
            {
                OrderID = 10248 + i,
                CustomerID = customers[i % 10],
                OrderDate = new DateTime(2023, 1, (i % 28) + 1),
                Freight = 25.5 * (i + 1)
            });
        }
        return data;
    }

    public class OrderGrouping
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
