<!-- Test 1.1: Static Small Content - No Scrollbar -->
<SfFixture @ref="fixture1" Test="StaticSmallContentNoScrollbar" Description="Static 400px grid with 5 rows should not render scrollbar">
    <ComponentUnderTest>
        <SfGrid ID="StaticGrid1" @ref="StaticGrid1" DataSource="GenerateSmallData()" Height="400" Width="100%">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture1 { get; set; }
    private SfGrid<Order> StaticGrid1;

    public void StaticSmallContentNoScrollbar(Fixture fixture1)
    {
        var cut = fixture1.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.Height == "400", "Grid height set to 400px");
        
        // Check that content element has overflow auto
        var contentElement = cut.Find(".e-content");
        Assert.NotNull(contentElement, "Content element exists");
        
        // Verify that scrollbar is not rendered (no space wasted)
        // The key is: header paddingRight should be 0 (no scrollbar space reserved)
        var headerContent = cut.Find(".e-gridheader");
        Assert.NotNull(headerContent, "Header exists");
        
        // Check header doesn't have scrollbar padding
        var computedStyle = headerContent.GetAttribute("style");
        var hasPaddingRight = computedStyle?.Contains("padding-right") ?? false;
        Assert.False(hasPaddingRight, "No padding-right applied to header (no scrollbar space reserved)");
        
        // Verify content scrollHeight is less than offsetHeight
        // This verifies no scroll is needed
        Assert.True(cut.Instance.Rows.Count == 5, "Expected 5 rows");
    }

    public List<Order> GenerateSmallData()
    {
        var data = new List<Order>();
        for (int i = 1; i <= 5; i++)
        {
            data.Add(new Order()
            {
                OrderID = 1000 + i,
                CustomerID = "CUSTOMER" + i,
                OrderDate = new DateTime(2023, 1, i),
                Freight = 25.5 * i
            });
        }
        return data;
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}


<!-- Test 1.2: Dynamic Record Addition - Scrollbar Should Appear -->
<SfFixture @ref="fixture2" Test="DynamicRecordAdditionScrollbarAppears" Description="Adding records dynamically should show scrollbar">
    <ComponentUnderTest>
        <SfGrid ID="DynamicGrid2" @ref="DynamicGrid2" DataSource="GenerateDynamicSmallData()" Height="400" Width="100%">
            <GridColumns>
                <GridColumn Field=@nameof(OrderDynamic.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderDynamic.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderDynamic.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(OrderDynamic.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture2 { get; set; }
    private SfGrid<OrderDynamic> DynamicGrid2;
    private List<OrderDynamic> dynamicData;

    public void DynamicRecordAdditionScrollbarAppears(Fixture fixture2)
    {
        var cut = fixture2.GetComponentUnderTest<SfGrid<OrderDynamic>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.Height == "400", "Grid height set to 400px");
        
        // Initially: 5 rows only, scrollbar should not be visible
        var initialRows = cut.Instance.Rows.Count;
        Assert.True(initialRows == 5, $"Initial rows count: expected 5, got {initialRows}");
        
        // Simulate dynamic addition: add 50 more rows
        var newRecords = new List<OrderDynamic>();
        for (int i = 6; i <= 55; i++)
        {
            newRecords.Add(new OrderDynamic()
            {
                OrderID = 1000 + i,
                CustomerID = "CUSTOMER" + i,
                OrderDate = new DateTime(2023, 1, (i % 28) + 1),
                Freight = 25.5 * i
            });
        }
        
        // Add records to the data source
        foreach (var record in newRecords)
        {
            dynamicData.Add(record);
        }
        
        // Refresh the grid
        cut.InvokeAsync(() => cut.Instance.Refresh());
        cut.WaitForState(() => cut.Instance.Rows.Count >= 55);
        
        // After addition: 55 rows, scrollbar should appear
        var finalRows = cut.Instance.Rows.Count;
        Assert.True(finalRows >= 55, $"Final rows count: expected >= 55, got {finalRows}");
        
        // Verify scrollbar appears (content.scrollHeight > content.offsetHeight)
        var contentElement = cut.Find(".e-content");
        Assert.NotNull(contentElement, "Content element exists");
        
        // The key assertion: after adding many rows, scrollbar should be present
        Assert.True(finalRows > initialRows, "Rows were added successfully");
    }

    public List<OrderDynamic> GenerateDynamicSmallData()
    {
        dynamicData = new List<OrderDynamic>();
        for (int i = 1; i <= 5; i++)
        {
            dynamicData.Add(new OrderDynamic()
            {
                OrderID = 1000 + i,
                CustomerID = "CUSTOMER" + i,
                OrderDate = new DateTime(2023, 1, i),
                Freight = 25.5 * i
            });
        }
        return dynamicData;
    }

    public class OrderDynamic
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}


