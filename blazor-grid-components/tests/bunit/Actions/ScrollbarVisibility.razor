<!-- Test Bug-1: Static height grid with small data must NOT have e-yscroll class (proves redundant scrollbar bug) -->
<SfFixture @ref="fixtureBug1" Test="StaticHeight_SmallData_ShouldNotHaveYScrollClass" Description="Grid with static height and content smaller than height must not render e-yscroll class on content element">
    <ComponentUnderTest>
        <SfGrid ID="BugGrid1" @ref="BugGrid1" DataSource="GenerateBug1Data()" Height="325" Width="100%">
            <GridColumns>
                <GridColumn Field=@nameof(OrderBug1.OrderID) HeaderText="Order ID" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderBug1.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderBug1.Freight) HeaderText="Freight" Format="C2" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixtureBug1 { get; set; }
    private SfGrid<OrderBug1> BugGrid1;

    public void StaticHeight_SmallData_ShouldNotHaveYScrollClass(Fixture fixtureBug1)
    {
        var cut = fixtureBug1.GetComponentUnderTest<SfGrid<OrderBug1>>();
        Assert.True(cut.Instance.Rows.Count == 3, $"Grid rendered 3 rows: actual={cut.Instance.Rows.Count}");
        Assert.Equal("325", cut.Instance.Height);

        // The .e-content element MUST retain the e-yscroll class (it is a query selector handle used
        // by windowResized() and selection module — removing it breaks those features).
        //
        // The fix is surgical: GetContentStyle() must write overflow-y:hidden as the initial inline
        // style so the browser does not render scrollbar arrows before JS setPadding() runs.
        // JS setPadding() then keeps overflow-y:hidden (content fits) or clears it (scroll needed).
        var contentElement = cut.Find(".e-content");
        Assert.NotNull(contentElement);

        // e-yscroll class MUST still be present (selector integrity)
        Assert.True(contentElement.ClassList.Contains("e-yscroll"),
            "e-yscroll class must remain on .e-content for selector query integrity.");

        // The inline overflow-y style must be 'hidden' when content fits inside static height.
        // Before the fix, GetContentStyle() does NOT write overflow-y:hidden, so the CSS class
        // e-yscroll renders the scrollbar track/arrows on first paint.
        var inlineStyle = contentElement.GetAttribute("style") ?? string.Empty;
        Assert.Contains("overflow-y:hidden", inlineStyle.Replace(" ", ""),
            "overflow-y:hidden must be set inline on .e-content when content height < static grid height. " +
            "Actual style: " + inlineStyle);
    }

    public List<OrderBug1> GenerateBug1Data()
    {
        return new List<OrderBug1>
        {
            new OrderBug1 { OrderID = 10001, CustomerID = "ALFKI", Freight = 32.38 },
            new OrderBug1 { OrderID = 10002, CustomerID = "ANATR", Freight = 11.61 },
            new OrderBug1 { OrderID = 10003, CustomerID = "ANTON", Freight = 65.83 }
        };
    }

    public class OrderBug1
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public double? Freight { get; set; }
    }
}


