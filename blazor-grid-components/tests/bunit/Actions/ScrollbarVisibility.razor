<!-- Test 3.1: Scroll + Filtering Interaction - Scrollbar Should Disappear When Filtered -->
<SfFixture @ref="fixture5" Test="ScrollFilteringInteraction" Description="Filtering should update scrollbar visibility correctly">
    <ComponentUnderTest>
        <SfGrid ID="FilterGrid5" @ref="FilterGrid5" DataSource="GenerateFilterData()" AllowFiltering="true" Height="400" Width="100%">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field=@nameof(OrderFilter.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderFilter.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderFilter.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(OrderFilter.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture5 { get; set; }
    private SfGrid<OrderFilter> FilterGrid5;

    public void ScrollFilteringInteraction(Fixture fixture5)
    {
        var cut = fixture5.GetComponentUnderTest<SfGrid<OrderFilter>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.AllowFiltering, "Filtering enabled");
        
        // Initially: 100 rows, scrollbar should be visible
        var initialRows = cut.Instance.Rows.Count;
        Assert.True(initialRows >= 100, $"Initial rows: expected >= 100, got {initialRows}");
        
        // Apply filter to show only 5 rows
        cut.InvokeAsync(async () => {
            await cut.Instance.FilterByColumn("CustomerID", "equal", "ALFKI");
        });
        cut.WaitForState(() => cut.Instance.Rows.Count <= 10);
        
        // After filter: 5 rows (or fewer), scrollbar should disappear
        var filteredRows = cut.Instance.Rows.Count;
        Assert.True(filteredRows < initialRows, $"Filtered rows reduced: {filteredRows} < {initialRows}");
        
        // Clear filter
        cut.InvokeAsync(async () => {
            await cut.Instance.ClearFiltering();
        });
        cut.WaitForState(() => cut.Instance.Rows.Count >= initialRows);
        
        // After clearing filter: 100 rows again, scrollbar should reappear
        var clearedRows = cut.Instance.Rows.Count;
        Assert.True(clearedRows >= initialRows, $"Filter cleared, rows restored: {clearedRows}");
    }

