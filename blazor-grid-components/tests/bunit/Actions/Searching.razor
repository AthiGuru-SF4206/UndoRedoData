@inherits GridTestBase
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Inputs
<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Flat grid with data source and column">
    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid" DataSource="GenerateOrderData()" Toolbar="@(new List<string>() { "Search" })" AllowPaging="true">

            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
            <GridEvents TValue="Order" OnActionComplete="OnActionComplete"></GridEvents>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }
    private SfGrid<Order> DefaultGrid;
    bool _canAssert = false;
    async void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        _canAssert = true;
        Assert.True(2 == cut.FindAll(".e-toolbar-item").Count(), "search renders properly");
        Assert.True(cut.FindAll(".e-toolbar-item")[1].ClassList.Contains("e-template"), "Template renders properly for search");
        Assert.True(1 == cut.FindAll(".e-searchinput").Count);
        Assert.True(1 == cut.FindAll(".e-input").Count);
        Assert.True(12 == cut.Instance.CurrentViewData.Count(), "current view data working properly");
        Assert.True(3 == cut.FindAll(".e-headercell").Count(), "Header cells generated properly");
        Assert.True(3 == cut.Find(".e-row").Children.Count(), "Number of cells generated properly");
        // Searching empty string
        cut.FindAll(".e-searchinput")[0].Input("");
        Task.Run(async () =>
        {
            var eventFn = cut.FindComponent<SfToolbar>().Instance.Items.First().OnClick;
            var eventHandler = (EventCallback<ClickEventArgs>)eventFn;
            var clickEventArgs = new ClickEventArgs();
            
            // Set Name property
            GridReflection.SetPropertyValue(clickEventArgs, "Name", "click");
            
            // Set Item property with ItemModel
            var itemModel = new ItemModel() 
            { 
                Id = cut.Instance.ID + "_search", 
                Text = "Search", 
                Type = ItemType.Input 
            };
            GridReflection.SetPropertyValue(clickEventArgs, "Item", itemModel);
            await eventHandler.InvokeAsync(clickEventArgs);
        }).GetAwaiter();

        cut.FindComponent<SfPager>().FindAll(".e-link").ElementAt(1).Click();
        //goto page testing for search
        await cut.Instance.GoToPageAsync(2);
        //Assert.True(1 == cut.Find(".e-toolbar-right").Children.Count(), "CurrentViewData count is proper");
    }
    void OnActionComplete()
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        Assert.True(8 == cut.Instance.CurrentViewData.Count(), "paging  working properly during search");
    }
    }
