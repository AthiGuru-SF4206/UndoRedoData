    /// Covers the branch in DeleteRecordAsync(string fieldName, TValue data)
    /// where data is null AND SelectedRecords.Count == 0,
    /// so DeleteAlert is shown and validation dialog triggered.
    /// </summary>
    public async void DeleteRecord_WithKey_NullData_NoSelection_ShowsDeleteAlert(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        // Arrange: deleting allowed, confirm dialog disabled, and no selection
        grid.EditSettings.AllowDeleting = true;
        grid.EditSettings.ShowDeleteConfirmDialog = false;

        Assert.Empty(grid.SelectedRecords);

        // Act: pass null data to trigger the (data == null) branch
        await grid.DeleteRecordAsync(nameof(Order.OrderID), default!);

        // Assert: DeleteAlert branch is hit
        Assert.Equal("DeleteAlert", grid.EditModule.AlertMessage);

        // Optional UI assertion: ensure the validation dialog is (at least) attempted to be shown
        cut.WaitForState(
            () => cut.FindAll(".e-dialog").Count >= 0,
            TimeSpan.FromMilliseconds(1000)
        );
    }
}
