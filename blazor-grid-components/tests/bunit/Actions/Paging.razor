<SfFixture @ref="pagerFixture"
           Test="UpdateExternalMessageAsync_PagerMessageUpdated"
           Description="Covers UpdateExternalMessageAsync by validating pager external message UI">
    <ComponentUnderTest>
        <SfGrid TItem="Order"
                DataSource="@GenerateOrderData()"
                AllowPaging="true">
            <GridEditSettings AllowAdding="true"
                              AllowDeleting="true"
                              AllowEditing="true">
            </GridEditSettings>
            <GridEvents TValue="Order">
            </GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID)
                            HeaderText="Order ID"
                            TextAlign="TextAlign.Right"
                            IsPrimaryKey="true"
                            Width="120">
                </GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID)
                            HeaderText="Customer Name"
                            Width="150">
                </GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate)
                            HeaderText="Order Date"
                            Type="ColumnType.Date"
                            TextAlign="TextAlign.Right"
                            Width="160">
                </GridColumn>
                <GridColumn Field=@nameof(Order.Freight)
                            HeaderText="Freight"
                            TextAlign="TextAlign.Right"
                            Width="200">
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture pagerFixture { get; set; }

    async void UpdateExternalMessageAsync_PagerMessageUpdated(Fixture fixture)
    {

        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        cut.WaitForState(() => cut.FindAll(".e-gridpager").Count > 0);

        var message = "External message from test";

        await cut.Instance.UpdateExternalMessageAsync(message);

        cut.WaitForState(() =>
        {
            var externalMsgElem = cut.FindAll(".e-gridpager .e-pagerexternalmsg").FirstOrDefault();
            return externalMsgElem != null &&
                   externalMsgElem.TextContent != null &&
                   externalMsgElem.TextContent.Contains(message, StringComparison.Ordinal);
        });

        var externalMessageElement = cut.Find(".e-gridpager .e-pagerexternalmsg");
        Assert.NotNull(externalMessageElement);
        Assert.Contains(message, externalMessageElement.TextContent);
    }
    }