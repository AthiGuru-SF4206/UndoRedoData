@inherits GridTestBase
@using Syncfusion.Blazor.Buttons

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Flat grid with data source and column">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
            <GridEvents TValue="Order" DataBound="DataBound"></GridEvents>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }
    bool _canAssert = false;
    void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        Assert.True(12 == cut.FindAll(".e-row").Count, "Number of rows generated properly");
        Assert.True(3 == cut.Find(".e-row").Children.Count(), "Number of cells generated properly");
        Assert.True(12 == cut.Instance.CurrentViewData.Count(), "CurrentViewData count is proper");
        _canAssert = true;
        cut.FindComponent<SfPager>().FindAll(".e-link").ElementAt(1).Click();
    }

    void DataBound()
    {
        if (_canAssert)
        {
            _canAssert = false;
            var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
            Assert.True(8 == cut.FindAll(".e-row").Count, "On paging rows refreshed properly");
            Assert.True(8 == cut.Instance.CurrentViewData.Count(), "On paging current view data changed properly");
        }
    }
}

<SfFixture @ref="fixture2" TestAsync="GridBasicRendering2" Description="Paging functionalities">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering=true AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" IsPrimaryKey=true Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
            <GridPageSettings PageCount="4" PageSize="2" CurrentPage="2" EnableQueryString="true"></GridPageSettings>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture2 { get; set; }
    async Task GridBasicRendering2(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(2 == cut.FindAll(".e-row").Count, "page size testing");
        Assert.True(2 == cut.Instance.PageSettings.CurrentPage, "current page testing");
        Assert.True(1 == cut.FindAll(".e-pager").Count, "class testing");
        Assert.True(4 == cut.FindAll(".e-numericcontainer")[0].ChildNodes.Length, "page count testing");
        // Assert.True(true == cut.FindAll(("e-numericcontainer")[0].ChildNodes[0].ChildNodes[0]).Attr("aria-owns"), "page count testing"); //
        Assert.True(20 == cut.Instance.TotalItemCount, "totalRecordsCount testing");
        await cut.Instance.FilterByColumnAsync("CustomerID", "equal", "anton");
        Assert.True("CustomerID: anton" == cut.FindAll(".e-pagerexternalmsg")[0].TextContent);
    }
}

<SfFixture @ref="fixture3" TestAsync="GridBasicRendering3" Description="Disabled paging">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowPaging=false>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
            <GridPageSettings PageCount="4" PageSize="0" CurrentPage="2" EnableQueryString="true"></GridPageSettings>
            <GridEvents TValue="Order" DataBound="DataBound0" OnActionComplete="ActionComplete1"></GridEvents>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture3 { get; set; }
    bool _canAssert3 = false;
    async Task GridBasicRendering3(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(0 == cut.FindAll(".e-pager").Count, "class testing");
        cut.Instance.AllowPaging = true;
        await cut.Instance.CallStateHasChangedAsync();
        cut.WaitForState(() => cut.Instance.AllowPaging);
        Assert.True(1 == cut.FindAll(".e-pager").Count, "allowpaging true setmodel testing");
        cut.Instance.AllowPaging = false;
        cut.Instance.PageSettings.PageSize = 2;
        await cut.Instance.CallStateHasChangedAsync();
        Assert.True(0 == cut.FindAll(".e-pager").Count, "allowpaging false setmodel testing");
        await cut.Instance.CallStateHasChangedAsync();
    }

    void DataBound0()
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.Instance.AllowPaging = true;
        Assert.True(1 == cut.FindAll(".e-pager").Count, "allowpaging true setmodel testing");
    }
    void ActionComplete1()
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.Instance.PageSettings.CurrentPage = 1;
      
    }
}


