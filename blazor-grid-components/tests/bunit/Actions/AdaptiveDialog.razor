<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Adaptive dialog rendering">
    <ComponentUnderTest>
        <SfGrid ID="Grid" @ref="Grid" DataSource="GenerateRows()" EnableAdaptiveUI=true RowRenderingMode="RowDirection.Vertical" AllowSorting=true AllowFiltering=true Toolbar="@(new List<string>() {"PdfExport", "ExcelExport", "ColumnChosser", "CsvExport" })"
                ShowColumnChooser=true AllowExcelExport=true AllowPdfExport=true ShowColumnMenu=true>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> GridData { get; set; }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.AllowSorting, "Sorting enabled"); 
        Assert.True(cut.Instance.AllowFiltering, "Filtering enabled");
        Assert.True(cut.Instance.RowRenderingMode == RowDirection.Vertical, "Row rendering mode set to vertical");
        var adaptiveDialog = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.AdaptiveDialogRenderer<Order>>();

        //Filtering
        await cut.Instance.FilterByColumnAsync("CustomerID", "equal", "Alfki");
        cut.FindAll(".e-toolbar-item")[0].Click();
        Assert.True(cut.FindAll(".e-toolbar-item")[0].Id == "Grid_filter", "Filter button clicked");
        cut.FindAll(".e-filterset")[0].Click();
        Assert.True(cut.Instance.FilterSettings.Columns.Count() == 0, "Remove Filtering working properly");
        BeforeOpenCloseMenuEventArgs<MenuItem> args = new BeforeOpenCloseMenuEventArgs<MenuItem>();
        MenuItem menuItem = new MenuItem();
        cut.InvokeAsync(() => adaptiveDialog.Instance.OnCloseMenu(args)).GetAwaiter();
        List<GridSortColumn> SortedColumns = new List<GridSortColumn>();
        SortedColumns.Add(new GridSortColumn() { Field = "OrderID", Direction = SortDirection.Ascending });
        cut.Instance.SortSettings.Columns = SortedColumns;
        cut.InvokeAsync(() => adaptiveDialog.Instance.SetSortingDirection(cut.Instance.Columns[0])).GetAwaiter();
        
    }

    public List<Order> GenerateRows()
    {
       List<Order> data = new List<Order>();
        int count = 1000;

        for (int i = 0; i < 15; i++)
        {
            data.Add(new Order() { OrderID = count + 1, CustomerID = "Alfki", OrderDate = new DateTime(1995, 05, 15), Freight = 25.7 * 2 });
            data.Add(new Order() { OrderID = count + 2, CustomerID = "Anantr", OrderDate = new DateTime(1994, 04, 04), Freight = 26.7 * 2 });
            data.Add(new Order() { OrderID = count + 3, CustomerID = "Blonp", OrderDate = new DateTime(1993, 03, 10), Freight = 27.7 * 2 });
            data.Add(new Order() { OrderID = count + 4, CustomerID = "Anton", OrderDate = new DateTime(1992, 02, 14), Freight = 28.7 * 2 });
            data.Add(new Order() { OrderID = count + 5, CustomerID = "Bolid", OrderDate = new DateTime(1991, 01, 18), Freight = 29.7 * 2 });
            count += 5;
        }

        return data;
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}

