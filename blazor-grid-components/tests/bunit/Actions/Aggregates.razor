@code {
    private string[] GroupOptions = (new string[] { "ShipCountry" });
    SfFixture fixture4 { get; set; }
    private SfGrid<Order> Grid;


    public void GridBasicRendering4(Fixture fixture)
    {
        var cut4 = fixture.GetComponentUnderTest<SfGrid<Order>>();

        Assert.True(1 == Grid.Aggregates.Count,
            "Aggregates count should be 1");
        Assert.True(1 == Grid.Aggregates[0].Columns.Count,
            "Aggregate columns count should be 1");

        Assert.True("Freight" == Grid.Aggregates[0].Columns[0].Field,
            "First aggregate column field should be 'Freight'");

        Assert.True(Grid.Aggregates[0].Columns[0].Type.Equals(AggregateType.Min),
            "Aggregate type should be Min");

        Assert.True(Grid.Aggregates[0].Columns[0].GroupCaptionTemplate != null,
            "GroupCaptionTemplate should not be null (hasGroupCaptionTemplate = true)");

        var groupCaptions = cut4.FindAll(".e-groupcaption");
        Assert.True(7 == groupCaptions.Count,
            "There should be 7 group caption cells (one per unique ShipCountry)");

        Assert.True(groupCaptions.All(gc => gc.InnerHtml.Contains("Minimum:")),
            "Every group caption must contain 'Minimum:' because CaptionTemplate renders val2.Min branch");

        Assert.True(groupCaptions.All(gc => !gc.InnerHtml.Contains("Customing:")),
            "No caption should fall into the else/Customing branch when Field is set");

        var austriaCaption = groupCaptions.FirstOrDefault(gc =>
            gc.InnerHtml.Contains("Austria"));
        Assert.True(austriaCaption != null,
            "Austria group caption should be rendered");
        Assert.True(austriaCaption!.InnerHtml.Contains("ShipCountry: Austria - 2 items"),
            "Austria caption should show field name, key and item count from GetCaption()");
        Assert.True(austriaCaption.InnerHtml.Contains("Minimum:") && austriaCaption.InnerHtml.Contains("41.34"),
            "Austria caption should show Minimum: 41.34 (GetCaption sets groupAggregate.Min via AggregateType.Min)");

        var belgiumCaption = groupCaptions.FirstOrDefault(gc =>
            gc.InnerHtml.Contains("Belgium"));
        Assert.True(belgiumCaption != null,
            "Belgium group caption should be rendered");
        Assert.True(belgiumCaption!.InnerHtml.Contains("ShipCountry: Belgium - 2 items"),
            "Belgium caption should show field name, key and item count from GetCaption()");
        Assert.True(belgiumCaption.InnerHtml.Contains("Minimum:") && belgiumCaption.InnerHtml.Contains("11.61"),
            "Belgium caption should show Minimum: 11.61 (GetCaption sets groupAggregate.Min via AggregateType.Min)");

        var brazilCaption = groupCaptions.FirstOrDefault(gc => gc.InnerHtml.Contains("Brazil"));
        Assert.True(brazilCaption != null && brazilCaption.InnerHtml.Contains("1 items"),
            "Brazil group caption should show 1 items");
        Assert.True(brazilCaption!.InnerHtml.Contains("Minimum:") && brazilCaption.InnerHtml.Contains("65.83"),
            "Brazil caption should show Minimum: 65.83");

        var mexicoCaption = groupCaptions.FirstOrDefault(gc => gc.InnerHtml.Contains("Mexico"));
