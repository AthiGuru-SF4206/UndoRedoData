<SfFixture @ref="fixture5" TestAsync="GridBasicRendering5" Description="Grid with Grouping">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" AllowGrouping="true" AllowPaging=true Toolbar="@(new List<string>(){ "Add", "Delete", "Update", "Cancel" })">
            <GridEditSettings AllowAdding="true" AllowDeleting="true" AllowEditing="true"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Visible=false Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture5 { get; set; }

    public async Task GridBasicRendering5(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        cut.FindAll(".e-headercell")[1].KeyDown(new KeyboardEventArgs() { Key = "ArrowLeft" });
        cut.FindAll(".e-headercell")[2].KeyDown(new KeyboardEventArgs() { Key = "Tab" });
        cut.FindAll(".e-rowcell")[0].KeyDown(new KeyboardEventArgs() { Key = "Tab", ShiftKey=true });
        cut.FindAll(".e-rowcell")[2].KeyDown(new KeyboardEventArgs() { Key = "Tab" });
        cut.FindAll(".e-headercell")[2].KeyDown(new KeyboardEventArgs() { Key = "ArrowRight" });
        await cut.Instance.GroupColumnAsync("OrderID");
        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length > 0, TimeSpan.FromMilliseconds(100));
        cut.FindAll(".e-headercell")[1].KeyDown(new KeyboardEventArgs() { Key = "Tab" });
        cut.FindAll(".e-rowcell")[0].KeyDown(new KeyboardEventArgs() { Key = "Tab", ShiftKey = true });
        cut.FindAll(".e-recordplusexpand")[2].KeyDown(new KeyboardEventArgs() { Key = "Tab", ShiftKey=true });
        cut.FindAll(".e-rowcell")[0].KeyDown(new KeyboardEventArgs() { Key = "ArrowLeft" });
        cut.FindAll(".e-recordplusexpand")[2].KeyDown(new KeyboardEventArgs() { Key = "ArrowDown" });
        await cut.Instance.GroupColumnAsync("CustomerID");
        await cut.Instance.GroupColumnAsync("OrderDate");
        cut.FindAll(".e-recordplusexpand")[0].KeyDown(new KeyboardEventArgs() { Key = "ArrowUp" });
        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length > 2, TimeSpan.FromMilliseconds(100));

        cut.FindAll(".e-recordplusexpand")[0].KeyDown(new KeyboardEventArgs() { Key = "ArrowUp", CtrlKey = true });
        await Task.Delay(100);
        Assert.True(cut.FindAll(".e-recordplusexpand").Count == 0, "No expand buttons must be found");
        cut.FindAll(".e-recordpluscollapse")[0].KeyDown(new KeyboardEventArgs() { Key = "ArrowDown", AltKey = true });
        await Task.Delay(100);
        Assert.True(cut.FindAll(".e-recordplusexpand").Count == 1, "One expand alone must be found");
        cut.FindAll(".e-recordpluscollapse")[0].KeyDown(new KeyboardEventArgs() { Key = "ArrowDown", CtrlKey = true });
        await Task.Delay(100);
        Assert.True(cut.FindAll(".e-recordpluscollapse").Count == 0, "No collapse buttons must be found");
        cut.FindAll(".e-recordplusexpand")[0].KeyDown(new KeyboardEventArgs() { Key = "ArrowUp", AltKey = true });
        await Task.Delay(100);
        Assert.True(cut.FindAll(".e-recordpluscollapse").Count == 1, "One collapse button only must be found");

    }

}

