<SfFixture @ref="fixture4" Test="SearchForeignRendering" Description="ForeignKey Feature Testing">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateForeignData()" Toolbar="@(new List<string>() { "Search" })" Height="315">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridForeignColumn Field=@nameof(Order.EmployeeID) HeaderText="Employee Name" ForeignKeyValue="FirstName" ForeignDataSource="@GenerateEmployeeData()" Width="150"></GridForeignColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
            <GridEvents TValue="Order" OnActionComplete="ActionCompleteHandle"></GridEvents>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture4 { get; set; }

    async void SearchForeignRendering(Fixture fixture4)
    {
        var cut = fixture4.GetComponentUnderTest<SfGrid<Order>>();
        cut.FindAll(".e-searchinput")[0].Input("Nancy");
        Task.Run(async () =>
        {
            var eventFn = cut.FindComponent<SfToolbar>().Instance.Items.First().OnClick;
            var eventHandler = (EventCallback<ClickEventArgs>)eventFn;
            var clickEventArgs = new ClickEventArgs();
            
            // Set Name property
            GridReflection.SetPropertyValue(clickEventArgs, "Name", "click");
            
            // Set Item property with ItemModel
            var itemModel = new ItemModel()
            {
                Id = cut.Instance.ID + "_search",
                Text = "Search",
                Type = ItemType.Input
            };
            GridReflection.SetPropertyValue(clickEventArgs, "Item", itemModel);
            await eventHandler.InvokeAsync(clickEventArgs);
            //var eventArgs = new ClickEventArgs() { Name = "click", Item = new ItemModel() { Id = cut.Instance.ID + "_search", Text = "Search", Type = ItemType.Input } };
            //await eventHandler.InvokeAsync(eventArgs);
        }).GetAwaiter();
        await cut.Instance.SelectRowAsync(1);
        await cut.Instance.StartEditAsync();
        Assert.False(cut.Instance.IsEdit == true, "Edit template working properly while searching");
        await cut.Instance.EndEditAsync();
        Assert.True(cut.Instance.IsEdit == false, "Edit condition checks");
    }

    async void ActionCompleteHandle()
    {
        var cut = fixture4.GetComponentUnderTest<SfGrid<Order>>();
        await cut.Instance.SearchAsync(" ");
        Assert.True(1 == cut.Instance.CurrentViewData.Count(), "Current view data working properly");
    }
}
