@inherits GridTestBase

@using Syncfusion.Blazor.Navigations;

<SfFixture @ref="fixture" Test="ForeignRendering" Description="ForeignKey Feature Testing">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateForeignData()" Height="315">
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridForeignColumn Field=@nameof(Order.EmployeeID) HeaderText="Employee Name" EditType="EditType.DropDownEdit" ForeignKeyValue="FirstName" ForeignDataSource="@GenerateEmployeeData()" Width="150"></GridForeignColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }

    void ForeignRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.FindAll(".e-row").Count > 0);
        Assert.True(9 == cut.FindAll(".e-row").Count, "Number of rows generated properly");
        Assert.True(4 == cut.Find(".e-row").Children.Count(), "Number of cells generated properly");
        Assert.True(9 == cut.Instance.CurrentViewData.Count(), "CurrentViewData count is proper");
        Assert.True(cut.Instance.Columns[0].IsForeignColumn() == false, "OrderID column");
        Assert.True(cut.Instance.Columns[1].IsForeignColumn() == true, "ForeignKey column");
        Assert.True(cut.Instance.Columns[1].IsForeignKeyField() == false, "isForeignKeyMethod both field and foreignkey field are same");
        Assert.True(cut.Instance.Columns[1].ForeignKeyValue == "FirstName", "Foreign Key Value Field");
    }
}

