@*Test 12: INTERACTIVE - Multiple Column Filtering with UI Interaction*@
<SfFixture @ref="fixture12" TestAsync="MultipleColumnUIFiltering" Description="Multiple Column Filtering with UI Interaction (Interactive UI Test)">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings ShowFilterBarOperator="true" Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" Mode="FilterBarMode.Immediate"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Type="ColumnType.Integer" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Type="ColumnType.String" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Type="ColumnType.Double" Format="C2" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture12 { get; set; }

    async Task MultipleColumnUIFiltering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;
        var initialCount = Grid.CurrentViewData.Count();

        // Apply filter to first column (OrderID) with "equal" operator
        var filterIcons = cut.FindAll(".e-icons.e-filter");
        Assert.True(filterIcons.Count >= 3, "Should have 3 filter icons for 3 columns");

        // Click first filter icon (OrderID)
        filterIcons[0].Click();
        await Task.Delay(500);
        var dropdowns1 = cut.FindAll(".e-dropdownlist");
        dropdowns1[0].MouseDown();
        await Task.Delay(500);
        cut.Find("li[data-value=\"equal\"]")?.Click();
        await Task.Delay(500);
        var inputs1 = cut.FindAll(".e-enhanced-filter-input input");
        inputs1[0].Input("10248");
        await Task.Delay(1000);

      

        // Apply filter to second column (CustomerID) with "contains" operator
        filterIcons[1].Click();
        await Task.Delay(500);
        var dropdowns2 = cut.FindAll(".e-dropdownlist");
        dropdowns2[0].MouseDown();
        await Task.Delay(500);
        cut.Find("li[data-value=\"contains\"]")?.Click();
        await Task.Delay(500);
        var inputs2 = cut.FindAll(".e-enhanced-filter-input input");
        inputs2[1].Input("VINET");
        await Task.Delay(1000);


        // Verify results are filtered
        var filteredCount = cut.FindAll(".e-row").Count;
        Assert.True(filteredCount <= initialCount, "Filtered results should be subset of initial data");

        // Clear all filters
        await Grid.ClearFilteringAsync();

    }
}

@*Test 13: INTERACTIVE - Operator Switching on Same Column*@
<SfFixture @ref="fixture13" TestAsync="OperatorSwitchingUI" Description="Operator Switching on Same Column (Interactive UI Test)">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings ShowFilterBarOperator="true" Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" Mode="FilterBarMode.Immediate"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Type="ColumnType.String" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture13 { get; set; }

    async Task OperatorSwitchingUI(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;

        // First, apply filter with "contains" operator
        var filterIcons = cut.FindAll(".e-icons.e-filter");
        filterIcons[0].Click();
        await Task.Delay(500);
        var dropdowns = cut.FindAll(".e-dropdownlist");
        dropdowns[0].MouseDown();
        await Task.Delay(500);
        cut.Find("li[data-value=\"contains\"]")?.Click();
        await Task.Delay(500);
        var inputs = cut.FindAll(".e-enhanced-filter-input input");
        inputs[0].Input("ALF");
        await Task.Delay(1000);

        
