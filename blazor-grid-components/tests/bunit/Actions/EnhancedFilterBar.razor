@inherits GridTestBase
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Tests
@using System.Threading.Tasks
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@*Enhanced FilterBar Component Tests - Interactive Tests with Operator Dropdown Click*@

@*Test 1: Basic ShowFilterOperator Rendering with Immediate Mode*@
<SfFixture @ref="fixture1" Test="ShowFilterBarOperatorBasicRenderingImmediate" Description="Enhanced FilterBar Rendering with Immediate Mode">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings ShowFilterBarOperator="true" Type="Syncfusion.Blazor.Grids.FilterType.FilterBar" Mode="FilterBarMode.Immediate"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Type="ColumnType.Integer" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Type="ColumnType.String" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Type="ColumnType.Double" Format="C2" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" HeaderText="Order Date" Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDateOff)" HeaderText="Shipped Date" Type="ColumnType.DateTime" Format="dd/MM/yyyy hh:mm" Width="130"></GridColumn>
                <GridColumn Field="@nameof(Order.Verified)" HeaderText="Verified" Type="ColumnType.Boolean" DisplayAsCheckBox="true" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture1 { get; set; }

    async void ShowFilterBarOperatorBasicRenderingImmediate(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;
        
        // Verify enhanced filter bar is rendered
       
        var enhancedFilterInputs = cut.FindAll(".e-enhanced-filter-input");
        Assert.True(enhancedFilterInputs.Count > 0, "Enhanced filter inputs should be rendered");

        // Verify operator dropdown icons are present
       
        var filterIcons = cut.FindAll(".e-icons.e-filter");
        Assert.True(filterIcons.Count > 0, "Filter operator icons should be rendered");

        // Verify grid is in immediate mode
        Assert.True(Grid.FilterSettings.Mode == FilterBarMode.Immediate, "Filter mode should be Immediate");
        Assert.True(Grid.FilterSettings.ShowFilterBarOperator == true, "ShowFilterBarOperator should be enabled");
    }
}

