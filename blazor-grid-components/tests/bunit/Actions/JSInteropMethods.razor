    public void BeforeCopyPasteHandler(BeforeCopyPasteEventArgs args)
    {
        // Store the event args for verification
        copyPasteEventArgsList.Add(args);

        // READ all properties (GET operations)
        string? action = args.Action;
        bool isCancelled = args.Cancel;
        string? clipboardText = args.ClipboardText;

        // MODIFY settable properties (SET operations)
        // Scenario 1: Transform clipboard text for copy action
        if (args.Action == "copy" && !string.IsNullOrEmpty(args.ClipboardText))
        {
            args.ClipboardText = args.ClipboardText.ToUpper() + "_COPIED";
        }

        // Scenario 2: Transform clipboard text for paste action
        if (args.Action == "paste" && !string.IsNullOrEmpty(args.ClipboardText))
        {
            args.ClipboardText = args.ClipboardText.Replace("\t", " | "); // Replace tabs with pipe separator
        }

        // Scenario 3: Cancel copy action for specific conditions
        if (args.Action == "copy" && args.ClipboardText?.Contains("SENSITIVE") == true)
        {
            args.Cancel = true; // Cancel copy of sensitive data
        }

        // Scenario 4: Limit paste size
        if (args.Action == "paste" && args.ClipboardText?.Length > 100)
        {
            args.Cancel = true; // Cancel if pasting too much data
        }
    }

