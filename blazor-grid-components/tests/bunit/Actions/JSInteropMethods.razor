        });

        // ===== Test Scenario 2: Paste Action with Text Transformation =====
        var pasteEventArgs = new BeforeCopyPasteEventArgs()
        {
            Action = "paste",
            Cancel = false,
            ClipboardText = "Field1\tField2\tField3"
        };

        var pasteJson = JsonSerializer.Serialize(pasteEventArgs);
        await cut.InvokeAsync(async () =>
        {
            await cut.Instance._jsAdaptor.InvokeCopyPasteAction(pasteJson, "paste");
        });

        // ===== Test Scenario 3: Copy Sensitive Data (Should be Cancelled) =====
        var sensitiveEventArgs = new BeforeCopyPasteEventArgs()
        {
            Action = "copy",
            Cancel = false,
            ClipboardText = "SENSITIVE CUSTOMER DATA"
        };

        var sensitiveJson = JsonSerializer.Serialize(sensitiveEventArgs);
        await cut.InvokeAsync(async () =>
        {
            await cut.Instance._jsAdaptor.InvokeCopyPasteAction(sensitiveJson, "copy");
        });

        // ===== Test Scenario 4: Paste Large Data (Should be Cancelled) =====
        string largeData = string.Concat(Enumerable.Repeat("X", 150)); // 150 characters > 100 limit
        var largeDataEventArgs = new BeforeCopyPasteEventArgs()
