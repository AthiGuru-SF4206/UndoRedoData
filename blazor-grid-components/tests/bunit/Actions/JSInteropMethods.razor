<SfFixture @ref="fixture12" TestAsync="GridBasicRendering12" Description="BeforeAutoFillCell Event with UpdateCell">
    <ComponentUnderTest>
        <SfGrid ID="Grid" DataSource="GenerateRows()" AllowSelection="true" EnableAutoFill=true AllowPaging=true Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Cancel", "Update" })">
            <GridEditSettings AllowAdding=true AllowDeleting=true AllowEditing=true Mode="EditMode.Batch"></GridEditSettings>
            <GridSelectionSettings Mode="SelectionMode.Cell" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridEvents BeforeAutoFillCell="BeforeAutoFillCellHandler" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" Uid="ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Uid="Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Uid="Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Uid="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture12 { get; set; }
    private BeforeAutoFillCellEventArgs<Order>? capturedEventArgs;

    public void BeforeAutoFillCellHandler(BeforeAutoFillCellEventArgs<Order> args)
    {
        // Store event args for test verification
        capturedEventArgs = args;

        // Read all properties (GET operations)
        int rowIndex = args.RowIndex;
        int columnIndex = args.ColumnIndex;
        string? columnName = args.ColumnName;
        object? currentValue = args.Value;
        Order? rowData = args.Data;
        bool isCancelled = args.Cancel;

        // Modify settable properties (SET operations)
        // Change the value being filled in the cell
        if (args.ColumnName == nameof(Order.CustomerID))
        {
            args.Value = "MODIFIED_" + (args.Value ?? "DEFAULT");
        }

        // Demonstrate Cancel property usage - example: cancel for specific conditions
        if (args.RowIndex > 5)
        {
            args.Cancel = true; // Cancel autofill for rows beyond index 5
        }
    }

    public async Task GridBasicRendering12(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");

        // Select a cell to start editing
        await cut.Instance.SelectRowAsync(0);
        await cut.Instance.StartEditAsync();

        // Update multiple cells using UpdateCell method which triggers BeforeAutoFillCell event
        await cut.Instance._jsAdaptor.UpdateCell(0, nameof(Order.CustomerID), "CUSTOMERID_1");
        await cut.Instance._jsAdaptor.UpdateCell(1, nameof(Order.CustomerID), "CUSTOMERID_2");
        await cut.Instance._jsAdaptor.UpdateCell(2, nameof(Order.Freight), "150.50");

        // Verify event args were captured and processed
        await cut.InvokeAsync(() =>
        {
            if (capturedEventArgs != null)
            {
                // Verify RowIndex property was read
                Assert.True(capturedEventArgs.RowIndex >= 0, "RowIndex should be non-negative");

                // Verify ColumnIndex property was read
                Assert.True(capturedEventArgs.ColumnIndex >= 0, "ColumnIndex should be non-negative");

                // Verify ColumnName property was read
                Assert.NotNull(capturedEventArgs.ColumnName);
                Assert.False(string.IsNullOrEmpty(capturedEventArgs.ColumnName), "ColumnName should not be empty");

                // Verify Value property can be read and set
                Assert.NotNull(capturedEventArgs.Value);

                // Verify Data property was read
                Assert.NotNull(capturedEventArgs.Data);

                // Verify Cancel property can be read and set
                Assert.False(capturedEventArgs.Cancel == null, "Cancel property should exist");
            }
        });
    }            
}

