@code{
    SfFixture fixture14 { get; set; }
    private SfGrid<Order> gridRef14;
    private List<BeforeCellPasteEventArgs<Order>> pasteEventArgsList = new();

    public void BeforeCellPasteHandler(BeforeCellPasteEventArgs<Order> args)
    {
        // Store the event args for verification
        pasteEventArgsList.Add(args);

        // READ all properties (GET operations)
        bool isCancelled = args.Cancel;
        string? pasteValue = args.CellValue;
        string? columnName = args.ColumnName;
        int columnIndex = args.ColumnIndex;
        Order? rowData = args.Data;
        int rowIndex = args.RowIndex;

        // MODIFY settable properties (SET operations)
        // Modify CellValue - transform the pasted value
        if (!string.IsNullOrEmpty(args.CellValue) && args.ColumnName == nameof(Order.CustomerID))
        {
            args.CellValue = args.CellValue.ToUpper() + "_PASTED";
        }

        // Modify Freight value if pasting numeric data
        if (args.ColumnName == nameof(Order.Freight) && decimal.TryParse(args.CellValue, out var freightValue))
        {
            args.CellValue = (freightValue * 1.1m).ToString(); // Add 10% markup
        }

        // Conditionally cancel paste for specific rows
        if (args.RowIndex >= 5)
        {
            args.Cancel = true; // Cancel paste for rows beyond index 5
        }
    }

    public async Task GridBasicRendering14(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");

        // Initialize the paste event args list for this test
        pasteEventArgsList.Clear();

        // Select a cell to enable paste operations
        await cut.Instance.SelectRowAsync(0);
        //await cut.Instance.SelectCellAsync(0, 1); // Select CustomerID cell

        // Simulate paste actions using InvokePasteAction
        // Create BeforeCellPasteEventArgs JSON object for CustomerID column
        var pasteArgsForCustomerID = new BeforeCellPasteEventArgs<Order>()
        {
            CellValue = "testcustomer",
            ColumnName = nameof(Order.CustomerID),
            ColumnIndex = 1,
            RowIndex = 0,
            Cancel = false,
            Data = cut.Instance.Rows[0].Data as Order
        };

        // Invoke paste action for CustomerID
        // Note: InvokePasteAction expects (args object, rowIndex, columnIndex, columnField)
        var pasteJsonForCustomerID = JsonSerializer.Serialize(pasteArgsForCustomerID);
        await cut.InvokeAsync(async () =>
        {
            await cut.Instance._jsAdaptor.InvokePasteAction(pasteJsonForCustomerID, 0, 1, nameof(Order.CustomerID));
        });

        // Simulate paste action for Freight column
        var pasteArgsForFreight = new BeforeCellPasteEventArgs<Order>()
        {
            CellValue = "100.00",
            ColumnName = nameof(Order.Freight),
            ColumnIndex = 3,
            RowIndex = 1,
            Cancel = false,
            Data = cut.Instance.Rows[1].Data as Order
        };

        var pasteJsonForFreight = JsonSerializer.Serialize(pasteArgsForFreight);
        await cut.InvokeAsync(async () =>
        {
            await cut.Instance._jsAdaptor.InvokePasteAction(pasteJsonForFreight, 1, 3, nameof(Order.Freight));
        });

        // Test cancellation scenario - paste to row index 5 or beyond
        var pasteArgsCancelled = new BeforeCellPasteEventArgs<Order>()
        {
            CellValue = "shouldbecancelled",
            ColumnName = nameof(Order.CustomerID),
            ColumnIndex = 1,
            RowIndex = 6,
            Cancel = false,
            Data = cut.Instance.Rows[6].Data as Order
        };

        var pasteJsonCancelled = JsonSerializer.Serialize(pasteArgsCancelled);
        await cut.InvokeAsync(async () =>
        {
            await cut.Instance._jsAdaptor.InvokePasteAction(pasteJsonCancelled, 6, 1, nameof(Order.CustomerID));
        });

        // Verify event args were captured and processed
        await cut.InvokeAsync(() =>
        {
            Assert.True(pasteEventArgsList.Count > 0, "BeforeCellPaste event should have been triggered");

            // Verify first paste operation (CustomerID)
            var firstPasteEvent = pasteEventArgsList[0];
            Assert.NotNull(firstPasteEvent);
            Assert.Equal(0, firstPasteEvent.RowIndex);
            Assert.Equal(1, firstPasteEvent.ColumnIndex);
            Assert.Equal(nameof(Order.CustomerID), firstPasteEvent.ColumnName);
            Assert.NotNull(firstPasteEvent.CellValue);
            Assert.Contains("PASTED", firstPasteEvent.CellValue); // Verify value was modified
            Assert.NotNull(firstPasteEvent.Data);

            // Verify second paste operation (Freight with numeric transformation)
            if (pasteEventArgsList.Count > 1)
            {
                var secondPasteEvent = pasteEventArgsList[1];
                Assert.Equal(1, secondPasteEvent.RowIndex);
                Assert.Equal(nameof(Order.Freight), secondPasteEvent.ColumnName);
                // Value should have 10% markup applied
                if (decimal.TryParse(secondPasteEvent.CellValue, out var resultFreight))
                {
                    Assert.True(resultFreight > 100, "Freight value should have 10% markup applied");
                }
            }

            // Verify cancellation scenario
            if (pasteEventArgsList.Count > 2)
            {
                var cancelledPasteEvent = pasteEventArgsList[2];
                Assert.True(cancelledPasteEvent.Cancel, "Paste should be cancelled for row index >= 5");
            }
        });
    }
