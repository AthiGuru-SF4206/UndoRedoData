        var col = (Syncfusion.Blazor.Grids.GridColumn)colProp.GetValue(inst)!;
        col.Type = Syncfusion.Blazor.Grids.ColumnType.Integer;
        col.ValueType = typeof(int?);

        // Create and set numeric operator dropdowns (first >=, second <=)
        var firstNumDropProp = t.GetProperty("FirstNumberOperatorDropDown", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        var secondNumDropProp = t.GetProperty("SecondNumberOperatorDropDown", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        var firstNumDrop = Activator.CreateInstance(firstNumDropProp.PropertyType)!;
        var secondNumDrop = Activator.CreateInstance(secondNumDropProp.PropertyType)!;
        firstNumDropProp.SetValue(inst, firstNumDrop);
        secondNumDropProp.SetValue(inst, secondNumDrop);

        var opValProp = firstNumDrop.GetType().GetProperty("Value")!;
        var opValProp2 = secondNumDrop.GetType().GetProperty("Value")!;
        opValProp.SetValue(firstNumDrop, "greaterthanorequal");
        opValProp2.SetValue(secondNumDrop, "lessthanorequal");

        // Create numeric editors and set values
        var firstIntProp = t.GetProperty("FirstNumericValueasInt", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        var secondIntProp = t.GetProperty("SecondNumericValueasInt", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        var firstInt = Activator.CreateInstance(firstIntProp.PropertyType)!;
        var secondInt = Activator.CreateInstance(secondIntProp.PropertyType)!;
        firstIntProp.SetValue(inst, firstInt);
        secondIntProp.SetValue(inst, secondInt);

        var intValProp = firstInt.GetType().GetProperty("Value")!;
        intValProp.SetValue(firstInt, 1001);
        intValProp.SetValue(secondInt, 1005);

        // Force integer branch
        var isIntProp = t.GetProperty("_isInteger", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var isLongProp = t.GetProperty("_isLong", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        isIntProp?.SetValue(inst, true);
        isLongProp?.SetValue(inst, false);

        // Read via value readers (may return boxed int/long/double)
        var first = inst.GetFirstColumnFilterValue();   // expected numeric (1001)
        var second = inst.GetSecondColumnFilterValue(); // expected numeric (1005)

        Assert.NotNull(first);
        Assert.NotNull(second);

        // 🔒 Type-agnostic numeric comparison (avoids InvalidCastException on boxed double/long)
        var firstAsInt = Convert.ToInt32(first);
        var secondAsInt = Convert.ToInt32(second);

        Assert.Equal(1001, firstAsInt);
        Assert.Equal(1005, secondAsInt);

        await Task.CompletedTask;
    }
}
<SfFixture @ref="fixture55" TestAsync="ExcelFilter_Closed_And_OnCloseMenu_CancelBranches" Description="Excel Closed() cancel and OnCloseMenu() ParentItem null branches">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture55 { get; set; }

    public async Task ExcelFilter_Closed_And_OnCloseMenu_CancelBranches(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.False(cut.Instance.EnableAdaptiveUI);

        // Open Excel dialog once to ensure FilterModule and excel instance are ready
        cut.FindAll(".e-filtermenudiv")[0].Click();
        var excel = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var inst = excel.Instance;
        var t = inst.GetType();

        // -------------------------
        // OnCloseMenu: ParentItem == null => Cancel = true; IsSubMenuDialog=false
        // -------------------------
        var argsType = typeof(Syncfusion.Blazor.Navigations.BeforeOpenCloseMenuEventArgs<>)
                       .MakeGenericType(typeof(Syncfusion.Blazor.Navigations.MenuItem));
        var args = Activator.CreateInstance(argsType)!;
        var cancelProp = argsType.GetProperty("Cancel")!;
        var parentItemProp = argsType.GetProperty("ParentItem")!;
        cancelProp.SetValue(args, false);
        parentItemProp.SetValue(args, null);

        // Set IsSubMenuDialog = true then call OnCloseMenu (not UI-blocking)
        var isSubMenuProp = t.GetProperty("IsSubMenuDialog", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        isSubMenuProp.SetValue(inst, true);

        t.GetMethod("OnCloseMenu", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!
         .Invoke(inst, new object[] { args });

        Assert.True((bool)cancelProp.GetValue(args)!, "OnCloseMenu must set Cancel=true when ParentItem is null");
        Assert.False((bool)isSubMenuProp.GetValue(inst)!, "OnCloseMenu must set IsSubMenuDialog=false for non-adaptive");

        // -------------------------
        // Closed(): when !isDialogClosed and FilterModule != null => args.Cancel=true & isDialogClosed=true
        // -------------------------
        var isDialogClosedField = t.GetField("isDialogClosed", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        isDialogClosedField.SetValue(inst, false);

        var beforeCloseType = typeof(Syncfusion.Blazor.Popups.BeforeCloseEventArgs);
        var beforeCloseArgs = Activator.CreateInstance(beforeCloseType)!;
        var bcCancelProp = beforeCloseType.GetProperty("Cancel")!;
        bcCancelProp.SetValue(beforeCloseArgs, false);

        // Closed() may trigger StateHasChanged/EventAggregator → run on dispatcher
        await cut.InvokeAsync(() =>
        {
            t.GetMethod("Closed", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!
             .Invoke(inst, new object[] { beforeCloseArgs });
        });

        Assert.True((bool)bcCancelProp.GetValue(beforeCloseArgs)!, "Closed must set args.Cancel=true");
        Assert.True((bool)isDialogClosedField.GetValue(inst)!, "Closed must set isDialogClosed=true");
    }
}
