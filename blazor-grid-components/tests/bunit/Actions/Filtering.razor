@code{

    async void GridStringColumnTesting(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;

        //Filter string with * operator //Filter number with ! operator testing
        await filterColumn("CustomerID", "*VI", Grid, cut).ContinueWith(c =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.StartsWith);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "CustomerID", Operator.StartsWith.ToString().ToLower(), "VI"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter string with % first operator testing
        await filterColumn("CustomerID", "%v", Grid, cut).ContinueWith(c =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.EndsWith);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "CustomerID", Operator.EndsWith.ToString().ToLower(), "V"));
            clearFilter(Grid, cut).GetAwaiter();
        });
        //Filter string with % last operator testing
        await filterColumn("CustomerID", "b%", Grid, cut).ContinueWith(c =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.StartsWith);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "CustomerID", Operator.StartsWith.ToString().ToLower(), "b"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter string with empty operator testing
        await filterColumn("CustomerID", "", Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("CustomerID", "isempty", "");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 0);
            Assert.True(cut.FindAll(".e-row").Count == 0, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        //Filter string with not empty operator testing
        await filterColumn("CustomerID", "", Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("CustomerID", "isnotempty","");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 12);
            Assert.True(cut.FindAll(".e-row").Count == 12, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        //Filter string with doesnotstarswith operator testing
        await filterColumn("CustomerID", "A", Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("CustomerID", "doesnotstartswith", "A");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 8);
            Assert.True(cut.FindAll(".e-row").Count == 8, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        //Filter string with doesnotendswith operator testing
        await filterColumn("CustomerID", "D", Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("CustomerID", "doesnotendswith", "D");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 12);
            Assert.True(cut.FindAll(".e-row").Count == 12, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        //Filter string with doesnotcontains operator testing
        await filterColumn("CustomerID", "A", Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("CustomerID", "doesnotcontains", "A");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 8);
            Assert.True(cut.FindAll(".e-row").Count == 8, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        //Filter string with like operator testing
        await filterColumn("CustomerID", "%A", Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("CustomerID", "like", "%A");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 12);
            Assert.True(cut.FindAll(".e-row").Count == 12, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
            await Grid.FilterByColumnAsync("CustomerID", "like", "%D");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 4);
            Assert.True(cut.FindAll(".e-row").Count == 4, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
            await Grid.FilterByColumnAsync("CustomerID", "like", "%A%");
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 12);
            Assert.True(cut.FindAll(".e-row").Count == 12, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        await filterColumn("CustomerID", "A*R", Grid, cut).ContinueWith(async c =>
