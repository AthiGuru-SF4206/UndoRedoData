<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Flat grid with filterBar type">

    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code{

    SfFixture fixture { get; set; }
    SfFixture fixture1 { get; set; }
    bool _canAssert = false;

    public async Task filterColumn(string colName, string value, SfGrid<Order> Grid, IRenderedComponent<SfGrid<Order>> comp)
    {

        comp.Find($"[id ={colName}_filterBarcell]").Input(value);
        comp.Find($"[id ={colName}_filterBarcell]").KeyDown(new KeyboardEventArgs() { Key = "Enter" });
        comp.WaitForState(() => Grid.FilterSettings.Columns.Count() == 1, TimeSpan.FromSeconds(200));
        Syncfusion.Blazor.Grids.Internal.FilterBarParameters filterBarParameters = new Blazor.Grids.Internal.FilterBarParameters();
        var rows = filterBarParameters.Rows;
    }

    public async Task clearFilter(SfGrid<Order> Grid, IRenderedComponent<SfGrid<Order>> comp)
    {

        await Grid.ClearFilteringAsync();
        comp.WaitForState(() => Grid.FilterSettings.Columns.Count() == 0);
        comp.WaitForState(() => comp.FindAll(".e-row").Count == 12);

    }

    @*FilterBarTest-BasicMethods*@
    async void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        _canAssert = true;
        var Grid = cut.Instance;
        Grid.AllowFiltering = false;
        await Grid.Refresh();
        cut.WaitForState(() => cut.FindAll(".e-filterbar").Count() == 0);
        Assert.True(cut.FindAll(".e-filterbar").Count() == 0, "AllowFiltering false testing");

        Grid.AllowFiltering = true;
        await Grid.Refresh();
        cut.WaitForState(() => cut.FindAll(".e-filterbar").Count() == 1);
        Assert.True(cut.FindAll(".e-filterbar").Count() == 1, "AllowFiltering true testing");

        //enable paging
        Grid.AllowPaging = true;
        await Grid.Refresh();
        cut.WaitForState(() => cut.FindAll(".sf-pager").Count() > 0);
        Assert.True(cut.FindAll(".sf-pager").Count() > 0, "Filter-enable pager testing");
            await Grid.Refresh(true);
            var isModelRefreshField = Grid.GetType().GetField(
                        "isGridModelRefresh",
                        System.Reflection.BindingFlags.NonPublic |
                        System.Reflection.BindingFlags.Instance);

            var modelRefreshValue = (bool)isModelRefreshField.GetValue(Grid);
            Assert.True(modelRefreshValue, "Refresh(true) must set isGridModelRefresh = true");
            Assert.False(Grid.RefreshColumnHeader, "RefreshColumnHeader should not be set in model refresh mode.");
            Assert.False(Grid.ForceUpdate, "ForceUpdate should not be set in model refresh mode.");
        await Grid.GoToPageAsync(2);
        var pagerInstance = cut.FindComponent<SfPager>();
        await Grid.PagerRef.RefreshAsync();
        pagerInstance.WaitForState(() => pagerInstance.Find(".e-currentitem").InnerHtml == "2");
        Assert.True(pagerInstance.Find(".e-currentitem").InnerHtml == "2", "Filter-Last page testing");
        await Grid.FilterByColumnAsync("CustomerID", "equal", "ANTON");
        Assert.True(Grid.FilterSettings.Columns.Count() == 1, "Filter method working properly");
        Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "CustomerID", "equal", "ANTON"), "Checking Filtering column object");
        await Grid.ClearFilteringAsync();
        Assert.True(Grid.FilterSettings.Columns.Count() == 0, "Clear filter method working properly");
    }

}

