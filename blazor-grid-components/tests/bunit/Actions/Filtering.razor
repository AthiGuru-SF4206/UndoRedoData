    public async Task ExcelFilter_ValueReaders_ConfiguredNumeric(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        // Open filter on Integer column
        cut.FindAll(".e-filtermenudiv")[0].Click();

        var excel = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var inst = excel.Instance;
        var t = inst.GetType();

        // Ensure Column.Type/ValueType are correct for numeric path
