<SfFixture @ref="fixture1" Test="GridClearFiltering" Description="FilterBarTest- All ClearFilteringMethods">

    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings>
                <GridFilterColumns>
                    <GridFilterColumn Field="CustomerID" MatchCase=false Operator="Operator.StartsWith" Predicate="and" Value="@val"></GridFilterColumn>
                    <GridFilterColumn Field="EmployeeID" MatchCase="false" Operator="Operator.Equal" Predicate="and" Value="@employee"></GridFilterColumn>
                    <GridFilterColumn Field="OrderID" MatchCase="false" Operator="Operator.Equal" Predicate="and" Value="@orderid"></GridFilterColumn>
                </GridFilterColumns>
            </GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
                <GridColumn Field="@nameof(Order.EmployeeID)" Width="150"></GridColumn>
            </GridColumns>

        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {

    public int employee = 4;
    public int orderid = 1001;

    async void GridClearFiltering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.FilterSettings.Columns.Count() == 3, "Initial mulitiple filtering column checked");
        await cut.Instance.ClearFilteringAsync("CustomerID");
        Assert.True(cut.Instance.FilterSettings.Columns.Count() == 2, "Clear the filtering based on the field and count tested");
        await cut.Instance.ClearFilteringAsync(new List<string>() { "EmployeeID", "OrderID" });
        cut.WaitForState(() => cut.Instance.FilterSettings.Columns.Count() == 0);
        Assert.True(cut.Instance.FilterSettings.Columns.Count() == 0, "Clear the filtering using list of String");
    }

    //Checking Filtering Object common
    bool checkFilteringColumn(List<GridFilterColumn> Columns, string field, string filterOperator, string value)
    {
        bool isEqual = true;
        GridFilterColumn filterColumn = Columns.First();
        if (field != null)
        {
            isEqual = isEqual && filterColumn.Field == field;
        }
        if (filterOperator != null)
        {
            isEqual = isEqual && filterColumn.Operator.ToString().ToLower() == filterOperator;
        }
        isEqual = isEqual && filterColumn.Value.ToString().ToLower() == value.ToLower();
        return isEqual;
    }


    void OnActionComplete(ActionEventArgs<Order> args)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Filtering)
        {
            GridTest();
        }

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.ClearFiltering)
        {

            Assert.True(cut.Instance.FilterSettings.Columns.Count() == 0, "Filtering working properly");
        }

    }

    private void GridTest()
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        try
        {
            var pagerInstance = cut.FindComponent<SfPager>();
            pagerInstance.Find(".e-pagerexternalmsg").MarkupMatches(@"<div class=""e-pagerexternalmsg"" aria-label=""Pager external message"">CustomerID: Venkat</div>", "Filter message check");
        }
        catch (Exception exception)
        {
            throw new ArgumentException("Parameter cannot be null");
        }
    }


    async Task OnDataBound()
    {
        if (_canAssert)
        {
            _canAssert = false;
            var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
            var gridInstance = cut.Instance;
            if (gridInstance.FilterSettings.Columns.Count() > 0)
            {
                await gridInstance.ClearFilteringAsync();
            }
        }
    }


}

<SfFixture @ref="fixture3" Test="GridNumberColumnTesting" Description="FilterBarTest- number column and format testing">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
                <GridColumn Field="@nameof(Order.EmployeeID)" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code{

    SfFixture fixture3 { get; set; }

    async void GridNumberColumnTesting(Fixture fixture3)
    {
        var cut = fixture3.GetComponentUnderTest<SfGrid<Order>>();
        var Grid = cut.Instance;
        await Grid.FilterByColumnAsync("OrderID", "equal", 1002);
        cut.WaitForState(() => cut.FindAll(".e-row").Count == 1);
        Assert.True(1 == cut.FindAll(".e-row").Count, "Filter number column testing");
        clearFilter(Grid, cut).GetAwaiter();
        cut.WaitForState(() => Grid.CurrentViewData.Count() > 1);
        cut.WaitForState(() => cut.FindAll(".e-row").Count() > 1);
        Assert.True(Grid.CurrentViewData.Count() == cut.FindAll(".e-row").Count, "clear number Filtering testing");
        await Grid.FilterByColumnAsync("Freight", "equal", 26.70);
        cut.WaitForState(() => Grid.FilterSettings.Columns.Count() == 1);
        cut.WaitForState(() => cut.FindAll(".e-row").Count == 1);
        Assert.True(cut.FindAll(".e-row").Count == 1, "Filter number format column testing");
        Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "Freight", "equal", "26.7"), "Filter number format filter object testing");
        await Grid.ClearFilteringAsync();
        cut.WaitForState(() => Grid.FilterSettings.Columns.Count() == 0);
        cut.WaitForState(() => cut.FindAll(".e-row").Count == 12);
        await filterColumn("OrderID", "<1013", Grid, cut).ContinueWith(t =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.LessThan);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "OrderID", Operator.LessThan.ToString().ToLower(), "1013"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter number with > operator testing issue
        await filterColumn("OrderID", ">1013", Grid, cut).ContinueWith(c =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.GreaterThan);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "OrderID", Operator.GreaterThan.ToString().ToLower(), "1013"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter number with >= operator testing
        await filterColumn("OrderID", ">=1013", Grid, cut).ContinueWith(d =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.GreaterThanOrEqual);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "OrderID", Operator.GreaterThanOrEqual.ToString().ToLower(), "1013"));
            clearFilter(Grid, cut).GetAwaiter();

        });

        //Filter number with <= operator testing
        await filterColumn("OrderID", "<=1013", Grid, cut).ContinueWith(e =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.LessThanOrEqual);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "OrderID", Operator.LessThanOrEqual.ToString().ToLower(), "1013"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter number with = operator testing
        await filterColumn("OrderID", "=1013", Grid, cut).ContinueWith(f =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.Equal);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "OrderID", Operator.Equal.ToString().ToLower(), "1013"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter number with ! operator testing
        await filterColumn("OrderID", "!=1013", Grid, cut).ContinueWith(c =>
        {
            Assert.True(Grid.FilterSettings.Columns[0].Operator == Operator.NotEqual);
            Assert.True(checkFilteringColumn(Grid.FilterSettings.Columns, "OrderID", Operator.NotEqual.ToString().ToLower(), "1013"));
            clearFilter(Grid, cut).GetAwaiter();
        });

        //Filter number with null operator testing
        await filterColumn("OrderID", null, Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("OrderID", "isnull", null);
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 0);
            Assert.True(cut.FindAll(".e-row").Count == 0, "Filter Number column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });

        //Filter number with null operator testing
        await filterColumn("OrderID", null, Grid, cut).ContinueWith(async c =>
        {
            await Grid.FilterByColumnAsync("OrderID", "isnotnull", null);
            cut.WaitForState(() => cut.FindAll(".e-row").Count == 12);
            Assert.True(cut.FindAll(".e-row").Count == 12, "Filter Number column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
        });
    }

}

<SfFixture @ref="fixture" Test="GridStringColumnTesting" Description="Filterbar String operator testing">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
