            cut.WaitForState(() => cut.FindAll(".e-row").Count == 4);
            Assert.True(cut.FindAll(".e-row").Count == 4, "Filter String column testing");
            await Grid.ClearFilteringAsync();
            cut.WaitForState(() => cut.FindAll(".e-row").Count == Grid.CurrentViewData.Count());
