<SfFixture @ref="fixture10" TestAsync="CommandClickHandlerTest" Description="Test CommandClickHandler using reflection to invoke internal method">
    <ComponentUnderTest>
        <SfGrid ID="CommandGrid" @ref="CommandGrid" DataSource="GenerateRows18()" Height="400" RowHeight="38">
            <GridEvents OnRecordClick="@RecordClickHandler" TValue="OrderCommandData"></GridEvents>
            
            <GridPageSettings PageSize="40"></GridPageSettings>
            <GridColumns>
                <GridColumn Field=@nameof(OrderCommandData.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderCommandData.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderCommandData.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn HeaderText="Manage Records" Width="150">
                    <GridCommandColumns>
                        <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
                        <GridCommandColumn Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-delete", CssClass = "e-flat" })"></GridCommandColumn>
                    </GridCommandColumns>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture10 { get; set; }
    private SfGrid<OrderCommandData> CommandGrid;
    public List<OrderCommandData> GridDataCommand { get; set; }

    public async Task CommandClickHandlerTest(Fixture fixture18)
    {
        var cut = fixture18.GetComponentUnderTest<SfGrid<OrderCommandData>>();

       
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.Height != "auto", "Grid height set successfully");

       
        var gridColumn = new GridCommandColumn()
        {
            Type = CommandButtonType.Edit,
            Title = "Command"
        };

        var rowData = new OrderCommandData()
        {
            OrderID = 1001,
            CustomerID = "Alfki",
            OrderDate = new DateTime(1995, 05, 15),
            Freight = 51.4
        };

        var row = new Row<object>()
        {
            Data = rowData,
            Index = 0,
            Uid = "grid-row-1"
        };

        var cell = new Cell<object>()
        {
            Index = 4,
        };


        var rowBase = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.GridRowBase<OrderCommandData>>();

        await rowBase.Instance.CommandClickHandler(gridColumn, row, cell);
        cut.Instance.IsRenderedFromTreeGrid = true;

        gridColumn.Type = CommandButtonType.Delete;
        row.Index = 1;

        await rowBase.Instance.CommandClickHandler(gridColumn, row, cell);

        gridColumn.Type = CommandButtonType.Save;
        row.Index = 2;

        await rowBase.Instance.CommandClickHandler(gridColumn, row, cell);

        gridColumn.Type = CommandButtonType.Cancel;
        row.Index = 3;

        await rowBase.Instance.CommandClickHandler(gridColumn, row, cell);



        Assert.True(cut.Instance.Rows.Count > 0, "Grid rows still available after command click");
        Assert.True(cut.Instance.Height != "auto", "Grid height maintained after command click");
    }
    public void RecordClickHandler(RecordClickEventArgs<OrderCommandData> args)
    {
        
    }

    public List<OrderCommandData> GenerateRows18()
    {
        List<OrderCommandData> data = new List<OrderCommandData>();
        int count = 1000;

        for (int i = 0; i < 50; i++)
        {
            data.Add(new OrderCommandData()
            {
                OrderID = count + 1,
                CustomerID = "Alfki",
                OrderDate = new DateTime(1995, 05, 15),
                Freight = 25.7 * 2
            });
            data.Add(new OrderCommandData()
            {
                OrderID = count + 2,
                CustomerID = "Anantr",
                OrderDate = new DateTime(1994, 04, 04),
                Freight = 26.7 * 2
            });
            count += 2;
        }
        GridDataCommand = data;
        return data;
    }

    public class OrderCommandData
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}
