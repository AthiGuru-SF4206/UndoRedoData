<SfFixture @ref="fixture3" TestAsync="BatchEdit_CustomValidatorTemplate_3" Description="BatchEdit validator template branch and ShowValidationMessage delegate coverage">
    <ComponentUnderTest>
        <SfGrid @ref="Grid3" DataSource="GetRows3()" Toolbar="@(new List<string>() { "Add", "Update", "Cancel" })">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Batch" ShowConfirmDialog="false" ShowDeleteConfirmDialog="false">
                <Validator Context="validatorContext3">
                    @{
                        ValidatorContext3 = validatorContext3 as Syncfusion.Blazor.Grids.ValidatorTemplateContext;
                        ValidatorTemplateCaptured3 = ValidatorContext3 != null;
                    }
                    <div id="custom-validator-3">CustomValidator3</div>
                </Validator>
            </GridEditSettings>
            <GridEvents OnCellEdit="CellEditHandler3" TValue="BatchEditRow3"></GridEvents>
            <GridColumns>
                <GridColumn Field="@nameof(BatchEditRow3.OrderID)" HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120" ValidationRules="@(new ValidationRules { Required = true })"></GridColumn>
                <GridColumn Field="@nameof(BatchEditRow3.CustomerID)" HeaderText="Customer Name" Width="160" ValidationRules="@(new ValidationRules { Required = true, MinLength = 5 })"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture3 { get; set; }
    SfGrid<BatchEditRow3> Grid3 { get; set; }
    List<BatchEditRow3> Data3 { get; set; }
    bool ValidatorTemplateCaptured3 { get; set; }
    Syncfusion.Blazor.Grids.ValidatorTemplateContext? ValidatorContext3 { get; set; }
    bool CellEditSeen3 { get; set; }
    string LastEditedColumn3 { get; set; }

    public List<BatchEditRow3> GetRows3()
    {
        Data3 = new List<BatchEditRow3>
        {
            new BatchEditRow3 { OrderID = 1001, CustomerID = "ALFKI" },
            new BatchEditRow3 { OrderID = 1002, CustomerID = "ANANTR" }
        };
        return Data3;
    }

    public void CellEditHandler3(CellEditArgs<BatchEditRow3> args)
    {
        CellEditSeen3 = true;
        LastEditedColumn3 = args.ColumnName;
        Assert.True(args != null);
        Assert.True(args.RowData != null);
        Assert.True(args.Data != null);
        Assert.True(!string.IsNullOrEmpty(args.ColumnName));
    }

    public async Task BatchEdit_CustomValidatorTemplate_3(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<BatchEditRow3>>();
        var grid = cut.Instance;

        await grid.EditCellAsync(0, nameof(BatchEditRow3.CustomerID));
        cut.WaitForState(() => cut.FindAll(".e-editedbatchcell").Count == 1, TimeSpan.FromSeconds(2));
        cut.WaitForState(() => cut.FindAll("#custom-validator-3").Count == 1, TimeSpan.FromSeconds(2));

        Assert.True(CellEditSeen3);
        Assert.True(LastEditedColumn3 == nameof(BatchEditRow3.CustomerID));
        Assert.True(ValidatorTemplateCaptured3);
        Assert.True(ValidatorContext3 != null);
        Assert.True(ValidatorContext3!.ShowValidationMessage != null);
        Assert.True(ValidatorContext3.EditContext != null);
        Assert.True(ValidatorContext3.Data != null);

        var fieldName = nameof(BatchEditRow3.CustomerID);
        var message = "Custom required message 3";
        ValidatorContext3.ShowValidationMessage!(fieldName, false, message);

        var model = (BatchEditRow3)ValidatorContext3.Data!;
        var editContext = ValidatorContext3.EditContext!;
        var fieldIdentifier = new FieldIdentifier(model, fieldName);
        var messages = editContext.GetValidationMessages(fieldIdentifier).ToList();

        Assert.True(messages.Count >= 0);
        Assert.True(!messages.Any(m => m.Contains(message)));

        await grid.CloseEditAsync();
        Assert.True(cut.FindAll(".e-editedbatchcell").Count == 0);
    }

    public class BatchEditRow3
    {
        public int OrderID { get; set; }
        public string CustomerID { get; set; }
    }
}

