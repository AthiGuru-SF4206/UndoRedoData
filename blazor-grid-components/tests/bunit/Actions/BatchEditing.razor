<SfFixture @ref="fixture6" TestAsync="BatchEdit_AfterRender_Cycles_6" Description="BatchEdit after render coverage through edit save close reopen cycles">
    <ComponentUnderTest>
        <SfGrid @ref="Grid6" DataSource="GetRows6()" Toolbar="@(new List<string>() { "Add", "Update", "Cancel" })">
            <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Batch" ShowConfirmDialog="false" ShowDeleteConfirmDialog="false"></GridEditSettings>
            <GridEvents OnCellEdit="CellEditHandler6" TValue="BatchEditRow6"></GridEvents>
            <GridColumns>
                <GridColumn Field="@nameof(BatchEditRow6.OrderID)" HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120" ValidationRules="@(new ValidationRules { Required = true })"></GridColumn>
                <GridColumn Field="@nameof(BatchEditRow6.CustomerID)" HeaderText="Customer Name" Width="180" ValidationRules="@(new ValidationRules { Required = true, MinLength = 5 })"></GridColumn>
                <GridColumn Field="@nameof(BatchEditRow6.Freight)" HeaderText="Freight" Width="140" EditType="EditType.NumericEdit" TextAlign="TextAlign.Right" ValidationRules="@(new ValidationRules { Required = true, Min = 1, Max = 1000 })"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture6 { get; set; }
    SfGrid<BatchEditRow6> Grid6 { get; set; }
    List<BatchEditRow6> Data6 { get; set; }
    int CellEditCount6 { get; set; }
    string LastEditedColumn6 { get; set; }

    public List<BatchEditRow6> GetRows6()
    {
        Data6 = new List<BatchEditRow6>
        {
            new BatchEditRow6 { OrderID = 4001, CustomerID = "ABCDE", Freight = 10 },
            new BatchEditRow6 { OrderID = 4002, CustomerID = "FGHIJ", Freight = 20 }
        };
        return Data6;
    }

    public void CellEditHandler6(CellEditArgs<BatchEditRow6> args)
    {
        CellEditCount6++;
        LastEditedColumn6 = args.ColumnName;
        Assert.True(args != null);
        Assert.True(args.RowData != null);
        Assert.True(args.Data != null);
        Assert.True(!string.IsNullOrEmpty(args.ColumnName));
    }

    public async Task BatchEdit_AfterRender_Cycles_6(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<BatchEditRow6>>();
        var grid = cut.Instance;

        Assert.True(CellEditCount6 == 0);

        await grid.EditCellAsync(0, nameof(BatchEditRow6.CustomerID));
        cut.WaitForState(() => cut.FindAll(".e-editedbatchcell").Count == 1, TimeSpan.FromSeconds(2));
        Assert.True(CellEditCount6 >= 1);
        Assert.True(LastEditedColumn6 == nameof(BatchEditRow6.CustomerID));

        var input = cut.FindAll(".e-editedbatchcell input").First();
        input.Change("A");

        await grid.SaveCellAsync();
        Assert.True(cut.FindAll(".e-editedbatchcell").Count == 1);

        await grid.CloseEditAsync();
        Assert.True(cut.FindAll(".e-editedbatchcell").Count == 0);

        await grid.EditCellAsync(0, nameof(BatchEditRow6.Freight));
        cut.WaitForState(() => cut.FindAll(".e-numerictextbox").Count > 0 || cut.FindAll(".e-editedbatchcell").Count == 1, TimeSpan.FromSeconds(2));
        Assert.True(CellEditCount6 >= 2);
        Assert.True(LastEditedColumn6 == nameof(BatchEditRow6.Freight));

        await grid.CloseEditAsync();
        Assert.True(cut.FindAll(".e-editedbatchcell").Count == 0);
    }

    public class BatchEditRow6
    {
        public int OrderID { get; set; }
        public string CustomerID { get; set; }
        public double Freight { get; set; }
    }
}