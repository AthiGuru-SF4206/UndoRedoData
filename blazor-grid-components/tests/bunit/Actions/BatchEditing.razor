    public List<BatchEditRow4> GetRows4()
    {
        Data4 = new List<BatchEditRow4>
        {
            new BatchEditRow4 { OrderID = 2001, CustomerID = "ABCDE" },
            new BatchEditRow4 { OrderID = 2002, CustomerID = "FGHIJ" }
        };
        return Data4;
    }

    public void ActionBeginHandler4(ActionEventArgs<BatchEditRow4> args)
    {
        RequestTypes4.Add(args.RequestType);
        Assert.True(args != null);
        Assert.True(args.RequestType == args.RequestType);
    }

    public async Task BatchEdit_DefaultValidators_4(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<BatchEditRow4>>();
        var grid = cut.Instance;

        await grid.EditCellAsync(0, nameof(BatchEditRow4.CustomerID));
        cut.WaitForState(() => cut.FindAll(".e-editedbatchcell").Count == 1, TimeSpan.FromSeconds(2));
        Assert.True(cut.FindAll(".e-editedbatchcell").Count == 1);

        var input = cut.FindAll(".e-editedbatchcell input").First();
        input.Change("A");

        await grid.SaveCellAsync();
        Assert.True(cut.FindAll(".e-editedbatchcell").Count == 1);

        input = cut.FindAll(".e-editedbatchcell input").First();
        input.Change("VALIDX");

        await grid.SaveCellAsync();
