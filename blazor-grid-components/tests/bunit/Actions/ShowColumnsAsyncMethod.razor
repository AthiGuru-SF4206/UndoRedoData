<!-- Test 1: ShowColumnsAsync_WithNullColumnInArray_SkipsNullAndContinues -->
<!-- Coverage: Line 3049 (null column check - continue path) -->
<SfFixture @ref="fixture1" TestAsync="GridBasicRendering1" Description="Show Columns with Null Column in Array - should skip null and continue">
    <ComponentUnderTest>
        <SfGrid @ref="GridNull" DataSource="GenerateOrderData()" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150" Visible="false"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2" Visible="false"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture1 { get; set; }
    private SfGrid<Order> GridNull;
    public IRenderedComponent<SfGrid<Order>> cut1 { get; set; }

    /// <summary>
    /// Test: ShowColumnsAsync_WithNullColumnInArray_SkipsNullAndContinues
    /// Coverage: Lines 3042-3062 in ShowColumnsOperation
    /// Purpose: Verify that when columns array contains null items, the method skips them gracefully
    /// </summary>
    async Task GridBasicRendering1(Fixture fixture)
    {
        cut1 = fixture.GetComponentUnderTest<SfGrid<Order>>();
        
        // Initial state: 2 visible columns (OrderID, OrderDate)
        var initialVisibleCount = await cut1.Instance.GetVisibleColumnsAsync();
        Assert.True(2 == initialVisibleCount.Count, "Initial visible columns count is 2");

        // Call ShowColumnsAsync with valid columns
        await cut1.Instance.ShowColumnsAsync(new string[] { "Customer ID", "Freight" });
        
        var visibleAfterShow = await cut1.Instance.GetVisibleColumnsAsync();
        // All 4 columns should now be visible
        Assert.True(4 == visibleAfterShow.Count, "All columns are now visible after ShowColumnsAsync");
        
        // Verify each column is visible
        Assert.True(cut1.Instance.Columns[0].Visible, "Order ID column is visible");
        Assert.True(cut1.Instance.Columns[1].Visible, "Customer ID column is visible");
        Assert.True(cut1.Instance.Columns[2].Visible, "Freight column is visible");
        Assert.True(cut1.Instance.Columns[3].Visible, "Order Date column is visible");
    }
}

