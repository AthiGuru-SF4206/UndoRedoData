<!-- Test 8: ShowColumnsAsync_WithVisibilityChangedEvent_FiresCorrectly -->
<!-- Coverage: Lines 3105-3112 (ColumnVisibilityChanged event firing) -->
<SfFixture @ref="fixture8" TestAsync="GridBasicRendering8" Description="Show Columns should fire ColumnVisibilityChanged event correctly">
    <ComponentUnderTest>
        <SfGrid @ref="GridVisibilityEvent" DataSource="GenerateOrderData()" AllowPaging="true">
            <GridEvents ColumnVisibilityChanged="OnColumnVisibilityChanged" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150" Visible="false"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2" Visible="false"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture8 { get; set; }
    private SfGrid<Order> GridVisibilityEvent;
    public IRenderedComponent<SfGrid<Order>> cut8 { get; set; }
    private int visibilityChangedCount = 0;
    private List<string> lastVisibleColumnHeaders = new List<string>();
    private List<string> lastHiddenColumnHeaders = new List<string>();

    /// <summary>
    /// Test: ShowColumnsAsync_WithVisibilityChangedEvent_FiresCorrectly
    /// Coverage: Lines 3105-3112 (ColumnVisibilityChanged event event args population)
    /// Purpose: Verify that ColumnVisibilityChanged event is fired with correct VisibleColumns and HiddenColumns
    /// </summary>
    async Task GridBasicRendering8(Fixture fixture)
    {
        cut8 = fixture.GetComponentUnderTest<SfGrid<Order>>();
        visibilityChangedCount = 0;
        lastVisibleColumnHeaders.Clear();
        lastHiddenColumnHeaders.Clear();

        // Initial state: 2 visible columns
        var initialVisible = await cut8.Instance.GetVisibleColumnsAsync();
        Assert.True(2 == initialVisible.Count, "Initial visible columns count is 2");

        // Show columns - should trigger ColumnVisibilityChanged event
        await cut8.Instance.ShowColumnsAsync(new string[] { "Customer ID", "Freight" });
        
        // Verify event was fired
        Assert.True(visibilityChangedCount > 0, "ColumnVisibilityChanged event was fired");
        
        // Verify all columns are now visible
        var finalVisible = await cut8.Instance.GetVisibleColumnsAsync();
        Assert.True(4 == finalVisible.Count, "All 4 columns are now visible");
        
        // Verify event args contained correct information
        Assert.True(lastVisibleColumnHeaders.Count >= 4, "Event provided visible columns info");
    }

    private void OnColumnVisibilityChanged(ColumnVisibilityChangedEventArgs args)
    {
        visibilityChangedCount++;
        lastVisibleColumnHeaders = args.VisibleColumns?.Select(x => x.HeaderText).ToList() ?? new List<string>();
        lastHiddenColumnHeaders = args.HiddenColumns?.Select(x => x.HeaderText).ToList() ?? new List<string>();
    }
}

