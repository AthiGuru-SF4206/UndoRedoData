@code
{
    SfFixture fixture9 { get; set; }
    private SfGrid<Order> GridActionCompleteEvent;
    public IRenderedComponent<SfGrid<Order>> cut9 { get; set; }
    private int actionCompleteCount = 0;
    private Blazor.Grids.Action lastActionRequestType = default;
    private int lastVisibleColumnsCount = 0;

    /// <summary>
    /// Test: ShowColumnsAsync_WithActionCompleteEvent_FiresWithColumnState
    /// Coverage: Lines 3098-3103 (OnActionComplete event firing with ColumnState RequestType)
    /// Purpose: Verify that OnActionComplete event is fired with RequestType=ColumnState and VisibleColumns populated
    /// </summary>
    async Task GridBasicRendering9(Fixture fixture)
    {
        cut9 = fixture.GetComponentUnderTest<SfGrid<Order>>();
        actionCompleteCount = 0;
        lastActionRequestType = default;
        lastVisibleColumnsCount = 0;

        // Initial state
        var initialVisible = await cut9.Instance.GetVisibleColumnsAsync();
        Assert.True(3 == initialVisible.Count, "Initial visible columns count is 3");

        // Show column - should trigger OnActionComplete event
        await cut9.Instance.ShowColumnsAsync(new string[] { "Customer ID" });
        
        // Verify event was fired
        Assert.True(actionCompleteCount > 0, "OnActionComplete event was fired");
        
        // Verify event had ColumnState RequestType
        Assert.True(lastActionRequestType == Blazor.Grids.Action.ColumnState, "RequestType was ColumnState");
        
        // Verify visible columns were populated in event args
        Assert.True(lastVisibleColumnsCount > 0, "VisibleColumns count was provided in event args");
    }

    private void OnActionComplete(ActionEventArgs<Order> args)
    {
        if (args.RequestType == Blazor.Grids.Action.ColumnState)
        {
            actionCompleteCount++;
            lastActionRequestType = args.RequestType;
            lastVisibleColumnsCount = args.VisibleColumns?.Count ?? 0;
        }
    }
}

