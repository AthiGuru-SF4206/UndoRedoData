<SfFixture @ref="fixture60" TestAsync="ExcelFilter_CloseCustomDialogHandler_Adaptive" Description="Excel CloseCustomDialogHandler adaptive path">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true" EnableAdaptiveUI="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture60 { get; set; }

    public async Task ExcelFilter_CloseCustomDialogHandler_Adaptive(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.EnableAdaptiveUI);

        // Open Excel filter on second column to instantiate ExcelBase
        cut.FindAll(".e-filtermenudiv")[1].Click();
        var excel = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var inst = excel.Instance;
        var t = inst.GetType();

        // isSubMenuItemSelected = true (precondition)
        var selectedField = t.GetField("isSubMenuItemSelected",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        selectedField.SetValue(inst, true);

        // Invoke CloseCustomDialogHandler on dispatcher (triggers aggregator + state)
        await cut.InvokeAsync(() =>
        {
            t.GetMethod("CloseCustomDialogHandler",
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!
             .Invoke(inst, null);
        });

        // Expect flag cleared
        var after = (bool)selectedField.GetValue(inst)!;
        Assert.False(after, "isSubMenuItemSelected must be false after CloseCustomDialogHandler");

        // Validate FilterModule.FilterIconIsClicked == false
        var grid = cut.Instance;
        var gridType = grid.GetType();
        var fmProp = gridType.GetProperty("FilterModule",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (fmProp != null)
        {
            var fm = fmProp.GetValue(grid);
            if (fm != null)
            {
                var fmType = fm.GetType();
                var iconProp = fmType.GetProperty("FilterIconIsClicked",
                    System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
                if (iconProp != null)
                {
                    var clicked = (bool)iconProp.GetValue(fm)!;
                    Assert.False(clicked, "FilterIconIsClicked must be false after CloseCustomDialogHandler");
                }
            }
        }
    }
}
<SfFixture @ref="fixture61" TestAsync="ExcelFilter_OperatorHelpers_Local" Description="ExcelBase GetClass/GetNumberClass branches">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridColumns>
                <!-- Number then String so we can open both -->
                <GridColumn Field="@nameof(Order.OrderID)" Type="ColumnType.Integer" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Type="ColumnType.String" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture61 { get; set; }

    public async Task ExcelFilter_OperatorHelpers_Local(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        // ---------- String side (GetClass) ----------
        cut.FindAll(".e-filtermenudiv")[1].Click(); // open for CustomerID (string)
        var excelStr = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var instStr = excelStr.Instance;
        var tStr = instStr.GetType();

        // Access StringDropDown and method
        var strDropProp = tStr.GetProperty("StringDropDown", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        var strDrop = (System.Collections.IList)strDropProp.GetValue(instStr)!;
        Assert.True(strDrop.Count > 0);

        var getClass = tStr.GetMethod("GetClass",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;

        // null index => true
        var rNull = (bool)getClass.Invoke(instStr, new object?[] { (int?)null, strDrop })!;
        Assert.True(rNull);

        int emptyIdx = -1, notEmptyIdx = -1, equalIdx = -1;
        for (int i = 0; i < strDrop.Count; i++)
        {
            var opItem = strDrop[i];
            var valProp = opItem.GetType().GetProperty("Value")!;
            var v = (string)valProp.GetValue(opItem)!;
            if (v == "isempty") emptyIdx = i;
            else if (v == "isnotempty") notEmptyIdx = i;
            else if (v == "equal") equalIdx = i;
        }
        Assert.True(emptyIdx >= 0 && notEmptyIdx >= 0 && equalIdx >= 0);

        var rEmpty = (bool)getClass.Invoke(instStr, new object?[] { (int?)emptyIdx, strDrop })!;
        var rNotEmpty = (bool)getClass.Invoke(instStr, new object?[] { (int?)notEmptyIdx, strDrop })!;
        var rEqual = (bool)getClass.Invoke(instStr, new object?[] { (int?)equalIdx, strDrop })!;
        Assert.False(rEmpty);
        Assert.False(rNotEmpty);
        Assert.True(rEqual);

        // ---------- Number side (GetNumberClass) ----------
        cut.FindAll(".e-filtermenudiv")[0].Click(); // open for OrderID (numeric)
        var excelNum = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var instNum = excelNum.Instance;
        var tNum = instNum.GetType();

        var numDropProp = tNum.GetProperty("NumberDropDown", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        var numDrop = (System.Collections.IList)numDropProp.GetValue(instNum)!;
        Assert.True(numDrop.Count > 0);

        var getNumClass = tNum.GetMethod("GetNumberClass",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;

        // null index => true
        var rnNull = (bool)getNumClass.Invoke(instNum, new object?[] { (int?)null, numDrop })!;
        Assert.True(rnNull);

        int isNullIdx = -1, isNotNullIdx = -1, eqIdx = -1;
        for (int i = 0; i < numDrop.Count; i++)
        {
            var opItem = numDrop[i];
            var valProp = opItem.GetType().GetProperty("Value")!;
            var v = (string)valProp.GetValue(opItem)!;
            if (v == "isnull") isNullIdx = i;
            else if (v == "isnotnull") isNotNullIdx = i;
            else if (v == "equal") eqIdx = i;
        }
        Assert.True(isNullIdx >= 0 && isNotNullIdx >= 0 && eqIdx >= 0);

        var rIsNull = (bool)getNumClass.Invoke(instNum, new object?[] { (int?)isNullIdx, numDrop })!;
        var rIsNotNull = (bool)getNumClass.Invoke(instNum, new object?[] { (int?)isNotNullIdx, numDrop })!;
        var rEq = (bool)getNumClass.Invoke(instNum, new object?[] { (int?)eqIdx, numDrop })!;
        Assert.False(rIsNull);
        Assert.False(rIsNotNull);
        Assert.True(rEq);

        await Task.CompletedTask;
    }
}
