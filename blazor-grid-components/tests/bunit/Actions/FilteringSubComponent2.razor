    public async Task ExcelFilter_ItemSelected_OperatorSelection(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.False(cut.Instance.EnableAdaptiveUI); // ensure non-adaptive

        // Open Excel filter
        cut.FindAll(".e-filtermenudiv")[0].Click();
        var excel = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var inst = excel.Instance;
        var t = inst.GetType();

        // Create MenuEventArgs<MenuItem> to simulate selecting "Equal"
        var argsType = typeof(Syncfusion.Blazor.Navigations.MenuEventArgs<>)
                       .MakeGenericType(typeof(Syncfusion.Blazor.Navigations.MenuItem));
        var args = Activator.CreateInstance(argsType)!;
        var itemProp = argsType.GetProperty("Item")!;
        var menuItem = new Syncfusion.Blazor.Navigations.MenuItem { Text = "Equal", Id = "equal" };
        itemProp.SetValue(args, menuItem);

        // Call ItemSelected on dispatcher (may trigger dialog hide)
        await cut.InvokeAsync(async () =>
        {
            var m = t.GetMethod("ItemSelected",
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
            var task = (Task)m.Invoke(inst, new object[] { args })!;
            await task;
        });

        // Validate flags/selected operator
        var isSelField = t.GetField("isSubMenuItemSelected",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        Assert.True((bool)isSelField.GetValue(inst)!);

        var selOpProp = t.GetProperty("SelectedFoperator",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!;
        Assert.Equal("equal", (string?)selOpProp.GetValue(inst));

        // Parent.FilterModule.IsSubMenuClick == true
        var gridType = cut.Instance.GetType();
        var fmProp = gridType.GetProperty("FilterModule",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var fm = fmProp?.GetValue(cut.Instance);
        if (fm != null)
        {
            var fmType = fm.GetType();
            var subMenuClickProp = fmType.GetProperty("IsSubMenuClick");
            if (subMenuClickProp != null)
            {
                Assert.True((bool)subMenuClickProp.GetValue(fm)!);
            }
        }
    }
}
