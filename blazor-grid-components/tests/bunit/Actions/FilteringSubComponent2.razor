        var addMethod = listType.GetMethod("Add");
        Assert.NotNull(clearMethod);
        Assert.NotNull(addMethod);

        clearMethod!.Invoke(filteredColumnsObj, null);
        var json = System.Text.Json.JsonDocument.Parse("\"ALFKI\"");
        var je = json.RootElement.Clone();
        var gfc = new Syncfusion.Blazor.Grids.GridFilterColumn();
        gfc.Field = nameof(Order.CustomerID);
