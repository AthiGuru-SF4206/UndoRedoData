        // Invoke (no UI side-effects, safe to call directly)
        t.GetMethod("OnCloseMenu", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!
         .Invoke(inst, new object[] { args });

        Assert.False((bool)cancelProp.GetValue(args)!, "Cancel must remain false when a ParentItem exists");
        Assert.False((bool)isSubMenuProp.GetValue(inst)!, "IsSubMenuDialog must be false for non-adaptive path");
