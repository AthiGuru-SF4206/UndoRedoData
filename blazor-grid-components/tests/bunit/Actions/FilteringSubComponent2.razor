@code {
    SfFixture fixture69 { get; set; }

    public async Task ExcelFilter_GetData_PopulatesOperatorLists(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        // Open once to instantiate ExcelBase; either column works
        cut.FindAll(".e-filtermenudiv")[0].Click();

        var excel = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var inst = excel.Instance;
        var t = inst.GetType();

        // Call GetData() explicitly to bump lines even if OnInitialized() already did
        t.GetMethod("GetData", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!
         .Invoke(inst, null);

        // Read populated lists
        var numDrop = (System.Collections.IList)t.GetProperty("NumberDropDown", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!.GetValue(inst)!;
        var strDrop = (System.Collections.IList)t.GetProperty("StringDropDown", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)!.GetValue(inst)!;

        Assert.True(numDrop.Count > 0, "NumberDropDown must be populated");
        Assert.True(strDrop.Count > 0, "StringDropDown must be populated");

        // Verify a few key operators exist
        bool Has(System.Collections.IList list, string value)
        {
            for (int i = 0; i < list.Count; i++)
            {
                var v = (string)list[i].GetType().GetProperty("Value")!.GetValue(list[i])!;
                if (string.Equals(v, value, StringComparison.OrdinalIgnoreCase)) return true;
            }
            return false;
        }

        Assert.True(Has(numDrop, "equal"));
        Assert.True(Has(numDrop, "isnull"));
        Assert.True(Has(numDrop, "isnotnull"));

        Assert.True(Has(strDrop, "equal"));
        Assert.True(Has(strDrop, "isempty"));
        Assert.True(Has(strDrop, "isnotempty"));
    }
}
