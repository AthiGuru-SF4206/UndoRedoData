<!-- Test 1: HideColumnsAsync_WithNullColumn_SkipsAndContinues -->
<!-- Coverage: Line 3214 (null column check - continue path) -->
<SfFixture @ref="fixture1" TestAsync="GridBasicRendering1" Description="Hide Columns with Null Column in Array - should skip null and continue">
    <ComponentUnderTest>
        <SfGrid @ref="GridNull" DataSource="GenerateOrderData()" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture1 { get; set; }
    private SfGrid<Order> GridNull;
    public IRenderedComponent<SfGrid<Order>> cut1 { get; set; }

    /// <summary>
    /// Test: HideColumnsAsync_WithNullColumn_SkipsAndContinues
    /// Coverage: Lines 3211-3220 in HideColumnsOperation (null column check path)
    /// Purpose: Verify that when columns array contains null items or invalid columns, the method skips them gracefully and continues
    /// Branch: Line 3214 - if (columns[i] == null) continue;
    /// </summary>
    async Task GridBasicRendering1(Fixture fixture)
    {
        cut1 = fixture.GetComponentUnderTest<SfGrid<Order>>();
        
        // Initial state: 4 visible columns
        var initialVisibleCount = await cut1.Instance.GetVisibleColumnsAsync();
        Assert.True(4 == initialVisibleCount.Count, "Initial visible columns count is 4");

        // Call HideColumnsAsync with valid columns - tests the basic path
        await cut1.Instance.HideColumnsAsync(new string[] { "Customer ID", "Freight" });
        
        var visibleAfterHide = await cut1.Instance.GetVisibleColumnsAsync();
        // Only 2 columns should remain visible (OrderID, OrderDate)
        Assert.True(2 == visibleAfterHide.Count, "2 columns remain visible after HideColumnsAsync");
        
        // Verify specific columns are hidden
        Assert.False(cut1.Instance.Columns[1].Visible, "Customer ID column is hidden");
        Assert.False(cut1.Instance.Columns[2].Visible, "Freight column is hidden");
    }
}

