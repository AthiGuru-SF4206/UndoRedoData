<!-- Test 8: HideColumnsAsync_WithVisibilityChangedEvent_FiresCorrectly -->
<!-- Coverage: Lines 3100-3105 (ColumnVisibilityChanged event firing and args validation) -->
<SfFixture @ref="fixture8" TestAsync="GridBasicRendering8" Description="Hide Columns should fire ColumnVisibilityChanged event with correct args">
    <ComponentUnderTest>
        <SfGrid @ref="GridVisibilityEvent" DataSource="GenerateOrderData()" AllowPaging="true">
            <GridEvents ColumnVisibilityChanged="OnColumnVisibilityChanged8" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture8 { get; set; }
    private SfGrid<Order> GridVisibilityEvent;
    public IRenderedComponent<SfGrid<Order>> cut8 { get; set; }
    private int visibilityChangedCount8 = 0;
    private List<string> lastVisibleColumnHeaders8 = new List<string>();
    private List<string> lastHiddenColumnHeaders8 = new List<string>();

    /// <summary>
    /// Test: HideColumnsAsync_WithVisibilityChangedEvent_FiresCorrectly
    /// Coverage: Lines 3100-3105 (ColumnVisibilityChanged event event args population)
    /// Purpose: Verify that ColumnVisibilityChanged event is fired with correct VisibleColumns and HiddenColumns args
    /// Branch: Line 3100 - GridEvents?.ColumnVisibilityChanged.HasDelegate == true
    /// </summary>
    async Task GridBasicRendering8(Fixture fixture)
    {
        cut8 = fixture.GetComponentUnderTest<SfGrid<Order>>();
        visibilityChangedCount8 = 0;
        lastVisibleColumnHeaders8.Clear();
        lastHiddenColumnHeaders8.Clear();

        // Initial state: 4 visible columns
        var initialVisible = await cut8.Instance.GetVisibleColumnsAsync();
        Assert.True(4 == initialVisible.Count, "Initial visible columns count is 4");

        // Hide columns - should trigger ColumnVisibilityChanged event
        await cut8.Instance.HideColumnsAsync(new string[] { "Customer ID", "Freight" });
        
        // Verify event was fired
        Assert.True(visibilityChangedCount8 > 0, "ColumnVisibilityChanged event was fired");
        
        // Verify only 2 columns remain visible
        var finalVisible = await cut8.Instance.GetVisibleColumnsAsync();
        Assert.True(2 == finalVisible.Count, "2 columns remain visible after hide");
        
        // Verify event args contained correct information
        Assert.True(lastVisibleColumnHeaders8.Count >= 2, "Event provided visible columns info");
        Assert.True(lastHiddenColumnHeaders8.Count >= 2, "Event provided hidden columns info");
    }

    private void OnColumnVisibilityChanged8(ColumnVisibilityChangedEventArgs args)
    {
        visibilityChangedCount8++;
        lastVisibleColumnHeaders8 = args.VisibleColumns?.Select(x => x.HeaderText).ToList() ?? new List<string>();
        lastHiddenColumnHeaders8 = args.HiddenColumns?.Select(x => x.HeaderText).ToList() ?? new List<string>();
    }
}

