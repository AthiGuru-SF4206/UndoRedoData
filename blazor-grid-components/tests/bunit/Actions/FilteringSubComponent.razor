        var result22 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("CONTAINS");
        Assert.True(result22 == Syncfusion.Blazor.Operator.None, "GetEnumOperator: uppercase 'CONTAINS' should return Operator.None (case sensitive)");

