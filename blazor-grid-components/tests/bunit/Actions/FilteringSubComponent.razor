        Assert.True(result14 == Syncfusion.Blazor.Operator.WildCard, "GetEnumOperator: 'wildcard' should return Operator.WildCard");

        // Test Case 15: "isnull" -> Operator.IsNull
        var result15 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("isnull");
        Assert.True(result15 == Syncfusion.Blazor.Operator.IsNull, "GetEnumOperator: 'isnull' should return Operator.IsNull");

        // Test Case 16: "isnotnull" -> Operator.IsNotNull
        var result16 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("isnotnull");
        Assert.True(result16 == Syncfusion.Blazor.Operator.IsNotNull, "GetEnumOperator: 'isnotnull' should return Operator.IsNotNull");

        // Test Case 17: "isempty" -> Operator.IsEmpty
        var result17 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("isempty");
        Assert.True(result17 == Syncfusion.Blazor.Operator.IsEmpty, "GetEnumOperator: 'isempty' should return Operator.IsEmpty");

        // Test Case 18: "isnotempty" -> Operator.IsNotEmpty
        var result18 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("isnotempty");
        Assert.True(result18 == Syncfusion.Blazor.Operator.IsNotEmpty, "GetEnumOperator: 'isnotempty' should return Operator.IsNotEmpty");

        // Test Case 19: default case - any other value -> Operator.None
        var result19 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("invalidoperator");
        Assert.True(result19 == Syncfusion.Blazor.Operator.None, "GetEnumOperator: invalid operator should return Operator.None");

        // Test Case 20: default case - empty string -> Operator.None
        var result20 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("");
        Assert.True(result20 == Syncfusion.Blazor.Operator.None, "GetEnumOperator: empty string should return Operator.None");

