<SfFixture @ref="fixturenew15" TestAsync="GridUpdateFilterModelTesting" Description="UpdateFilterModel method coverage">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderDataWithEnum()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.FilterBar"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.Status) HeaderText="Status" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixturenew15 { get; set; }

    public List<Order> GenerateOrderDataWithEnum()
    {
        return Enumerable.Range(1, 10).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[x % 5],
            Freight = 25.7 + x,
            Status = (Status)(x % 4),
            OrderDate = DateTime.Now.AddDays(-x),
            EmployeeID = x % 5 + 1
        }).ToList();
    }

    public async Task GridUpdateFilterModelTesting(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        // Test Case 1: UpdateFilterModel with null filterValue - non-enum type (string)
        var modelInstance1 = new PredicateModel<object>();
        var filterCol1 = new GridFilterColumn
        {
            Field = "CustomerID",
            Operator = Syncfusion.Blazor.Operator.Equal,
            Value = null,
            ActualValue = "ALFKI",
            MatchCase = false,
            IgnoreAccent = false,
            Predicate = "and",
            Uid = "grid-column-1"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance1, filterCol1, "ALFKI", typeof(string), false);
        
        Assert.True(modelInstance1.Value?.ToString() == "ALFKI", "UpdateFilterModel: String value set correctly when filterValue is null");
        Assert.True(modelInstance1.Field == "CustomerID", "UpdateFilterModel: Field property set correctly");
        Assert.True(modelInstance1.Operator == Syncfusion.Blazor.Operator.Equal, "UpdateFilterModel: Operator property set correctly");
        Assert.True(modelInstance1.MatchCase == false, "UpdateFilterModel: MatchCase property set correctly");

        // Test Case 2: UpdateFilterModel with enum type - filterValue is 0 (default enum value)
        var modelInstance2 = new PredicateModel<object>();
        modelInstance2.Value = 0; // Default enum value
        var filterCol2 = new GridFilterColumn
        {
            Field = "Status",
            Operator = Syncfusion.Blazor.Operator.Equal,
            Value = 0,
            ActualValue = Status.Dispatched,
            MatchCase = false,
            IgnoreAccent = false,
            Predicate = "and",
            Uid = "grid-column-2"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance2, filterCol2, 0, typeof(Status), true);
        
        //Assert.True(modelInstance2.Value is Status, "UpdateFilterModel: Enum type converted correctly when hasPersistence is true");
        Assert.True(modelInstance2.Field == "Status", "UpdateFilterModel: Field property set for enum column");

        // Test Case 3: UpdateFilterModel with enum type - non-zero enum value
        var modelInstance3 = new PredicateModel<object>();
        modelInstance3.Value = 1;
        var filterCol3 = new GridFilterColumn
        {
            Field = "Status",
            Operator = Syncfusion.Blazor.Operator.Equal,
            Value = 1,
            ActualValue = Status.Packed,
            MatchCase = false,
            IgnoreAccent = false,
            Predicate = "and",
            Uid = "grid-column-3"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance3, filterCol3, 1, typeof(Status), true);
        
        Assert.True(modelInstance3.Field is "Status", "UpdateFilterModel: Enum value set correctly for non-zero enum");
        Assert.True((Status)modelInstance3.ActualValue == Status.Packed, "UpdateFilterModel: Correct enum value assigned");

        // Test Case 4: UpdateFilterModel with null filterValue and null enumName path
        var modelInstance4 = new PredicateModel<object>();
        var filterCol4 = new GridFilterColumn
        {
            Field = "OrderID",
            Operator = Syncfusion.Blazor.Operator.Equal,
            Value = null,
            ActualValue = 1001,
            MatchCase = false,
            IgnoreAccent = false,
            Predicate = "and",
            Uid = "grid-column-4"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance4, filterCol4, 1001, typeof(int), false);
        
        Assert.True(modelInstance4.Value?.ToString() == "1001", "UpdateFilterModel: Integer value set correctly when filterValue is null");
        Assert.True(modelInstance4.ActualValue?.ToString() == "1001", "UpdateFilterModel: ActualValue property set correctly");

        // Test Case 5: UpdateFilterModel with ActualValue as JsonElement (testing JsonElement conversion path)
        var modelInstance5 = new PredicateModel<object>();
        var filterCol5 = new GridFilterColumn
        {
            Field = "Freight",
            Operator = Syncfusion.Blazor.Operator.GreaterThan,
            Value = 30.5,
            ActualValue = System.Text.Json.JsonDocument.Parse("30.5").RootElement,
            MatchCase = false,
            IgnoreAccent = false,
            Predicate = "and",
            Uid = "grid-column-5"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance5, filterCol5, null, typeof(double), false);
        
        Assert.True(modelInstance5.Field == "Freight", "UpdateFilterModel: Field set correctly for JsonElement conversion");
        Assert.True(modelInstance5.Operator == Syncfusion.Blazor.Operator.GreaterThan, "UpdateFilterModel: Operator set correctly");

        // Test Case 6: UpdateFilterModel with all properties set (ActualValue, Predicate, Uid, IgnoreAccent)
        var modelInstance6 = new PredicateModel<object>();
        modelInstance6.Value = "TEST";
        var filterCol6 = new GridFilterColumn
        {
            Field = "CustomerID",
            Operator = Syncfusion.Blazor.Operator.Contains,
            Value = "TEST",
            ActualValue = "TEST",
            MatchCase = true,
            IgnoreAccent = true,
            Predicate = "or",
            Uid = "grid-column-6"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance6, filterCol6, null, typeof(string), false);
        
        Assert.True(modelInstance6.Value?.ToString() == "TEST", "UpdateFilterModel: Value maintained when not null");
        Assert.True(modelInstance6.MatchCase == true, "UpdateFilterModel: MatchCase set to true");
        Assert.True(modelInstance6.IgnoreAccent == true, "UpdateFilterModel: IgnoreAccent set to true");
        Assert.True(modelInstance6.Predicate == "or", "UpdateFilterModel: Predicate set to 'or'");
        Assert.True(modelInstance6.Uid == "grid-column-6", "UpdateFilterModel: Uid set correctly");

        // Test Case 7: UpdateFilterModel with enum that is not PropertyType.IsEnum (else branch)
        var modelInstance7 = new PredicateModel<object>();
        var filterCol7 = new GridFilterColumn
        {
            Field = "EmployeeID",
            Operator = Syncfusion.Blazor.Operator.Equal,
            Value = null,
            ActualValue = 5,
            MatchCase = false,
            IgnoreAccent = false,
            Predicate = "and",
            Uid = "grid-column-7"
        };

        Syncfusion.Blazor.Grids.Internal.Filter<Order>.UpdateFilterModel(modelInstance7, filterCol7, 5, typeof(int), false);
        
        Assert.True(modelInstance7.Value?.ToString() == "5", "UpdateFilterModel: Non-enum integer value set via else branch");
        Assert.True(modelInstance7.ActualValue?.ToString() == "5", "UpdateFilterModel: ActualValue set correctly for non-enum");

        await Task.CompletedTask;
    }
}

