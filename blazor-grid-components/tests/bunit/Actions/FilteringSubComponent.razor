        var result23 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("StartsWith");
        Assert.True(result23 == Syncfusion.Blazor.Operator.None, "GetEnumOperator: mixed case 'StartsWith' should return Operator.None (case sensitive)");
    }
}

<SfFixture @ref="fixturenewnew15" TestAsync="ExcelFilter_CustomValuePipeline" Description="Excel filter custom value pipeline">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="120"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer Name" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixturenewnew15 { get; set; }
    public async Task ExcelFilter_CustomValuePipeline(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid should render rows before applying Excel filter.");
        cut.Instance.EnablePersistence = true;
        if (cut.Instance.FilterSettings.Columns == null)
        {
            cut.Instance.FilterSettings.Columns = new List<GridFilterColumn>();
        }
        cut.Instance.FilterSettings.Columns.Clear();
        cut.Instance.FilterSettings.Columns.Add(new GridFilterColumn
        {
            Field = nameof(Order.CustomerID),
            ActualValue = "ALFKI",
            ColumnType = "String",
            Operator = Operator.Equal,
            Value = "ALFKI"
        });
        cut.FindAll(".e-filtermenudiv")[1].Click();
        var excelFilter = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.ExcelBase<Order>>();
        var excelInstance = excelFilter.Instance;
        Assert.NotNull(excelInstance);
        var excelType = excelInstance.GetType();
        var createdHandlerMethod = excelType.GetMethod(
        "CreatedHandler",
        System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(createdHandlerMethod);
        var createdTask = (Task)createdHandlerMethod.Invoke(excelInstance, new object[] { new object() })!;
        await createdTask;
        var customFilterItemProp = excelType.GetProperty(
        "CustomFilterItem",
        System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(customFilterItemProp);
        var customFilterItem = customFilterItemProp.GetValue(excelInstance);
        Assert.NotNull(customFilterItem);
        var order = Assert.IsType<Order>(customFilterItem);
        Assert.Equal("ALFKI", order.CustomerID);
    }
}

