        Assert.True(result12 == Syncfusion.Blazor.Operator.Equal, "GetEnumOperator: 'equal' should return Operator.Equal");

        // Test Case 13: "like" -> Operator.Like
        var result13 = Syncfusion.Blazor.Grids.Internal.Filter<Order>.GetEnumOperator("like");
        Assert.True(result13 == Syncfusion.Blazor.Operator.Like, "GetEnumOperator: 'like' should return Operator.Like");

        // Test Case 14: "wildcard" -> Operator.WildCard
