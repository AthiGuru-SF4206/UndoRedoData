        Assert.NotNull(firstNumDropProp);
        Assert.NotNull(secondNumDropProp);
        var firstNumDropInstance = Activator.CreateInstance(firstNumDropProp!.PropertyType)!;
        var secondNumDropInstance = Activator.CreateInstance(secondNumDropProp!.PropertyType)!;
        firstNumDropProp.SetValue(excelInstance, firstNumDropInstance);
        secondNumDropProp.SetValue(excelInstance, secondNumDropInstance);
        var firstNumDropType = firstNumDropInstance.GetType();
        var numDropValueProp = firstNumDropType.GetProperty("Value");
        Assert.NotNull(numDropValueProp);
        var secondNumDropType = secondNumDropInstance.GetType();
        var secondNumDropValueProp = secondNumDropType.GetProperty("Value");
        Assert.NotNull(secondNumDropValueProp);
        numDropValueProp!.SetValue(firstNumDropInstance, "greaterthanorequal");
        secondNumDropValueProp!.SetValue(secondNumDropInstance, "lessthanorequal");
        var firstNumField = excelType.GetProperty(
            "FirstNumericValueasInt",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var secondNumField = excelType.GetProperty(
            "SecondNumericValueasInt",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(firstNumField);
        Assert.NotNull(secondNumField);
        var firstNumericInstance = Activator.CreateInstance(firstNumField!.PropertyType)!;
        var secondNumericInstance = Activator.CreateInstance(secondNumField!.PropertyType)!;
        firstNumField.SetValue(excelInstance, firstNumericInstance);
        secondNumField.SetValue(excelInstance, secondNumericInstance);
        var numericType = firstNumericInstance.GetType();
        var numericValueProp = numericType.GetProperty("Value");
        Assert.NotNull(numericValueProp);
        numericValueProp!.SetValue(firstNumericInstance, 1001);
        numericValueProp.SetValue(secondNumericInstance, 1005);
        var isIntegerProp = excelType.GetProperty(
            "_isInteger",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var isLongProp = excelType.GetProperty(
            "_isLong",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (isIntegerProp != null) isIntegerProp.SetValue(excelInstance, true);
        if (isLongProp != null) isLongProp.SetValue(excelInstance, false);
        var andRadioButtonProp = excelType.GetProperty(
            "AndRadioButton",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(andRadioButtonProp);
        andRadioButtonProp!.SetValue(excelInstance, "and");
        var filterBtnMethod = excelType.GetMethod(
            "FilterBtnClick",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(filterBtnMethod);
        await cut.InvokeAsync(async () =>
        {
            var t = (Task)filterBtnMethod!.Invoke(excelInstance, null)!;
            await t;
        });
        var columns = cut.Instance.FilterSettings.Columns;
        Assert.NotNull(columns);
        Assert.Equal(2, columns!.Count);
        foreach (var col in columns)
        {
            Assert.Equal(nameof(Order.OrderID), col.Field);
            Assert.Equal("and", col.Predicate);
            Assert.NotNull(col.Value);
        }
    }
