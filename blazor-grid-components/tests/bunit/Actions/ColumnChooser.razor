<SfFixture @ref="fixture" Test="ColumnChooserRendering" Description="ColumnChooser with all the Visible Columns">
    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid" DataSource="GenerateOrderData()" ShowColumnChooser="true" Toolbar=@ToolbarItems AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
    <Fragment>
        <SfButton OnClick="show_hide" CssClass="e-primary" Content="Hide"></SfButton>
    </Fragment>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }
    private SfGrid<Order> DefaultGrid;
    public string[] ToolbarItems = new string[] { "ColumnChooser" };
    public IRenderedComponent<SfGrid<Order>> cut { get; set; }
    void ColumnChooserRendering(Fixture fixture)
    {

        cut = fixture.GetComponentUnderTest<SfGrid<Order>>();


        var btn = fixture.GetFragment<SfButton>();
        btn.FindAll(".e-btn").ElementAt(0).Click();

    }

    void show_hide()
    {
        var bb = this.cut.FindAll(".e-toolbar-item");
        var btn = this.cut.FindAll(".e-btn");
        Assert.True(this.cut.FindAll(".e-icons.e-choosercheck")[0].ClassList.Contains("e-check"), "Checking  all the Columsn checked or not.");


        Assert.True(this.cut.Instance.GetVisibleColumnsAsync().Result.Count() == 4, "Total Visible Columns");

        this.cut.FindAll(".e-icons.e-choosercheck")[1].Click();

        this.cut.FindAll(".e-icons.e-choosercheck")[2].Click();

        btn[1].Click();

        Assert.True(this.cut.Instance.GetVisibleColumnsAsync().Result.Count() == 2, "Total Visible Columns");
        Assert.True(this.cut.Instance.GetVisibleColumnsAsync().Result[0].Field == "Freight", "Total Visible Columns");
        Assert.True(this.cut.Instance.GetVisibleColumnsAsync().Result[1].Field == "OrderDate", "Total Visible Columns");
        Assert.True(this.cut.Instance.GetHiddenColumnsAsync().Result.Count() == 2, "Total Visible Columns");
        Assert.True(this.cut.Instance.GetHiddenColumnsAsync().Result[0].Field == "OrderID", "Total Visible Columns");
        Assert.True(this.cut.Instance.GetHiddenColumnsAsync().Result[1].Field == "CustomerID", "Total Visible Columns");


    }
}



