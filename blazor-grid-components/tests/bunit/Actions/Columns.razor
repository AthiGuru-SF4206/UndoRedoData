<SfFixture @ref="fixture2" Test="GridBasicRendering2" Description="Show Hide column for frozon Rows and Columns  Using Button Click with initially CustomerID column as false">
    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid2" DataSource="GenerateOrderData()" FrozenColumns="2" FrozenRows="2" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150" Visible="false"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>

            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
    <Fragment>
        <SfButton OnClick="show_hide2" CssClass="e-primary" Content="ShowHide"></SfButton>
    </Fragment>
</SfFixture>
@code
  {
    SfFixture fixture2 { get; set; }
    private SfGrid<Order> DefaultGrid2;
    public string[] HideItems2 = new string[] { "OrderDate", "Freight" };
    public string[] HideHeaderItems2 = new string[] { "Order Date", "Customer ID" };
    public string[] ShowItem2 = new string[] { "OrderDate" };
    public string[] ShowHeaderItems2 = new string[] { "Order Date", "Customer ID", "Order ID" };

    public IRenderedComponent<SfGrid<Order>> cut2 { get; set; }
    void GridBasicRendering2(Fixture fixture)
    {
        cut2 = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(3 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of  Columns generated before clicking ShowHide button ");
        //Assert.True(1 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after clicking ShowHide button ");

        var btn = fixture.GetFragment<SfButton>();
        btn.FindAll(".e-btn").ElementAt(0).Click();
        //cut2.Instance.FreezeModule!.GetFreezeLineClientOptions();
    }

    async void show_hide2()
    {
        // Hide columns by its Header text
        await this.DefaultGrid2.HideColumnsAsync(HideHeaderItems2);
        Assert.True(1 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Header Columns generated after calling Hide method");
        //Assert.True(3 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after after calling Hide method");

        //Show columns by its Header text
        await this.DefaultGrid2.ShowColumnsAsync(ShowHeaderItems2);
        Assert.True(4 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Header Columns generated after calling Show method ");
        //Assert.True(0 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after after calling Show method");

        // Hide columns by its Field
        await this.DefaultGrid2.HideColumnsAsync(HideItems2, "field");
        Assert.True(2 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling Hide method ");
        //Assert.True(2 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after after calling Hide method");

        //Show columns by its Field
        await this.DefaultGrid2.ShowColumnsAsync(ShowItem2, "field");
        Assert.True(3 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling Show method ");
        //Assert.True(1 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after after calling Show method");

        //Hide Column by SetVisible function
        this.DefaultGrid2.GetColumnsAsync().Result[0].SetVisibility(false);
        Assert.True(2 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling SetVisible method ");
        //Assert.True(2 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling SetVisible method ");

        //Show Column by SetVisible function
        this.DefaultGrid2.GetColumnsAsync().Result[0].SetVisibility(true);
        this.DefaultGrid2.GetColumnsAsync().Result[2].SetVisibility(true);
        Assert.True(4 == cut2.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling SetVisible method ");
        //Assert.True(0 == cut2.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling SetVisible method ");

    }
    }
