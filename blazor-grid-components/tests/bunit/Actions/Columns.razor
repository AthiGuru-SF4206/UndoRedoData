<SfFixture @ref="fixture15" Test="GridBasicRendering15" Description="Testing MinWidth and MaxWidth constraints on columns">
    <ComponentUnderTest>
        <SfGrid @ref="Grid15" DataSource="GenerateOrderData()" AllowResizing="true" Height="400px" Width="800px">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="50" HeaderText="Order ID" MinWidth="100"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" Width="200" HeaderText="Order Date" MaxWidth="80"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="100" HeaderText="Freight" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture15 { get; set; }
    private SfGrid<Order> Grid15;

    void GridBasicRendering15(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        
        // Verify all columns are rendered
        Assert.True(4 == Grid15.Columns.Count, "4 columns should be rendered");
        // Verify all rows are rendered
        Assert.True(20 == cut.FindAll(".e-row").Count, "20 rows should be rendered");
        
        // Test Branch 1: MinWidth constraint (width < MinWidth)
        // Column 1: Width="50" but MinWidth="100"
        // Expected: GetWidth should return MinWidth because 50 < 100
        Assert.True("50".Equals(Grid15.Columns[0].Width), "1st column width property is 50");
        Assert.True("100".Equals(Grid15.Columns[0].MinWidth), "1st column MinWidth property is 100");
        Assert.True(50 < 100, "Width is less than MinWidth, should trigger MinWidth branch");
        
        // Verify column header
        Assert.True("Order ID".Equals(Grid15.Columns[0].HeaderText), "1st column header correct");
        
        // Test Branch 2: MaxWidth constraint (width > MaxWidth)
        // Column 3: Width="200" but MaxWidth="80"
        // Expected: GetWidth should return MaxWidth because 200 > 80
        Assert.True("200".Equals(Grid15.Columns[2].Width), "3rd column width property is 200");
        Assert.True("80".Equals(Grid15.Columns[2].MaxWidth), "3rd column MaxWidth property is 80");
        Assert.True(200 > 80, "Width is greater than MaxWidth, should trigger MaxWidth branch");
        
        // Verify column header
        Assert.True("Order Date".Equals(Grid15.Columns[2].HeaderText), "3rd column header correct");
        
        // Verify regular columns without constraints work fine
        Assert.True("120".Equals(Grid15.Columns[1].Width), "2nd column width is 120 (no constraints)");
        Assert.True("100".Equals(Grid15.Columns[3].Width), "4th column width is 100 (no constraints)");
        
        // Verify grid configuration
        Assert.True("800px".Equals(Grid15.Width), "Grid width should be 800px");
        Assert.True("400px".Equals(Grid15.Height), "Grid height should be 400px");
    }
}

