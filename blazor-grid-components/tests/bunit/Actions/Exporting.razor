    public void ExcelQueryCellInfoHandler(ExcelQueryCellInfoEventArgs<Order> args)
    {
        // Here you can customize your code
        if (args.Column.Field == "CustomerID")
        {
            Assert.True(args.Column.Field == "CustomerID");
            Assert.True(args.Data != null);
            Assert.True(args.Cell != null);
            Assert.True(args.ColSpan == 0);
            Assert.True(args.ColumnIndex == 1);
            Assert.True(args.RowIndex >= 0);
            Assert.True(args.Style != null);
            Assert.True(args.Value != null);

            if (args.Data.CustomerID == "ALFKI")
            {
                args.Cell.CellStyle.BackColor = "#DC143C";
            }
            else if (args.Data.CustomerID == "ANANTR")
            {
                args.Cell.CellStyle.BackColor = "#FF0000";
            }
        }
    }

