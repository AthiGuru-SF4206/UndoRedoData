    public List<OrdersDetailsExport48> GenerateStackedHeaderData48()
    {
        return Enumerable.Range(1, 30).Select(x => new OrdersDetailsExport48()
        {
            OrderID = 10248 + x,
            CustomerID = "CUST" + x,
            EmployeeID = (x % 5) + 1,
            Freight = Math.Round((2.3 * x), 2),
            Verified = x % 2 == 0,
            OrderDate = DateTime.Now.AddDays(-x),
            ShipCity = "City " + x,
            ShipName = "Ship Name " + x,
            ShipCountry = new string[] { "USA", "Germany", "France", "Spain", "Italy" }[x % 5],
            ShippedDate = DateTime.Now.AddDays(-(x - 5)),
            ShipAddress = "Address " + x,
            Email = "customer" + x + "@domain.com"
        }).ToList();
    }

