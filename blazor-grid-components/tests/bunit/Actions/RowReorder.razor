    <ComponentUnderTest>
        <SfGrid ID="Grid4" @ref="Grid4" DataSource="GenerateOrderData()" AllowRowDragAndDrop=true AllowSelection="true">
            <GridEvents RowDropping="RowDroppingHandler" RowDropped="RowDroppedHandler" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture4 { get; set; }
    SfGrid<Order> Grid4;
    private RowDroppingEventArgs<Order> lastDroppingArgs;
    private RowDroppedEventArgs<Order> lastDroppedArgs;
    private bool allowDrop = true;

    async Task AsyncRowDroppingEvent(Fixture fixture)
    {
        // ARRANGE
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.Rows?.Count > 0, TimeSpan.FromSeconds(5));

        lastDroppingArgs = null;
        lastDroppedArgs = null;
        allowDrop = true;

        // ACT - Perform drag and drop
        if (cut.Instance.RowReorderModule != null)
        {
            cut.Instance.RowReorderModule.IsReorderByInteraction = true;

            await cut.Instance.RowReorderModule.RowDragStartEvent(0, cut.Instance.Rows[0].Uid);

            await cut.Instance.RowReorderModule.ReorderRows(
                fromIndex: 0,
                toIndex: 2,
                action: "delete"
            );

            // Add action to trigger full reorder with events
            await cut.Instance.RowReorderModule.ReorderRows(
                fromIndex: 0,
                toIndex: 2,
                action: "add",
                isDragWithinGrid: true,
                targetClass: ".e-row",
                targetId: "Grid",
                targetDimension: null
            );
        }

        // ASSERT
        // Events should have been triggered
        Assert.True(cut.Instance.Rows.Count > 0, "Grid still has rows after event handling");
    }

    /// <summary>
    /// Event handler for RowDropping event
    /// </summary>
    private void RowDroppingHandler(RowDroppingEventArgs<Order> args)
    {
        lastDroppingArgs = args;
        var targetDimension = new Dimension { Width = 100, Height = 30, Bottom = 30, Top = 0, Left = 0, Right = 100 };
        args.TargetDimension = targetDimension;
        if (!allowDrop)
        {
            args.Cancel = true;
        }
    }

    /// <summary>
    /// Event handler for RowDropped event
    /// </summary>
    private void RowDroppedHandler(RowDroppedEventArgs<Order> args)
    {
        lastDroppedArgs = args;
    }
}

<SfFixture @ref="fixture5" TestAsync="AsyncVirtualizationDeleteAdd" Description="Virtualized grid - Delete then Add sequence with index calculations">
    <ComponentUnderTest>
        <SfGrid ID="Grid5" @ref="Grid5" DataSource="GenerateOrderData()" AllowRowDragAndDrop=true AllowPaging=true Height="400" EnableVirtualization=true>
            <GridPageSettings PageSize="10"></GridPageSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture5 { get; set; }
    SfGrid<Order> Grid5;

    async Task AsyncVirtualizationDeleteAdd(Fixture fixture)
    {
        // ARRANGE
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.Rows?.Count > 0, TimeSpan.FromSeconds(5));

        Assert.True(cut.Instance.EnableVirtualization, "Virtualization enabled");
        var initialRowCount = cut.Instance.Rows?.Count ?? 0;

        // ACT - Delete and then add to simulate swap
        if (cut.Instance.RowReorderModule != null && initialRowCount > 1)
        {
            var firstRow = cut.Instance.Rows[0];
            var secondRow = cut.Instance.Rows[1];

            // Drag start
            await cut.Instance.RowReorderModule.RowDragStartEvent(0, firstRow.Uid);

            // Delete action
            await cut.Instance.RowReorderModule.ReorderRows(
                fromIndex: 0,
                toIndex: 1,
                action: "delete",
                isDragWithinGrid: true,
                toUid: secondRow.Uid
            );

            // Add action (swap)
            await cut.Instance.RowReorderModule.ReorderRows(
                fromIndex: 0,
                toIndex: 1,
                action: "add",
                isDragWithinGrid: true,
                toUid: secondRow.Uid
            );
        }

        // ASSERT
        var finalRowCount = cut.Instance.Rows?.Count ?? 0;
        Assert.True(finalRowCount >= 0, "Row count valid after delete-add swap");
        Assert.True(cut.FindAll(".e-row").Count >= 0, "Rows rendered after swap");
    }
}

