</SfFixture>

@code
{
    SfFixture fixture13 { get; set; }
    private SfGrid<Order> Grid13;

    public async Task GridReorderingWithFrozenRowsAndColumns(Fixture fixture13)
    {
        var cut = fixture13.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.Rows.Count > 0);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.FrozenRows == 2, "Frozen rows should be 2");
        Assert.True(cut.Instance.FrozenColumns == 2, "Frozen columns should be 2");
        
        // Get original records before reordering
        // Note: We'll reorder rows beyond the frozen rows (index 2+)
        var originalRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        var originalRowCount = originalRecords.Count;
        
        // Store row data at positions 2, 3, and 4 (non-frozen rows)
        var originalRow2ID = (originalRecords[2] as Order)?.OrderID;
        var originalRow3ID = (originalRecords[3] as Order)?.OrderID;
        var originalRow4ID = (originalRecords[4] as Order)?.OrderID;
        
        // Also store frozen rows to verify they don't change position
        var frozenRow0ID = (originalRecords[0] as Order)?.OrderID;
        var frozenRow1ID = (originalRecords[1] as Order)?.OrderID;
        
        // Reorder non-frozen rows from index 2 to index 4
        await cut.Instance.ReorderRowAsync(2, 4);
        
        // Verify reordering occurred in non-frozen rows
        var recordsAfterReorder = await cut.Instance.GetCurrentViewRecordsAsync();
        
        // Verify frozen rows remain at positions 0 and 1
        Assert.Equal(frozenRow0ID, (recordsAfterReorder[0] as Order)?.OrderID);
        Assert.Equal(frozenRow1ID, (recordsAfterReorder[1] as Order)?.OrderID);
        
        // Verify non-frozen rows were reordered (positions 2, 3, 4 should be different)
        Assert.Equal(originalRow3ID, (recordsAfterReorder[2] as Order)?.OrderID);
        Assert.Equal(originalRow4ID, (recordsAfterReorder[3] as Order)?.OrderID);
        Assert.Equal(originalRow2ID, (recordsAfterReorder[4] as Order)?.OrderID);
        
        // Verify frozen state is maintained
        Assert.True(cut.Instance.FrozenRows == 2, "Frozen rows should remain 2 after reordering");
        Assert.True(cut.Instance.FrozenColumns == 2, "Frozen columns should remain 2 after reordering");
        
        // Verify total row count is unchanged
        Assert.Equal(originalRowCount, recordsAfterReorder.Count);
    }
}

