@code
{
    SfFixture fixturenew4 { get; set; }
    private SfGrid<Order> Gridnew4;

    public async Task GridReorderingWithEditModeBatch(Fixture fixture4)
    {
        var cut = fixture4.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.Rows.Count > 0);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");

        // Get original records before any operations
        var originalRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        var originalRowCount = originalRecords.Count;
        var originalFirstRowID = (originalRecords[0] as Order)?.OrderID;
        var originalSecondRowID = (originalRecords[1] as Order)?.OrderID;
        var originalThirdRowID = (originalRecords[2] as Order)?.OrderID;

        // Start editing row 0 to modify it
        await cut.Instance.StartEditAsync();

        // Save the edit (even though we didn't modify anything, it should complete)
        await cut.Instance.SaveCellAsync();

        // Verify records are still in original order after save
        var recordsAfterSave = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.Equal(originalFirstRowID, (recordsAfterSave[0] as Order)?.OrderID);
        Assert.Equal(originalRowCount, recordsAfterSave.Count);

        // Now reorder rows from index 0 to index 2 (move first row to position 2)
        await cut.Instance.ReorderRowAsync(0, 2);

        // Verify reordering occurred
        // After reorder(0, 2): [1002, 1003, 1001, 1004, ...]
        // First row should now be the original second row
        var recordsAfterReorder = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.Equal(originalSecondRowID, (recordsAfterReorder[0] as Order)?.OrderID);
        Assert.Equal(originalThirdRowID, (recordsAfterReorder[1] as Order)?.OrderID);
        Assert.Equal(originalFirstRowID, (recordsAfterReorder[2] as Order)?.OrderID);
        Assert.NotEqual(originalFirstRowID, (recordsAfterReorder[0] as Order)?.OrderID);
        Assert.Equal(originalRowCount, recordsAfterReorder.Count);
    }
}


