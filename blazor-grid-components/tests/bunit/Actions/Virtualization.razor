<SfFixture @ref="fixture16" TestAsync="HandleVirtualScrollKeyDown" Description="HandleVirtualScrollKeyDown with cell keydown interaction">
    <ComponentUnderTest>
        <SfGrid ID="InfiniteScroll16" @ref="InfiniteScroll16" DataSource="GenerateRows16()" EnableVirtualization="true" Height="400" RowHeight="38">
            <GridPageSettings PageSize="40"></GridPageSettings>
            <GridColumns>
                <GridColumn Field=@nameof(OrderSimple1.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(OrderSimple1.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(OrderSimple1.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(OrderSimple1.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>


@code
{
    SfFixture fixture16 { get; set; }
    private SfGrid<OrderSimple1> InfiniteScroll16;
    public List<OrderSimple1> GridDataSimple1 { get; set; }

    public async Task HandleVirtualScrollKeyDown(Fixture fixture16)
    {
        var cut = fixture16.GetComponentUnderTest<SfGrid<OrderSimple1>>();
        
        // Assert: Grid rendered successfully
        Assert.True(cut.Instance.EnableVirtualization, "Virtualization enabled");
        Assert.True(cut.Instance.RowHeight > 0, "Row height set successfully");
        Assert.True(cut.Instance.Height != "auto", "Grid height set successfully");
        
        // Assert: Initial data loaded
        cut.Instance.AddRecordAsync().GetAwaiter();
        Assert.True(cut.Instance.CurrentViewData.Count() > 0, "Initial view data loaded successfully");
        cut.Instance.VirtualScrollModule.RowStartIndex = 5;
        cut.Instance.VirtualScrollModule.CurrentRowIndex = 5;
        Assert.True(cut.Instance.VirtualScrollModule.RowStartIndex != 0, "RowStartIndex increased after scroll");
        Assert.True(cut.Instance.VirtualScrollModule.CurrentRowIndex == cut.Instance.VirtualScrollModule.RowStartIndex, "CurrentRowIndex equals RowStartIndex");

        var cell2 = cut.FindAll(".e-rowcell")[0];
        var keyboardArgs = new KeyboardEventArgs
        {
            Key = "ArrowUp",
            Code = "ArrowUp",
            Type = "keydown",
            Repeat = false
        };
        await cell2.KeyDownAsync(keyboardArgs);
        
        // Simulate cell keydown interaction
        var cell1 = cut.FindAll(".e-rowcell")[0];
        await cell1.KeyDownAsync(new KeyboardEventArgs() { Key = "ArrowDown" });

        cut.Instance.AddRecordAsync().GetAwaiter();
        Assert.True(cut.Instance.CurrentViewData.Count() > 0, "Initial view data loaded successfully");

        var cell = cut.FindAll(".e-rowcell")[0];
        await cell.KeyDownAsync(new KeyboardEventArgs() { Key = "ArrowUp" });
        // Assert: Cell interaction successful
        Assert.True(cut.Instance.Rows.Count > 0, "Cell keydown interaction successful");
    }

    public List<OrderSimple1> GenerateRows16()
    {
        List<OrderSimple1> data = new List<OrderSimple1>();
        int count = 1000;

        for (int i = 0; i < 500; i++)
        {
            data.Add(new OrderSimple1() { OrderID = count + 1, CustomerID = "Alfki", OrderDate = new DateTime(1995, 05, 15), Freight = 25.7 * 2 });
            data.Add(new OrderSimple1() { OrderID = count + 2, CustomerID = "Anantr", OrderDate = new DateTime(1994, 04, 04), Freight = 26.7 * 2 });
            data.Add(new OrderSimple1() { OrderID = count + 3, CustomerID = "Blonp", OrderDate = new DateTime(1993, 03, 10), Freight = 27.7 * 2 });
            data.Add(new OrderSimple1() { OrderID = count + 4, CustomerID = "Anton", OrderDate = new DateTime(1992, 02, 14), Freight = 28.7 * 2 });
            data.Add(new OrderSimple1() { OrderID = count + 5, CustomerID = "Bolid", OrderDate = new DateTime(1991, 01, 18), Freight = 29.7 * 2 });
            count += 5;
        }
        GridDataSimple1 = data;
        return data;
    }

    public class OrderSimple1
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
