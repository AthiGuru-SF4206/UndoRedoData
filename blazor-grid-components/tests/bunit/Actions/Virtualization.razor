<SfFixture @ref="fixture7" Test="GridBasicRendering7" Description="Virtualization + Grouping selection range test">
    <ComponentUnderTest>
        <SfGrid @ref="Grid7" DataSource="GenerateOrderData()" Height="400" Width="600" EnableVirtualization="true" RowHeight="38" AllowSelection="true" AllowGrouping="true">
            <GridPageSettings PageSize="12"></GridPageSettings>
            
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" Width="130" HeaderText="Order Date"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="100" HeaderText="Freight" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture7 { get; set; }
    private SfGrid<Order> Grid7;

    async void GridBasicRendering7(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid has rows");
        Assert.True(cut.Instance.EnableVirtualization, "Virtualization must be enabled");
        await Grid7.GroupColumnAsync("CustomerID");
        await Grid7.ExpandAllGroupAsync();
        Assert.True(20 == cut.Find(".e-gridcontent").QuerySelectorAll("tr:not([style*='display: none'])").Count(), "Expand State");
        var rows = cut.Find(".e-gridcontent").QuerySelectorAll("tr:not([style*='display: none'])").Count();
        var visibleTrs = cut.Find(".e-gridcontent").QuerySelectorAll("tr:not([style*='display: none'])")
                          .Where(tr => tr.QuerySelectorAll("td").Length > 0).ToList();

        // if virtualization didn't render the row we need, bring it into view via SelectRowAsync
        if (visibleTrs.Count <= 4)
        {
            await cut.Instance.SelectRowAsync(4); // forces virtualization to render that row
            cut.WaitForState(() => cut.Find(".e-gridcontent").QuerySelectorAll("tr:not([style*='display: none'])").Count() > 4);
            visibleTrs = cut.Find(".e-gridcontent").QuerySelectorAll("tr:not([style*='display: none'])")
                          .Where(tr => tr.QuerySelectorAll("td").Length > 0).ToList();
        }
        visibleTrs[1].QuerySelectorAll("td")[1].Click(new MouseEventArgs() { Type = "click", ShiftKey = false, CtrlKey = false });
        visibleTrs[4].QuerySelectorAll("td")[1].Click(new MouseEventArgs() { Type = "click", ShiftKey = true, CtrlKey = false });
        Assert.True(cut.Instance.SelectedRowIndexes.Count >= 4, "Range selection should include rows 1..4");

       
    }
}


