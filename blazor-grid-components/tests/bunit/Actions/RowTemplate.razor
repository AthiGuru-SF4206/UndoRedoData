@code {
    SfFixture fixture;
    private SfGrid<Employee> Grid { get; set; }
    public List<Employee> Employees { get; set; }

    void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Employee>>();
