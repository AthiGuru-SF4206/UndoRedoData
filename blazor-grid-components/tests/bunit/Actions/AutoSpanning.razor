        Assert.True(groupCaptions.Count > 0, "Grouping should render group caption rows with frozen right layout");

        // Scenario 2: Frozen right + grouping + Column mode AutoSpan
        cut.Instance.AutoSpan = AutoSpanMode.Column;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        var rowspanCells = cut.FindAll("td[rowspan]");
        Assert.True(rowspanCells.Count > 0 || groupCaptions.Count > 0, "Column mode AutoSpan should work with frozen right + grouping");

        // Scenario 3: Frozen right + grouping + HorizontalAndVertical AutoSpan
        cut.Instance.AutoSpan = AutoSpanMode.HorizontalAndVertical;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        var spannedCells = cut.FindAll("td[rowspan], td[colspan]");
        Assert.True(spannedCells.Count > 0, "HorizontalAndVertical AutoSpan should work with frozen right + grouping");

        // Scenario 4: Verify cells in frozen section
        var frozenCells = cut.FindAll(".e-rightfreeze td");
        Assert.True(frozenCells.Count > 0, "Frozen right section should render cells with grouping and AutoSpan");

        // Scenario 5: Toggle grouping while maintaining frozen right
        try
        {
            await cut.Instance.UngroupColumnAsync(nameof(EmployeeDetails.EmployeeName));
            cut.Render();
            cut.WaitForState(() => cut.FindAll(".e-rightfreeze").Count > 0, TimeSpan.FromSeconds(3));

            Assert.True(cut.FindAll(".e-rightfreeze").Count > 0, "Frozen right panel should persist after ungrouping");
        }
        catch { /* If method not present, continue */ }
    }

