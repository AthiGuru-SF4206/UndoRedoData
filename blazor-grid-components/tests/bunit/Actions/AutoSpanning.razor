    async void AutoSpanningNone(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetails>>();
        cut.WaitForState(() => cut.FindAll(".e-row").Count > 0, TimeSpan.FromSeconds(5));
        Syncfusion.Blazor.Grids.Internal.AutoSpanningExtensions.Intersect(AutoSpanMode.None, AutoSpanMode.None);
    }
    /// <summary>
    /// Covers automatic spanning behaviors across modes - Normal scenarios with EmployeeDetails data
    /// Tests AutoSpan Row, Column, and HorizontalAndVertical modes with time slot duplicates
    /// </summary>
    async void AsyncAutoSpanning(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetails>>();
        cut.WaitForState(() => cut.FindAll(".e-row").Count > 0, TimeSpan.FromSeconds(5));

        // Scenario 1: AutoSpan Row mode (column-spanning across rows with duplicate time values)
        cut.Instance.AutoSpan = AutoSpanMode.Row;
        cut.Instance.SuppressAutoSpanning = false;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        // DOM assertion - Row mode creates column spans for duplicate horizontal time slot values
        var colspanCells = cut.FindAll("td[colspan]");
        Assert.True(colspanCells.Count > 0, "AutoSpan Row mode should create colspan attributes for duplicate time slot values across rows");

        // Scenario 2: AutoSpan Column mode (row-spanning for duplicate employee activities)
        cut.Instance.AutoSpan = AutoSpanMode.Column;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        // DOM assertion - Column mode creates row spans for duplicate vertical values
        var rowspanCells = cut.FindAll("td[rowspan]");
        Assert.True(rowspanCells.Count > 0, "AutoSpan Column mode should create rowspan attributes for duplicate activity values");

        // Scenario 3: HorizontalAndVertical combined mode
        cut.Instance.AutoSpan = AutoSpanMode.HorizontalAndVertical;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        // DOM assertion - Combined mode should create both rowspan and colspan
        var hasRowspan = cut.FindAll("td[rowspan]").Count > 0;
        var hasColspan = cut.FindAll("td[colspan]").Count > 0;
        Assert.True(hasRowspan || hasColspan, "HorizontalAndVertical mode should create both rowspan and colspan attributes");

        // Scenario 4: Verify all cells rendered with EmployeeDetails data
        var allCells = cut.FindAll("td");
        Assert.True(allCells.Count > 0, "Grid should have rendered cells with EmployeeDetails dataset");

        // Scenario 5: Verify spanning attributes exist when data has duplicates
        var spannedCells = cut.FindAll("td[rowspan], td[colspan]");
        Assert.True(spannedCells.Count > 0, "AutoSpan processing should create spanned cells when EmployeeDetails has duplicate activities");

        // Scenario 6: Disable auto-spanning and verify it's suppressed
        cut.Instance.SuppressAutoSpanning = true;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));
        Assert.True(cut.FindAll("td").Count > 0, "Grid should render without spanning when SuppressAutoSpanning is true");
        await Grid2.ExportToExcelAsync();
        await Grid2.ExportToPdfAsync();
        await Grid2.ExportToCsvAsync();

    }

    /// <summary>
    /// AutoSpan with Left Frozen columns (FreezeDirection.Left)
    /// Tests that spanning works correctly when columns are frozen on the left
    /// </summary>
    async void AsyncAutoSpanningFrozenLeft(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeDetails>>();
        cut.WaitForState(() => cut.FindAll(".e-row").Count > 0, TimeSpan.FromSeconds(5));

        // Scenario 1: Basic left frozen with AutoSpan
        cut.Instance.AutoSpan = AutoSpanMode.Row;
        cut.Render();
        cut.WaitForState(() => cut.FindAll(".e-row").Count > 0, TimeSpan.FromSeconds(5));

        // Assert left-frozen visual panel exists
        var leftFreezePanel = cut.FindAll(".e-leftfreeze");
        Assert.True(leftFreezePanel.Count > 0, "Left frozen panel should be rendered when FreezeDirection.Left is set");

        // Scenario 2: Verify cells are rendered in frozen panel
        var frozenCells = cut.FindAll(".e-leftfreeze td");
        Assert.True(frozenCells.Count > 0, "Frozen left columns should render cells (EmployeeID and EmployeeName)");

        // Scenario 3: AutoSpan Column mode with left frozen
        cut.Instance.AutoSpan = AutoSpanMode.Column;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        var rowspanCells = cut.FindAll("td[rowspan]");
        Assert.True(rowspanCells.Count > 0, "AutoSpan Column mode should work with left frozen columns");

        // Scenario 4: HorizontalAndVertical with left frozen
        cut.Instance.AutoSpan = AutoSpanMode.HorizontalAndVertical;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        var hasRowspan = cut.FindAll("td[rowspan]").Count > 0;
        var hasColspan = cut.FindAll("td[colspan]").Count > 0;
        Assert.True(hasRowspan || hasColspan, "HorizontalAndVertical should create spanning with left frozen columns");

        // Scenario 5: Verify spanning attributes exist in both frozen and movable sections
        var spannedCells = cut.FindAll("td[rowspan], td[colspan]");
        Assert.True(spannedCells.Count > 0, "AutoSpan processing should create spanned cells with left frozen layout");

        // Scenario 6: Left frozen with frozen rows
        cut.Instance.FrozenRows = 2;
        cut.Instance.AutoSpan = AutoSpanMode.Row;
        cut.Render();
        cut.WaitForState(() => cut.FindAll("td").Count > 0, TimeSpan.FromSeconds(3));

        Assert.True(cut.FindAll("td").Count > 0, "Grid should render with left frozen columns and frozen rows");

        await GridFrozenLeft.ExportToExcelAsync();
        await GridFrozenLeft.ExportToPdfAsync();
        await GridFrozenLeft.ExportToCsvAsync();
    }

