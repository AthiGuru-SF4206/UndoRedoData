    private bool preventStartEdit { get; set; } 

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");
        preventCurrentAction = true;
        await cut.Instance.AddRecordAsync();
        Assert.True(cut.FindAll(".e-addedrow").Count == 0);
        preventCurrentAction = false;
        await cut.Instance.AddRecordAsync();
        Assert.True(cut.FindAll(".e-addedrow").Count == 1);
        preventCurrentAction = true;
        await cut.Instance.CloseEditAsync();
        Assert.True(cut.FindAll(".e-addedrow").Count == 1);
        preventCurrentAction = false;
        await cut.Instance.CloseEditAsync();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");
        await cut.Instance.SelectRowAsync(0);
        
        cut.WaitForAssertion(() =>
        {
            Assert.True(cut.FindAll(".e-selectionbackground").Count > 0, "Row is selected.");
        }, TimeSpan.FromSeconds(2));

        //Assert.True(cut.FindAll(".e-selectionbackground").Count > 0, "Row is selected.");
        preventCurrentAction = true;
        await cut.Instance.StartEditAsync();
        Assert.True(cut.FindAll(".e-inline-edit").Count == 0, "Editing has not started");
        preventCurrentAction = false;
        preventStartEdit = true;
        await cut.Instance.StartEditAsync();
        Assert.True(cut.FindAll(".e-inline-edit").Count == 0, "Editing has not started");
        preventStartEdit = false;
        await cut.Instance.StartEditAsync();
        Assert.True(cut.FindAll(".e-inline-edit").Count > 0, "Editing has been initiated.");
    }

