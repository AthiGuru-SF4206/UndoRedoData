@code
{
    SfFixture fixture2 { get; set; }
    SfGrid<Order> Grid2 {get; set; }
    bool preventAction { get; set; } 
    string currentAction { get; set; }

    public async Task GridBasicRendering1(Fixture fixture)
    {
        var cut = fixture2.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");
        cut.FindAll(".e-rowcell ")[1].Click();
        await cut.FindAll(".e-rowcell ")[1].DoubleClickAsync(new MouseEventArgs());
        Assert.True(cut.FindAll(".e-inline-edit").Count > 0, "Editing has been initiated.");
        await cut.Instance.CloseEditAsync();
        Assert.True(cut.FindAll(".e-inline-edit").Count == 0, "Editing row is not visible in grid");
        preventAction = true;
        await cut.Instance.HideColumnAsync("Customer Name");
        preventAction = false;
        currentAction = "Hide";
        await cut.Instance.HideColumnAsync("Customer Name");
        Assert.False(cut.Instance.Columns[1].Visible, "Column is hidden");
        currentAction = "Show";
        await cut.Instance.ShowColumnAsync("Customer Name");
        Assert.True(cut.Instance.Columns[1].Visible, "Column is visible");
        currentAction = null;
    }

    public void RecordClickHandler(RecordClickEventArgs<Order> args)
    {
        Assert.True(args.RowIndex == 0);
        Assert.True(args.CellIndex == 1);
        Assert.True(args.RowData != null);
        Assert.True(args.ForeignKeyData == null);
        Assert.True(args.Column.Field == "CustomerID");
    }

    public void RecordDoubleClickHandler(RecordDoubleClickEventArgs<Order> args)
    {

    }

    public void CreatedHandler(object args)
    {
        Assert.True(true, "Grid created successfully");
    }

    public void RowDragStarting(RowDragStartingEventArgs<Order> args)
    {

    }

    public void RowDataBoundHandler(RowDataBoundEventArgs<Order> args)
    {
        Assert.True(args.Data != null);
        Assert.True(args.Row != null);
    }

    public void VisibilityChangingHandler(ColumnVisibilityChangingEventArgs args)
    {
        if (currentAction == null) {return;}
        if (preventAction)
        {
            args.Cancel = true;
        }
        Assert.True(currentAction.Equals("Hide", StringComparison.Ordinal) ? args.HiddenColumns.Count() == 1 : args.HiddenColumns.Count() == 0);
        Assert.True(currentAction.Equals("Hide", StringComparison.Ordinal) ? args.VisibleColumns.Count == 3 : args.VisibleColumns.Count == 4);
    }

    public void VisibilityChangedHandler(ColumnVisibilityChangedEventArgs args)
    {
        
    }
