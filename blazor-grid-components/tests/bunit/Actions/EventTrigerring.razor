@code
{
    SfFixture fixture3 { get; set; }
    SfGrid<Order> Grid3 { get; set; }
    public string[] Initial = (new string[] { "CustomerID", "OrderDate" });
    public List<Syncfusion.Blazor.Grids.SortColumn> sortColumns { get; set; } = new List<Syncfusion.Blazor.Grids.SortColumn>();

    public async Task GridBasicRendering3(Fixture fixture)
    {
        var cut = fixture3.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");
        await cut.InvokeAsync(() => cut.Instance.ClearGroupingAsync());
        cut.WaitForState(() => cut.FindAll(".e-groupheadercell").Count() == 0, TimeSpan.FromMilliseconds(1000));
        Assert.True(cut.FindAll(".e-groupheadercell").Count() == 0, "Grouping has been cleared.");
        await cut.InvokeAsync(() => cut.Instance.SelectRowsByRangeAsync(1, 3));
        var selectedIndexes = cut.Instance.GetSelectedRowIndexesAsync();
        cut.WaitForState(() => selectedIndexes.Result.Count() == 3, TimeSpan.FromMilliseconds(200));
        Assert.True(selectedIndexes.Result.Count() == 3, "Rows selected successfully.");
        await cut.InvokeAsync(() =>cut.Instance.ClearRowSelectionAsync());
        cut.WaitForState(() => cut.Instance.SelectedRowIndex == -1, TimeSpan.FromMilliseconds(200));
        Assert.True(cut.Instance.SelectedRowIndex == -1, "Row selection cleared successfully.");
        sortColumns.Add(new() { Field = nameof(Order.Freight), Direction = SortDirection.Descending });
        sortColumns.Add(new() { Field = nameof(Order.CustomerID), Direction = SortDirection.Ascending});
        await cut.InvokeAsync(() => cut.Instance.SortColumnsAsync(sortColumns,true));
        cut.WaitForState(() => cut.Instance.SortSettings.Columns.Count() == 2, TimeSpan.FromMilliseconds(10));
        Assert.True(cut.Instance.SortSettings.Columns.Count() == 2, "Sorting applied successfully.");
        List<string> listItems = new List<string>();
        listItems.Add("Freight");
        listItems.Add("CustomerID");
        await cut.InvokeAsync(() => cut.Instance.ClearSortingAsync(listItems));
        cut.WaitForState(() => cut.Instance.SortSettings.Columns.Count() == 0, TimeSpan.FromMilliseconds(10));
        Assert.True(cut.Instance.SortSettings.Columns.Count() == 0, "Sorting cleared successfully.");
        var uid = cut.Instance.GetUidByColumnFieldAsync("OrderID");
        Assert.True(uid != null, "Column UID retrieved successfully.");
        var rowIndex = cut.Instance.GetRowIndexByPrimaryKeyAsync(1001);
        Assert.False(await cut.Instance.IsDirtyAsync(), "Returns false since the edit mode is not in batch");
        await cut.InvokeAsync(() => cut.Instance.ExportToCsvAsync());
        Assert.True(true, "CSV Exported successfully.");

        // cut.Instance.ReorderColumnByTargetIndex("OrderID", 1);
        // cut.WaitForState(() => cut.FindAll(".e-headertext")[0].TextContent != "OrderID", TimeSpan.FromMilliseconds(1000));
        // Assert.True(cut.FindAll(".e-headertext")[0].TextContent == "Customer Name");
        // cut.Instance.ReorderColumnByIndex(2, 0);
        // cut.Instance.AutoFitColumns();
        // Assert.True(cut.Find(".e-grid").OffsetWidth > cut.Find(".e-columnheader").OffsetWidth, "Autofit applied");
        // Assert.True(true, "Columns auto fitted successfully.");

        var fieldNames = cut.Instance.GetColumnFieldNamesAsync();
        Assert.True(fieldNames.Result.Count == 4, "Column field names retrieved successfully.");
        await cut.Instance.HideColumnAsync("CustomerID", "Field");
        Assert.True(cut.Instance.Columns.Where(x => x.Visible).Count() == 3, "Columns hidden successfully.");
        await cut.Instance.ShowColumnAsync("CustomerID", "Field");
        Assert.True(cut.Instance.Columns.Where(x => x.Visible).Count() == 4, "Columns shown successfully.");
        var rowData = new Order() { OrderID = 1006, CustomerID = "Nancy", OrderDate = new DateTime(1995, 03, 25), Freight = 25.7 * 2 };
        await cut.Instance.SetRowDataAsync(1006, rowData);
        Assert.True((cut.Instance.Rows[5].Data as Order).CustomerID.ToString() == "Nancy", "Row Data has been set");
        var updateData = new Order() { OrderID = 1001, CustomerID = "Davolio", OrderDate = new DateTime(1995, 03, 25), Freight = 25.7 * 2 };
        await cut.Instance.UpdateRowAsync(0, updateData);
        Assert.True((cut.Instance.Rows[0].Data as Order).CustomerID.ToString() == "Davolio", "Row Data has been updated");   
    }
}


