@code
{
    SfFixture fixture4 { get; set; }
    private SfGrid<Order> Grid4;
    bool isAdd4 = true;

    public async Task GridBasicRendering4(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();

        Order addRecord = new Order()
            {
                OrderID = 1111,
                CustomerID = "ABCDE",
                Freight = 25.7,
                OrderDate = new DateTime(2010, 5, 1)
            };
        await Grid4.AddRecordAsync(addRecord);
        isAdd4 = false;
        await cut.Instance.SelectRowAsync(1);
        var data = new Order() { OrderID = 10, CustomerID = "BOLID", Freight = 25.7 * 2, OrderDate = new DateTime(2020, 05, 15) };
        await cut.Instance.UpdateRowAsync(0, data);
        isAdd4 = true;
    }

    public void RowUpdatingHandler4(RowUpdatingEventArgs<Order> args)
    {
        if(isAdd4)
        {
            Assert.True(args.Action == SaveActionType.Added, "Row updating action is added");
            Assert.False(args.Action == SaveActionType.Edited, "Row updating action is not edited");
        }
        else
        {
            Assert.False(args.Action == SaveActionType.Added, "Row updating action is not added");
            Assert.True(args.Action == SaveActionType.Edited, "Row updating action is edited");
        }
    }

    public void RowUpdatedHandler4(RowUpdatedEventArgs<Order> args)
    {
        if (isAdd4)
        {
            Assert.True(args.Action == SaveActionType.Added, "Row updated action is added");
            Assert.False(args.Action == SaveActionType.Edited, "Row updated action is not edited");
        }
        else
        {
            Assert.False(args.Action == SaveActionType.Added, "Row updated action is not added");
            Assert.True(args.Action == SaveActionType.Edited, "Row updated action is edited");
        }
    }
}
