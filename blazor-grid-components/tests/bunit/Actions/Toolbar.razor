    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData()" Toolbar="CustomToolbaritems" AllowSorting="true" AllowExcelExport="true" AllowPdfExport="true" AllowPaging="true">
            <GridEditSettings AllowAdding="true" AllowDeleting="true" AllowEditing="true"></GridEditSettings>
            <GridEvents OnToolbarClick="ToolbarClickHandler" TValue="Order"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" EditType="EditType.DropDownEdit" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" EditType="EditType.DatePickerEdit" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="160"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" EditType="EditType.NumericEdit" Format="C2" ValidationRules="@(new ValidationRules{ Required=true, Range = new object[]{1, 1000}})" TextAlign="TextAlign.Right" Width="200"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCountry) HeaderText="Ship Country" EditType="EditType.DropDownEdit" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
<style>
    .e-expand::before {
        content: '\e82e';
    }

    .e-collapse::before {
        content: '\e834';
    }
</style>

@code
{
    SfFixture fixture3 { get; set; }
    private List<ItemModel> CustomToolbaritems = new List<ItemModel>() { new ItemModel() { Text = "Expand all", TooltipText = "Expand all", PrefixIcon = "e-expand" }, new ItemModel() { Text = "Collapse all", TooltipText = "Collapse all", PrefixIcon = "e-collapse", Align = (Syncfusion.Blazor.Navigations.ItemAlign.Right) } };

    async void CustomToolbarRendering(Fixture fixture3)
    {
        var cut = fixture3.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(1 == cut.FindAll("#" + cut.Instance.ID + "_toolbarItems").Count, "Toolbar rendering properly");
        Assert.True(2 == cut.FindAll(".e-toolbar-item").Count(), "custom toolbar items rendering properly");
        Assert.False(cut.FindAll(".e-toolbar-item")[0].ClassList.Contains("e-overlay"), "Expand Item Enabled");
        Assert.False(cut.FindAll(".e-toolbar-item")[1].ClassList.Contains("e-overlay"), "Collpase Item Enabled");
        Assert.True(cut.FindAll(".e-btn-icon")[0].ClassList.Contains("e-expand"), "Expand Item Icon");
        Assert.True(cut.FindAll(".e-btn-icon")[1].ClassList.Contains("e-collapse"), "Collpase Item Icon");
        Assert.True(cut.FindAll(".e-tbar-btn-text")[0].InnerHtml.Equals(" Expand all "), "custom toolbar text applied properly");
        Assert.True(cut.FindAll(".e-tbar-btn-text")[1].InnerHtml.Equals(" Collapse all "), "custom toolbar text applied properly");
        cut.FindAll(".e-btn").ElementAt(0).Click();
    }


    public async Task ToolbarClickHandler(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        var cut = fixture3.GetComponentUnderTest<SfGrid<Order>>();
        if (args.Item.Text == "Expand all")
        {
            await cut.Instance.ExpandAllGroupAsync();
        }
        if (args.Item.Text == "Collapse all")
        {
            await cut.Instance.CollapseAllGroupAsync();
        }
    }
}
