@inherits GridTestBase

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Grids

<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="Implementing the column menu events in the Grid">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" AllowFiltering=true AllowGrouping=true AllowPaging=true ShowColumnMenu=true ColumnMenuItems=@MenuItems>
            <GridEvents OnColumnMenuOpen="ColumnMenuOpenHandler" ColumnMenuItemClicked="ColumnMenuClickHandler" TValue="Order" ></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    private string[] MenuItems = new string[] { "Group", "Ungroup", "ColumnChooser", "Filter" };
    private bool preventColumnMenuRendering { get; set; }
    public List<Order> GridData { get; set; }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");
        
        preventColumnMenuRendering = false;
        cut.FindAll(".e-columnmenu")[1].Click(new MouseEventArgs());
        Assert.True(cut.FindAll(".e-menu-item").Count == 4, "Column menu items are rendered properly.");
        cut.FindAll(".e-menu-item")[0].Click(new MouseEventArgs());
        cut.Instance._jsAdaptor.PreventColumnMenuClose(true);
    }

    public void ColumnMenuOpenHandler(ColumnMenuOpenEventArgs args)
    {
        if (preventColumnMenuRendering)
        {
            args.Cancel = true;
            return;
        }
        Assert.True(args.Column.Field == "CustomerID");
        Assert.True(args.Items.Count == 4);
        Assert.True(args.ParentItem == null);
        Assert.True(args.ColumnMenuIndex == 0);
        // Assert.True(args.Top != 0 && args.Left != 0);
        // args.Cancel = preventColumnMenuRendering;
    }

    public void ColumnMenuClickHandler(ColumnMenuClickEventArgs args)
    {
        Assert.True(args.Column.Field == "CustomerID");
        Assert.True(args.Item.Text == "Group by this column");
        Assert.True(args.Event is MouseEventArgs);
        Assert.True(args.Element.Id == null);
    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 30).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}

