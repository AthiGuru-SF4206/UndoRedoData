</SfFixture>

@code
{
    SfFixture fixture2 { get; set; }

    public async Task GridBasicRendering2(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.TotalItemCount == 30, "All the records are rendered.");

        var headerCell = cut.FindAll(".e-headercell")[1];
