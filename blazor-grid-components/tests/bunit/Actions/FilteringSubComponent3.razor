    public async Task GridFilterMenu_OperatorHelpers(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        cut.FindAll(".e-filtermenudiv.e-icons.e-icon-filter")[0].Click();
