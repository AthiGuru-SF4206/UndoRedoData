@code {
    SfFixture fixture34 { get; set; }
    private bool _cancelOnFilterDialogOpening = false;
    private bool _cancelOnActionBegin = false;
    public async Task GridFilterMenu_DialogCanceling(Fixture fixture)
    {
        var cut = fixture34.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        var icons = cut.FindAll(".e-filtermenudiv.e-icons.e-icon-filter");
        Assert.True(icons.Count > 1);
        var gridType = grid.GetType();
        var filterModuleProp = gridType.GetProperty(
            "FilterModule",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(filterModuleProp);
        var filterModule = filterModuleProp!.GetValue(grid);
        Assert.NotNull(filterModule);
        var fmType = filterModule!.GetType();
        var filterIconIsClickedProp = fmType.GetProperty(
            "FilterIconIsClicked",
            System.Reflection.BindingFlags.Public |
            System.Reflection.BindingFlags.NonPublic |
            System.Reflection.BindingFlags.Instance);
        Assert.NotNull(filterIconIsClickedProp);
        bool GetIconClicked() => (bool)filterIconIsClickedProp!.GetValue(filterModule)!;
        _cancelOnFilterDialogOpening = false;
        _cancelOnActionBegin = false;
        icons[1].Click();
        var renderer = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterMenuRenderer<Order>>();
        Assert.NotNull(renderer.Instance);
        Assert.True(GetIconClicked());
        _cancelOnFilterDialogOpening = true;
        await cut.InvokeAsync(async () => await renderer.Instance.OpenFilterDialog());
        Assert.False(GetIconClicked());
        Assert.True(cut.FindAll(".e-filter-popup").Count == 0);
        _cancelOnFilterDialogOpening = false;
        _cancelOnActionBegin = false;
        icons = cut.FindAll(".e-filtermenudiv.e-icons.e-icon-filter");
        Assert.True(icons.Count > 1);
        icons[1].Click();
        var renderer2 = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterMenuRenderer<Order>>();
