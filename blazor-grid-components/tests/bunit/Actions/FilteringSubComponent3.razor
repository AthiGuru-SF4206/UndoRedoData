        var numberDropProp = rendererType.GetProperty("NumberDropDown",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(stringDropProp);
        Assert.NotNull(numberDropProp);
        var stringDropObj = stringDropProp!.GetValue(rendererInstance);
        var numberDropObj = numberDropProp!.GetValue(rendererInstance);
        Assert.NotNull(stringDropObj);
        Assert.NotNull(numberDropObj);
        var stringDrop = (System.Collections.IList)stringDropObj!;
        var numberDrop = (System.Collections.IList)numberDropObj!;
        Assert.True(stringDrop.Count > 0);
        Assert.True(numberDrop.Count > 0);
        static string GetOperatorValue(object opItem)
        {
            var opType = opItem.GetType();
            var valueProp = opType.GetProperty("Value");
            Assert.NotNull(valueProp);
            return (string)valueProp!.GetValue(opItem)!;
        }
        int emptyIndex = -1;
        int notEmptyIndex = -1;
        int equalIndex = -1;
        for (int i = 0; i < stringDrop.Count; i++)
        {
            var val = GetOperatorValue(stringDrop[i]);
            if (val == "isempty")
            {
                emptyIndex = i;
            }
            else if (val == "isnotempty")
            {
                notEmptyIndex = i;
            }
            else if (val == "equal")
            {
                equalIndex = i;
            }
        }
        Assert.True(emptyIndex >= 0, "StringDropDown must contain 'isempty'.");
        Assert.True(notEmptyIndex >= 0, "StringDropDown must contain 'isnotempty'.");
        Assert.True(equalIndex >= 0, "StringDropDown must contain 'equal'.");
        int isNullIndex = -1;
        int isNotNullIndex = -1;
        int numEqualIndex = -1;
        for (int i = 0; i < numberDrop.Count; i++)
        {
            var val = GetOperatorValue(numberDrop[i]);
            if (val == "isnull")
            {
                isNullIndex = i;
            }
            else if (val == "isnotnull")
            {
                isNotNullIndex = i;
            }
            else if (val == "equal")
            {
                numEqualIndex = i;
            }
        }
        Assert.True(isNullIndex >= 0, "NumberDropDown must contain 'isnull'.");
        Assert.True(isNotNullIndex >= 0, "NumberDropDown must contain 'isnotnull'.");
        Assert.True(numEqualIndex >= 0, "NumberDropDown must contain 'equal'.");
        var getClassMethod = rendererType.GetMethod("GetClass",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var getNumberClassMethod = rendererType.GetMethod("GetNumberClass",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(getClassMethod);
        Assert.NotNull(getNumberClassMethod);
        var resultNullIndex = (bool)getClassMethod!.Invoke(rendererInstance, new object?[] { (int?)null, stringDropObj })!;
        Assert.True(resultNullIndex, "GetClass should return true when stringIndex is null.");
        var resultIsEmpty = (bool)getClassMethod.Invoke(rendererInstance, new object?[] { (int?)emptyIndex, stringDropObj })!;
        Assert.False(resultIsEmpty, "GetClass should return false for 'isempty' operator.");
        var resultIsNotEmpty = (bool)getClassMethod.Invoke(rendererInstance, new object?[] { (int?)notEmptyIndex, stringDropObj })!;
        Assert.False(resultIsNotEmpty, "GetClass should return false for 'isnotempty' operator.");
        var resultEqual = (bool)getClassMethod.Invoke(rendererInstance, new object?[] { (int?)equalIndex, stringDropObj })!;
        Assert.True(resultEqual, "GetClass should return true for normal operator like 'equal'.");
        var numberResultNullIndex = (bool)getNumberClassMethod!.Invoke(rendererInstance, new object?[] { (int?)null, numberDropObj })!;
        Assert.True(numberResultNullIndex, "GetNumberClass should return true when stringIndex is null.");
        var numberResultIsNull = (bool)getNumberClassMethod.Invoke(rendererInstance, new object?[] { (int?)isNullIndex, numberDropObj })!;
        Assert.False(numberResultIsNull, "GetNumberClass should return false for 'isnull' operator.");
        var numberResultIsNotNull = (bool)getNumberClassMethod.Invoke(rendererInstance, new object?[] { (int?)isNotNullIndex, numberDropObj })!;
        Assert.False(numberResultIsNotNull, "GetNumberClass should return false for 'isnotnull' operator.");
        var numberResultEqual = (bool)getNumberClassMethod.Invoke(rendererInstance, new object?[] { (int?)numEqualIndex, numberDropObj })!;
        Assert.True(numberResultEqual, "GetNumberClass should return true for normal operator like 'equal'.");
        var isNullOrEmptyMethod = rendererType.GetMethod("IsNullOrEmptyOperator",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(isNullOrEmptyMethod);
        bool CheckIsNullOrEmpty(string op)
        {
            return (bool)isNullOrEmptyMethod!.Invoke(rendererInstance, new object[] { op })!;
        }
        Assert.True(CheckIsNullOrEmpty("isnull"));
        Assert.True(CheckIsNullOrEmpty("isnotnull"));
        Assert.True(CheckIsNullOrEmpty("isempty"));
        Assert.True(CheckIsNullOrEmpty("isnotempty"));
        Assert.False(CheckIsNullOrEmpty("equal"));
    }
}

