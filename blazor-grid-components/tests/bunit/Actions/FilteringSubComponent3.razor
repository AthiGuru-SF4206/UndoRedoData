<SfFixture @ref="fixture30" TestAsync="GridFilterMenu_DialogLifecycle_NonAdaptive" Description="Menu filter - dialog lifecycle non-adaptive">
    <ComponentUnderTest>
        <SfGrid TItem="Order" DataSource="GenerateOrderData()" AllowFiltering="true" AllowPaging="true" AllowGrouping="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" TextAlign="TextAlign.Right" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code {
    SfFixture fixture30 { get; set; }
    public async Task GridFilterMenu_DialogLifecycle_NonAdaptive(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        Assert.True(cut.FindAll(".e-filtermenudiv.e-icons.e-icon-filter").Count > 0);
        cut.FindAll(".e-filtermenudiv.e-icons.e-icon-filter")[0].Click();
        var filterRenderer = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterMenuRenderer<Order>>();
        Assert.NotNull(filterRenderer.Instance);
        await cut.InvokeAsync(async () => await filterRenderer.Instance.OpenFilterDialog());
        cut.WaitForState(() => cut.FindAll(".e-filter-popup").Count > 0);
        var gridType = grid.GetType();
        var filterModuleProp = gridType.GetProperty("FilterModule",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(filterModuleProp);
        var filterModule = filterModuleProp!.GetValue(grid);
        Assert.NotNull(filterModule);
        var fmType = filterModule!.GetType();
        var filterIconIsClickedProp = fmType.GetProperty(
            "FilterIconIsClicked",
            System.Reflection.BindingFlags.Public |
            System.Reflection.BindingFlags.NonPublic |
            System.Reflection.BindingFlags.Instance);
        Assert.NotNull(filterIconIsClickedProp);
        var clickedBeforeClose = (bool)filterIconIsClickedProp!.GetValue(filterModule)!;
        Assert.True(clickedBeforeClose);
        var rendererInstance = filterRenderer.Instance;
        var rendererType = rendererInstance.GetType();
        var closedMethod = rendererType.GetMethod("Closed",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(closedMethod);
        cut.InvokeAsync(() => closedMethod!.Invoke(rendererInstance, null)).GetAwaiter();
        var clickedAfterClose = (bool)filterIconIsClickedProp.GetValue(filterModule)!;
        Assert.False(clickedAfterClose);
        await grid.FilterByColumnAsync(nameof(Order.OrderID), "equal", 1001);
        cut.WaitForState(() => grid.FilterSettings.Columns.Count == 1);
        Assert.True(grid.FilterSettings.Columns.Count == 1);
        cut.FindAll(".e-filtermenudiv.e-icons.e-icon-filter")[0].Click();
        filterRenderer = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterMenuRenderer<Order>>();
        rendererInstance = filterRenderer.Instance;
        rendererType = rendererInstance.GetType();
        var clearMethod = rendererType.GetMethod("ClearBtnClick",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        Assert.NotNull(clearMethod);
        await cut.InvokeAsync(async () =>
        {
            var clearTask = (Task)clearMethod!.Invoke(rendererInstance, null)!;
            await clearTask;
        });
        cut.WaitForState(() => grid.FilterSettings.Columns == null || grid.FilterSettings.Columns.Count == 0);
        Assert.True(grid.FilterSettings.Columns == null || grid.FilterSettings.Columns.Count == 0);
        var filterIconColumnProp = fmType.GetProperty(
            "FilterIconColumn",
            System.Reflection.BindingFlags.Public |
            System.Reflection.BindingFlags.NonPublic |
            System.Reflection.BindingFlags.Instance);
        Assert.NotNull(filterIconColumnProp);
        var iconColumn = filterIconColumnProp!.GetValue(filterModule);
        Assert.Null(iconColumn);
        var clickedAfterClear = (bool)filterIconIsClickedProp.GetValue(filterModule)!;
        Assert.False(clickedAfterClear);
    }
}

