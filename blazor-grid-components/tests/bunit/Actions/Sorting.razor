    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid9" DataSource="GenerateOrderData()" AllowGrouping="true" AllowSorting="true" AllowMultiSorting="true">
            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="OrderID" Direction="SortDirection.Ascending"></GridSortColumn>
                    <GridSortColumn Field="CustomerID" Direction="SortDirection.Descending"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>

        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture9 { get; set; }
    SfGrid<Order> DefaultGrid9;
    async void GridBasicRendering9(Fixture fixture9)
    {
        var cut = fixture9.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(1 == cut.FindAll(".e-ascending").Count(), "SortDirection Count is proper");
        Assert.True(2 == cut.FindAll(".e-sortnumber").Count(), "SortNumber count is proper");
        Assert.True(1 == cut.FindAll(".e-descending").Count(), "SortDirection Count is proper");
        Assert.True(1 == cut.FindAll(".e-groupdroparea").Count, "");

        await DefaultGrid9.SortColumnAsync("OrderDate", SortDirection.Ascending, true);

        cut.WaitForState(() => cut.FindAll(".e-sortnumber").Count() == 3);
        Assert.True(2 == cut.FindAll(".e-ascending").Count(), "SortDirection Count is proper");
        Assert.True(3 == cut.FindAll(".e-sortnumber").Count(), "SortNumber count is proper");
        Assert.True(1 == cut.FindAll(".e-descending").Count(), "SortDirection Count is proper");

        //Enable Grouping

        await DefaultGrid9.GroupColumnAsync("OrderID");

        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length == 1);
        Assert.True(cut.Instance.GroupSettings.Columns[0] == "OrderID", "");
        Assert.True(1 == cut.Instance.GroupSettings.Columns.Length, "Group Settings");
        Assert.True(2 == cut.Instance.SortSettings.Columns.Where(x => x.Direction.Equals(SortDirection.Ascending)).ToList().Count(), "SortDirection Count is proper");
        Assert.True(3 == cut.FindAll(".e-sortnumber").Count(), "SortNumber count is proper");
        Assert.True(1 == cut.FindAll(".e-descending").Count(), "SortDirection Count is proper");

        //Disable Grouping

        await DefaultGrid9.UngroupColumnAsync("OrderID");
        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length == 0);
        Assert.True(0 == cut.Instance.GroupSettings.Columns.Length, "Group Settings");

    }

}

