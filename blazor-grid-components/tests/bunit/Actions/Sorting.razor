@inherits GridTestBase
@*single sort asc testing*@

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Flat grid with data source and column">
    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid" DataSource="GenerateOrderData()" AllowSorting="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="150" Format="c2"></GridColumn>
            </GridColumns>
            <GridEvents TValue="Order" OnActionComplete="SingleSort"></GridEvents>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }
    private SfGrid<Order> DefaultGrid;
    bool _canAssert = false;
    async void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(0 == cut.FindAll(".e-sortnumber").Count(), "SortNumber count is proper");
        Assert.True(0 == cut.FindAll(".e-ascending").Count(), "SortDirection Count is proper");
        Assert.True(0 == cut.FindAll(".e-descending").Count(), "SortDirection  Count is proper");
        cut.FindAll(".e-headercell")[0].Click();

        var sortColumn1 = new Syncfusion.Blazor.Grids.SortColumn { Field = "OrderID", Direction = Syncfusion.Blazor.Grids.SortDirection.Ascending };
        var sortColumn2 = sortColumn1;

        // Equality Check
        var result = sortColumn1.Equals((object)sortColumn2);
        var result2 = sortColumn1.Equals(sortColumn2);

        //HashCode Check
        var sortColumn = new Syncfusion.Blazor.Grids.SortColumn { Field = "OrderID", Direction = Syncfusion.Blazor.Grids.SortDirection.Ascending };
        var hashCode = sortColumn.GetHashCode();
        Assert.IsType<int>(hashCode);

            //Operator Check
        // Arrange
        var col1 = new Syncfusion.Blazor.Grids.SortColumn { Field = "OrderID", Direction = Syncfusion.Blazor.Grids.SortDirection.Ascending };
        var col2 = new Syncfusion.Blazor.Grids.SortColumn { Field = "OrderID", Direction = Syncfusion.Blazor.Grids.SortDirection.Ascending };

        // Act
        var EqualResult = col1 == col2;

        // Assert
        Assert.True(EqualResult);

        // Arrange
        var colNotEqual1 = new Syncfusion.Blazor.Grids.SortColumn { Field = "OrderID", Direction = Syncfusion.Blazor.Grids.SortDirection.Ascending };
        var colNotEqual2 = new Syncfusion.Blazor.Grids.SortColumn { Field = "CustomerID", Direction = Syncfusion.Blazor.Grids.SortDirection.Descending };

        // Act
        var NotEqualResult = colNotEqual1 != colNotEqual2;
        // Assert
        Assert.False(NotEqualResult); // !Equals() = !true = false
    }

    void SingleSort()
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.SortSettings.Columns[0].Direction.Equals(Syncfusion.Blazor.Grids.SortDirection.Ascending), "On Sorting Direction chenges properly");
        Assert.True(cut.Instance.SortSettings.Columns[0].Field.Equals("OrderID"), "");

    }

}
