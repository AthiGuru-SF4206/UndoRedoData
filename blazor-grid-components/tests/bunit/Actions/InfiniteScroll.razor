@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> GridData { get; set; }

    public void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.InfiniteScrollSettings.EnableCache, "Infinite scroll cache enabled");
        Assert.True(cut.Instance.Height != "auto", "Grid height set successfully");

        List<Order> dataList = GridData.Take(cut.Instance.PageSettings.PageSize * 3).ToList();
        List<Order> newData = new List<Order>();
        for (int i = 1; i <= cut.Instance.PageSettings.PageSize; i++)
        {
            newData.Add(new Order() { OrderID = dataList.Count + i, CustomerID = "Alfki", OrderDate = new DateTime(1995, 05, 15), Freight = 25.7 * 2 });
        }

        cut.Instance.InfiniteScrollModule.IsDownScroll = true;
        cut.Instance.InfiniteScrollModule.RefreshInfiniteCurrentViewData(newData);
        cut.Instance.InfiniteScrollModule.IsDownScroll = false;
        Assert.True(cut.Instance.CurrentViewData.Count() == 120, "Infinite scroll down scroll data updated successfully");

        ActionArgs args = new ActionArgs();
        args.RequestType = "InfiniteScrolling";
        cut.Instance.InfiniteScrollModule.GenerateInfiniteScrollDatas(args, isBottom: true).GetAwaiter();
    }

    public List<Order> GenerateRows()
    {
        List<Order> data = new List<Order>();
        int count = 0;

        for (int i = 0; i < 500; i++)
        {
            data.Add(new Order() { OrderID = count + 1, CustomerID = "Alfki", OrderDate = new DateTime(1995, 05, 15), Freight = 25.7 * 2 });
            data.Add(new Order() { OrderID = count + 2, CustomerID = "Anantr", OrderDate = new DateTime(1994, 04, 04), Freight = 26.7 * 2 });
            data.Add(new Order() { OrderID = count + 3, CustomerID = "Blonp", OrderDate = new DateTime(1993, 03, 10), Freight = 27.7 * 2 });
            data.Add(new Order() { OrderID = count + 4, CustomerID = "Anton", OrderDate = new DateTime(1992, 02, 14), Freight = 28.7 * 2 });
            data.Add(new Order() { OrderID = count + 5, CustomerID = "Bolid", OrderDate = new DateTime(1991, 01, 18), Freight = 29.7 * 2 });
            count += 5;
        }
        GridData = data;
        return data;
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}


