@inherits GridTestBase
@using System.Timers
<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Selection using Select Row method">
    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid" DataSource="GenerateOrderData()" AllowPaging="true" AllowSelection="true">
            <GridEvents RowSelected="RowSelectedHandler" RowSelecting="RowSelectingHandler" RowDeselected="RowDeSelectedHandler" RowDeselecting="RowDeSelectingHandler" TValue="Order" />
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single" Mode="@_selectionMode" />
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
    <Fragment>
        <SfButton OnClick="Select" CssClass="e-primary" Content="Hide"></SfButton>
    </Fragment>

</SfFixture>
@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> DefaultGrid;
    bool preventCurrentAction { get; set; }
    bool _canAssert = false;
    SelectionMode _selectionMode = SelectionMode.Row;
    public IRenderedComponent<SfGrid<Order>> cut { get; set; }
    public void GridBasicRendering(Fixture fixture)
    {

        cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var btn = fixture.GetFragment<SfButton>();
        btn.FindAll(".e-btn").ElementAt(0).Click();
        _selectionMode = SelectionMode.Cell;
        cut.Instance.Refresh();

        _selectionMode = SelectionMode.Both;
        cut.Instance.Refresh();

        _selectionMode = SelectionMode.Row;
        cut.Instance.Refresh();
        // Assert.True(1 == cut.FindAll(".e-row").ElementAt(2).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after clicking ShowHide button ");

    }
    async void Select()
    {
        preventCurrentAction = true;
        await this.DefaultGrid.SelectRowAsync(2);
        Assert.True(0 == this.cut.Instance.SelectedRowIndexes.Count, "Number of  Rows selected using SelectRow method ");

        preventCurrentAction = false;
        await this.DefaultGrid.SelectRowAsync(2);
        Assert.True(2 == this.cut.Instance.SelectedRowIndexes[0], "Number of  Rows selected using SelectRow method ");
        preventCurrentAction = true;
        await this.DefaultGrid.ClearSelectionAsync();
        Assert.True(1 == this.cut.Instance.SelectedRowIndexes.Count, "Number of  Rows selected using ClearSelection method");
        preventCurrentAction = false;
        Assert.True(0 == this.cut.Instance.SelectedRowIndexes.Count, "Number of  Rows selected using SelectRowIndexes method");
    }

    public void RowSelectedHandler(RowSelectEventArgs<Order> args)
    {
        Assert.True(2 == args.RowIndex, "RowIndex of the selected row");
        Assert.False(args.IsCtrlPressed, "IsCtrlPressed of the selected row");
        Assert.False(args.IsShiftPressed, "IsShiftPressed of the selected row");
        Assert.True(args.Data != null);
        Assert.True(args.Datas.Count == 1);
        Assert.True(args.Event == null);
        Assert.True(args.ForeignKeyData.Count == 0);
        Assert.True(args.PreviousRowIndex == -1);
        Assert.True(args.RowIndexes.Count == 1);
        Assert.False(args.IsInteracted);
    }

    public void RowSelectingHandler(RowSelectingEventArgs<Order> args)
    {
        args.Cancel = preventCurrentAction;
        Assert.True(2 == args.RowIndex, "RowIndex of the selected row");
        Assert.False(args.IsCtrlPressed, "IsCtrlPressed of the selected row");
        Assert.False(args.IsShiftPressed, "IsShiftPressed of the selected row");
        Assert.True(args.Data != null);
        Assert.True(args.Datas.Count == 1);
        Assert.True(args.Event == null);
        Assert.True(args.ForeignKeyData.Count == 0);
        // Assert.True(args.PreviousRowIndex == -1);
        Assert.True(args.RowIndexes.Count == 1);
        Assert.False(args.IsInteracted);
    }
    public void RowDeSelectedHandler(RowDeselectEventArgs<Order> args)
    {
        Assert.True(2 == args.RowIndex, "RowIndex of the deselected row");
    }
    public void RowDeSelectingHandler(RowDeselectEventArgs<Order> args)
    {
        args.Cancel = preventCurrentAction;
        Assert.True(2 == args.RowIndex, "RowIndex of the deselected row");
        Assert.True(2 == args.RowIndex, "RowIndex of the selected row");
        Assert.False(args.IsCtrlPressed, "IsCtrlPressed of the selected row");
        Assert.False(args.IsShiftPressed, "IsShiftPressed of the selected row");
        Assert.True(args.Data != null);
        Assert.True(args.Datas.Count == 1);
        Assert.True(args.Event == null);
        Assert.True(args.ForeignKeyData.Count == 0);
        Assert.True(args.RowIndexes.Count == 1);
        Assert.False(args.IsInteracted);
    }
}

