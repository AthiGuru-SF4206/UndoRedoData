<SfFixture @ref="fixture" TestAsync="GridBasicRendering" Description="cell selection flow mode">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="GenerateRows()" AllowSelection="true" AllowPaging=true>
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Cell" CellSelectionMode="CellSelectionMode.Flow"></GridSelectionSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture { get; set; }
    private SfGrid<Order> Grid;
    public List<Order> GridData { get; set; }

    public async Task GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");

        cut.FindAll(".e-rowcell")[2].Click(new MouseEventArgs() { Type = "click" });
        cut.FindAll(".e-rowcell")[15].Click(new MouseEventArgs() { ShiftKey = true, Type = "click" });
        cut.FindAll(".e-rowcell")[20].Click(new MouseEventArgs() { Type = "click", CtrlKey = true });
        cut.FindAll(".e-rowcell")[25].Click(new MouseEventArgs() { ShiftKey = true, CtrlKey = true, Type = "click" });

        cut.FindAll(".e-rowcell")[2].Click(new MouseEventArgs() { Type = "click" });
        cut.FindAll(".e-rowcell")[15].Click(new MouseEventArgs() { CtrlKey = true, Type = "click" });

        cut.FindAll(".e-rowcell")[2].Click(new MouseEventArgs() { Type = "click" });
        cut.FindAll(".e-rowcell")[15].Click(new MouseEventArgs() { Type = "click", ShiftKey = true });
        cut.FindAll(".e-rowcell")[25].Click(new MouseEventArgs() { Type = "click", ShiftKey = true });
        cut.FindAll(".e-rowcell")[0].KeyDown(new KeyboardEventArgs() { Key = "Escape" });
        cut.WaitForState(() => cut.Instance.FocusModule.LastKeyCombination != null, TimeSpan.FromMilliseconds(1000));

        cut.FindAll(".e-rowcell")[2].Click(new MouseEventArgs() { Type = "click" });
        cut.FindAll(".e-rowcell")[2].KeyDown(new KeyboardEventArgs() { Key = "ArrowDown", Code = "ArrowDown", ShiftKey = true });
        cut.WaitForState(() => cut.Instance.FocusModule.LastKeyCombination != null, TimeSpan.FromMilliseconds(1000));
        cut.FindAll(".e-rowcell")[6].KeyDown(new KeyboardEventArgs() { Key = "ArrowDown", Code = "ArrowDown", ShiftKey = true });
        cut.WaitForState(() => cut.Instance.FocusModule.LastKeyCombination != null, TimeSpan.FromMilliseconds(1000));
        cut.FindAll(".e-rowcell")[10].KeyDown(new KeyboardEventArgs() { Key = "ArrowUp", Code = "ArrowUp", ShiftKey = true });

    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 50).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}

