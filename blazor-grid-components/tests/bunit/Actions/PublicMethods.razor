        var FilteredRecords = cut.Instance.GetFilteredRecordsAsync().Result;
        Assert.True(FilteredRecords != null, "gets the correct column using GetFilteredRecords method");
        await cut.Instance.ClearFilteringAsync();

        var PersistedData = cut.Instance.GetPersistDataAsync().Result;
        Assert.True(PersistedData != null, "gets the correct column using GetPersistData method");
        var PersistData = cut.Instance.GetPersistDataAsync().Result;
        Assert.True(PersistData != null, "gets the correct column using GetPersistData method");

        await cut.Instance.ReorderRowAsync(3, 0);
        var records = cut.Instance.GetCurrentViewRecordsAsync();
        Assert.True(records.Result[0].OrderID == 1004, "Row reordered");

        // Existing multi-column sort (uses the 1-parameter overload)
        sortColumns.Add(new() { Field = nameof(Order.Freight), Direction = SortDirection.Descending });
        sortColumns.Add(new() { Field = nameof(Order.OrderID), Direction = SortDirection.Ascending });

        // 1) Use the overload WITHOUT clearPreviousSort
        await cut.Instance.SortColumnsAsync(sortColumns); // calls SortColumnsAsync(List<SortColumn>)

        // Verify both directions rendered
        var sortDescending = cut.FindAll(".e-descending");
        var sortAscending = cut.FindAll(".e-ascending");
        Assert.True(sortAscending.Count > 0, "Sorting Ascending done");
        Assert.True(sortDescending.Count > 0, "Sorting Descending done");

