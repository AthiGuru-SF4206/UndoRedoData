@code
{
    SfFixture fixture4 { get; set; }
    private SfGrid<Orderss> Grid4;
    public List<Orderss> GridData4 { get; set; }

    public async Task GridBasicRendering4(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Orderss>>();

        await cut.Instance.ScrollIntoViewAsync(rowIndex: 20);
        await cut.Instance.RefreshScrollLeftPosition();
        var gridInstance = cut.Instance;
        var gridType = gridInstance.GetType();

        var refreshVirtualGridMethod = gridType.GetMethod(
            "RefreshVirtualGrid",
            System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);

        Assert.NotNull(refreshVirtualGridMethod);
        var firstWidth = "800px";
        var firstCallTask = (Task)refreshVirtualGridMethod.Invoke(
            gridInstance,
            new object[] { firstWidth });

        await firstCallTask;
        Assert.Equal(firstWidth, gridInstance.Width);

        var virtualScrollField = gridType.GetField(
            "VirtualScrollModule",
            System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
        try
        {
            Assert.NotNull(virtualScrollField);
            virtualScrollField.SetValue(gridInstance, null);
        }
        catch
        {
            
        }
        var secondWidth = "1024px";
        var secondCallTask = (Task)refreshVirtualGridMethod.Invoke(
            gridInstance,
            new object[] { secondWidth });

        await secondCallTask;
        Assert.Equal(secondWidth, gridInstance.Width);
    }

    public List<Orderss> GenerateRows4()
    {
        return GridData4 = Enumerable.Range(1, 10000).Select(x => new Orderss()
            {
                OrderID = 1000 + x,
