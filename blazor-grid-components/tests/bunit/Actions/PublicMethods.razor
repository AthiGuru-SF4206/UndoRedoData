@code {
    SfFixture fixture9 { get; set; }
    private SfGrid<Order> GridMerge;

 
    public async Task GridMergeUnmergeCells_PublicMethods(Fixture fixture)
    {
        // Arrange
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.NotNull(cut.Instance);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid should have rows before merge operations.");
        var singleMerge = new MergeCellInfo
        {
            RowIndex = 1,      // 2nd data row
            ColumnIndex = 1,   // CustomerID
            RowSpan = 2,       // rows 1-2
            ColumnSpan = 2     // CustomerID + OrderDate
        };

        await cut.Instance.MergeCellsAsync(singleMerge);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid must still have rows after single merge.");


        var mergeAreaA = new MergeCellInfo
        {
            RowIndex = 0,
            ColumnIndex = 0,
            RowSpan = 2,   // rows 0-1
            ColumnSpan = 1 // only OrderID
        };

        var mergeAreaB = new MergeCellInfo
        {
            RowIndex = 3,
            ColumnIndex = 2,
            RowSpan = 2,   // rows 3-4
            ColumnSpan = 2 // OrderDate + Freight
        };

        var mergeInfos = new List<MergeCellInfo> { mergeAreaA, mergeAreaB };

        await cut.Instance.MergeCellsAsync(mergeInfos);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid must still have rows after multi-area merge.");

        var unmergeSingle = new UnmergeCellInfo
        {
            RowIndex = mergeAreaA.RowIndex,
            ColumnIndex = mergeAreaA.ColumnIndex
        };

        await cut.Instance.UnmergeCellsAsync(unmergeSingle);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid must be usable after single-area unmerge.");


        var unmergeFromSingleMerge = new UnmergeCellInfo
        {
            RowIndex = singleMerge.RowIndex,
            ColumnIndex = singleMerge.ColumnIndex
        };

        var unmergeFromMultiMergeB = new UnmergeCellInfo
        {
            RowIndex = mergeAreaB.RowIndex,
            ColumnIndex = mergeAreaB.ColumnIndex
        };

        var unmergeInfos = new List<UnmergeCellInfo>
        {
            unmergeFromSingleMerge,
            unmergeFromMultiMergeB
        };

        await cut.Instance.UnmergeCellsAsync(unmergeInfos);
        Assert.True(cut.Instance.Rows.Count > 0, "Grid must be usable after multi-area unmerge.");

        await cut.Instance.UnmergeAllAsync();
        var currentRecords = await cut.Instance.GetCurrentViewRecordsAsync();
        Assert.NotNull(currentRecords);
        Assert.Equal(GridData.Count, currentRecords.Count);
    }
