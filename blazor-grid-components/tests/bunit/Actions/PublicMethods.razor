        await cut.Instance.AutoFitColumnAsync(AutoFitColumn);
        string[] AutoFitColumns = { "OrderID", "CustomerID", "Freight" };
        await cut.Instance.AutoFitColumnsAsync(AutoFitColumns);
        Assert.All(cut.Instance.Columns, col => Assert.True(col.IsPersistAutoFit));
