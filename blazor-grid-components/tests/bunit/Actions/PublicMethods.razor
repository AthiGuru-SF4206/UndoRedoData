        await cut.Instance.SetCellValueAsync(1002, "CustomerID", "Syncfusion");

        await cut.Instance.SearchAsync("ALFKI");
        Assert.True(cut.Instance.SearchSettings.Key == "ALFKI", "Search done");


        //Cannot check this cases in BUnit.
        await cut.Instance.ResetPersistDataAsync();
        await cut.Instance.SetPersistDataAsync("");
        await cut.Instance.SelectCellsByRangeAsync((2, 0), (0, 2));
        await cut.Instance.EnableToolbarItemsAsync(new List<string>() { "Add", "Edit" }, false);
        await cut.Instance.EnableToolbarItemsAsync(new List<string>() { "Add", "Edit" }, true);
        await cut.Instance.ExportToExcelAsync();
        await cut.Instance.ExportToCsvAsync();
        await cut.Instance.ExportToExcelAsync();
        await cut.Instance.RefreshColumnsAsync();
        await cut.Instance.RefreshHeaderAsync();
        await cut.Instance.RefreshHeaderAsync();
        await cut.Instance.GetFilterUIInfo();

        await cut.Instance.SelectRowAsync(2);
        var copy = cut.Instance.CopyAsync();
        var copyHeader = cut.Instance.CopyAsync(true);
        await cut.Instance.ReorderColumnByIndexAsync(2, 0);
        await cut.Instance.ReorderColumnByTargetIndexAsync("Freight", 3);
        await cut.Instance.ReorderColumnsAsync(new List<string> { "OrderID", "CustomerID" }, "Freight");
        string[] columns = ["OrderID", "CustomerID"];
        await cut.Instance.ReorderColumnsAsync(columns, "Freight");
        await cut.Instance.ReorderColumnAsync("OrderID", "Freight");
        await Task.Yield();

        cut.Instance.EnablePersistence = true;
