@code {
    SfFixture fixture7 { get; set; }
    private SfGrid<PagingOrder> GridUpdate;
    public List<PagingOrder> GridUpdateData { get; set; }
    public async Task GridUpdatePageSizeAsync(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<PagingOrder>>();

        GridUpdate = cut.Instance;
        Assert.NotNull(GridUpdate);

        var initialRecords = await GridUpdate.GetCurrentViewRecordsAsync();
        

        var originalPageSize = GridUpdate.PageSettings.PageSize;
        await GridUpdate.UpdatePageSizeAsync(height: 600, rowHeight: 0);
        Assert.Equal(originalPageSize, GridUpdate.PageSettings.PageSize);
        await GridUpdate.UpdatePageSizeAsync(600, 30);
        Assert.Equal(40, GridUpdate.PageSettings.PageSize);

        var recordsAfterVirtualUpdate = await GridUpdate.GetCurrentViewRecordsAsync();
        Assert.NotEmpty(recordsAfterVirtualUpdate);
        GridUpdate.AllowPaging = false;
        var beforeNoPagingCall = GridUpdate.PageSettings.PageSize;

        await GridUpdate.UpdatePageSizeAsync(pageSize: 5);
        Assert.Equal(beforeNoPagingCall, GridUpdate.PageSettings.PageSize);

        // Re-enable paging for remaining cases
        GridUpdate.AllowPaging = true;

        var beforeZeroPageSizeCall = GridUpdate.PageSettings.PageSize;

        await GridUpdate.UpdatePageSizeAsync(pageSize: 0);
        Assert.Equal(beforeZeroPageSizeCall, GridUpdate.PageSettings.PageSize);
        await GridUpdate.UpdatePageSizeAsync(pageSize: 5);
        Assert.Equal(5, GridUpdate.PageSettings.PageSize);
        var recordsAfterPagingUpdate = await GridUpdate.GetCurrentViewRecordsAsync();
        Assert.NotEmpty(recordsAfterPagingUpdate);
    }

