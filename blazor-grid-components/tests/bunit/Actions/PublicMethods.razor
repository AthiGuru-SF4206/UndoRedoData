        await cut.Instance.CloseEditAsync();
        Assert.True(cut.Instance.IsEdit == false, "Cell is in editable state.");

        string uid = "col";
        var col = cut.Instance.GetColumnByUidAsync(uid).Result;
        Assert.True(col.Field == "CustomerID", "gets the correct column using GetColumnByUid method");

        var Column = cut.Instance.GetColumnIndexByFieldAsync("CustomerID").Result;
        Assert.True(Column == 1, "gets the correct column using GetColumnIndexByField method");

