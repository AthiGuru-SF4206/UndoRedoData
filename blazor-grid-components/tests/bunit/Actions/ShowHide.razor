@inherits GridTestBase

<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Show Hide column Using Button Click">
    <ComponentUnderTest>
        <SfGrid @ref="DefaultGrid" DataSource="GenerateOrderData()" AllowPaging="true">
            <GridColumns>
                <GridColumn Field="@nameof(Order.OrderID)" HeaderText="Order ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" HeaderText="Customer ID" Width="150"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" HeaderText="Freight" Width="150" Format="c2"></GridColumn>
                <GridColumn Field=@nameof(Order.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" Width="130"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
    <Fragment>
        <SfButton OnClick="show_hide" CssClass="e-primary" Content="Hide"></SfButton>
    </Fragment>
</SfFixture>
@code
  {
    SfFixture fixture { get; set; }
    private SfGrid<Order> DefaultGrid;
    public string[] HideItems = new string[] { "OrderDate", "Freight" };
    public string[] HideHeaderItems = new string[] { "Order Date", "Customer ID" };
    public string[] ShowItem = new string[] { "OrderDate" };
    public string[] ShowHeaderItems = new string[] { "Order Date", "Customer ID" };
    public IRenderedComponent<SfGrid<Order>> cut { get; set; }
    void GridBasicRendering(Fixture fixture)
    {

        cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        Assert.True(4 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of  Columns generated before clicking ShowHide button ");
        //Assert.True(0 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM before clicking ShowHide button ");

        var btn = fixture.GetFragment<SfButton>();
        btn.FindAll(".e-btn").ElementAt(0).Click();

    }

    async void show_hide()
    {
        // Hide columns by its Header text
        await this.DefaultGrid.HideColumnsAsync(HideHeaderItems);
        Assert.True(2 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Header Columns generated after calling Hide method");
        //Assert.True(2 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling Hide method ");


        //Show columns by its Header text
        await this.DefaultGrid.ShowColumnsAsync(ShowHeaderItems);
        Assert.True(4 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Header Columns generated after calling Show method ");
        //Assert.True(0 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling Show method");

        // Hide columns by its Field
        await this.DefaultGrid.HideColumnsAsync(HideItems, "field");
        Assert.True(2 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling Hide method ");
        ///Assert.True(2 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling Hide method ");


        //Show columns by its Field
        await this.DefaultGrid.ShowColumnsAsync(ShowItem, "field");
        Assert.True(3 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling Show method ");
        //Assert.True(1 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling Show method");

        //Hide Column by SetVisible function
        this.DefaultGrid.GetColumnsAsync().Result[0].SetVisibility(false);
        Assert.True(2 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling SetVisible method ");
        //Assert.True(2 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling SetVisible method");

        //Show Column by SetVisible function
        this.DefaultGrid.GetColumnsAsync().Result[0].SetVisibility(true);
        this.DefaultGrid.GetColumnsAsync().Result[2].SetVisibility(true);
        Assert.True(4 == cut.Instance.GetVisibleColumnsAsync().Result.Count, "Number of Columns generated after calling SetVisible method ");
        //Assert.True(0 == cut.FindAll(".e-row").ElementAt(0).ChildNodes.GetElementsByClassName("e-hide").Length, "Number of  Columns hided in DOM after calling SetVisible method");

    }
}

