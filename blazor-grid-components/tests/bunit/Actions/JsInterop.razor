                <GridColumn Field=@nameof(OrderData2.OrderDate) HeaderText=" Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(OrderData2.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture2 { get; set; }
    private SfGrid<OrderData2> Grid2;
    public List<OrderData2> GridData2 { get; set; }
    private string[] Initial5 = (new string[] { "CustomerID" });
    public void GridBasicRendering2(Fixture fixture2)
    {
        var cut = fixture2.GetComponentUnderTest<SfGrid<OrderData2>>();
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        Assert.True(cut.Instance.Height != "auto", "Grid height set successfully");
        Assert.True(cut.Instance.RowHeight > 0, "Row height available");
        Assert.True(cut.Instance.AllowGrouping, "Grouping enabled");
        Assert.True(cut.Instance.GroupSettings.Columns.Count() > 0, "Grouped columns available");
        Assert.True(cut.Instance.GroupSettings.EnableLazyLoading, "Lazy load grouping enabled");
        Assert.True(cut.Instance.RowHeight > 0, "Row height available");
        Assert.True(cut.Instance.EnableInfiniteScrolling, "Infinite scrolling enabled");
        ActionArgs args = new ActionArgs();
        args.RequestType = "InfiniteScrolling";
        cut.Instance.GroupModule.ExpandCollapse(cut.Instance.Rows[0]).GetAwaiter();
        var middleuid = cut.FindAll(".e-lazyload-middle-down")[0].GetAttribute("data-uid");
        var middleIndex = int.Parse(cut.FindAll(".e-lazyload-middle-down")[0].GetAttribute("aria-rowindex"));
        string infiniteArgs = "{\"requestType\":\"InfiniteScrolling\"}";
        cut.InvokeAsync(() => cut.Instance._jsAdaptor.LoadInfiniteData(infiniteArgs, isBottom: true, isLazyLoadChild:true, middleRowUid: middleuid, middleRowIndex:middleIndex));
        cut.WaitForState(() => cut.Instance.Rows.Count == 59, TimeSpan.FromMilliseconds(2000));
    }

    public List<OrderData2> GenerateRows2()
    {
        List<OrderData2> data = new List<OrderData2>();
        int count = 1000;

        for (int i = 0; i < 2000; i++)
        {
            data.Add(new OrderData2() { OrderID = count + 1, CustomerID = "Alfki", OrderDate = new DateTime(1995, 05, 15), Freight = 25.7 * 2 });
            data.Add(new OrderData2() { OrderID = count + 2, CustomerID = "Anantr", OrderDate = new DateTime(1994, 04, 04), Freight = 26.7 * 2 });
            data.Add(new OrderData2() { OrderID = count + 3, CustomerID = "Blonp", OrderDate = new DateTime(1993, 03, 10), Freight = 27.7 * 2 });
            data.Add(new OrderData2() { OrderID = count + 4, CustomerID = "Anton", OrderDate = new DateTime(1992, 02, 14), Freight = 28.7 * 2 });
            data.Add(new OrderData2() { OrderID = count + 5, CustomerID = "Bolid", OrderDate = new DateTime(1991, 01, 18), Freight = 29.7 * 2 });
            count += 5;
        }
        GridData2 = data;
        return data;
    }

    public class OrderData2
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}

