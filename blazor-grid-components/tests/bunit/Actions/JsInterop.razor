<SfFixture @ref="fixture2" Test="GridBasicRendering2" Description="Generate lazy load child items for the infinite scroll normal mode">
    <ComponentUnderTest>
        <SfGrid ID="Grid2" @ref="Grid2" DataSource="GenerateRows2()" Height="400" RowHeight="38" EnableInfiniteScrolling=true AllowGrouping=true>
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridGroupSettings Columns="@Initial5" EnableLazyLoading=true></GridGroupSettings>
