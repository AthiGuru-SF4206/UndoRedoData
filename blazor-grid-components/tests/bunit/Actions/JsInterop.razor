<SfFixture @ref="fixture10" Test="GridBasicRendering10" Description="Prevent Extra Frozen Cell Rendering with Hidden Frozen Column and Grouping">
    <ComponentUnderTest>
        <SfGrid @ref="Grid10" DataSource="GetAllRecords()" Width="600" AllowResizing="true" AllowRowDragAndDrop=true AllowGrouping="true">
            <GridGroupSettings Columns="Initials"></GridGroupSettings>
            <GridEditSettings AllowAdding=true AllowDeleting=true AllowEditing=true Mode="EditMode.Normal"></GridEditSettings>
            <GridColumns>
                <GridColumn Visible="false" IsFrozen="true" />
                <GridColumn Field="@nameof(Order.OrderID)" Width="110" HeaderText="Order ID"></GridColumn>
                <GridColumn Field="@nameof(Order.CustomerID)" Width="120" HeaderText="Customer ID" IsFrozen="true"></GridColumn>
                <GridColumn Field="@nameof(Order.OrderDate)" Width="130" HeaderText="Order Date"></GridColumn>
                <GridColumn Field="@nameof(Order.Freight)" Width="100" HeaderText="Freight" Format="c2"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>
@code
{
    SfFixture fixture10 { get; set; }
    private SfGrid<Order> Grid10;

    void GridBasicRendering10(Fixture fixture10)
    {
        var cut = fixture10.GetComponentUnderTest<SfGrid<Order>>();

        Assert.True(cut.Instance.AllowRowDragAndDrop, "Row drag and drop enabled");
        Assert.True(cut.Instance.AllowResizing, "Column resizing enabled");
        Assert.True(cut.Instance.AllowGrouping, "Grouping enabled");
        Assert.True(cut.Instance.GroupSettings.Columns.Count() > 0, "Grid has grouped columns");
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");
        
        var frozenColumns = cut.Instance.Columns.Where(col => col.IsFrozen).ToList();
        Assert.True(frozenColumns.Count > 0, "Grid has frozen columns");
        
        var initialDisableState = cut.Instance.GroupModule.DisableExtraFrozenTd;
        
        cut.Instance._jsAdaptor.PreventExtraFrozenCellRendering();
        
        Assert.True(cut.Instance.GroupModule.DisableExtraFrozenTd, "DisableExtraFrozenTd flag is set to true");
        Assert.True(cut.Instance.GroupModule.DisableExtraFrozenTd != initialDisableState || initialDisableState == true,
            "DisableExtraFrozenTd state changed or was already true");

        var resizableColumn = cut.Instance.Columns.FirstOrDefault(col => col.Field == nameof(Order.OrderID));
        var columnWidthArgs = "{\"requestType\":\"columnWidthChanged\",\"columnUid\":\"" + resizableColumn.Uid + "\",\"width\":\"150\"}";
        cut.Instance._jsAdaptor.ColumnWidthChanged(columnWidthArgs, isResizing: false);

        Assert.True(cut.Instance.Rows.Count > 0, "Grid maintains its data after PreventExtraFrozenCellRendering");
    }
}


