@code
{
    SfFixture Fixture11 { get; set; }
    private SfGrid<Order> Grid11;
    bool resizeStoppedCancel;

    void GridBasicRendering11(Fixture fixture11)
    {
        var cut = fixture11.GetComponentUnderTest<SfGrid<Order>>();

        Assert.True(cut.Instance.AllowRowDragAndDrop, "Row drag and drop enabled");
        Assert.True(cut.Instance.AllowResizing, "Column resizing enabled");
        Assert.True(cut.Instance.AllowGrouping, "Grouping enabled");
        Assert.True(cut.Instance.GroupSettings.Columns.Count() > 0, "Grid has grouped columns");
        Assert.True(cut.Instance.Rows.Count > 0, "Grid rendered successfully");

        var frozenColumns = cut.Instance.Columns.Where(col => col.IsFrozen).ToList();
        Assert.True(frozenColumns.Count > 0, "Grid has frozen columns");

        var initialDisableState = cut.Instance.GroupModule.DisableExtraFrozenTd;

        cut.Instance._jsAdaptor.PreventExtraFrozenCellRendering();

        Assert.True(cut.Instance.GroupModule.DisableExtraFrozenTd, "DisableExtraFrozenTd flag is set to true");
        var resizableColumn = cut.Instance.Columns.FirstOrDefault(col => col.Field == nameof(Order.OrderID));
        var columnWidthArgsWithAllowStopEvent = "{\"requestType\":\"columnResizeStopped\","
            + "\"columnUid\":\"" + resizableColumn.Uid + "\","
            + "\"width\":\"150\","
            + "\"allowStopEvent\":true,"
            + "\"tableWidth\":\"600\","
            + "\"leftFrozenTableWidth\":\"200\","
            + "\"rightFrozenTableWidth\":\"100\""
        + "}";
        //cut.Instance._jsAdaptor.ColumnWidthChanged(columnWidthArgsWithAllowStopEvent, isResizing: false);
        cut.InvokeAsync(() => cut.Instance._jsAdaptor.ColumnWidthChanged(columnWidthArgsWithAllowStopEvent, isResizing: false));
        resizeStoppedCancel = true;
        //cut.Instance._jsAdaptor.ColumnWidthChanged(columnWidthArgsWithAllowStopEvent, isResizing: false);
        cut.InvokeAsync(() => cut.Instance._jsAdaptor.ColumnWidthChanged(columnWidthArgsWithAllowStopEvent, isResizing: false));

        Assert.True(cut.Instance.Rows.Count > 0, "Grid maintains its data after PreventExtraFrozenCellRendering");
    }

    public void OnResizeStart(ResizeArgs args)
    {
        
    }
    public void ResizeStopped(ResizeArgs args)
    {   
        args.Cancel = resizeStoppedCancel;
        Assert.True(args.Column.Field != null, "Check Field not null");
    }
}
 
 

