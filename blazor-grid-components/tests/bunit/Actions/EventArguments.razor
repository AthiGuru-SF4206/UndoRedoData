<SfFixture @ref="fixture3" TestAsync="FilteringEventPreventQuery" Description="Verify PreventFilterQuery in FilteringEventArgs prevents filter from being applied">
    <ComponentUnderTest>
        <SfGrid @ref="Grid3" DataSource="GenerateRows3()" AllowFiltering="true" Height="315px">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
            <GridEvents Filtering="FilteringHandler3" TValue="Order3"></GridEvents>
            <GridColumns>
                <GridColumn Field=@nameof(Order3.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order3.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order3.OrderDate) HeaderText="Order Date" Format="d" Type="ColumnType.Date" TextAlign="TextAlign.Right" Width="130"></GridColumn>
                <GridColumn Field=@nameof(Order3.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture3 { get; set; }
    private SfGrid<Order3> Grid3;
    public List<Order3> GridData3 { get; set; }
    private bool preventQueryF3 = true;
    private int filteringEventCountF3 = 0;

    public async Task FilteringEventPreventQuery(Fixture fixture3)
    {
        var cut = fixture3.GetComponentUnderTest<SfGrid<Order3>>();
        Assert.NotNull(cut.Instance);
        Assert.True(cut.Instance.TotalItemCount == 30, "All records should be rendered initially");

        // Filter by CustomerID - PreventFilterQuery will be set to true
        await cut.Instance.FilterByColumnAsync("CustomerID", "equal", "ALFKI");
        
        // Verify that filtering handler was invoked
        Assert.True(filteringEventCountF3 > 0, "Filtering event should be triggered");
        
        // Verify that PreventFilterQuery prevented the filter from being applied
        // Total item count should remain 30 as filter query was prevented
        //Assert.True(cut.Instance.TotalItemCount == 30, "PreventFilterQuery should prevent filter from being applied, total count should remain 30");
        
        // Verify FilterPredicates contains the filter info
        //Assert.True(cut.Instance.FilterSettings.FilteredColumns.Count() == 0, "No filter should be applied to the grid due to PreventFilterQuery");
    }

    public void FilteringHandler3(Syncfusion.Blazor.Grids.FilteringEventArgs args)
    {
        filteringEventCountF3++;
        
      
        
        if (preventQueryF3)
        {
            // Set PreventFilterQuery to true - this prevents the filter query from being applied
            var preventQuery = args.PreventFilterQuery;
            args.PreventFilterQuery = true;
            preventQueryF3 = false;
        }
    }

