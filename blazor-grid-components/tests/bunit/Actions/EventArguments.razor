        // cut.FindAll(".e-filtermenudiv")[1].Click(new MouseEventArgs());

        await cut.Instance.SearchAsync("Alfki");
        Assert.True(cut.Instance.TotalItemCount != 30, "Searching operation is executed.");
        await cut.Instance.GroupColumnAsync("CustomerID");
        // await cut.Instance.SelectRowAsync(0);
        // Assert.True(cut.Instance.Rows[0].IsSelected, "Row is selected.");
        // await cut.Instance.StartEditAsync();
        // Assert.True(cut.FindAll(".e-inline-edit").Count == 1);
        // Order addRecord = new Order()
        // {
        //     OrderID = 1100,
        //     CustomerID = "ABCDE",
        //     Freight = 25.7,
        //     OrderDate = new DateTime(2010, 5, 1)
        // };
        // await cut.Instance.AddRecordAsync(addRecord);
        // await cut.Instance.AddRecordAsync();
        // Assert.True(cut.FindAll(".e-addedrow").Count == 1);
        // _allowGrouping = false;
        // await cut.Instance.CloseEditAsync();
    }

    public void SearchingHandler(SearchingEventArgs args)
    {
        args.Cancel = preventSearch;
    }

    public void SearchedHandler(SearchedEventArgs args)
    {
        Assert.True(args.SearchText == "Alfki");
    }

    public void GroupingHandler(GroupingEventArgs args)
    {
        args.Cancel = preventGrouping;
    }

    public void GroupedHandler(GroupedEventArgs args)
    {
        Assert.True(args.Action.ToString() == "Add");
        Assert.True(args.ColumnName == "CustomerID");
    }

    public void ColumnReorderingHandler(ColumnReorderingEventArgs args)
    {
        args.Cancel = true;
    }

    public void FilteringHandler(Syncfusion.Blazor.Grids.FilteringEventArgs args)
    {
        if (preventFilter)
        {
            args.Cancel = true;
            Assert.True(args.FilterPredicates.Count == 1);
            Assert.True(args.ColumnName == "CustomerID");
        }
        else
        {
            args.PreventFilterQuery = true;    
        }
        preventFilter = false;
    }

    public void ColumnMenuOpenHandler(ColumnMenuOpenEventArgs args)
    {

    }

    public void FilterDialogOpeningHandler(FilterDialogOpeningEventArgs args)
    {
        Assert.True(args.ColumnName == "CustomerID");
        Assert.True(args.CheckboxListData.Count() > 0);
        Assert.True(args.FilterChoiceCount == 0);
    }

    public void RowCreatingHandler(RowCreatingEventArgs<Order> args)
    {
        
    }

    public void RowCreatedHandler(RowCreatedEventArgs<Order> args)
    {

    }

    public void EditCancelingHandler(EditCancelingEventArgs<Order> args)
    {
        
    }

    public void EditCanceledHandler(EditCanceledEventArgs<Order> args)
    {
        
    }

    public void BeginEditHandler(BeginEditArgs<Order> args)
    {
        
    }

    public List<Order> GenerateRows()
    {
        return GridData = Enumerable.Range(1, 30).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
            OrderDate = DateTime.Now.AddDays(-x),
        }).ToList();
    }

    public class Order
    {
        public int? OrderID { get; set; }
        public string CustomerID { get; set; }
        public DateTime? OrderDate { get; set; }
        public double? Freight { get; set; }
    }
}


