        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length == 1);

        Assert.True(1 == cut.Instance.GroupSettings.Columns.Length, "Group Settings");
        Assert.True(1 == cut.Instance.SortSettings.Columns.Count(), "Sort Settings");
        Assert.True(1 == cut.FindAll(".e-grouptopleftcell").Count(), "Group Indent Cell");
        Assert.True(cut.FindAll(".e-grouptopleftcell")[0].QuerySelector(".e-headercelldiv").ClassList.Contains("e-emptycell"), "Group Indent Cell Contains empeycell class");

        var content = cut.FindAll(".e-gridcontent")[0].QuerySelectorAll("tr");
        Assert.True(1 == content[0].QuerySelectorAll(".e-recordplusexpand").Count(), "Record Expand Cell");
        Assert.True(content[0].QuerySelectorAll(".e-recordplusexpand")[0].FirstElementChild.ClassList.Contains("e-gdiagonaldown"), "Group Indent Cell");
        Assert.True(1 == content[0].QuerySelectorAll(".e-groupcaption").Count(), "Group Caption Cell");
        Assert.True("3" == content[0].QuerySelectorAll(".e-groupcaption")[0].GetAttribute("colspan"), "Group caption colspan");
        Assert.True("\nCustomer Name: ALFKI - 4 items        " == content[0].QuerySelectorAll(".e-groupcaption")[0].TextContent, "Group caption textcontent");
        Assert.True(1 == content[1].QuerySelectorAll(".e-indentcell").Count(), "Normal Row Indent Cell");

        var gHeader = cut.FindAll(".e-groupheadercell");
        Assert.True(1 == gHeader[0].QuerySelectorAll(".e-grouptext").Count(), "Group Text Area");
        Assert.True("Customer Name" == gHeader[0].QuerySelectorAll(".e-grouptext")[0].TextContent, "Group TextContent");
        Assert.True(1 == gHeader[0].QuerySelectorAll(".e-groupsort").Count(), "Group Sorting Count");
        Assert.True(gHeader[0].QuerySelectorAll(".e-groupsort")[0].ClassList.Contains("e-ascending"), "Group Sorting Order");
        Assert.True(1 == gHeader[0].QuerySelectorAll(".e-ungroupbutton").Count(), "UnGroup Button");
    }

    public void ActionBeginHandler(ActionEventArgs<Order> args)
    {
        Assert.True(args.ColumnName == "CustomerID", "Grouped column name");
        Assert.True(args.Direction == SortDirection.Ascending, "Grouped column name");
        Assert.True(args.Cancel == false, "Grouped column name");
    }

    public void ActionCompleteHandler(ActionEventArgs<Order> args)
    {
        if (args.RequestType.Equals(Syncfusion.Blazor.Grids.Action.Grouping))
        {
            var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
            Assert.True(args.ColumnName == "CustomerID", "Grouped column name");
            Assert.True(args.Direction == SortDirection.Ascending, "Grouped direction check");
            Assert.True(args.Cancel == false, "args cancel check");
        }
    }
}

