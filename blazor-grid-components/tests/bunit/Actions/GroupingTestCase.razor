        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length == 2);
        cut.Instance.GroupSettings.EnableLazyLoading = false;
        cut.Instance.EnableInfiniteScrolling = false;
        cut.Instance.EnableVirtualization = true;
        cut.Instance.GroupSettings.PersistGroupState = true;

        await cut.Instance.ExpandAllGroupAsync();
        cut.WaitForState(() =>
            cut.Find(".e-gridcontent")
               .QuerySelectorAll("tr:not([style*='display: none'])")
               .Count() > 0);

        var visibleVirtual = cut.Find(".e-gridcontent")
                                .QuerySelectorAll("tr:not([style*='display: none'])")
                                .Count();
        Assert.True(visibleVirtual > 0, "ExpandAllGroupAsync with virtualization-only executed");

        cut.Instance.EnableInfiniteScrolling = true;
        cut.Instance.EnableVirtualization = false;
        cut.Instance.GroupSettings.EnableLazyLoading = false;
        cut.Instance.GroupSettings.PersistGroupState = true;

        await cut.Instance.CollapseAllGroupAsync();
        cut.WaitForState(() =>
            cut.Find(".e-gridcontent")
               .QuerySelectorAll("tr:not([style*='display: none'])")
               .Count() < visibleVirtual);

        await cut.Instance.ExpandAllGroupAsync();
        cut.WaitForState(() =>
            cut.Find(".e-gridcontent")
               .QuerySelectorAll("tr:not([style*='display: none'])")
               .Count() >= visibleVirtual);

        var visibleInfinitePersist = cut.Find(".e-gridcontent")
                                        .QuerySelectorAll("tr:not([style*='display: none'])")
                                        .Count();
        Assert.True(visibleInfinitePersist >= visibleVirtual,
            "Non-lazy ExpandAllGroupAsync with infinite & PersistGroupState executed");

        cut.Instance.EnableInfiniteScrolling = false;
        cut.Instance.EnableVirtualization = true;
        cut.Instance.GroupSettings.EnableLazyLoading = false;

        await cut.Instance.ExpandAllGroupAsync();
