                                         .QuerySelectorAll("tr:not([style*='display: none'])")
                                         .Count();

        cut.Instance.AllowGrouping = false;
        await cut.Instance.ExpandAllGroupAsync();

        var visibleAfterNoGrouping = cut.Find(".e-gridcontent")
                                        .QuerySelectorAll("tr:not([style*='display: none'])")
                                        .Count();

        Assert.True(
            visibleBeforeNoGrouping == visibleAfterNoGrouping,
            "ExpandAllGroupAsync no-op when AllowGrouping is false");


        cut.Instance.AllowGrouping = true;
    }
}
