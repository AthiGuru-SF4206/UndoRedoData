@code {
    SfFixture fixture6 { get; set; }
    public SfGrid<EmployeeData6> Grid6 { get; set; }
    public List<EmployeeData6> Employees6 { get; set; }

    private bool isDetailExpanding { get; set; }
    private bool isActionComplete { get; set; }
    private bool isDetailDataBound { get; set; }
    private bool isDetailExpanded { get; set; }
    private bool isDetailCollapsed { get; set; }

    public async Task GridBasicRendering6(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<EmployeeData6>>();

        await Grid6.ExpandCollapseDetailRowAsync("FirstName", "Nancy");

        cut.WaitForAssertion(() =>
        {
            Assert.True(isDetailExpanding, "DetailExpanding event fired");
            Assert.True(isDetailDataBound, "DetailDataBound event fired");
            Assert.True(isDetailExpanded, "DetailExpanded event fired");
        }, TimeSpan.FromSeconds(50));

        // Assert.True(isDetailExpanding, "DetailExpanding event fired");
        // Assert.True(isDetailDataBound, "DetailDataBound event fired");
        // Assert.True(isDetailExpanded, "DetailExpanded event fired");

        isDetailCollapsed = false;
        await Grid6.ExpandCollapseDetailRowAsync("FirstName", "Nancy");
        Assert.True(isDetailCollapsed, "DetailCollapsed event fired");

        await Grid6.ExpandAllDetailRowAsync();
        Assert.True(cut.FindAll(".detailtable").Count == 9);
        await Grid6.CollapseAllDetailRowAsync();
        Assert.True(cut.FindAll(".detailtable").Count == 0);
        Assert.True(isActionComplete, "OnActionComplete event fired");
    }

    public void DetailExpandingHandler(DetailsExpandingEventArgs<EmployeeData6> args)
    {
        isDetailExpanding = true;
    }

    public void ActionCompleteHandler(ActionEventArgs<EmployeeData6> args)
    {
        isActionComplete = true;
    }

    public void DetailDataBoundHandler(DetailDataBoundEventArgs<EmployeeData6> args)
    {
        isDetailDataBound = true;
    }

    public void DetailExpandedHandler(DetailsExpandedEventArgs<EmployeeData6> args)
    {
        isDetailExpanded = true;
    }

    public void DetailCollapsedHandler(DetailsCollapsedEventArgs<EmployeeData6> args)
    {
        isDetailCollapsed = true;
    }

    public List<EmployeeData6> GenerateRows6()
    {
        return Employees6 = Enumerable.Range(1, 9).Select(x => new EmployeeData6()
        {
            EmployeeID = x,
            FirstName = (new string[] { "Nancy", "Andrew", "Janet", "Margaret", "Steven" })[new Random().Next(5)],
            LastName = (new string[] { "Davolio", "Fuller", "Leverling", "Peacock", "Buchanan" })[new Random().Next(5)],
            Title = (new string[] { "Sales Representative", "Vice President, Sales", "Sales Manager",
                                    "Inside Sales Coordinator" })[new Random().Next(4)],
            HireDate = DateTime.Now.AddDays(-x),
            City = (new string[] { "Seattle", "Tacoma", "Redmond", "Kirkland", "London" })[new Random().Next(5)],
            Country = (new string[] { "USA", "UK" })[new Random().Next(2)],
        }).ToList();
    }

    public class EmployeeData6
    {
        public int? EmployeeID { get; set; }
        public string FirstName { get; set; }
        public string LastName { get; set; }
        public string Title { get; set; }
        public DateTime? HireDate { get; set; }
        public string City { get; set; }
        public string Country { get; set; }
    }
}

