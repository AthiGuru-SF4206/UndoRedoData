<SfFixture @ref="fixture" Test="GridBasicRendering" Description="Display a Detail Template">
    <ComponentUnderTest>
        <SfGrid @ref="Grid" DataSource="@GenerateEmployeeData()" AllowPaging="true">
            <GridEvents OnRecordClick="RecordClick" DetailsExpanding="DetailsExpandingHandler" DetailsExpanded="DetailsExpandedHandler" DetailsCollapsing="DetailsCollapsingHandler" DetailsCollapsed="DetailsCollapsedHandler" TValue="Employee"></GridEvents>
            <GridTemplates>
                <DetailTemplate>
                    @{
                        var employee = (context as Employee);
                        <table class="detailtable" width="100%">
                            <colgroup>
                                <col width="35%">
                                <col width="35%">
                                <col width="30%">
                            </colgroup>
                            <tbody>
                                <tr>
                                    <td rowspan="4" style="text-align: center;">
                                        <img class="photo" src="@($" Images/Employees/{employee.EmployeeID}.png")" alt="@employee.EmployeeID" />
                                    </td>
                                    <td>
                                        <span style="font-weight: 500;">Employee ID: </span> @employee.FirstName
                                    </td>
                                    <td>
                                        <span style="font-weight: 500;">Hire Date: </span> @employee.HireDate
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span style="font-weight: 500;">Last Name: </span> @employee.LastName
                                    </td>
                                    <td>
                                        <span style="font-weight: 500;">City: </span> @employee.City
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span style="font-weight: 500;">Title: </span> @employee.Title
                                    </td>
                                    <td>
                                        <span style="font-weight: 500;">Country: </span> @employee.Country
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    }
                </DetailTemplate>
            </GridTemplates>
            <GridColumns>
                <GridColumn Field=@nameof(Employee.FirstName) HeaderText="First Name" Width="110"> </GridColumn>
                <GridColumn Field=@nameof(Employee.LastName) HeaderText="Last Name" Width="110"></GridColumn>
                <GridColumn Field=@nameof(Employee.Title) HeaderText="Title" Width="110"></GridColumn>
                <GridColumn Field=@nameof(Employee.Country) HeaderText="Country" Width="110"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code
{
    SfFixture fixture;
    private SfGrid<Employee> Grid { get; set; }
    private bool preventExpanding { get; set; }
    private bool preventCollapsing { get; set; }

    void GridBasicRendering(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Employee>>();

        Assert.True(9 == cut.FindAll(".e-row").Count, "All rows are rendered properly");
        Assert.True(9 == cut.FindAll(".e-detailrowcollapse").Count, "detail template rows are rendered");
        Assert.False(cut.FindAll(".e-icons")[0].ClassList.Contains("e-dtdiagonaldown e-icon-gdownarrow"), "detail template is not expanded");
        Assert.True(0 == cut.FindAll(".e-detailrow").Count, "detail template hasn't rendered");        

        cut.FindAll(".e-row")[0].Children[0].Click(new MouseEventArgs());

        Assert.True(1 == cut.FindAll(".e-detailrow").Count, "detail template has been rendered");
        Assert.True(8 == cut.FindAll(".e-detailrowcollapse").Count, "other eight rows are rendered without expanding");
        Assert.True(1 == cut.FindAll(".e-detailrowexpand").Count, "Detail template rendering properly");
        Assert.True(1 == cut.FindAll(".e-dtdiagonaldown").Count, "detail template row is expanded properly");

        cut.FindAll(".e-row")[0].Children[0].Click(new MouseEventArgs());

        // using the cancel propert to prevent from expanding and collapsing the detail template.
        preventExpanding = true;
        cut.FindAll(".e-row")[0].Children[0].Click(new MouseEventArgs());
        Assert.True(9 == cut.FindAll(".e-detailrowcollapse").Count, "All the rows are in collapsed state");

        preventExpanding = false;
        cut.FindAll(".e-row")[0].Children[0].Click(new MouseEventArgs());
        Assert.True(8 == cut.FindAll(".e-detailrowcollapse").Count, "other eight rows are rendered without expanding");

        var RowExpand = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.GridRow<Employee>>();
        var rowData = new Employee()
        {
            FirstName = "Alfki",
            LastName = "Alfki",
            Title = "Alfki",
            Country = "Alfki"
        };
        RowExpand.Instance.IsExpanded(rowData, true);

        preventCollapsing = true;
        cut.FindAll(".e-row")[0].Children[0].Click(new MouseEventArgs());
        Assert.True(8 == cut.FindAll(".e-detailrowcollapse").Count, "other eight rows are rendered without expanding");

        preventCollapsing = false;
        cut.FindAll(".e-row")[0].Children[0].Click(new MouseEventArgs());
        Assert.True(9 == cut.FindAll(".e-detailrowcollapse").Count, "All the rows are in collapsed state");

        
    }

    public async Task DetailsExpandingHandler(DetailsExpandingEventArgs<Employee> args)
    {
        args.Cancel = preventExpanding;
        Assert.True(args.Data != null);
        // below line is commented since its not working fine need to fix this in source level.
        // Assert.True(args.RowIndex == 0);
    }

    public void DetailsExpandedHandler(DetailsExpandedEventArgs<Employee> args)
    {
    }

    public void RecordClick(RecordClickEventArgs<Employee> args)
    {
        
    }

    public async Task DetailsCollapsingHandler(DetailsCollapsingEventArgs<Employee> args)
    {
        args.Cancel = preventCollapsing;
        Assert.True(args.Data != null);
        // below line is commented since its not working fine need to fix this in source level.
        // Assert.True(args.RowIndex == 0);
    }

    public void DetailsCollapsedHandler(DetailsCollapsedEventArgs<Employee> args)
    {
    }
    
}
