@code {

    SfFixture fixture71 { get; set; }

    List<Product> GenerateProductData71()
    {
        return new List<Product>
        {
            new Product { ProductName = "Chai", UnitsInStock = 10 },
            new Product { ProductName = "Chai", UnitsInStock = 20 },
            new Product { ProductName = "Chang", UnitsInStock = 30 }
        };
    }

    void ReactiveAggregateGroupingFooter71(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Product>>();
