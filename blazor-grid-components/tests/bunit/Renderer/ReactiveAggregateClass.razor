@code
{
    SfFixture fixture3 { get; set; }
    private SfGrid<Product> DefaultGrid3;
    public static List<Product> Products3 { get; set; }
    private string[] Units3 = (new string[] { "QuantityPerUnit" });
    bool preventCurrentAction3 = false;
    public List<Product> GenerateProductData3()
    {
        return Products3 = Enumerable.Range(1, 10).Select(x => new Product
        {
            ID = 1000 + x,
            ProductName = (new string[] { "Chai", "Chang", "Aniseed Syrup", "Chef Anton's Cajun Seasoning", "Chef Anton's Gumbo Mix" })[new Random().Next(5)],
            QuantityPerUnit = (new string[] { "10 boxes x 20 bags", "24 - 12 oz bottles", "12 - 550 ml bottles", "48 - 6 oz jars", "36 boxes" })[new Random().Next(5)],
            UnitsInStock = x,
            Discontinued = (new bool[] { true, false })[new Random().Next(2)]
        }).ToList();
    }
    public async void GridBasicRendering3(Fixture fixture)
    {
        var cut3 = fixture.GetComponentUnderTest<SfGrid<Product>>();
        await cut3.Instance.AddRecordAsync();
        Assert.True(cut3.FindAll(".e-insertedrow").Count == 1);
        Product addRecord = new Product()
        {
            ID = 5000,
            ProductName = "ABCDE",
            QuantityPerUnit = "100",
            UnitsInStock = 50,
            Discontinued = false
        };
        await DefaultGrid3.FilterByColumnAsync("ProductName", "equal", "Chai");
        await DefaultGrid3.AddRecordAsync(addRecord);
        await DefaultGrid3.SelectRowAsync(4);
        await DefaultGrid3.DeleteRecordAsync();
        await DefaultGrid3.EndEditAsync();
        await DefaultGrid3.ClearFilteringAsync();
    }

    public class CustomAdaptor : DataAdaptor
    {
        // Performs the data read operation.
        public override object Read(DataManagerRequest dm, string key = null)
        {
            // Retrieve the data source.
            IEnumerable<Product> DataSource = Products3;

            // Perform searching on the data source if search criteria are provided.
            if (dm.Search != null && dm.Search.Count > 0)
            {
                DataSource = DataOperations.PerformSearching(DataSource, dm.Search);
            }

            // Perform sorting on the data source if sorting criteria are provided.
            if (dm.Sorted != null && dm.Sorted.Count > 0)
            {
                DataSource = DataOperations.PerformSorting(DataSource, dm.Sorted);
            }

            // Perform filtering on the data source if filter criteria are provided.
            if (dm.Where != null && dm.Where.Count > 0)
            {
                DataSource = DataOperations.PerformFiltering(DataSource, dm.Where, dm.Where[0].Operator);
            }

            // Count the total number of records.
            int count = DataSource.Cast<Product>().Count();

            // Perform paging by skipping the specified number of records.
            if (dm.Skip != 0)
            {
                DataSource = DataOperations.PerformSkip(DataSource, dm.Skip);
            }

            // Take the specified number of records for paging.
            if (dm.Take != 0)
            {
                DataSource = DataOperations.PerformTake(DataSource, dm.Take);
            }

            // Return the result with or without counts based on the request.
            return dm.RequiresCounts ? new DataResult() { Result = DataSource, Count = count } : (object)DataSource;
        }

        // Performs the insert operation.
        public override object Insert(DataManager dm, object value, string key)
        {
            Products3.Insert(0, value as Product);
            return value;
        }

        // Performs the remove operation.
        public override object Remove(DataManager dm, object value, string keyField, string key)
        {
            Products3.Remove(Products3.Where(or => or.ID == int.Parse(value.ToString())).FirstOrDefault());
            return value;
        }

        // Performs the update operation.
        public override object Update(DataManager dm, object value, string keyField, string key)
        {
            var data = Products3.Where(or => or.ID == (value as Product).ID).FirstOrDefault();
            if (data != null)
            {
                data.ID = (value as Product).ID;
                data.ProductName = (value as Product).ProductName;
                data.QuantityPerUnit = (value as Product).QuantityPerUnit;
                data.UnitsInStock = (value as Product).UnitsInStock;
                data.Discontinued = (value as Product).Discontinued;
            }
            return value;
        }

        // Performs the batch update operation.
        public override object BatchUpdate(DataManager dm, object Changed, object Added, object Deleted, string KeyField, string Key, int? dropIndex)
        {
            // Update the changed records in the data source.
            if (Changed != null)
            {
                foreach (var record in (IEnumerable<Product>)Changed)
                {
                    Product val = Products3.Where(or => or.ID == record.ID).FirstOrDefault();
                    val.ProductName = record.ProductName;
                    val.QuantityPerUnit = record.QuantityPerUnit;
                    val.UnitsInStock = record.UnitsInStock;
                    val.Discontinued = record.Discontinued;
                }
            }

            // Add the new records to the data source.
            if (Added != null)
            {
                foreach (var record in (IEnumerable<Product>)Added)
                {
                    Products3.Add(record);
                }
            }

            // Remove the deleted records from the data source.
            if (Deleted != null)
            {
                foreach (var record in (IEnumerable<Product>)Deleted)
                {
                    Products3.Remove(Products3.Where(or => or.ID == record.ID).FirstOrDefault());
                }
            }

            // Return the updated data source.
            return Products3;
        }
    }

}



