<SfFixture @ref="fixture4" Test="DeepGrouping_ExpandCollapseNavigation" Description="Test deep grouping hierarchy with sequential expansion to exercise multi-level navigation. PREREQUISITE: EnableVirtualization for CurrentGroupedData population.">
    <ComponentUnderTest>
        <SfGrid DataSource="@GenerateOrderData().Take(60).ToList()" AllowGrouping="true" AllowPaging="true">
            <GridGroupSettings Columns="@(new string[] { "CustomerID", "ShipCountry", "ShipCity" })" ShowGroupedColumn="true"></GridGroupSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" TextAlign="TextAlign.Right" IsPrimaryKey="true" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCountry) HeaderText="Country" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCity) HeaderText="City" Width="150"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" Width="200"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture fixture4 { get; set; }

    void DeepGrouping_ExpandCollapseNavigation(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        cut.WaitForState(() => cut.Instance.GroupSettings.Columns.Length == 3);
        cut.WaitForState(() => cut.Instance.CurrentViewData != null && cut.Instance.CurrentViewData.Count() > 0);
        var level1Expands = cut.FindAll(".e-recordplusexpand");
        Assert.True(level1Expands.Count > 0, "Level 1 groups have expand buttons");
        if (level1Expands.Count > 0)
        {
            level1Expands[0].Click();
            Task.Delay(350);
            var allExpands = cut.FindAll(".e-recordplusexpand");
            Assert.True(allExpands.Count > level1Expands.Count || cut.FindAll(".e-recordpluscollapse").Count > 0,
                "Level 1 expanded - Level 2 groups now visible");
            var level2Expands = allExpands.Skip(1).FirstOrDefault();
            if (level2Expands != null)
            {
                level2Expands.Click();
                Task.Delay(350);
                
                var afterLevel2 = cut.FindAll(".e-recordpluscollapse");
                Assert.True(afterLevel2.Count >= 2, "Multi-level expansion successful");
            }
        }
    }
}


