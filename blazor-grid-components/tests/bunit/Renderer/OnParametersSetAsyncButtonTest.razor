@inherits GridTestBase

<SfFixture @ref="Fixture1" Test="OnParametersSetAsync_AllowAdding_ChangeViaButton" Description="Verify OnParametersSetAsync is triggered when AllowAdding changes via button click">
    <ComponentUnderTest>
        <div>
            <SfButton OnClick="EditChangeAllowAdding">Disable AllowAdding</SfButton>
        </div>
        <SfGrid DataSource="GenerateOrderData()" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })" Height="315" AllowTextWrap="true" EnableInfiniteScrolling ="true" AllowSelection="true" AllowSorting="true" AllowMultiSorting="true">
            <GridSortSettings AllowUnsort="true">
                <GridSortColumns>
                    <GridSortColumn Field="OrderID" Direction="@direction"></GridSortColumn>
                </GridSortColumns>
            </GridSortSettings>
            <GridSelectionSettings Mode ="@mode" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings>
            <GridEditSettings AllowAdding="@allowAddingF1" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
            <GridTextWrapSettings WrapMode="@WrapModeValue"></GridTextWrapSettings>
            <GridSearchSettings Fields=@InitSearch Operator=Syncfusion.Blazor.Operator.Contains Key="Ha" IgnoreCase="@ignorecase"></GridSearchSettings>
            <GridInfiniteScrollSettings EnableCache="@isEnabled"></GridInfiniteScrollSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules{ Required=true})" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" ValidationRules="@(new ValidationRules{ Required=true, MinLength=5})" Width="120" TextAlign="TextAlign.None"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" ValidationRules="@(new ValidationRules{ Required=true, Min=1, Max=1000})" Format="C2" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCountry) HeaderText="Ship Country" EditType="EditType.DropDownEdit" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture Fixture1 { get; set; }
    bool allowAddingF1 = true;
    public SortDirection direction = SortDirection.Ascending;
    public SelectionMode mode = SelectionMode.Both;
    public WrapMode WrapModeValue { get; set; } = WrapMode.Content;
    public bool ignorecase = true;
    public string[] InitSearch = new string[] { "CustomerID" };
    public bool isEnabled = true;
    void EditChangeAllowAdding()
    {
        allowAddingF1 = false;
    }
    void SortDirectionChange()
    {
        direction = SortDirection.Descending;
    }
    void SelectionModeChange()
    {

        mode = SelectionMode.Row;
    }
    void selectionTypeChange()
    {
        mode = SelectionMode.Both;
    }
    void selectionTypeChange2()
    {
        mode = SelectionMode.Cell;
    }
    void TextWrapChange()
    {
        WrapModeValue = WrapMode.Header;
    }
    void IgnoreCaseChange()
    {
        ignorecase = !ignorecase;
    }
    void InfiniteScrollChange()
    {
        isEnabled = !isEnabled;
    }
    void OnParametersSetAsync_AllowAdding_ChangeViaButton(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        // Verify initial state: AllowAdding is true
        Assert.True(grid.EditSettings.AllowAdding, "Initial AllowAdding should be true");

        // Invoke the property change method directly (simulates button click)
        EditChangeAllowAdding();
        TextWrapChange();
        IgnoreCaseChange();
        InfiniteScrollChange();
        SelectionModeChange();
        selectionTypeChange();
        selectionTypeChange2();
        SortDirectionChange();
        // Render to apply the parameter changes and trigger OnParametersSetAsync
        cut.Render();
        
        // Verify the change was applied through OnParametersSetAsync
        Assert.False(grid.EditSettings.AllowAdding, "AllowAdding should be false after property change triggers OnParametersSetAsync");
    }
}

