<SfFixture @ref="Fixture5" Test="OnParametersSetAsync_ToggleMultipleTimes_ButtonClick" Description="Verify OnParametersSetAsync handles multiple toggle operations via button clicks">
    <ComponentUnderTest>
        <div>
            <SfButton OnClick="ToggleAllowAdding">Toggle AllowAdding</SfButton>
        </div>
        <SfGrid DataSource="GenerateOrderData()" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })" Height="315">
            <GridEditSettings AllowAdding="@allowAddingF5" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules{ Required=true})" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" ValidationRules="@(new ValidationRules{ Required=true, MinLength=5})" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" ValidationRules="@(new ValidationRules{ Required=true, Min=1, Max=1000})" Format="C2" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCountry) HeaderText="Ship Country" EditType="EditType.DropDownEdit" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture Fixture5 { get; set; }
    bool allowAddingF5 = true;
    
    void ToggleAllowAdding()
    {
        allowAddingF5 = !allowAddingF5;
    }
    
    void OnParametersSetAsync_ToggleMultipleTimes_ButtonClick(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        
        // Verify initial state
        Assert.True(grid.EditSettings.AllowAdding, "Initial AllowAdding should be true");
        
        // First toggle: true -> false
        ToggleAllowAdding();
        cut.Render();
        Assert.False(grid.EditSettings.AllowAdding, "After first toggle, AllowAdding should be false");
        
        // Second toggle: false -> true
        ToggleAllowAdding();
        cut.Render();
        Assert.True(grid.EditSettings.AllowAdding, "After second toggle, AllowAdding should be true");
        
        // Third toggle: true -> false
        ToggleAllowAdding();
        cut.Render();
        Assert.False(grid.EditSettings.AllowAdding, "After third toggle, AllowAdding should be false");
    }
}

