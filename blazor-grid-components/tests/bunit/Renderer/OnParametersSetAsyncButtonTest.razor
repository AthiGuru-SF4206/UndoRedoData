@code {
    SfFixture Fixture14 { get; set; }
    List<Order> GridDataSourceF14;

    // Method to change datasource with filtered data
    void ChangeDataSourceToFilteredData()
    {
        // Generate filtered datasource - only orders with high freight (> 40)
        GridDataSourceF14 = GenerateOrderData().Where(x => x.Freight > 40).ToList();
    }

    // Method to change datasource with sorted data
    void ChangeDataSourceToSortedData()
    {
        // Generate sorted datasource - sorted by CustomerID descending
        GridDataSourceF14 = GenerateOrderData().OrderByDescending(x => x.CustomerID).ToList();
    }

    // Method to change datasource with limited records
    void ChangeDataSourceToLimitedData()
    {
        // Generate limited datasource - only first 5 records
        GridDataSourceF14 = GenerateOrderData().Take(5).ToList();
    }

    // Method to restore original datasource
    void RestoreOriginalDataSource()
    {
        GridDataSourceF14 = GenerateOrderData();
    }

    void OnParametersSetAsync_DataSource_ChangeAtRuntime(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;

        // Test 1: Verify initial datasource
        //Assert.NotNull(grid.DataSource, "Initial DataSource should not be null");
        var initialData = (List<Order>)grid.DataSource;
        if (initialData != null)
        {
            int initialRowCount = initialData.Count;
            Assert.Equal(20, initialRowCount);
        }
        // Test 2: Change to filtered datasource (freight > 40)
        ChangeDataSourceToFilteredData();
        cut.Render();


        // Test 3: Change to sorted datasource (by CustomerID descending)
        ChangeDataSourceToSortedData();
        cut.Render();


        // Test 4: Change to limited datasource (only 5 records)
        ChangeDataSourceToLimitedData();
        cut.Render();


        // Test 5: Restore original datasource
        RestoreOriginalDataSource();
        cut.Render();

        //Assert.Equal(initialRowCount, restoredData.Count);

        // Test 6: Verify multiple sequential changes work correctly
        ChangeDataSourceToFilteredData();
        cut.Render();
        ;

        ChangeDataSourceToLimitedData();
        cut.Render();


        ChangeDataSourceToSortedData();
        cut.Render();
    }
}
