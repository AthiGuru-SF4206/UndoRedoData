        {
            new Syncfusion.Blazor.Grids.ColumnState {Column = grid.Columns[0], PreventRefresh = true },
            new Syncfusion.Blazor.Grids.ColumnState { Column = grid.Columns[1],  PreventRefresh = true }
        };
        // Verify initial state: PersistGroupState is true
        //Assert.NotNull(grid.GroupSettings, "GroupSettings should be initialized");
        Assert.True(grid.GroupSettings.PersistGroupState, "Initial PersistGroupState should be true");

        // Verify initial grouped columns
        //Assert.NotNull(grid.GroupSettings.Columns, "Grouped columns should be initialized");
        Assert.Equal(2, grid.GroupSettings.Columns.Length);
        Assert.Contains("CustomerID", grid.GroupSettings.Columns);
        Assert.Contains("ShipCity", grid.GroupSettings.Columns);
        changeFiltering();
        // Invoke the property change method directly (simulates button click)
        ChangePersistGroupState();
        
        // Render to apply the parameter changes and trigger OnParametersSetAsync
        cut.Render();
        
        // Verify PersistGroupState changed to false after parameter change triggers OnParametersSetAsync
        Assert.False(grid.GroupSettings.PersistGroupState, "PersistGroupState should be false after property change triggers OnParametersSetAsync");
    }
}

