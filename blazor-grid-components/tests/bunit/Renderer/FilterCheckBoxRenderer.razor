<SfFixture @ref="Fixture26" Test="GetPredicate_AllBranches_ForeignDataModuleNullAndSet_NonForeignCountZeroSkipped" Description="Verify getPredicate covers: outer if false (Uid match skip), foreign IsForeignColumn=true with DataModule=null (inner if false), foreign with DataModule set (inner if true + ForeignKeyPredicates call), Distinct, non-foreign else with collection.Count != 0, and all pink/red lines">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" AllowFiltering="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture Fixture26 { get; set; }
    void GetPredicate_AllBranches_ForeignDataModuleNullAndSet_NonForeignCountZeroSkipped(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        cut.WaitForState(() => cut.FindAll(".e-filtermenudiv").Count > 0, TimeSpan.FromSeconds(10));
        cut.FindAll(".e-filtermenudiv").First().Click();
        cut.WaitForState(() => cut.FindAll(".e-filter-popup").Count > 0 || cut.FindAll(".e-resfilterdiv").Count > 0, TimeSpan.FromSeconds(10));

        var renderer = cut.FindComponent<Syncfusion.Blazor.Grids.Internal.FilterCheckBoxRenderer<Order>>();

        var cols = grid.GetColumnsAsync().Result;
        var column = cols[0];

        // 1. Outer if false: col.Uid == Column.Uid → entire block skipped (covers false path)
        var filterColsSkip = new System.Collections.Generic.List<Syncfusion.Blazor.Grids.GridFilterColumn>()
        {
            new Syncfusion.Blazor.Grids.GridFilterColumn() { Uid = column.Uid, Field = column.Field }
        };
        var resultSkip = renderer.Instance.getPredicate(filterColsSkip);
        Assert.True(resultSkip.Count == 0, "Skip branch (outer if false) fully covered");

        // 2. Foreign true + DataModule == null (inner if false) + still adds complex predicate
        var foreignColNullDM = new Syncfusion.Blazor.Grids.GridColumn()
        {
            Uid = "foreignUidNull",
            Field = "FKFieldNull",
            ForeignKeyValue = "FKFieldNull"
        };
        // Make it discoverable by GetColumnByFColUidOrField and IsForeignColumn=true
        var colProp = renderer.Instance.GetType().GetProperty("Column", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        colProp?.SetValue(renderer.Instance, foreignColNullDM);
        (grid.Columns as System.Collections.IList)?.Add(foreignColNullDM);

        var filterColsForeignNull = new System.Collections.Generic.List<Syncfusion.Blazor.Grids.GridFilterColumn>()
        {
            new Syncfusion.Blazor.Grids.GridFilterColumn() { Uid = foreignColNullDM.Uid, Field = foreignColNullDM.Field }
        };
        var resultForeignNull = renderer.Instance.getPredicate(filterColsForeignNull);
        Assert.True(resultForeignNull != null && resultForeignNull.Count > 0, "Foreign branch + inner if false (DataModule null) covered");

        // 3. Foreign true + DataModule != null (inner if true → ForeignKeyPredicates called)
        try
        {
            var dataModuleProp = grid.GetType().GetProperty("DataModule", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public);
            if (dataModuleProp != null && dataModuleProp.GetValue(grid) == null)
            {
                var dgTypeDef = grid.GetType().Assembly.GetType("Syncfusion.Blazor.Grids.Internal.DataGenerator`1");
                if (dgTypeDef != null)
                {
                    var dgType = dgTypeDef.MakeGenericType(typeof(Order));
                    var dgInstance = Activator.CreateInstance(dgType, new object[] { grid });
                    dataModuleProp.SetValue(grid, dgInstance);
                }
            }
        }
        catch { /* best-effort */ }

        var foreignColWithDM = new Syncfusion.Blazor.Grids.GridColumn()
        {
            Uid = "foreignUidWithDM",
            Field = "FKFieldWithDM",
            ForeignKeyValue = "FKFieldWithDM"
        };
        colProp?.SetValue(renderer.Instance, foreignColWithDM);
        (grid.Columns as System.Collections.IList)?.Add(foreignColWithDM);

        var filterColsForeignWithDM = new System.Collections.Generic.List<Syncfusion.Blazor.Grids.GridFilterColumn>()
        {
            new Syncfusion.Blazor.Grids.GridFilterColumn() { Uid = foreignColWithDM.Uid, Field = foreignColWithDM.Field }
        };
        var resultForeignWithDM = renderer.Instance.getPredicate(filterColsForeignWithDM);
        Assert.True(resultForeignWithDM != null && resultForeignWithDM.Count > 0, "Foreign branch + inner if true (DataModule set + ForeignKeyPredicates call) covered");

        // Non-foreign else + collection.Count != 0 already covered in prior mixed test; Count==0 unreachable after Distinct
    }
}

