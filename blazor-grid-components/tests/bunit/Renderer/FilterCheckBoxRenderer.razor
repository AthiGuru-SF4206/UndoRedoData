        col.Operator = Syncfusion.Blazor.Operator.DoesNotContain;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "z" }));
        col.Operator = Syncfusion.Blazor.Operator.StartsWith;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "a" }));
        col.Operator = Syncfusion.Blazor.Operator.DoesNotStartWith;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "z" }));
        col.Operator = Syncfusion.Blazor.Operator.EndsWith;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "c" }));
        col.Operator = Syncfusion.Blazor.Operator.DoesNotEndWith;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "z" }));
        col.Operator = Syncfusion.Blazor.Operator.IsNull;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, null, "x" }));
        col.Operator = Syncfusion.Blazor.Operator.IsNotNull;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "x" }));
        col.Operator = Syncfusion.Blazor.Operator.IsEmpty;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, string.Empty, "x" }));
        col.Operator = Syncfusion.Blazor.Operator.IsNotEmpty;
        Assert.True((bool)method.Invoke(null, new object[] { true, col, 0, "abc", "x" }));
    }
}

