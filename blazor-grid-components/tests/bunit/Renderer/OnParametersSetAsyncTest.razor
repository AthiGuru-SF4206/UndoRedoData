<SfFixture @ref="Fixture5" Test="OnParametersSetAsync_TrueToFalseThenBack_ToggleMultipleTimes" Description="Verify OnParametersSetAsync handles multiple toggle operations on EditSettings properties">
    <ComponentUnderTest>
        <SfGrid DataSource="GenerateOrderData()" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })" Height="315">
            <GridEditSettings AllowAdding="false" AllowEditing="false" AllowDeleting="false" Mode="EditMode.Normal"></GridEditSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules{ Required=true})" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" ValidationRules="@(new ValidationRules{ Required=true, MinLength=5})" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" ValidationRules="@(new ValidationRules{ Required=true, Min=1, Max=1000})" Format="C2" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.ShipCountry) HeaderText="Ship Country" EditType="EditType.DropDownEdit" Width="150"></GridColumn>
            </GridColumns>
        </SfGrid>
    </ComponentUnderTest>
</SfFixture>

@code {
    SfFixture Fixture5 { get; set; }
    void OnParametersSetAsync_TrueToFalseThenBack_ToggleMultipleTimes(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        
        // Verify initial state: all false
        Assert.False(grid.EditSettings.AllowAdding, "Initial AllowAdding should be false");
        Assert.False(grid.EditSettings.AllowEditing, "Initial AllowEditing should be false");
        Assert.False(grid.EditSettings.AllowDeleting, "Initial AllowDeleting should be false");
        
        // Toggle to true
        grid.EditSettings.AllowAdding = true;
        grid.EditSettings.AllowEditing = true;
        grid.EditSettings.AllowDeleting = true;
        //cut.SetParametersAsync(Microsoft.AspNetCore.Components.ParameterView.Empty).GetAwaiter().GetResult();
        Assert.True(grid.EditSettings.AllowAdding, "After first toggle, AllowAdding should be true");
        Assert.True(grid.EditSettings.AllowEditing, "After first toggle, AllowEditing should be true");
        Assert.True(grid.EditSettings.AllowDeleting, "After first toggle, AllowDeleting should be true");
        
        // Toggle back to false
        grid.EditSettings.AllowAdding = false;
        grid.EditSettings.AllowEditing = false;
        grid.EditSettings.AllowDeleting = false;
        //cut.SetParametersAsync(Microsoft.AspNetCore.Components.ParameterView.Empty).GetAwaiter().GetResult();
        Assert.False(grid.EditSettings.AllowAdding, "After second toggle, AllowAdding should be false");
        Assert.False(grid.EditSettings.AllowEditing, "After second toggle, AllowEditing should be false");
        Assert.False(grid.EditSettings.AllowDeleting, "After second toggle, AllowDeleting should be false");
    }
}

<SfFixture @ref="Fixture6" Test="OnParametersSetAsync_AllowAddingFalse_VerifyGridBehavior" Description="Verify grid disables Add functionality when AllowAdding is changed to false at runtime">
    <ComponentUnderTest>
        <SfGrid @ref="Grid6" DataSource="GenerateOrderData()" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel" })" Height="315" AllowTextWrap="true">
            <GridEditSettings AllowAdding="@Adding" AllowEditing="true" AllowDeleting="true" Mode="EditMode.Normal"></GridEditSettings>
            <GridTextWrapSettings WrapMode="@WrapModeValue"></GridTextWrapSettings>
            <GridSearchSettings Fields=@InitSearch Operator=Syncfusion.Blazor.Operator.Contains Key="Ha" IgnoreCase="@ignoreCase"></GridSearchSettings>
            <GridColumns>
                <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules{ Required=true})" TextAlign="TextAlign.Right" Width="120"></GridColumn>
                <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" ValidationRules="@(new ValidationRules{ Required=true, MinLength=5})" Width="120"></GridColumn>
