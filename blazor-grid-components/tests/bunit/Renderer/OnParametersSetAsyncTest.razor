    private bool ignoreCase = true;
    public string[] InitSearch = new string[] { "CustomerID" };
    public WrapMode WrapModeValue { get; set; } = WrapMode.Content;
    private SfGrid<Order> Grid6;
    void OnParametersSetAsync_AllowAddingFalse_VerifyGridBehavior(Fixture fixture)
    {
        var cut = fixture.GetComponentUnderTest<SfGrid<Order>>();
        var grid = cut.Instance;
        
        // Verify toolbar has "Add" button initially
        cut.WaitForState(() => cut.FindAll(".e-btn").Count > 0, TimeSpan.FromSeconds(5));
        var toolbarButtons = cut.FindAll(".e-btn");
        var addButton = toolbarButtons.FirstOrDefault(b => b.TextContent.Contains("Add"));
        //Assert.NotNull(addButton, "Add button should be present in toolbar");
        
        // Change AllowAdding to false
        Adding = false;
        WrapModeValue = WrapMode.Header;
        grid.EditSettings.AllowAdding = false;
