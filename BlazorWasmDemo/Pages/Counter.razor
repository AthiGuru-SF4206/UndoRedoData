@* @page "/counter"

@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons

<SfButton OnClick="SaveSingleCellHandler">Save single cell</SfButton>
<SfButton OnClick="SaveMultipleCellsHandler">Bulk save</SfButton>
<SfGrid DataSource="@Orders" TValue="Order" @ref="DefaultGrid" ID="Grid" AllowSorting="true" AllowFiltering="true" AllowPaging="true" Toolbar="@(new List<string>() { "Add", "Delete", "Edit", "Update", "Cancel" })">
    <GridPageSettings PageSize="8"></GridPageSettings>
    <GridEditSettings AllowEditing="true" AllowDeleting="true" AllowAdding="true" Mode="@EditMode.Cell"></GridEditSettings>
    <GridColumns>
        <GridColumn Field=@nameof(Order.OrderID) HeaderText="Order ID" IsPrimaryKey="true" TextAlign="@TextAlign.Right" Width="140"></GridColumn>
        <GridColumn Field=@nameof(Order.CustomerID) HeaderText="Customer Name" Width="150"></GridColumn>
        <GridColumn Field=@nameof(Order.Freight) HeaderText="Freight" Width="150" ValidationRules="@(new ValidationRules { Required = true, Min = 1, Max = 1000 })"></GridColumn>
        <GridColumn HeaderText="Manage Records" Width="150">
            <GridCommandColumns>
                <GridCommandColumn Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
                <GridCommandColumn Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-delete", CssClass = "e-flat" })"></GridCommandColumn>
                <GridCommandColumn Type="CommandButtonType.Save" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-update", CssClass = "e-flat" })"></GridCommandColumn>
                <GridCommandColumn Type="CommandButtonType.Cancel" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-cancel-icon", CssClass = "e-flat" })"></GridCommandColumn>
            </GridCommandColumns>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    public SfGrid<Order> DefaultGrid { get; set; }
    public static List<Order> Orders { get; set; }

    protected override void OnInitialized()
    {
        Orders = Enumerable.Range(1, 75).Select(x => new Order()
        {
            OrderID = 1000 + x,
            CustomerID = (new string[] { "ALFKI", "ANANTR", "ANTON", "BLONP", "BOLID" })[new Random().Next(5)],
            Freight = 2.1 * x,
        }).ToList();
    }

    private async Task SaveSingleCellHandler()
    {
        await DefaultGrid.SaveCellToDatasourceAsync("1001", "Freight", 50.5);
    }

    private async Task SaveMultipleCellsHandler()
    {
        var cellUpdates = new List<CellUpdate>
        {
            new CellUpdate { PrimaryKeyValue = "1005", ColumnField = "Freight", NewValue = 50.5 },
            new CellUpdate { PrimaryKeyValue = "1006", ColumnField = "CustomerID", NewValue = "Barath" },
            new CellUpdate { PrimaryKeyValue = "1007", ColumnField = "Freight", NewValue = 35.25 },
            new CellUpdate { PrimaryKeyValue = "1070", ColumnField = "Freight", NewValue = 35.25 },
            new CellUpdate { PrimaryKeyValue = "1070", ColumnField = "CustomerID", NewValue = "35.25" }
        };
        await DefaultGrid.SaveCellsToDatasourceAsync(cellUpdates);
    }

    
    public class Order
    {
        public int OrderID { get; set; }
        public string CustomerID { get; set; }
        public double Freight { get; set; }
    }
}
 *@