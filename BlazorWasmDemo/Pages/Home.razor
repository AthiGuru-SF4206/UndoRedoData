@page "/"
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs

<!-- Control Panel -->
<div style="padding: 20px; background-color: #f5f5f5; border-radius: 4px; margin-bottom: 20px;">
    <h4 style="margin: 0 0 15px 0;">Undo/Redo Configuration</h4>

    <!-- Toggle Undo/Redo Feature -->
    @*     <div style="margin-bottom: 15px;">
        <label style="font-weight: 500; margin-right: 10px;">Enable Undo/Redo:</label>
        <SfButton @onclick="ToggleUndoRedo" CssClass="@(EnableUndoRedo ? "e-success" : "e-outline")">
            @(EnableUndoRedo ? "ON" : "OFF")
        </SfButton>
    </div> *@

    <!-- Dynamic Undo/Redo Limit -->
    <div style="margin-bottom:15px;">
        <label style="font-weight:500; margin-right:10px;">
            Undo/Redo Limit:
        </label>

        <SfNumericTextBox TValue="int"
                          @bind-Value="UndoRedoLimit"
                          Min="1"
                          Max="50"
                          Width="200px">
        </SfNumericTextBox>

        <span style="margin-left:10px;color:#666;">
            Actions: @UndoRedoLimit
        </span>
    </div>
    <!-- Keyboard Shortcuts Info -->
    <div style="padding: 10px; background-color: #fff3cd; border-left: 4px solid #ffc107; border-radius: 2px; margin-bottom: 10px;">
        <small><strong>⌨️ Keyboard Shortcuts:</strong> Ctrl+Z (Undo) | Ctrl+Y (Redo)</small>
    </div>
    <!-- Status Information -->
    <div style="padding: 10px; background-color: #e8f4f8; border-left: 4px solid #0078d4; border-radius: 2px;">
        <small><strong>Status:</strong> Undo/Redo is <strong>@(EnableUndoRedo ? "ENABLED" : "DISABLED")</strong> | Limit: <strong>@UndoRedoLimit</strong> actions</small>
    </div>
</div>

<!-- Data Grid with Undo/Redo -->
<SfGrid @ref="GridRef" DataSource="@OrderData" EnableAutoFill="false"
        Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Update", "Cancel", "Undo", "Redo" })"
        Height="400">
  @*   <GridSelectionSettings CellSelectionMode="CellSelectionMode.Box" Mode="Syncfusion.Blazor.Grids.SelectionMode.Cell" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"></GridSelectionSettings> *@
    <GridEditSettings AllowAdding="true"
                      AllowEditing="true"
                      AllowDeleting="true"
                      Mode="EditMode.Batch"
                      EnableUndoRedo="@EnableUndoRedo"
                      UndoRedoLimit="@UndoRedoLimit">
    </GridEditSettings>
    <GridColumns>
        <GridColumn Field=@nameof(OrderDetails.OrderID) HeaderText="Order ID" IsPrimaryKey="true" ValidationRules="@(new ValidationRules { Required = true })" TextAlign="TextAlign.Right" Width="100"></GridColumn>
        <GridColumn Field=@nameof(OrderDetails.CustomerID) HeaderText="Customer" ValidationRules="@(new ValidationRules { Required = true, MinLength = 3 })" Width="120"></GridColumn>
        <GridColumn Field=@nameof(OrderDetails.OrderDate) HeaderText="Order Date" Type="ColumnType.Date" Format="MM/dd/yyyy" EditType="EditType.DatePickerEdit" Width="140"></GridColumn>
        <GridColumn Field=@nameof(OrderDetails.Freight) HeaderText="Freight" Format="C2" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" ValidationRules="@(new ValidationRules { Min = 0, Max = 5000 })" Width="120"></GridColumn>
        <GridColumn Field=@nameof(OrderDetails.Quantity) HeaderText="Quantity" TextAlign="TextAlign.Right" EditType="EditType.NumericEdit" ValidationRules="@(new ValidationRules { Required = true, Min = 1, Max = 100 })" Width="110"></GridColumn>
        <GridColumn Field=@nameof(OrderDetails.ShipCountry) HeaderText="Ship Country" Width="130"></GridColumn>
        <GridColumn Field=@nameof(OrderDetails.Status) HeaderText="Status" EditType="EditType.DropDownEdit" Width="120"></GridColumn>
    </GridColumns>
</SfGrid>

@code {
    // State Management
    private SfGrid<OrderDetails> GridRef;
    private List<OrderDetails> OrderData { get; set; }
    private bool EnableUndoRedo = true;
    private int UndoRedoLimit = 10;

    protected override void OnInitialized()
    {
        OrderData = OrderDetails.GetAllRecords();
    }

    // Toggle Undo/Redo Feature
    private void ToggleUndoRedo()
    {
        EnableUndoRedo = !EnableUndoRedo;
        GridRef.CallStateHasChanged();
        StateHasChanged();
    }

    // Order Details Model
    public class OrderDetails
    {
        public static List<OrderDetails> Order = new List<OrderDetails>();

        public OrderDetails() { }

        public OrderDetails(int OrderID, string CustomerID, DateTime OrderDate, double Freight, int Quantity, string ShipCountry, string Status)
